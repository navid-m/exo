val ecs       = use("ecs.sx")
val engine    = use("engine.sx")
val math      = use("std/math")
val rendering = use("rendering.sx")

val SNOW_FLAKE_COUNT: i32 = 17
val SNOW_MIN_X: f32 = -3.2
val SNOW_MAX_X: f32 = 3.2 
val SNOW_MIN_Z: f32 = -3.6
val SNOW_MAX_Z: f32 = -0.2 
val SNOW_RESPAWN_Y: f32 = 3.9
val SNOW_FLOOR_Y: f32 = -0.2 

type (SceneUpdater) SnowUpdater = {}

fn wrap_range(value: f32, min_v: f32, max_v: f32) f32 = {
    val span: f32 = max_v - min_v
    if span <= (0.0 as f32) {
        return value
    }
    val wrapped: mut f32 = value
    if wrapped < min_v {
        wrapped = wrapped + span
    }
    if wrapped > max_v {
        wrapped = wrapped - span
    }
    return wrapped
}

fn respawn_x(index: i32, time: f32) f32 = {
    val phase: f32 = (index as f32) * (0.77 as f32) + time * (0.31 as f32)
    val norm: f32 = ((math.sin(phase as f64)) as f32) * (0.5 as f32) + (0.5 as f32)
    return SNOW_MIN_X + norm * (SNOW_MAX_X - SNOW_MIN_X)
}

fn respawn_z(index: i32, time: f32) f32 = {
    val phase: f32 = (index as f32) * (1.11 as f32) + time * (0.23 as f32)
    val norm: f32 = ((math.cos(phase as f64)) as f32) * (0.5 as f32) + (0.5 as f32)
    return SNOW_MIN_Z + norm * (SNOW_MAX_Z - SNOW_MIN_Z)
}

pub fn (SnowUpdater) su_update(_: mut self, scene: mut ecs.Scene3D, dt: f32, time: f32) void = {
    val next_spheres: mut list[ecs.SphereEntity] = []
    val index: mut i32 = 0 as i32
    for sphere in scene.spheres {
        if index < SNOW_FLAKE_COUNT {
            val phase: f32 = time * (0.82 as f32) + (index as f32) * (0.63 as f32)
            val fall_speed: f32 = (0.72 as f32) + ((math.sin((phase * (1.33 as f32)) as f64)) as f32) * (0.22 as f32)
            val drift_x: f32 = ((math.sin((phase * (1.91 as f32)) as f64)) as f32) * (0.36 as f32) * dt
            val drift_z: f32 = ((math.cos((phase * (1.57 as f32)) as f64)) as f32) * (0.22 as f32) * dt
            val next_y: f32 = sphere.position.y - fall_speed * dt
            if next_y <= SNOW_FLOOR_Y {
                @append(next_spheres, ecs.make_sphere(
                    ecs.make_vec3(respawn_x(index, time), SNOW_RESPAWN_Y, respawn_z(index, time)),
                    sphere.color,
                    sphere.radius
                ))
            } else {
                @append(next_spheres, ecs.make_sphere(
                    ecs.make_vec3(
                        wrap_range(sphere.position.x + drift_x, SNOW_MIN_X, SNOW_MAX_X),
                        next_y,
                        wrap_range(sphere.position.z + drift_z, SNOW_MIN_Z, SNOW_MAX_Z)
                    ),
                    sphere.color,
                    sphere.radius
                ))
            }
        } else {
            @append(next_spheres, sphere)
        }
        index = index + (1 as i32)
    }
    scene.spheres = next_spheres
}

fn build_snow_scene() ecs.Scene3D = {
    val scene: mut ecs.Scene3D = ecs.new_scene(
        ecs.make_light(
            ecs.make_vec3(-1.2 as f32, 4.5 as f32, 1.8 as f32),
            ecs.make_vec3(0.96 as f32, 0.98 as f32, 1.00 as f32),
            2.2 as f32,
            10.0 as f32
        )
    )

    @append(scene.cubes, ecs.make_cube(
        ecs.make_vec3(0.0 as f32, -4.4 as f32, -1.8 as f32),
        ecs.make_vec3(0.98 as f32, 0.98 as f32, 1.00 as f32),
        8.8 as f32,
        0.0 as f32
    ))

    @append(scene.spheres, ecs.make_sphere(ecs.make_vec3(-2.8 as f32, 2.8 as f32, -0.3 as f32), ecs.make_vec3(1.00 as f32, 1.00 as f32, 1.00 as f32), 0.07 as f32))
    @append(scene.spheres, ecs.make_sphere(ecs.make_vec3(-2.1 as f32, 3.4 as f32, -1.4 as f32), ecs.make_vec3(0.98 as f32, 0.99 as f32, 1.00 as f32), 0.06 as f32))
    @append(scene.spheres, ecs.make_sphere(ecs.make_vec3(-1.3 as f32, 2.5 as f32, -2.1 as f32), ecs.make_vec3(0.96 as f32, 0.99 as f32, 1.00 as f32), 0.08 as f32))
    @append(scene.spheres, ecs.make_sphere(ecs.make_vec3(-0.6 as f32, 3.1 as f32, -3.0 as f32), ecs.make_vec3(1.00 as f32, 1.00 as f32, 1.00 as f32), 0.06 as f32))
    @append(scene.spheres, ecs.make_sphere(ecs.make_vec3(0.2 as f32, 2.4 as f32, -0.8 as f32), ecs.make_vec3(0.98 as f32, 0.99 as f32, 1.00 as f32), 0.07 as f32))
    @append(scene.spheres, ecs.make_sphere(ecs.make_vec3(0.8 as f32, 3.6 as f32, -1.7 as f32), ecs.make_vec3(0.97 as f32, 0.99 as f32, 1.00 as f32), 0.05 as f32))
    @append(scene.spheres, ecs.make_sphere(ecs.make_vec3(1.5 as f32, 2.7 as f32, -2.8 as f32), ecs.make_vec3(1.00 as f32, 1.00 as f32, 1.00 as f32), 0.07 as f32))
    @append(scene.spheres, ecs.make_sphere(ecs.make_vec3(2.2 as f32, 3.2 as f32, -0.6 as f32), ecs.make_vec3(0.97 as f32, 0.99 as f32, 1.00 as f32), 0.06 as f32))
    @append(scene.spheres, ecs.make_sphere(ecs.make_vec3(2.9 as f32, 2.5 as f32, -1.9 as f32), ecs.make_vec3(1.00 as f32, 1.00 as f32, 1.00 as f32), 0.08 as f32))
    @append(scene.spheres, ecs.make_sphere(ecs.make_vec3(-2.5 as f32, 1.8 as f32, -3.3 as f32), ecs.make_vec3(0.97 as f32, 0.99 as f32, 1.00 as f32), 0.07 as f32))
    @append(scene.spheres, ecs.make_sphere(ecs.make_vec3(-1.7 as f32, 1.3 as f32, -0.9 as f32), ecs.make_vec3(1.00 as f32, 1.00 as f32, 1.00 as f32), 0.06 as f32))
    @append(scene.spheres, ecs.make_sphere(ecs.make_vec3(-0.9 as f32, 1.9 as f32, -2.2 as f32), ecs.make_vec3(0.98 as f32, 0.99 as f32, 1.00 as f32), 0.07 as f32))
    @append(scene.spheres, ecs.make_sphere(ecs.make_vec3(-0.1 as f32, 1.5 as f32, -3.4 as f32), ecs.make_vec3(0.97 as f32, 1.00 as f32, 1.00 as f32), 0.06 as f32))
    @append(scene.spheres, ecs.make_sphere(ecs.make_vec3(0.6 as f32, 1.1 as f32, -1.2 as f32), ecs.make_vec3(1.00 as f32, 1.00 as f32, 1.00 as f32), 0.07 as f32))
    @append(scene.spheres, ecs.make_sphere(ecs.make_vec3(1.4 as f32, 1.7 as f32, -2.4 as f32), ecs.make_vec3(0.97 as f32, 0.99 as f32, 1.00 as f32), 0.06 as f32))
    @append(scene.spheres, ecs.make_sphere(ecs.make_vec3(2.1 as f32, 1.2 as f32, -3.1 as f32), ecs.make_vec3(1.00 as f32, 1.00 as f32, 1.00 as f32), 0.08 as f32))
    @append(scene.spheres, ecs.make_sphere(ecs.make_vec3(2.7 as f32, 1.9 as f32, -1.5 as f32), ecs.make_vec3(0.97 as f32, 0.99 as f32, 1.00 as f32), 0.06 as f32))

    @append(scene.spheres, ecs.make_sphere(ecs.make_vec3(-1.3 as f32, -0.6 as f32, -2.1 as f32), ecs.make_vec3(0.96 as f32, 0.97 as f32, 1.00 as f32), 0.48 as f32))
    @append(scene.spheres, ecs.make_sphere(ecs.make_vec3(-1.3 as f32, 0.05 as f32, -2.1 as f32), ecs.make_vec3(0.98 as f32, 0.99 as f32, 1.00 as f32), 0.34 as f32))
    @append(scene.spheres, ecs.make_sphere(ecs.make_vec3(-1.3 as f32, 0.55 as f32, -2.1 as f32), ecs.make_vec3(1.00 as f32, 1.00 as f32, 1.00 as f32), 0.22 as f32))

    @append(scene.cubes, ecs.make_cube(
        ecs.make_vec3(1.9 as f32, -0.1 as f32, -1.0 as f32),
        ecs.make_vec3(0.88 as f32, 0.95 as f32, 1.00 as f32),
        0.46 as f32,
        0.38 as f32
    ))
    @append(scene.cubes, ecs.make_cube(
        ecs.make_vec3(2.5 as f32, 0.2 as f32, -2.3 as f32),
        ecs.make_vec3(0.90 as f32, 0.96 as f32, 1.00 as f32),
        0.34 as f32,
        -0.52 as f32
    ))
    return scene
}

pub fn main() i32 = {
    val scene: mut ecs.Scene3D = build_snow_scene()
    scene.model = trust engine.load_embedded_fixture_model()

    val input: engine.InputConfig = {
        keys: rendering.default_key_bindings(),
        mouse: {
            enabled:       true,
            sensitivity_x: 0.0018 as f32,
            sensitivity_y: 0.0018 as f32,
            invert_y:      false
        },
        quit_key: engine.SDL_SCANCODE_ESCAPE
    }
    val config: mut engine.ExoConfig = rendering.default_config()
    config.title = "exo-snow"
    config.width = 1280 as i32
    config.height = 720 as i32

    val app: engine.ExoApp = engine.create_app(config, scene, rendering.default_camera(), input)
    val su: SnowUpdater = {}
    return trust engine.run_app_with_scene_updater[SnowUpdater](app, su)
}
