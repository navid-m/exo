val math     = use("std/math")
val ecs      = use("ecs.sx")
val cam      = use("engine/camera.sx")
val input    = use("engine/input.sx")
val audio    = use("engine/audio.sx")
val shaders  = use("engine/shaders.sx")
val glb      = use("engine/glb.sx")
val renderer = use("engine/renderer.sx")
val mesh     = use("engine/mesh.sx")
val exoerr   = use("engine/error.sx")

val DEFAULT_SCREEN_WIDTH: i32 = 1440
val DEFAULT_SCREEN_HEIGHT: i32 = 900
val KEY_STATE_COUNT: i32 = 512

pub type ExoConfig = {
    title: ref u8
    width: i32
    height: i32
    shaders: shaders.ExoShaderConfig
}

pub type ExoApp = {
    config: ExoConfig
    scene: mut ecs.Scene3D
    scenes: mut list[ecs.Scene3D]
    active_scene_index: mut usize
    camera: mut cam.Camera
    input: input.InputConfig
    audio: audio.AudioMixerConfig
    audio_runtime: mut audio.RuntimeAudioMixer
    keys: mut ref u8
}

/// Application lifecycle and input hooks.
///
/// Games implement this spec to receive input and update their own state. The
/// engine does not assign any gameplay meaning to keys: callbacks decide what
/// every key press does.
pub spec AppEvents = {
    pub fn on_start(e: mut self, app: mut ExoApp) void
    pub fn on_update(e: mut self, app: mut ExoApp, dt: f32, time: f32) void
    pub fn on_key_down(e: mut self, app: mut ExoApp, key: i32) void
    pub fn on_key_up(e: mut self, app: mut ExoApp, key: i32) void
    pub fn on_mouse_move(e: mut self, app: mut ExoApp, dx: f32, dy: f32) void
    pub fn on_shutdown(e: mut self, app: mut ExoApp) void
}

type (AppEvents) NoAppEvents = {
    _unused: u8
}

pub fn (NoAppEvents) on_start(_: mut self, _: mut ExoApp) void = {}
pub fn (NoAppEvents) on_update(_: mut self, _: mut ExoApp, _: f32, _: f32) void = {}
pub fn (NoAppEvents) on_key_down(_: mut self, _: mut ExoApp, _: i32) void = {}
pub fn (NoAppEvents) on_key_up(_: mut self, _: mut ExoApp, _: i32) void = {}
pub fn (NoAppEvents) on_mouse_move(_: mut self, _: mut ExoApp, _: f32, _: f32) void = {}
pub fn (NoAppEvents) on_shutdown(_: mut self, _: mut ExoApp) void = {}

fn empty_audio_runtime() audio.RuntimeAudioMixer = {
    return {
        initialized: false,
        sample_audio: none as ref void
    }
}

pub fn default_camera() cam.Camera = {
    return cam.default_camera()
}

pub fn default_key_bindings() input.KeyBindings = {
    return input.default_key_bindings()
}

pub fn default_mouse_config() input.MouseConfig = {
    return input.default_mouse_config()
}

pub fn default_input_config() input.InputConfig = {
    return input.default_input_config()
}

pub fn default_audio_mixer() audio.AudioMixerConfig = {
    return audio.default_audio_mixer()
}

pub fn default_shader_config() shaders.ExoShaderConfig = {
    return shaders.default_shader_config()
}

pub fn load_glb(path: ref u8) option[ecs.GlbModel] = trust {
    return glb.load_glb(path)
}

pub fn parse_glb_bytes(data: ref u8, len: usize) option[ecs.GlbModel] = trust {
    return glb.parse_glb_bytes(data, len)
}

pub fn build_test_glb_fixture() glb.GlbFixture = trust {
    return glb.build_test_glb_fixture()
}

pub fn compute_glb_bounds(model: mut ref ecs.GlbModel) void = trust {
    glb.compute_glb_bounds(model)
}

pub fn load_embedded_fixture_model() ecs.GlbModel = trust {
    return glb.load_embedded_fixture_model()
}

pub fn default_config() ExoConfig = {
    return {
        title: "exo-engine",
        width: DEFAULT_SCREEN_WIDTH,
        height: DEFAULT_SCREEN_HEIGHT,
        shaders: default_shader_config()
    }
}

fn fallback_scene() ecs.Scene3D = {
    return ecs.new_scene(ecs.default_light())
}

fn first_scene(scenes: list[ecs.Scene3D]) ecs.Scene3D = {
    if @get(scenes, 0 as usize) is some scene {
        return scene
    }
    return fallback_scene()
}

pub fn create_scene_app(
    config: ExoConfig,
    scenes: list[ecs.Scene3D],
    camera: cam.Camera,
    input_cfg: input.InputConfig,
    audio_cfg: audio.AudioMixerConfig
) ExoApp = {
    return {
        config: config,
        scene: first_scene(scenes),
        scenes: scenes,
        active_scene_index: 0 as usize,
        camera: camera,
        input: input_cfg,
        audio: audio_cfg,
        audio_runtime: empty_audio_runtime(),
        keys: none as ref u8
    }
}

pub fn create_app(config: ExoConfig, scene: ecs.Scene3D, camera: cam.Camera, input_cfg: input.InputConfig) ExoApp = {
    val scenes: mut list[ecs.Scene3D] = []
    @append(scenes, scene)
    return create_scene_app(config, scenes, camera, input_cfg, default_audio_mixer())
}

pub type ExoAppBuilder = {
    title: mut ref u8
    width: mut i32
    height: mut i32
    shaders: mut shaders.ExoShaderConfig
    scenes: mut list[ecs.Scene3D]
    camera: mut cam.Camera
    input: mut input.InputConfig
    audio: mut audio.AudioMixerConfig
}

pub fn new_app() ExoAppBuilder = {
    val cfg: ExoConfig = default_config()
    return {
        title: cfg.title,
        width: cfg.width,
        height: cfg.height,
        shaders: cfg.shaders,
        scenes: [],
        camera: default_camera(),
        input: default_input_config(),
        audio: default_audio_mixer()
    }
}

pub fn build_app(builder: ExoAppBuilder) ExoApp = {
    val config: ExoConfig = {
        title: builder.title,
        width: builder.width,
        height: builder.height,
        shaders: builder.shaders
    }
    return create_scene_app(
        config,
        builder.scenes,
        builder.camera,
        builder.input,
        builder.audio
    )
}

pub fn with_title(app: mut ExoAppBuilder, title: ref u8) void = {
    app.title = title
}

pub fn with_resolution(app: mut ExoAppBuilder, width: i32, height: i32) void = {
    app.width = width
    app.height = height
}

pub fn with_shaders(app: mut ExoAppBuilder, shader_cfg: shaders.ExoShaderConfig) void = {
    app.shaders = shader_cfg
}

pub fn with_scene_list(app: mut ExoAppBuilder, scenes: list[ecs.Scene3D]) void = {
    app.scenes = scenes
}

pub fn with_camera(app: mut ExoAppBuilder, camera: cam.Camera) void = {
    app.camera = camera
}

pub fn with_default_camera(app: mut ExoAppBuilder) void = {
    app.camera = default_camera()
}

pub fn with_input(app: mut ExoAppBuilder, input_cfg: input.InputConfig) void = {
    app.input = input_cfg
}

pub fn with_key_bindings(app: mut ExoAppBuilder, keys: input.KeyBindings) void = {
    app.input.keys = keys
}

pub fn with_mouse_config(app: mut ExoAppBuilder, mouse: input.MouseConfig) void = {
    app.input.mouse = mouse
}

pub fn with_quit_key(app: mut ExoAppBuilder, key: i32) void = {
    app.input.quit_key = key
}

pub fn with_audio(app: mut ExoAppBuilder, audio_cfg: audio.AudioMixerConfig) void = {
    app.audio = audio_cfg
}

pub fn set_active_scene(app: mut ExoApp, index: usize) void = {
    if @get(app.scenes, index) is some scene {
        app.active_scene_index = index
        app.scene = scene
    }
}

pub fn next_scene(app: mut ExoApp) void = {
    val count: usize = @len(app.scenes)
    if count <= (1 as usize) {
        return
    }
    val next_index: usize = app.active_scene_index + (1 as usize)
    if next_index >= count {
        set_active_scene(app, 0 as usize)
        return
    }
    set_active_scene(app, next_index)
}

pub fn key_held(app: ExoApp, key: i32) bool = trust {
    return input.safe_key(app.keys, key) != 0
}

pub fn play_sound(app: ExoApp) bool = trust {
    return audio.play_runtime_audio(app.audio, app.audio_runtime)
}

fn run_app_internal[E: AppEvents](app0: ExoApp, events0: E) i32 = trust {
    val app: mut ExoApp = app0
    val events: E = events0
    val runtime: ref void = renderer.create(app.config.title, app.config.width, app.config.height, app.config.shaders)
    if runtime == none {
        exoerr.print("SDL3 runtime init failed")
        return 1 as i32
    }
    @print("exo controls: WASD move, Space/LShift up/down, arrows/mouse look, Esc quit\n", {})
    if app.input.mouse.enabled {
        if !renderer.set_relative_mouse_mode(runtime, true) {
            exoerr.print("SDL_SetWindowRelativeMouseMode failed")
            renderer.destroy(runtime)
            return 1 as i32
        }
    }
    val cube_mesh: renderer.MeshGPU = mesh.build_cube_mesh(runtime)
    val sphere_mesh: renderer.MeshGPU = mesh.build_sphere_mesh(runtime, 16 as i32, 24 as i32)
    val quad_mesh: renderer.MeshGPU = mesh.build_quad_mesh(runtime)
    if !renderer.mesh_valid(cube_mesh) || !renderer.mesh_valid(sphere_mesh) || !renderer.mesh_valid(quad_mesh) {
        renderer.destroy_mesh(runtime, quad_mesh)
        renderer.destroy_mesh(runtime, sphere_mesh)
        renderer.destroy_mesh(runtime, cube_mesh)
        renderer.destroy(runtime)
        return 1 as i32
    }
    val glb_mesh: mut renderer.MeshGPU = { raw: none as ref void, index_count: 0 as i32 }
    if app.scene.model.valid && app.scene.model.raw_bytes != none && app.scene.model.bin_length > (0 as usize) {
        glb_mesh = mesh.upload_glb_model(runtime, app.scene.model)
        val rt: mut ref renderer.Renderer = runtime as mut ref renderer.Renderer
        renderer.upload_glb_texture(rt, app.scene.model)
    }
    val last_scene_index: mut usize = app.active_scene_index
    app.audio_runtime = audio.init_runtime_audio(app.audio)
    if audio.audio_enabled(app.audio) && !app.audio_runtime.initialized {
        exoerr.print("SDL3 audio init failed")
        renderer.destroy_mesh(runtime, quad_mesh)
        renderer.destroy_mesh(runtime, sphere_mesh)
        renderer.destroy_mesh(runtime, cube_mesh)
        renderer.destroy(runtime)
        return 1 as i32
    }
    val prev_keys: ref u8 = @alloc(KEY_STATE_COUNT as usize) as ref u8
    if prev_keys == none {
        exoerr.print("failed to allocate key state")
        audio.shutdown_runtime_audio(app.audio_runtime)
        renderer.destroy_mesh(runtime, quad_mesh)
        renderer.destroy_mesh(runtime, sphere_mesh)
        renderer.destroy_mesh(runtime, cube_mesh)
        renderer.destroy(runtime)
        return 1 as i32
    }
    @memset(prev_keys as ref void, 0, KEY_STATE_COUNT as usize)
    E.on_start(events, app)
    val start_ticks: u64 = renderer.get_ticks()
    val last_ticks: mut u64 = start_ticks
    val quit: mut bool = false
    val exit_code: mut i32 = 0 as i32
    val debug_frame: mut i32 = 0 as i32
    for !quit {
        if renderer.poll_quit() {
            quit = true
        }
        val keys: ref u8 = renderer.keyboard_state()
        app.keys = keys
        val quit_pressed: u8 = input.safe_key(keys, app.input.quit_key)
        if quit_pressed != 0 {
            quit = true
        }

        val key_index: mut i32 = 0 as i32
        for key_index < KEY_STATE_COUNT {
            val key_cur: u8 = @load8(@ptradd(keys, key_index as usize))
            val key_prev: u8 = @load8(@ptradd(prev_keys, key_index as usize))
            if key_cur != 0 && key_prev == 0 {
                E.on_key_down(events, app, key_index)
            }
            if key_cur == 0 && key_prev != 0 {
                E.on_key_up(events, app, key_index)
            }
            @store8(@ptradd(prev_keys, key_index as usize), key_cur)
            key_index = key_index + (1 as i32)
        }

        if app.active_scene_index != last_scene_index {
            renderer.destroy_mesh(runtime, glb_mesh)
            glb_mesh = { raw: none as ref void, index_count: 0 as i32 }
            if app.scene.model.valid && app.scene.model.raw_bytes != none && app.scene.model.bin_length > (0 as usize) {
                glb_mesh = mesh.upload_glb_model(runtime, app.scene.model)
                val rt2: mut ref renderer.Renderer = runtime as mut ref renderer.Renderer
                renderer.upload_glb_texture(rt2, app.scene.model)
            } else {
                val rt2: mut ref renderer.Renderer = runtime as mut ref renderer.Renderer
                renderer.clear_glb_texture(rt2)
            }
            last_scene_index = app.active_scene_index
            @print("scene {d}\n", {app.active_scene_index})
        }

        val mx: mut f32 = 0.0 as f32
        val my: mut f32 = 0.0 as f32
        renderer.relative_mouse_state(@addr(mx), @addr(my))
        if mx != (0.0 as f32) || my != (0.0 as f32) {
            E.on_mouse_move(events, app, mx, my)
        }

        val now_ticks: u64 = renderer.get_ticks()
        val dt_raw: f32 = ((now_ticks - last_ticks) as f32) / (1000.0 as f32)
        val dt: f32 = math.fclamp(dt_raw as f64, 0.0, 0.05) as f32
        val time_value: f32 = ((now_ticks - start_ticks) as f32) / (1000.0 as f32)
        last_ticks = now_ticks
        cam.update_camera(app.camera, app.input, dt, keys, mx, my)
        E.on_update(events, app, dt, time_value)

        val frame_w: mut u32 = app.config.width as u32
        val frame_h: mut u32 = app.config.height as u32
        if !renderer.begin_frame(runtime, @addr(frame_w), @addr(frame_h)) {
            exoerr.print("SDL3 begin frame failed")
            exit_code = 1 as i32
            break
        }
        if !renderer.begin_reflection_pass(runtime, 0.05 as f32, 0.08 as f32, 0.14 as f32, 1.0 as f32) {
            exoerr.print("SDL3 reflection pass failed")
            exit_code = 1 as i32
            break
        }
        renderer.render_reflection_scene(runtime, cube_mesh, sphere_mesh, app.scene, app.camera, frame_w as i32, frame_h as i32, time_value, -0.18 as f32)
        if !renderer.begin_scene_pass(runtime, 0.09 as f32, 0.15 as f32, 0.30 as f32, 1.0 as f32) {
            exoerr.print("SDL3 scene pass failed")
            exit_code = 1 as i32
            break
        }
        renderer.render_scene(runtime, cube_mesh, sphere_mesh, quad_mesh, glb_mesh, app.scene, app.camera, frame_w as i32, frame_h as i32, time_value)
        if !renderer.apply_fxaa(runtime) {
            exoerr.print("SDL3 FXAA pass failed")
            exit_code = 1 as i32
            break
        }
        renderer.end_pass(runtime)
        if !renderer.submit_frame(runtime) {
            exoerr.print("SDL3 submit frame failed")
            exit_code = 1 as i32
            break
        }
        if debug_frame == (5 as i32) {
            renderer.debug_dump_scene(runtime, "/tmp/exo_scene.ppm")
        }
        debug_frame = debug_frame + (1 as i32)
    }
    E.on_shutdown(events, app)
    audio.shutdown_runtime_audio(app.audio_runtime)
    @free(prev_keys as ref void)
    renderer.destroy_mesh(runtime, glb_mesh)
    renderer.destroy_mesh(runtime, quad_mesh)
    renderer.destroy_mesh(runtime, sphere_mesh)
    renderer.destroy_mesh(runtime, cube_mesh)
    renderer.destroy(runtime)
    return exit_code
}

pub fn run_app_with_events[E: AppEvents](app: ExoApp, events: E) i32 = trust {
    return run_app_internal[E](app, events)
}

pub fn run_app(app0: ExoApp) i32 = trust {
    val events: NoAppEvents = {
        _unused: 0 as u8
    }
    return run_app_internal[NoAppEvents](app0, events)
}
