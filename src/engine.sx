val exo_last_error: mut ref u8 = none

fn clear_exo_error() void = {
    exo_last_error = none
}

fn set_exo_error(msg: ref u8) bool = {
    exo_last_error = msg
    return false
}

fn set_exo_error_ptr(msg: ref u8) ref void = {
    exo_last_error = msg
    return none as ref void
}

fn exo_sdl3_get_error() ref u8 = {
    if exo_last_error != none {
        return exo_last_error
    }
    return trust SDL_GetError()
}

fn read_f32(base: ref f32, index: usize) f32 = trust {
    val slot: ref F32Slot = @ptradd(base as ref void, index * (@sizeof(f32) as usize)) as ref F32Slot
    return slot.value
}

fn transpose_mat4_ptr(src: ref f32) Mat4 = trust {
    return mat4(
        read_f32(src, 0 as usize), read_f32(src, 4 as usize), read_f32(src, 8 as usize), read_f32(src, 12 as usize),
        read_f32(src, 1 as usize), read_f32(src, 5 as usize), read_f32(src, 9 as usize), read_f32(src, 13 as usize),
        read_f32(src, 2 as usize), read_f32(src, 6 as usize), read_f32(src, 10 as usize), read_f32(src, 14 as usize),
        read_f32(src, 3 as usize), read_f32(src, 7 as usize), read_f32(src, 11 as usize), read_f32(src, 15 as usize)
    )
}

fn vec4_from_ptr(src: ref f32, w: f32) Vec4f = trust {
    return {
        x: read_f32(src, 0 as usize),
        y: read_f32(src, 1 as usize),
        z: read_f32(src, 2 as usize),
        w: w
    }
}

fn load_binary_file(path: ref u8) option[BinaryBlob] = trust {
    val file: ref void = fopen(path, "rb")
    if file == none {
        set_exo_error(path)
        return none
    }
    fseek(file, 0, 2 as i32)
    val size: i64 = ftell(file)
    rewind(file)
    if size <= 0 {
        fclose(file)
        set_exo_error("failed to read file")
        return none
    }
    val buf: ref u8 = @alloc(size as usize) as ref u8
    if buf == none {
        fclose(file)
        set_exo_error("failed to allocate file buffer")
        return none
    }
    val read_count: usize = fread(buf as ref void, 1 as usize, size as usize, file)
    fclose(file)
    if read_count != size as usize {
        @free(buf as ref void)
        set_exo_error("failed to read file")
        return none
    }
    return some {
        data: buf,
        len: size as usize
    }
}

fn exo_load_shader(runtime: ref ExoSDL3Runtime, path: ref u8, stage: i32, num_samplers: u32, num_uniform_buffers: u32) ref void = trust {
    if load_binary_file(path) is some blob {
        val info: mut SDLGPUShaderCreateInfo = {
            code_size: 0 as usize,
            code: none as ref u8,
            entrypoint: none as ref u8,
            format: 0 as u32,
            stage: 0 as i32,
            num_samplers: 0 as u32,
            num_storage_textures: 0 as u32,
            num_storage_buffers: 0 as u32,
            num_uniform_buffers: 0 as u32,
            props: 0 as u32
        }
        info.code_size = blob.len
        info.code = blob.data
        info.entrypoint = "main"
        info.format = SDL_GPU_SHADERFORMAT_SPIRV
        info.stage = stage
        info.num_samplers = num_samplers
        info.num_uniform_buffers = num_uniform_buffers
        val shader: ref void = SDL_CreateGPUShader(runtime.device, @addr(info))
        @free(blob.data as ref void)
        return shader
    }
    return none as ref void
}

fn exo_create_texture(runtime: ref ExoSDL3Runtime, format: i32, usage: u32, width: u32, height: u32) ref void = {
    val info: mut SDLGPUTextureCreateInfo = {
        typ: 0 as i32,
        format: 0 as i32,
        usage: 0 as u32,
        width: 0 as u32,
        height: 0 as u32,
        layer_count_or_depth: 0 as u32,
        num_levels: 0 as u32,
        sample_count: 0 as i32,
        props: 0 as u32
    }
    info.typ = SDL_GPU_TEXTURETYPE_2D
    info.format = format
    info.usage = usage
    info.width = width
    info.height = height
    info.layer_count_or_depth = 1 as u32
    info.num_levels = 1 as u32
    info.sample_count = SDL_GPU_SAMPLECOUNT_1
    return trust SDL_CreateGPUTexture(runtime.device, @addr(info))
}

fn exo_release_render_targets(runtime: mut ref ExoSDL3Runtime) void = trust {
    if runtime.scene_depth != none {
        SDL_ReleaseGPUTexture(runtime.device, runtime.scene_depth)
        runtime.scene_depth = none
    }
    if runtime.scene_color != none {
        SDL_ReleaseGPUTexture(runtime.device, runtime.scene_color)
        runtime.scene_color = none
    }
    if runtime.reflection_depth != none {
        SDL_ReleaseGPUTexture(runtime.device, runtime.reflection_depth)
        runtime.reflection_depth = none
    }
    if runtime.reflection_color != none {
        SDL_ReleaseGPUTexture(runtime.device, runtime.reflection_color)
        runtime.reflection_color = none
    }
}

fn exo_recreate_render_targets(runtime: mut ref ExoSDL3Runtime, width: u32, height: u32) bool = trust {
    runtime.render_width = width
    runtime.render_height = height
    exo_release_render_targets(runtime)
    runtime.reflection_color = exo_create_texture(
        runtime,
        runtime.swapchain_format,
        SDL_GPU_TEXTUREUSAGE_COLOR_TARGET | SDL_GPU_TEXTUREUSAGE_SAMPLER,
        width,
        height
    )
    if runtime.reflection_color == none {
        return false
    }
    runtime.reflection_depth = exo_create_texture(
        runtime,
        SDL_GPU_TEXTUREFORMAT_D32_FLOAT,
        SDL_GPU_TEXTUREUSAGE_DEPTH_STENCIL_TARGET,
        width,
        height
    )
    if runtime.reflection_depth == none {
        return false
    }
    runtime.scene_depth = exo_create_texture(
        runtime,
        SDL_GPU_TEXTUREFORMAT_D32_FLOAT,
        SDL_GPU_TEXTUREUSAGE_DEPTH_STENCIL_TARGET,
        width,
        height
    )
    if runtime.scene_depth == none {
        return false
    }
    runtime.scene_color = exo_create_texture(
        runtime,
        runtime.swapchain_format,
        SDL_GPU_TEXTUREUSAGE_COLOR_TARGET | SDL_GPU_TEXTUREUSAGE_SAMPLER,
        width,
        height
    )
    return runtime.scene_color != none
}

fn exo_create_pipeline(
    runtime: ref ExoSDL3Runtime,
    vs_path: ref u8,
    fs_path: ref u8,
    color_format: i32,
    enable_blend: bool,
    src_color: i32,
    dst_color: i32,
    src_alpha: i32,
    dst_alpha: i32,
    depth_write: bool,
    fragment_samplers: u32
) ref void = trust {
    val vs: ref void = exo_load_shader(runtime, vs_path, SDL_GPU_SHADERSTAGE_VERTEX, 0 as u32, 1 as u32)
    if vs == none {
        return none as ref void
    }
    val fs: ref void = exo_load_shader(runtime, fs_path, SDL_GPU_SHADERSTAGE_FRAGMENT, fragment_samplers, 1 as u32)
    if fs == none {
        SDL_ReleaseGPUShader(runtime.device, vs)
        return none as ref void
    }
    val vertex_buffer_desc: mut SDLGPUVertexBufferDescription = {
        slot: 0 as u32,
        pitch: 0 as u32,
        input_rate: 0 as i32,
        instance_step_rate: 0 as u32
    }
    vertex_buffer_desc.slot = 0 as u32
    vertex_buffer_desc.pitch = 32 as u32
    vertex_buffer_desc.input_rate = SDL_GPU_VERTEXINPUTRATE_VERTEX
    val vertex_attributes: mut VertexAttributePair = {
        first: {
            location: 0 as u32,
            buffer_slot: 0 as u32,
            format: 0 as i32,
            offset: 0 as u32
        },
        second: {
            location: 0 as u32,
            buffer_slot: 0 as u32,
            format: 0 as i32,
            offset: 0 as u32
        }
    }
    vertex_attributes.first.location = 0 as u32
    vertex_attributes.first.buffer_slot = 0 as u32
    vertex_attributes.first.format = SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3
    vertex_attributes.first.offset = 0 as u32
    vertex_attributes.second.location = 1 as u32
    vertex_attributes.second.buffer_slot = 0 as u32
    vertex_attributes.second.format = SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3
    vertex_attributes.second.offset = 12 as u32
        val color_target: mut SDLGPUColorTargetDescription = {
            format: 0 as i32,
            blend_state: {
                src_color_blendfactor: 0 as i32,
                dst_color_blendfactor: 0 as i32,
                color_blend_op: 0 as i32,
                src_alpha_blendfactor: 0 as i32,
                dst_alpha_blendfactor: 0 as i32,
                alpha_blend_op: 0 as i32,
                color_write_mask: 0 as u8,
                enable_blend: false,
                enable_color_write_mask: false,
                padding1: 0 as u8,
                padding2: 0 as u8
            }
        }
        color_target.format = color_format
        color_target.blend_state.enable_blend = enable_blend
    color_target.blend_state.src_color_blendfactor = src_color
    color_target.blend_state.dst_color_blendfactor = dst_color
    color_target.blend_state.color_blend_op = SDL_GPU_BLENDOP_ADD
    color_target.blend_state.src_alpha_blendfactor = src_alpha
    color_target.blend_state.dst_alpha_blendfactor = dst_alpha
    color_target.blend_state.alpha_blend_op = SDL_GPU_BLENDOP_ADD
        val info: mut SDLGPUGraphicsPipelineCreateInfo = {
            vertex_shader: none as ref void,
            fragment_shader: none as ref void,
            vertex_input_state: {
                vertex_buffer_descriptions: none as ref SDLGPUVertexBufferDescription,
                num_vertex_buffers: 0 as u32,
                vertex_attributes: none as ref SDLGPUVertexAttribute,
                num_vertex_attributes: 0 as u32
            },
            primitive_type: 0 as i32,
            rasterizer_state: {
                fill_mode: 0 as i32,
                cull_mode: 0 as i32,
                front_face: 0 as i32,
                depth_bias_constant_factor: 0.0 as f32,
                depth_bias_clamp: 0.0 as f32,
                depth_bias_slope_factor: 0.0 as f32,
                enable_depth_bias: false,
                enable_depth_clip: false,
                padding1: 0 as u8,
                padding2: 0 as u8
            },
            multisample_state: {
                sample_count: 0 as i32,
                sample_mask: 0 as u32,
                enable_mask: false,
                enable_alpha_to_coverage: false,
                padding2: 0 as u8,
                padding3: 0 as u8
            },
        depth_stencil_state: {
            compare_op: 0 as i32,
            back_stencil_state: {
                fail_op: 0 as i32,
                pass_op: 0 as i32,
                depth_fail_op: 0 as i32,
                compare_op: 0 as i32
            },
            front_stencil_state: {
                fail_op: 0 as i32,
                pass_op: 0 as i32,
                depth_fail_op: 0 as i32,
                compare_op: 0 as i32
                },
                compare_mask: 0 as u8,
                write_mask: 0 as u8,
                enable_depth_test: false,
                enable_depth_write: false,
                enable_stencil_test: false,
                padding1: 0 as u8,
                padding2: 0 as u8,
                padding3: 0 as u8
            },
            target_info: {
                color_target_descriptions: none as ref SDLGPUColorTargetDescription,
                num_color_targets: 0 as u32,
                depth_stencil_format: 0 as i32,
                has_depth_stencil_target: false,
                padding1: 0 as u8,
                padding2: 0 as u8,
                padding3: 0 as u8
            },
            props: 0 as u32
    }
    info.vertex_shader = vs
    info.fragment_shader = fs
    info.vertex_input_state.vertex_buffer_descriptions = @addr(vertex_buffer_desc)
    info.vertex_input_state.num_vertex_buffers = 1 as u32
    info.vertex_input_state.vertex_attributes = @addr(vertex_attributes.first)
    info.vertex_input_state.num_vertex_attributes = 2 as u32
    info.primitive_type = SDL_GPU_PRIMITIVETYPE_TRIANGLELIST
    info.rasterizer_state.fill_mode = SDL_GPU_FILLMODE_FILL
    info.rasterizer_state.cull_mode = SDL_GPU_CULLMODE_NONE
    info.rasterizer_state.front_face = SDL_GPU_FRONTFACE_COUNTER_CLOCKWISE
    info.rasterizer_state.enable_depth_clip = true
    info.multisample_state.sample_count = SDL_GPU_SAMPLECOUNT_1
    info.depth_stencil_state.compare_op = SDL_GPU_COMPAREOP_LESS_OR_EQUAL
    info.depth_stencil_state.enable_depth_test = true
    info.depth_stencil_state.enable_depth_write = depth_write
    info.target_info.color_target_descriptions = @addr(color_target)
    info.target_info.num_color_targets = 1 as u32
    info.target_info.depth_stencil_format = SDL_GPU_TEXTUREFORMAT_D32_FLOAT
    info.target_info.has_depth_stencil_target = true
    val pipeline: ref void = SDL_CreateGPUGraphicsPipeline(runtime.device, @addr(info))
    SDL_ReleaseGPUShader(runtime.device, fs)
    SDL_ReleaseGPUShader(runtime.device, vs)
    return pipeline
}

/// Scene pipeline variant: stride=32 (pos+normal+uv), 3 vertex attributes, 1 fragment sampler.
fn exo_create_scene_pipeline(
    runtime: ref ExoSDL3Runtime,
    vs_path: ref u8,
    fs_path: ref u8,
    color_format: i32
) ref void = trust {
    val vs: ref void = exo_load_shader(runtime, vs_path, SDL_GPU_SHADERSTAGE_VERTEX, 0 as u32, 1 as u32)
    if vs == none { return none as ref void }
    val fs: ref void = exo_load_shader(runtime, fs_path, SDL_GPU_SHADERSTAGE_FRAGMENT, 1 as u32, 1 as u32)
    if fs == none {
        SDL_ReleaseGPUShader(runtime.device, vs)
        return none as ref void
    }
    val vbd: mut SDLGPUVertexBufferDescription = {
        slot: 0 as u32, pitch: 32 as u32,
        input_rate: SDL_GPU_VERTEXINPUTRATE_VERTEX, instance_step_rate: 0 as u32
    }
    val attrs: mut VertexAttributeTriple = {
        first:  { location: 0 as u32, buffer_slot: 0 as u32, format: SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3, offset: 0 as u32 },
        second: { location: 1 as u32, buffer_slot: 0 as u32, format: SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3, offset: 12 as u32 },
        third:  { location: 2 as u32, buffer_slot: 0 as u32, format: SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2, offset: 24 as u32 }
    }
    val color_target: mut SDLGPUColorTargetDescription = {
        format: color_format,
        blend_state: {
            src_color_blendfactor: 0 as i32, dst_color_blendfactor: 0 as i32,
            color_blend_op: 0 as i32, src_alpha_blendfactor: 0 as i32,
            dst_alpha_blendfactor: 0 as i32, alpha_blend_op: 0 as i32,
            color_write_mask: 0 as u8, enable_blend: false,
            enable_color_write_mask: false, padding1: 0 as u8, padding2: 0 as u8
        }
    }
    val info: mut SDLGPUGraphicsPipelineCreateInfo = {
        vertex_shader: vs, fragment_shader: fs,
        vertex_input_state: {
            vertex_buffer_descriptions: @addr(vbd),
            num_vertex_buffers: 1 as u32,
            vertex_attributes: @addr(attrs.first),
            num_vertex_attributes: 3 as u32
        },
        primitive_type: SDL_GPU_PRIMITIVETYPE_TRIANGLELIST,
        rasterizer_state: {
            fill_mode: SDL_GPU_FILLMODE_FILL, cull_mode: SDL_GPU_CULLMODE_NONE,
            front_face: SDL_GPU_FRONTFACE_COUNTER_CLOCKWISE,
            depth_bias_constant_factor: 0.0 as f32, depth_bias_clamp: 0.0 as f32,
            depth_bias_slope_factor: 0.0 as f32,
            enable_depth_bias: false, enable_depth_clip: true,
            padding1: 0 as u8, padding2: 0 as u8
        },
        multisample_state: {
            sample_count: SDL_GPU_SAMPLECOUNT_1, sample_mask: 0 as u32,
            enable_mask: false, enable_alpha_to_coverage: false,
            padding2: 0 as u8, padding3: 0 as u8
        },
        depth_stencil_state: {
            compare_op: SDL_GPU_COMPAREOP_LESS_OR_EQUAL,
            back_stencil_state:  { fail_op: 0 as i32, pass_op: 0 as i32, depth_fail_op: 0 as i32, compare_op: 0 as i32 },
            front_stencil_state: { fail_op: 0 as i32, pass_op: 0 as i32, depth_fail_op: 0 as i32, compare_op: 0 as i32 },
            compare_mask: 0 as u8, write_mask: 0 as u8,
            enable_depth_test: true, enable_depth_write: true,
            enable_stencil_test: false,
            padding1: 0 as u8, padding2: 0 as u8, padding3: 0 as u8
        },
        target_info: {
            color_target_descriptions: @addr(color_target),
            num_color_targets: 1 as u32,
            depth_stencil_format: SDL_GPU_TEXTUREFORMAT_D32_FLOAT,
            has_depth_stencil_target: true,
            padding1: 0 as u8, padding2: 0 as u8, padding3: 0 as u8
        },
        props: 0 as u32
    }
    val pipeline: ref void = SDL_CreateGPUGraphicsPipeline(runtime.device, @addr(info))
    SDL_ReleaseGPUShader(runtime.device, fs)
    SDL_ReleaseGPUShader(runtime.device, vs)
    return pipeline
}

fn exo_create_postprocess_pipeline(
    runtime: ref ExoSDL3Runtime,
    vs_path: ref u8,
    fs_path: ref u8,
    color_format: i32,
    fragment_samplers: u32,
    fragment_uniforms: u32
) ref void = trust {
    val vs: ref void = exo_load_shader(runtime, vs_path, SDL_GPU_SHADERSTAGE_VERTEX, 0 as u32, 0 as u32)
    if vs == none {
        return none as ref void
    }
    val fs: ref void = exo_load_shader(runtime, fs_path, SDL_GPU_SHADERSTAGE_FRAGMENT, fragment_samplers, fragment_uniforms)
    if fs == none {
        SDL_ReleaseGPUShader(runtime.device, vs)
        return none as ref void
    }
    val color_target: mut SDLGPUColorTargetDescription = {
        format: 0 as i32,
        blend_state: {
            src_color_blendfactor: 0 as i32,
            dst_color_blendfactor: 0 as i32,
            color_blend_op: 0 as i32,
            src_alpha_blendfactor: 0 as i32,
            dst_alpha_blendfactor: 0 as i32,
            alpha_blend_op: 0 as i32,
            color_write_mask: 0 as u8,
            enable_blend: false,
            enable_color_write_mask: false,
            padding1: 0 as u8,
            padding2: 0 as u8
        }
    }
    color_target.format = color_format
    val info: mut SDLGPUGraphicsPipelineCreateInfo = {
        vertex_shader: none as ref void,
        fragment_shader: none as ref void,
        vertex_input_state: {
            vertex_buffer_descriptions: none as ref SDLGPUVertexBufferDescription,
            num_vertex_buffers: 0 as u32,
            vertex_attributes: none as ref SDLGPUVertexAttribute,
            num_vertex_attributes: 0 as u32
        },
        primitive_type: 0 as i32,
        rasterizer_state: {
            fill_mode: 0 as i32,
            cull_mode: 0 as i32,
            front_face: 0 as i32,
            depth_bias_constant_factor: 0.0 as f32,
            depth_bias_clamp: 0.0 as f32,
            depth_bias_slope_factor: 0.0 as f32,
            enable_depth_bias: false,
            enable_depth_clip: false,
            padding1: 0 as u8,
            padding2: 0 as u8
        },
        multisample_state: {
            sample_count: 0 as i32,
            sample_mask: 0 as u32,
            enable_mask: false,
            enable_alpha_to_coverage: false,
            padding2: 0 as u8,
            padding3: 0 as u8
        },
        depth_stencil_state: {
            compare_op: 0 as i32,
            back_stencil_state: {
                fail_op: 0 as i32,
                pass_op: 0 as i32,
                depth_fail_op: 0 as i32,
                compare_op: 0 as i32
            },
            front_stencil_state: {
                fail_op: 0 as i32,
                pass_op: 0 as i32,
                depth_fail_op: 0 as i32,
                compare_op: 0 as i32
            },
            compare_mask: 0 as u8,
            write_mask: 0 as u8,
            enable_depth_test: false,
            enable_depth_write: false,
            enable_stencil_test: false,
            padding1: 0 as u8,
            padding2: 0 as u8,
            padding3: 0 as u8
        },
        target_info: {
            color_target_descriptions: none as ref SDLGPUColorTargetDescription,
            num_color_targets: 0 as u32,
            depth_stencil_format: 0 as i32,
            has_depth_stencil_target: false,
            padding1: 0 as u8,
            padding2: 0 as u8,
            padding3: 0 as u8
        },
        props: 0 as u32
    }
    info.vertex_shader = vs
    info.fragment_shader = fs
    info.primitive_type = SDL_GPU_PRIMITIVETYPE_TRIANGLELIST
    info.rasterizer_state.fill_mode = SDL_GPU_FILLMODE_FILL
    info.rasterizer_state.cull_mode = SDL_GPU_CULLMODE_NONE
    info.rasterizer_state.front_face = SDL_GPU_FRONTFACE_COUNTER_CLOCKWISE
    info.multisample_state.sample_count = SDL_GPU_SAMPLECOUNT_1
    info.target_info.color_target_descriptions = @addr(color_target)
    info.target_info.num_color_targets = 1 as u32
    info.target_info.has_depth_stencil_target = false
    val pipeline: ref void = SDL_CreateGPUGraphicsPipeline(runtime.device, @addr(info))
    SDL_ReleaseGPUShader(runtime.device, fs)
    SDL_ReleaseGPUShader(runtime.device, vs)
    return pipeline
}

fn load_png_texture(runtime: ref ExoSDL3Runtime, path: ref u8) ref void = trust {
    if load_binary_file(path) is some blob {
        val w: mut i32 = 0 as i32
        val h: mut i32 = 0 as i32
        val ch: mut i32 = 0 as i32
        val pixels: ref u8 = stbi_load_from_memory(blob.data, blob.len as i32, @addr(w), @addr(h), @addr(ch), 4 as i32)
        @free(blob.data as ref void)
        if pixels == none {
            return none as ref void
        }
        val tex_info: mut SDLGPUTextureCreateInfo = {
            typ: 0 as i32, format: 0 as i32, usage: 0 as u32,
            width: 0 as u32, height: 0 as u32, layer_count_or_depth: 0 as u32,
            num_levels: 0 as u32, sample_count: 0 as i32, props: 0 as u32
        }
        tex_info.typ = SDL_GPU_TEXTURETYPE_2D
        tex_info.format = SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM
        tex_info.usage = SDL_GPU_TEXTUREUSAGE_SAMPLER
        tex_info.width = w as u32
        tex_info.height = h as u32
        tex_info.layer_count_or_depth = 1 as u32
        tex_info.num_levels = 1 as u32
        tex_info.sample_count = SDL_GPU_SAMPLECOUNT_1
        val texture: ref void = SDL_CreateGPUTexture(runtime.device, @addr(tex_info))
        if texture == none {
            stbi_image_free(pixels as ref void)
            return none as ref void
        }
        val byte_size: u32 = (w as u32) * (h as u32) * (4 as u32)
        val tbuf_info: mut SDLGPUTransferBufferCreateInfo = {
            usage: 0 as i32, size: 0 as u32, props: 0 as u32
        }
        tbuf_info.usage = SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD
        tbuf_info.size = byte_size
        val tbuf: ref void = SDL_CreateGPUTransferBuffer(runtime.device, @addr(tbuf_info))
        if tbuf == none {
            SDL_ReleaseGPUTexture(runtime.device, texture)
            stbi_image_free(pixels as ref void)
            return none as ref void
        }
        val mapped: ref void = SDL_MapGPUTransferBuffer(runtime.device, tbuf, false)
        if mapped == none {
            SDL_ReleaseGPUTransferBuffer(runtime.device, tbuf)
            SDL_ReleaseGPUTexture(runtime.device, texture)
            stbi_image_free(pixels as ref void)
            return none as ref void
        }
        @memcpy(mapped, pixels as ref void, byte_size as usize)
        SDL_UnmapGPUTransferBuffer(runtime.device, tbuf)
        stbi_image_free(pixels as ref void)
        val cmd: ref void = SDL_AcquireGPUCommandBuffer(runtime.device)
        if cmd == none {
            SDL_ReleaseGPUTransferBuffer(runtime.device, tbuf)
            SDL_ReleaseGPUTexture(runtime.device, texture)
            return none as ref void
        }
        val copy_pass: ref void = SDL_BeginGPUCopyPass(cmd)
        val src: mut SDLGPUTextureTransferInfo = {
            transfer_buffer: tbuf, offset: 0 as u32,
            pixels_per_row: w as u32, rows_per_layer: h as u32
        }
        val dst: mut SDLGPUTextureRegion = {
            texture: texture, mip_level: 0 as u32, layer: 0 as u32,
            x: 0 as u32, y: 0 as u32, z: 0 as u32,
            w: w as u32, h: h as u32, d: 1 as u32
        }
        SDL_UploadToGPUTexture(copy_pass, @addr(src), @addr(dst), false)
        SDL_EndGPUCopyPass(copy_pass)
        SDL_SubmitGPUCommandBuffer(cmd)
        SDL_ReleaseGPUTransferBuffer(runtime.device, tbuf)
        return texture
    }
    return none as ref void
}

fn exo_create_pipelines(runtime: mut ref ExoSDL3Runtime, shaders: ExoShaderConfig) bool = trust {
    runtime.scene_pipeline = exo_create_scene_pipeline(
        runtime,
        shaders.scene.vertex_path,
        shaders.scene.fragment_path,
        runtime.swapchain_format
    )
    if runtime.scene_pipeline == none {
        return false
    }
    runtime.floor_pipeline = exo_create_pipeline(
        runtime,
        shaders.floor.vertex_path,
        shaders.floor.fragment_path,
        runtime.swapchain_format,
        true,
        SDL_GPU_BLENDFACTOR_SRC_ALPHA,
        SDL_GPU_BLENDFACTOR_ONE_MINUS_SRC_ALPHA,
        SDL_GPU_BLENDFACTOR_ONE,
        SDL_GPU_BLENDFACTOR_ONE_MINUS_SRC_ALPHA,
        false,
        1 as u32
    )
    if runtime.floor_pipeline == none {
        return false
    }
    runtime.glow_pipeline = exo_create_pipeline(
        runtime,
        shaders.glow.vertex_path,
        shaders.glow.fragment_path,
        runtime.swapchain_format,
        true,
        SDL_GPU_BLENDFACTOR_SRC_ALPHA,
        SDL_GPU_BLENDFACTOR_ONE,
        SDL_GPU_BLENDFACTOR_ONE,
        SDL_GPU_BLENDFACTOR_ONE,
        false,
        0 as u32
    )
    if runtime.glow_pipeline == none {
        return false
    }
    runtime.fxaa_pipeline = exo_create_postprocess_pipeline(
        runtime,
        shaders.fxaa.vertex_path,
        shaders.fxaa.fragment_path,
        runtime.swapchain_format,
        1 as u32,
        1 as u32
    )
    if runtime.fxaa_pipeline == none {
        return false
    }
    runtime.water_pipeline = exo_create_pipeline(
        runtime,
        shaders.water.vertex_path,
        shaders.water.fragment_path,
        runtime.swapchain_format,
        true,
        SDL_GPU_BLENDFACTOR_SRC_ALPHA,
        SDL_GPU_BLENDFACTOR_ONE_MINUS_SRC_ALPHA,
        SDL_GPU_BLENDFACTOR_ONE,
        SDL_GPU_BLENDFACTOR_ONE_MINUS_SRC_ALPHA,
        false,
        2 as u32
    )
    return runtime.water_pipeline != none
}

fn exo_destroy_pipelines(runtime: mut ref ExoSDL3Runtime) void = trust {
    if runtime.fxaa_pipeline != none {
        SDL_ReleaseGPUGraphicsPipeline(runtime.device, runtime.fxaa_pipeline)
        runtime.fxaa_pipeline = none
    }
    if runtime.water_pipeline != none {
        SDL_ReleaseGPUGraphicsPipeline(runtime.device, runtime.water_pipeline)
        runtime.water_pipeline = none
    }
    if runtime.glow_pipeline != none {
        SDL_ReleaseGPUGraphicsPipeline(runtime.device, runtime.glow_pipeline)
        runtime.glow_pipeline = none
    }
    if runtime.floor_pipeline != none {
        SDL_ReleaseGPUGraphicsPipeline(runtime.device, runtime.floor_pipeline)
        runtime.floor_pipeline = none
    }
    if runtime.scene_pipeline != none {
        SDL_ReleaseGPUGraphicsPipeline(runtime.device, runtime.scene_pipeline)
        runtime.scene_pipeline = none
    }
}

fn exo_begin_pass(runtime: mut ref ExoSDL3Runtime, color_target: ref void, depth_target: ref void, r: f32, g: f32, b: f32, a: f32) bool = trust {
    clear_exo_error()
    if !runtime.frame_active || runtime.command_buffer == none {
        return set_exo_error("no active frame")
    }
    if runtime.current_pass != none {
        SDL_EndGPURenderPass(runtime.current_pass)
        runtime.current_pass = none
    }
    val color_info: mut SDLGPUColorTargetInfo = {
        texture: none as ref void,
        mip_level: 0 as u32,
        layer_or_depth_plane: 0 as u32,
        clear_color: { r: 0.0 as f32, g: 0.0 as f32, b: 0.0 as f32, a: 0.0 as f32 },
        load_op: 0 as i32,
        store_op: 0 as i32,
        resolve_texture: none as ref void,
        resolve_mip_level: 0 as u32,
        resolve_layer: 0 as u32,
        cycle: false,
        cycle_resolve_texture: false,
        padding1: 0 as u8,
        padding2: 0 as u8
    }
    color_info.texture = color_target
    color_info.clear_color.r = r
    color_info.clear_color.g = g
    color_info.clear_color.b = b
    color_info.clear_color.a = a
    color_info.load_op = SDL_GPU_LOADOP_CLEAR
    color_info.store_op = SDL_GPU_STOREOP_STORE
    val depth_info: mut SDLGPUDepthStencilTargetInfo = {
        texture: none as ref void,
        clear_depth: 0.0 as f32,
        load_op: 0 as i32,
        store_op: 0 as i32,
        stencil_load_op: 0 as i32,
        stencil_store_op: 0 as i32,
        cycle: false,
        clear_stencil: 0 as u8,
        mip_level: 0 as u8,
        layer: 0 as u8
    }
    depth_info.texture = depth_target
    depth_info.clear_depth = 1.0 as f32
    depth_info.load_op = SDL_GPU_LOADOP_CLEAR
    depth_info.store_op = SDL_GPU_STOREOP_DONT_CARE
    depth_info.stencil_load_op = SDL_GPU_LOADOP_DONT_CARE
    depth_info.stencil_store_op = SDL_GPU_STOREOP_DONT_CARE
    runtime.current_pass = SDL_BeginGPURenderPass(runtime.command_buffer, @addr(color_info), 1 as u32, @addr(depth_info))
    if runtime.current_pass == none {
        return false
    }
    val viewport: mut SDLGPUViewport = {
        x: 0.0 as f32,
        y: 0.0 as f32,
        w: 0.0 as f32,
        h: 0.0 as f32,
        min_depth: 0.0 as f32,
        max_depth: 0.0 as f32
    }
    viewport.x = 0.0 as f32
    viewport.y = 0.0 as f32
    viewport.w = runtime.render_width as f32
    viewport.h = runtime.render_height as f32
    viewport.min_depth = 0.0 as f32
    viewport.max_depth = 1.0 as f32
    SDL_SetGPUViewport(runtime.current_pass, @addr(viewport))
    return true
}

fn exo_begin_pass_no_depth(runtime: mut ref ExoSDL3Runtime, color_target: ref void) bool = trust {
    clear_exo_error()
    if !runtime.frame_active || runtime.command_buffer == none {
        return set_exo_error("no active frame")
    }
    if runtime.current_pass != none {
        SDL_EndGPURenderPass(runtime.current_pass)
        runtime.current_pass = none
    }
    val color_info: mut SDLGPUColorTargetInfo = {
        texture: none as ref void,
        mip_level: 0 as u32,
        layer_or_depth_plane: 0 as u32,
        clear_color: { r: 0.0 as f32, g: 0.0 as f32, b: 0.0 as f32, a: 0.0 as f32 },
        load_op: 0 as i32,
        store_op: 0 as i32,
        resolve_texture: none as ref void,
        resolve_mip_level: 0 as u32,
        resolve_layer: 0 as u32,
        cycle: false,
        cycle_resolve_texture: false,
        padding1: 0 as u8,
        padding2: 0 as u8
    }
    color_info.texture = color_target
    color_info.load_op = SDL_GPU_LOADOP_DONT_CARE
    color_info.store_op = SDL_GPU_STOREOP_STORE
    runtime.current_pass = SDL_BeginGPURenderPass(runtime.command_buffer, @addr(color_info), 1 as u32, none as ref SDLGPUDepthStencilTargetInfo)
    if runtime.current_pass == none {
        return false
    }
    val viewport: mut SDLGPUViewport = {
        x: 0.0 as f32,
        y: 0.0 as f32,
        w: 0.0 as f32,
        h: 0.0 as f32,
        min_depth: 0.0 as f32,
        max_depth: 0.0 as f32
    }
    viewport.x = 0.0 as f32
    viewport.y = 0.0 as f32
    viewport.w = runtime.render_width as f32
    viewport.h = runtime.render_height as f32
    viewport.min_depth = 0.0 as f32
    viewport.max_depth = 1.0 as f32
    SDL_SetGPUViewport(runtime.current_pass, @addr(viewport))
    return true
}

fn exo_bind_mesh(runtime: ref ExoSDL3Runtime, mesh: ref ExoSDL3Mesh) void = trust {
    val vertex_binding: mut SDLGPUBufferBinding = {
        buffer: none as ref void,
        offset: 0 as u32
    }
    val index_binding: mut SDLGPUBufferBinding = {
        buffer: none as ref void,
        offset: 0 as u32
    }
    vertex_binding.buffer = mesh.vertex_buffer
    index_binding.buffer = mesh.index_buffer
    SDL_BindGPUVertexBuffers(runtime.current_pass, 0 as u32, @addr(vertex_binding), 1 as u32)
    SDL_BindGPUIndexBuffer(runtime.current_pass, @addr(index_binding), SDL_GPU_INDEXELEMENTSIZE_32BIT)
}

fn exo_destroy_runtime_resources(runtime: mut ref ExoSDL3Runtime) void = trust {
    exo_release_render_targets(runtime)
    if runtime.glb_texture != none {
        SDL_ReleaseGPUTexture(runtime.device, runtime.glb_texture)
        runtime.glb_texture = none
    }
    if runtime.normal_map_texture != none {
        SDL_ReleaseGPUTexture(runtime.device, runtime.normal_map_texture)
        runtime.normal_map_texture = none
    }
    if runtime.repeat_sampler != none {
        SDL_ReleaseGPUSampler(runtime.device, runtime.repeat_sampler)
        runtime.repeat_sampler = none
    }
    if runtime.linear_sampler != none {
        SDL_ReleaseGPUSampler(runtime.device, runtime.linear_sampler)
        runtime.linear_sampler = none
    }
    exo_destroy_pipelines(runtime)
}

/// Upload an embedded GLB image (PNG/JPEG bytes in the BIN chunk) as a GPU texture.
fn upload_glb_texture(runtime: mut ref ExoSDL3Runtime, model: ecs.GlbModel) void = trust {
    if runtime.glb_texture != none {
        SDL_ReleaseGPUTexture(runtime.device, runtime.glb_texture)
        runtime.glb_texture = none
    }
    if model.texture_length == (0 as usize) || model.raw_bytes == none {
        return
    }
    val img_ptr: ref u8 = @ptradd(model.raw_bytes, model.texture_offset) as ref u8
    val w: mut i32 = 0 as i32
    val h: mut i32 = 0 as i32
    val ch: mut i32 = 0 as i32
    val pixels: ref u8 = stbi_load_from_memory(img_ptr, model.texture_length as i32, @addr(w), @addr(h), @addr(ch), 4 as i32)
    if pixels == none { return }
    val tex_info: mut SDLGPUTextureCreateInfo = {
        typ: 0 as i32, format: 0 as i32, usage: 0 as u32,
        width: 0 as u32, height: 0 as u32, layer_count_or_depth: 0 as u32,
        num_levels: 0 as u32, sample_count: 0 as i32, props: 0 as u32
    }
    tex_info.typ    = SDL_GPU_TEXTURETYPE_2D
    tex_info.format = SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM
    tex_info.usage  = SDL_GPU_TEXTUREUSAGE_SAMPLER
    tex_info.width  = w as u32
    tex_info.height = h as u32
    tex_info.layer_count_or_depth = 1 as u32
    tex_info.num_levels   = 1 as u32
    tex_info.sample_count = SDL_GPU_SAMPLECOUNT_1
    val texture: ref void = SDL_CreateGPUTexture(runtime.device, @addr(tex_info))
    if texture == none {
        stbi_image_free(pixels as ref void)
        return
    }
    val byte_size: u32 = (w as u32) * (h as u32) * (4 as u32)
    val tbuf_info: mut SDLGPUTransferBufferCreateInfo = { usage: 0 as i32, size: 0 as u32, props: 0 as u32 }
    tbuf_info.usage = SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD
    tbuf_info.size  = byte_size
    val tbuf: ref void = SDL_CreateGPUTransferBuffer(runtime.device, @addr(tbuf_info))
    if tbuf == none {
        SDL_ReleaseGPUTexture(runtime.device, texture)
        stbi_image_free(pixels as ref void)
        return
    }
    val mapped: ref void = SDL_MapGPUTransferBuffer(runtime.device, tbuf, false)
    if mapped == none {
        SDL_ReleaseGPUTransferBuffer(runtime.device, tbuf)
        SDL_ReleaseGPUTexture(runtime.device, texture)
        stbi_image_free(pixels as ref void)
        return
    }
    @memcpy(mapped, pixels as ref void, byte_size as usize)
    SDL_UnmapGPUTransferBuffer(runtime.device, tbuf)
    stbi_image_free(pixels as ref void)
    val cmd: ref void = SDL_AcquireGPUCommandBuffer(runtime.device)
    if cmd == none {
        SDL_ReleaseGPUTransferBuffer(runtime.device, tbuf)
        SDL_ReleaseGPUTexture(runtime.device, texture)
        return
    }
    val copy_pass: ref void = SDL_BeginGPUCopyPass(cmd)
    val src: mut SDLGPUTextureTransferInfo = {
        transfer_buffer: tbuf, offset: 0 as u32,
        pixels_per_row: w as u32, rows_per_layer: h as u32
    }
    val dst: mut SDLGPUTextureRegion = {
        texture: texture, mip_level: 0 as u32, layer: 0 as u32,
        x: 0 as u32, y: 0 as u32, z: 0 as u32,
        w: w as u32, h: h as u32, d: 1 as u32
    }
    SDL_UploadToGPUTexture(copy_pass, @addr(src), @addr(dst), false)
    SDL_EndGPUCopyPass(copy_pass)
    SDL_SubmitGPUCommandBuffer(cmd)
    SDL_ReleaseGPUTransferBuffer(runtime.device, tbuf)
    runtime.glb_texture = texture
}

fn exo_sdl3_create_runtime(title: ref u8, width: i32, height: i32, shaders: ExoShaderConfig) ref void = trust {
    clear_exo_error()
    if !SDL_Init(SDL_INIT_VIDEO | SDL_INIT_AUDIO) {
        return none as ref void
    }
    val runtime: mut ref ExoSDL3Runtime = @alloc(@sizeof(ExoSDL3Runtime)) as mut ref ExoSDL3Runtime
    if runtime == none {
        SDL_Quit()
        return set_exo_error_ptr("failed to allocate runtime")
    }
    runtime.window = SDL_CreateWindow(title, width, height, 0 as u64)
    if runtime.window == none {
        exo_sdl3_destroy_runtime(runtime as ref void)
        return none as ref void
    }
    runtime.device = SDL_CreateGPUDevice(SDL_GPU_SHADERFORMAT_SPIRV, true, none as ref u8)
    if runtime.device == none {
        exo_sdl3_destroy_runtime(runtime as ref void)
        return none as ref void
    }
    if !SDL_ClaimWindowForGPUDevice(runtime.device, runtime.window) {
        exo_sdl3_destroy_runtime(runtime as ref void)
        return none as ref void
    }
    runtime.swapchain_format = SDL_GetGPUSwapchainTextureFormat(runtime.device, runtime.window)
    if !exo_create_pipelines(runtime, shaders) {
        exo_sdl3_destroy_runtime(runtime as ref void)
        return none as ref void
    }
    val sampler_info: mut SDLGPUSamplerCreateInfo = {
        min_filter: 0 as i32,
        mag_filter: 0 as i32,
        mipmap_mode: 0 as i32,
        address_mode_u: 0 as i32,
        address_mode_v: 0 as i32,
        address_mode_w: 0 as i32,
        mip_lod_bias: 0.0 as f32,
        max_anisotropy: 0.0 as f32,
        compare_op: 0 as i32,
        min_lod: 0.0 as f32,
        max_lod: 0.0 as f32,
        enable_anisotropy: false,
        enable_compare: false,
        padding1: 0 as u8,
        padding2: 0 as u8,
        props: 0 as u32
    }
    sampler_info.min_filter = SDL_GPU_FILTER_LINEAR
    sampler_info.mag_filter = SDL_GPU_FILTER_LINEAR
    sampler_info.mipmap_mode = SDL_GPU_SAMPLERMIPMAPMODE_LINEAR
    sampler_info.address_mode_u = SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE
    sampler_info.address_mode_v = SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE
    sampler_info.address_mode_w = SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE
    sampler_info.max_lod = 1.0 as f32
    runtime.linear_sampler = SDL_CreateGPUSampler(runtime.device, @addr(sampler_info))
    if runtime.linear_sampler == none {
        exo_sdl3_destroy_runtime(runtime as ref void)
        return none as ref void
    }
    val repeat_info: mut SDLGPUSamplerCreateInfo = {
        min_filter: 0 as i32, mag_filter: 0 as i32, mipmap_mode: 0 as i32,
        address_mode_u: 0 as i32, address_mode_v: 0 as i32, address_mode_w: 0 as i32,
        mip_lod_bias: 0.0 as f32, max_anisotropy: 0.0 as f32, compare_op: 0 as i32,
        min_lod: 0.0 as f32, max_lod: 0.0 as f32,
        enable_anisotropy: false, enable_compare: false,
        padding1: 0 as u8, padding2: 0 as u8, props: 0 as u32
    }
    repeat_info.min_filter = SDL_GPU_FILTER_LINEAR
    repeat_info.mag_filter = SDL_GPU_FILTER_LINEAR
    repeat_info.mipmap_mode = SDL_GPU_SAMPLERMIPMAPMODE_LINEAR
    repeat_info.address_mode_u = SDL_GPU_SAMPLERADDRESSMODE_REPEAT
    repeat_info.address_mode_v = SDL_GPU_SAMPLERADDRESSMODE_REPEAT
    repeat_info.address_mode_w = SDL_GPU_SAMPLERADDRESSMODE_REPEAT
    repeat_info.max_lod = 1.0 as f32
    runtime.repeat_sampler = SDL_CreateGPUSampler(runtime.device, @addr(repeat_info))
    if runtime.repeat_sampler == none {
        exo_sdl3_destroy_runtime(runtime as ref void)
        return none as ref void
    }
    if !exo_recreate_render_targets(runtime, width as u32, height as u32) {
        exo_sdl3_destroy_runtime(runtime as ref void)
        return none as ref void
    }
    runtime.normal_map_texture = load_png_texture(runtime, "./assets/normal_map.png")
    return runtime as ref void
}

fn exo_sdl3_destroy_runtime(runtime_raw: ref void) void = trust {
    if runtime_raw == none {
        SDL_Quit()
        return
    }
    val runtime: mut ref ExoSDL3Runtime = runtime_raw as mut ref ExoSDL3Runtime
    exo_destroy_runtime_resources(runtime)
    if runtime.device != none && runtime.window != none {
        SDL_ReleaseWindowFromGPUDevice(runtime.device, runtime.window)
    }
    if runtime.device != none {
        SDL_DestroyGPUDevice(runtime.device)
    }
    if runtime.window != none {
        SDL_DestroyWindow(runtime.window)
    }
    @free(runtime_raw)
    SDL_Quit()
}

fn exo_sdl3_poll_quit() bool = {
    val evt: mut SDLEvent = {
        typ: 0 as u32, p01: 0 as u32, p02: 0 as u32, p03: 0 as u32, p04: 0 as u32, p05: 0 as u32, p06: 0 as u32, p07: 0 as u32,
        p08: 0 as u32, p09: 0 as u32, p10: 0 as u32, p11: 0 as u32, p12: 0 as u32, p13: 0 as u32, p14: 0 as u32, p15: 0 as u32,
        p16: 0 as u32, p17: 0 as u32, p18: 0 as u32, p19: 0 as u32, p20: 0 as u32, p21: 0 as u32, p22: 0 as u32, p23: 0 as u32,
        p24: 0 as u32, p25: 0 as u32, p26: 0 as u32, p27: 0 as u32, p28: 0 as u32, p29: 0 as u32, p30: 0 as u32, p31: 0 as u32
    }
    val quit: mut bool = false
    for {
        if !(trust SDL_PollEvent(@addr(evt))) {
            break
        }
        if evt.typ == SDL_EVENT_QUIT || evt.typ == SDL_EVENT_WINDOW_CLOSE_REQUESTED {
            quit = true
        }
    }
    return quit
}

fn exo_sdl3_get_ticks() u64 = {
    return trust SDL_GetTicks()
}

fn exo_sdl3_get_keyboard_state() ref u8 = trust {
    return SDL_GetKeyboardState(none as ref i32) as ref u8
}

fn exo_sdl3_set_relative_mouse_mode(runtime_raw: ref void, enabled: bool) bool = trust {
    clear_exo_error()
    if runtime_raw == none {
        return set_exo_error("runtime unavailable")
    }
    val runtime: ref ExoSDL3Runtime = runtime_raw as ref ExoSDL3Runtime
    if runtime.window == none {
        return set_exo_error("runtime window unavailable")
    }
    return SDL_SetWindowRelativeMouseMode(runtime.window, enabled)
}

fn exo_sdl3_get_relative_mouse_state(x: ref f32, y: ref f32) void = {
    trust SDL_GetRelativeMouseState(x, y)
}

fn exo_sdl3_create_mesh(runtime_raw: ref void, vertices: ref void, vertex_bytes: u32, indices: ref void, index_bytes: u32, index_count: u32) ref void = trust {
    clear_exo_error()
    if runtime_raw == none {
        return set_exo_error_ptr("runtime unavailable")
    }
    val runtime: ref ExoSDL3Runtime = runtime_raw as ref ExoSDL3Runtime
    val mesh: mut ref ExoSDL3Mesh = @alloc(@sizeof(ExoSDL3Mesh)) as mut ref ExoSDL3Mesh
    if mesh == none {
        return set_exo_error_ptr("failed to allocate mesh")
    }
    val vertex_info: mut SDLGPUBufferCreateInfo = {
        usage: 0 as u32,
        size: 0 as u32,
        props: 0 as u32
    }
    vertex_info.usage = SDL_GPU_BUFFERUSAGE_VERTEX
    vertex_info.size = vertex_bytes
    mesh.vertex_buffer = SDL_CreateGPUBuffer(runtime.device, @addr(vertex_info))
    if mesh.vertex_buffer == none {
        exo_sdl3_destroy_mesh(runtime_raw, mesh as ref void)
        return none as ref void
    }
    val index_info: mut SDLGPUBufferCreateInfo = {
        usage: 0 as u32,
        size: 0 as u32,
        props: 0 as u32
    }
    index_info.usage = SDL_GPU_BUFFERUSAGE_INDEX
    index_info.size = index_bytes
    mesh.index_buffer = SDL_CreateGPUBuffer(runtime.device, @addr(index_info))
    if mesh.index_buffer == none {
        exo_sdl3_destroy_mesh(runtime_raw, mesh as ref void)
        return none as ref void
    }
    val transfer_info: mut SDLGPUTransferBufferCreateInfo = {
        usage: 0 as i32,
        size: 0 as u32,
        props: 0 as u32
    }
    transfer_info.usage = SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD
    transfer_info.size = vertex_bytes + index_bytes
    val transfer: ref void = SDL_CreateGPUTransferBuffer(runtime.device, @addr(transfer_info))
    if transfer == none {
        exo_sdl3_destroy_mesh(runtime_raw, mesh as ref void)
        return none as ref void
    }
    val mapped: ref void = SDL_MapGPUTransferBuffer(runtime.device, transfer, false)
    if mapped == none {
        SDL_ReleaseGPUTransferBuffer(runtime.device, transfer)
        exo_sdl3_destroy_mesh(runtime_raw, mesh as ref void)
        return none as ref void
    }
    @memcpy(mapped, vertices, vertex_bytes as usize)
    @memcpy(@ptradd(mapped, vertex_bytes as usize), indices, index_bytes as usize)
    SDL_UnmapGPUTransferBuffer(runtime.device, transfer)
    val command_buffer: ref void = SDL_AcquireGPUCommandBuffer(runtime.device)
    if command_buffer == none {
        SDL_ReleaseGPUTransferBuffer(runtime.device, transfer)
        exo_sdl3_destroy_mesh(runtime_raw, mesh as ref void)
        return none as ref void
    }
    val copy_pass: ref void = SDL_BeginGPUCopyPass(command_buffer)
    if copy_pass == none {
        SDL_CancelGPUCommandBuffer(command_buffer)
        SDL_ReleaseGPUTransferBuffer(runtime.device, transfer)
        exo_sdl3_destroy_mesh(runtime_raw, mesh as ref void)
        return none as ref void
    }
    val src_vertex: mut SDLGPUTransferBufferLocation = {
        transfer_buffer: none as ref void,
        offset: 0 as u32
    }
    val dst_vertex: mut SDLGPUBufferRegion = {
        buffer: none as ref void,
        offset: 0 as u32,
        size: 0 as u32
    }
    val src_index: mut SDLGPUTransferBufferLocation = {
        transfer_buffer: none as ref void,
        offset: 0 as u32
    }
    val dst_index: mut SDLGPUBufferRegion = {
        buffer: none as ref void,
        offset: 0 as u32,
        size: 0 as u32
    }
    src_vertex.transfer_buffer = transfer
    dst_vertex.buffer = mesh.vertex_buffer
    dst_vertex.size = vertex_bytes
    src_index.transfer_buffer = transfer
    src_index.offset = vertex_bytes
    dst_index.buffer = mesh.index_buffer
    dst_index.size = index_bytes
    SDL_UploadToGPUBuffer(copy_pass, @addr(src_vertex), @addr(dst_vertex), false)
    SDL_UploadToGPUBuffer(copy_pass, @addr(src_index), @addr(dst_index), false)
    SDL_EndGPUCopyPass(copy_pass)
    if !SDL_SubmitGPUCommandBuffer(command_buffer) {
        SDL_ReleaseGPUTransferBuffer(runtime.device, transfer)
        exo_sdl3_destroy_mesh(runtime_raw, mesh as ref void)
        return none as ref void
    }
    SDL_ReleaseGPUTransferBuffer(runtime.device, transfer)
    mesh.index_count = index_count
    return mesh as ref void
}

fn exo_sdl3_destroy_mesh(runtime_raw: ref void, mesh_raw: ref void) void = trust {
    if mesh_raw == none {
        return
    }
    val mesh: ref ExoSDL3Mesh = mesh_raw as ref ExoSDL3Mesh
    if runtime_raw != none {
        val runtime: ref ExoSDL3Runtime = runtime_raw as ref ExoSDL3Runtime
        if runtime.device != none {
            if mesh.index_buffer != none {
                SDL_ReleaseGPUBuffer(runtime.device, mesh.index_buffer)
            }
            if mesh.vertex_buffer != none {
                SDL_ReleaseGPUBuffer(runtime.device, mesh.vertex_buffer)
            }
        }
    }
    @free(mesh_raw)
}

fn exo_sdl3_begin_frame(runtime_raw: ref void, width: mut ref u32, height: mut ref u32) bool = trust {
    clear_exo_error()
    if runtime_raw == none {
        return set_exo_error("runtime unavailable")
    }
    val runtime: mut ref ExoSDL3Runtime = runtime_raw as mut ref ExoSDL3Runtime
    if runtime.frame_active {
        return set_exo_error("frame already active")
    }
    runtime.command_buffer = SDL_AcquireGPUCommandBuffer(runtime.device)
    if runtime.command_buffer == none {
        return false
    }
    val swap_width: mut u32 = 0 as u32
    val swap_height: mut u32 = 0 as u32
    if !(SDL_WaitAndAcquireGPUSwapchainTexture(runtime.command_buffer, runtime.window, @addr(runtime.swapchain_texture), @addr(swap_width), @addr(swap_height))) {
        SDL_CancelGPUCommandBuffer(runtime.command_buffer)
        runtime.command_buffer = none
        return false
    }
    if runtime.swapchain_texture == none {
        SDL_CancelGPUCommandBuffer(runtime.command_buffer)
        runtime.command_buffer = none
        return set_exo_error("swapchain texture unavailable")
    }
    if swap_width != runtime.render_width || swap_height != runtime.render_height {
        if !exo_recreate_render_targets(runtime, swap_width, swap_height) {
            SDL_CancelGPUCommandBuffer(runtime.command_buffer)
            runtime.command_buffer = none
            return false
        }
    }
    runtime.frame_active = true
    if width != none {
        @deref(width) = runtime.render_width
    }
    if height != none {
        @deref(height) = runtime.render_height
    }
    return true
}

fn exo_sdl3_begin_reflection_pass(runtime_raw: ref void, r: f32, g: f32, b: f32, a: f32) bool = trust {
    if runtime_raw == none {
        clear_exo_error()
        return set_exo_error("runtime unavailable")
    }
    val runtime: mut ref ExoSDL3Runtime = runtime_raw as mut ref ExoSDL3Runtime
    return exo_begin_pass(runtime, runtime.reflection_color, runtime.reflection_depth, r, g, b, a)
}

fn exo_sdl3_begin_scene_pass(runtime_raw: ref void, r: f32, g: f32, b: f32, a: f32) bool = trust {
    if runtime_raw == none {
        clear_exo_error()
        return set_exo_error("runtime unavailable")
    }
    val runtime: mut ref ExoSDL3Runtime = runtime_raw as mut ref ExoSDL3Runtime
    return exo_begin_pass(runtime, runtime.scene_color, runtime.scene_depth, r, g, b, a)
}

fn exo_sdl3_end_pass(runtime_raw: ref void) void = trust {
    if runtime_raw == none {
        return
    }
    val runtime: mut ref ExoSDL3Runtime = runtime_raw as mut ref ExoSDL3Runtime
    if runtime.current_pass != none {
        SDL_EndGPURenderPass(runtime.current_pass)
        runtime.current_pass = none
    }
}

fn exo_sdl3_apply_fxaa(runtime_raw: ref void) bool = trust {
    if runtime_raw == none {
        clear_exo_error()
        return set_exo_error("runtime unavailable")
    }
    val runtime: mut ref ExoSDL3Runtime = runtime_raw as mut ref ExoSDL3Runtime
    if !exo_begin_pass_no_depth(runtime, runtime.swapchain_texture) {
        return false
    }
    SDL_BindGPUGraphicsPipeline(runtime.current_pass, runtime.fxaa_pipeline)
    val binding: mut SDLGPUTextureSamplerBinding = {
        texture: runtime.scene_color,
        sampler: runtime.linear_sampler
    }
    SDL_BindGPUFragmentSamplers(runtime.current_pass, 0 as u32, @addr(binding), 1 as u32)
    val fu: mut FxaaFragmentUniforms = {
        texel_size: {
            x: (1.0 as f32) / (runtime.render_width as f32),
            y: (1.0 as f32) / (runtime.render_height as f32),
            z: 1.05 as f32,
            w: 0.85 as f32
        }
    }
    SDL_PushGPUFragmentUniformData(runtime.command_buffer, 0 as u32, @addr(fu) as ref void, @sizeof(FxaaFragmentUniforms) as u32)
    SDL_DrawGPUPrimitives(runtime.current_pass, 3 as u32, 1 as u32, 0 as u32, 0 as u32)
    return true
}

fn exo_sdl3_submit_frame(runtime_raw: ref void) bool = trust {
    clear_exo_error()
    if runtime_raw == none {
        return set_exo_error("frame not active")
    }
    val runtime: mut ref ExoSDL3Runtime = runtime_raw as mut ref ExoSDL3Runtime
    if !runtime.frame_active || runtime.command_buffer == none {
        return set_exo_error("frame not active")
    }
    exo_sdl3_end_pass(runtime_raw)
    val its_ok: bool = SDL_SubmitGPUCommandBuffer(runtime.command_buffer)
    runtime.command_buffer = none
    runtime.swapchain_texture = none
    runtime.frame_active = false
    return its_ok
}

fn exo_sdl3_draw_scene_mesh(
    runtime_raw: ref void,
    mesh_raw: ref void,
    model: ref f32,
    view_proj: ref f32,
    color: ref f32,
    camera_pos: ref f32,
    reflective: f32,
    glow: f32,
    alpha: f32,
    light_pos: ref f32,
    light_color: ref f32,
    light_intensity: f32,
    light_radius: f32
) void = trust {
    if runtime_raw == none || mesh_raw == none {
        return
    }
    val runtime: ref ExoSDL3Runtime = runtime_raw as ref ExoSDL3Runtime
    val mesh: ref ExoSDL3Mesh = mesh_raw as ref ExoSDL3Mesh
    val vu: mut SceneVertexUniforms = {
        model: transpose_mat4_ptr(model),
        view_proj: transpose_mat4_ptr(view_proj)
    }
    val fu: mut SceneFragmentUniforms = {
        color_reflective: vec4_from_ptr(color, reflective),
        camera_glow: vec4_from_ptr(camera_pos, glow),
        light_pos_intensity: vec4_from_ptr(light_pos, light_intensity),
        light_color_radius: vec4_from_ptr(light_color, light_radius),
        alpha_pad: { x: alpha, y: 0.0 as f32, z: 0.0 as f32, w: 0.0 as f32 }
    }
    val has_tex: mut f32 = 0.0 as f32
    val tex_to_bind: mut ref void = runtime.reflection_color
    if runtime.glb_texture != none {
        tex_to_bind = runtime.glb_texture
        has_tex = 1.0 as f32
        fu.alpha_pad.y = has_tex
    }
    val tex_binding: mut SDLGPUTextureSamplerBinding = {
        texture: tex_to_bind,
        sampler: runtime.linear_sampler
    }
    SDL_BindGPUGraphicsPipeline(runtime.current_pass, runtime.scene_pipeline)
    SDL_PushGPUVertexUniformData(runtime.command_buffer, 0 as u32, @addr(vu) as ref void, @sizeof(SceneVertexUniforms) as u32)
    SDL_PushGPUFragmentUniformData(runtime.command_buffer, 0 as u32, @addr(fu) as ref void, @sizeof(SceneFragmentUniforms) as u32)
    SDL_BindGPUFragmentSamplers(runtime.current_pass, 0 as u32, @addr(tex_binding), 1 as u32)
    exo_bind_mesh(runtime, mesh)
    SDL_DrawGPUIndexedPrimitives(runtime.current_pass, mesh.index_count, 1 as u32, 0 as u32, 0 as i32, 0 as u32)
}

fn exo_sdl3_draw_floor(runtime_raw: ref void, mesh_raw: ref void, model: ref f32, view_proj: ref f32, reflect_view_proj: ref f32, camera_pos: ref f32) void = trust {
    if runtime_raw == none || mesh_raw == none {
        return
    }
    val runtime: ref ExoSDL3Runtime = runtime_raw as ref ExoSDL3Runtime
    val mesh: ref ExoSDL3Mesh = mesh_raw as ref ExoSDL3Mesh
    val vu: mut FloorVertexUniforms = {
        model: transpose_mat4_ptr(model),
        view_proj: transpose_mat4_ptr(view_proj),
        reflect_view_proj: transpose_mat4_ptr(reflect_view_proj)
    }
    val fu: mut FloorFragmentUniforms = {
        camera_pos: vec4_from_ptr(camera_pos, 0.0 as f32)
    }
    val binding: mut SDLGPUTextureSamplerBinding = {
        texture: none as ref void,
        sampler: none as ref void
    }
    binding.texture = runtime.reflection_color
    binding.sampler = runtime.linear_sampler
    SDL_BindGPUGraphicsPipeline(runtime.current_pass, runtime.floor_pipeline)
    SDL_PushGPUVertexUniformData(runtime.command_buffer, 0 as u32, @addr(vu) as ref void, @sizeof(FloorVertexUniforms) as u32)
    SDL_PushGPUFragmentUniformData(runtime.command_buffer, 0 as u32, @addr(fu) as ref void, @sizeof(FloorFragmentUniforms) as u32)
    SDL_BindGPUFragmentSamplers(runtime.current_pass, 0 as u32, @addr(binding), 1 as u32)
    exo_bind_mesh(runtime, mesh)
    SDL_DrawGPUIndexedPrimitives(runtime.current_pass, mesh.index_count, 1 as u32, 0 as u32, 0 as i32, 0 as u32)
}

fn exo_sdl3_draw_glow(
    runtime_raw: ref void,
    mesh_raw: ref void,
    view_proj: ref f32,
    position: ref f32,
    width: f32,
    height: f32,
    camera_right: ref f32,
    camera_up: ref f32,
    color: ref f32,
    intensity: f32,
    alpha: f32
) void = trust {
    if runtime_raw == none || mesh_raw == none {
        return
    }
    val runtime: ref ExoSDL3Runtime = runtime_raw as ref ExoSDL3Runtime
    val mesh: ref ExoSDL3Mesh = mesh_raw as ref ExoSDL3Mesh
    val vu: mut GlowVertexUniforms = {
        view_proj: transpose_mat4_ptr(view_proj),
        position: vec4_from_ptr(position, 0.0 as f32),
        size: { x: width, y: height, z: 0.0 as f32, w: 0.0 as f32 },
        camera_right: vec4_from_ptr(camera_right, 0.0 as f32),
        camera_up: vec4_from_ptr(camera_up, 0.0 as f32)
    }
    val fu: mut GlowFragmentUniforms = {
        color_intensity: vec4_from_ptr(color, intensity),
        alpha_pad: { x: alpha, y: 0.0 as f32, z: 0.0 as f32, w: 0.0 as f32 }
    }
    SDL_BindGPUGraphicsPipeline(runtime.current_pass, runtime.glow_pipeline)
    SDL_PushGPUVertexUniformData(runtime.command_buffer, 0 as u32, @addr(vu) as ref void, @sizeof(GlowVertexUniforms) as u32)
    SDL_PushGPUFragmentUniformData(runtime.command_buffer, 0 as u32, @addr(fu) as ref void, @sizeof(GlowFragmentUniforms) as u32)
    exo_bind_mesh(runtime, mesh)
    SDL_DrawGPUIndexedPrimitives(runtime.current_pass, mesh.index_count, 1 as u32, 0 as u32, 0 as i32, 0 as u32)
}

fn exo_sdl3_create_audio(wav_path: ref u8, volume: i32) ref void = trust {
    clear_exo_error()
    if wav_path == none || string.len_raw(wav_path) == (0 as usize) {
        return set_exo_error_ptr("audio path is empty")
    }
    val audio: mut ref ExoSDL3Audio = @alloc(@sizeof(ExoSDL3Audio)) as mut ref ExoSDL3Audio
    if audio == none {
        return set_exo_error_ptr("failed to allocate audio")
    }
    if !SDL_LoadWAV(wav_path, @addr(audio.speci), @addr(audio.buffer), @addr(audio.length)) {
        exo_sdl3_destroy_audio(audio as ref void)
        return none as ref void
    }
    audio.stream = SDL_OpenAudioDeviceStream(SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK, @addr(audio.speci), none as ref void, none as ref void)
    if audio.stream == none {
        exo_sdl3_destroy_audio(audio as ref void)
        return none as ref void
    }
    SDL_SetAudioStreamGain(audio.stream, (volume as f32) / (128.0 as f32))
    if !SDL_ResumeAudioStreamDevice(audio.stream) {
        exo_sdl3_destroy_audio(audio as ref void)
        return none as ref void
    }
    return audio as ref void
}

fn exo_sdl3_destroy_audio(audio_raw: ref void) void = trust {
    if audio_raw == none {
        return
    }
    val audio: ref ExoSDL3Audio = audio_raw as ref ExoSDL3Audio
    if audio.stream != none {
        SDL_DestroyAudioStream(audio.stream)
    }
    if audio.buffer != none {
        SDL_free(audio.buffer as ref void)
    }
    @free(audio_raw)
}

fn exo_sdl3_play_audio(audio_raw: ref void, loops: i32, volume: i32) bool = trust {
    clear_exo_error()
    if audio_raw == none {
        return set_exo_error("audio unavailable")
    }
    val audio: ref ExoSDL3Audio = audio_raw as ref ExoSDL3Audio
    if audio.stream == none || audio.buffer == none || audio.length == (0 as u32) {
        return set_exo_error("audio unavailable")
    }
    val play_loops: mut i32 = loops
    if play_loops < (0 as i32) {
        play_loops = 0 as i32
    }
    if !SDL_ClearAudioStream(audio.stream) {
        return false
    }
    SDL_SetAudioStreamGain(audio.stream, (volume as f32) / (128.0 as f32))
    val repeats: mut i32 = 0 as i32
    for {
        if repeats > play_loops {
            break
        }
        if !SDL_PutAudioStreamData(audio.stream, audio.buffer as ref void, audio.length as i32) {
            return false
        }
        repeats = repeats + (1 as i32)
    }
    return SDL_FlushAudioStream(audio.stream)
}

fn vec3(x: f32, y: f32, z: f32) ecs.Vec3 = {
    return { x: x, y: y, z: z }
}

fn vec3_add(a: ecs.Vec3, b: ecs.Vec3) ecs.Vec3 = {
    return vec3(a.x + b.x, a.y + b.y, a.z + b.z)
}

fn vec3_sub(a: ecs.Vec3, b: ecs.Vec3) ecs.Vec3 = {
    return vec3(a.x - b.x, a.y - b.y, a.z - b.z)
}

fn vec3_scale(v: ecs.Vec3, s: f32) ecs.Vec3 = {
    return vec3(v.x * s, v.y * s, v.z * s)
}

fn vec3_dot(a: ecs.Vec3, b: ecs.Vec3) f32 = {
    return a.x * b.x + a.y * b.y + a.z * b.z
}

fn vec3_cross(a: ecs.Vec3, b: ecs.Vec3) ecs.Vec3 = {
    return vec3(
        a.y * b.z - a.z * b.y,
        a.z * b.x - a.x * b.z,
        a.x * b.y - a.y * b.x
    )
}

fn vec3_length(v: ecs.Vec3) f32 = {
    return math.sqrt((vec3_dot(v, v)) as f64) as f32
}

fn vec3_normalize(v: ecs.Vec3) ecs.Vec3 = {
    val len: f32 = vec3_length(v)
    if len < (0.00001 as f32) {
        return vec3(0.0 as f32, 0.0 as f32, 0.0 as f32)
    }
    return vec3_scale(v, (1.0 as f32) / len)
}

fn mat4(
    m00: f32, m01: f32, m02: f32, m03: f32,
    m10: f32, m11: f32, m12: f32, m13: f32,
    m20: f32, m21: f32, m22: f32, m23: f32,
    m30: f32, m31: f32, m32: f32, m33: f32
) Mat4 = {
    return {
        m00: m00, m01: m01, m02: m02, m03: m03,
        m10: m10, m11: m11, m12: m12, m13: m13,
        m20: m20, m21: m21, m22: m22, m23: m23,
        m30: m30, m31: m31, m32: m32, m33: m33
    }
}

fn mat_mul(a: Mat4, b: Mat4) Mat4 = {
    val r00: f32 = a.m00 * b.m00 + a.m01 * b.m10 + a.m02 * b.m20 + a.m03 * b.m30
    val r01: f32 = a.m00 * b.m01 + a.m01 * b.m11 + a.m02 * b.m21 + a.m03 * b.m31
    val r02: f32 = a.m00 * b.m02 + a.m01 * b.m12 + a.m02 * b.m22 + a.m03 * b.m32
    val r03: f32 = a.m00 * b.m03 + a.m01 * b.m13 + a.m02 * b.m23 + a.m03 * b.m33
    val r10: f32 = a.m10 * b.m00 + a.m11 * b.m10 + a.m12 * b.m20 + a.m13 * b.m30
    val r11: f32 = a.m10 * b.m01 + a.m11 * b.m11 + a.m12 * b.m21 + a.m13 * b.m31
    val r12: f32 = a.m10 * b.m02 + a.m11 * b.m12 + a.m12 * b.m22 + a.m13 * b.m32
    val r13: f32 = a.m10 * b.m03 + a.m11 * b.m13 + a.m12 * b.m23 + a.m13 * b.m33
    val r20: f32 = a.m20 * b.m00 + a.m21 * b.m10 + a.m22 * b.m20 + a.m23 * b.m30
    val r21: f32 = a.m20 * b.m01 + a.m21 * b.m11 + a.m22 * b.m21 + a.m23 * b.m31
    val r22: f32 = a.m20 * b.m02 + a.m21 * b.m12 + a.m22 * b.m22 + a.m23 * b.m32
    val r23: f32 = a.m20 * b.m03 + a.m21 * b.m13 + a.m22 * b.m23 + a.m23 * b.m33
    val r30: f32 = a.m30 * b.m00 + a.m31 * b.m10 + a.m32 * b.m20 + a.m33 * b.m30
    val r31: f32 = a.m30 * b.m01 + a.m31 * b.m11 + a.m32 * b.m21 + a.m33 * b.m31
    val r32: f32 = a.m30 * b.m02 + a.m31 * b.m12 + a.m32 * b.m22 + a.m33 * b.m32
    val r33: f32 = a.m30 * b.m03 + a.m31 * b.m13 + a.m32 * b.m23 + a.m33 * b.m33
    return mat4(
        r00, r01, r02, r03,
        r10, r11, r12, r13,
        r20, r21, r22, r23,
        r30, r31, r32, r33
    )
}

fn mat_translation(offset: ecs.Vec3) Mat4 = {
    return mat4(
        1.0 as f32, 0.0 as f32, 0.0 as f32, offset.x,
        0.0 as f32, 1.0 as f32, 0.0 as f32, offset.y,
        0.0 as f32, 0.0 as f32, 1.0 as f32, offset.z,
        0.0 as f32, 0.0 as f32, 0.0 as f32, 1.0 as f32
    )
}

fn mat_scale(scale: ecs.Vec3) Mat4 = {
    return mat4(
        scale.x, 0.0 as f32, 0.0 as f32, 0.0 as f32,
        0.0 as f32, scale.y, 0.0 as f32, 0.0 as f32,
        0.0 as f32, 0.0 as f32, scale.z, 0.0 as f32,
        0.0 as f32, 0.0 as f32, 0.0 as f32, 1.0 as f32
    )
}

fn mat_rotation_y(angle: f32) Mat4 = {
    val c: f32 = math.cos(angle as f64) as f32
    val s: f32 = math.sin(angle as f64) as f32
    return mat4(
        c, 0.0 as f32, s, 0.0 as f32,
        0.0 as f32, 1.0 as f32, 0.0 as f32, 0.0 as f32,
        -s, 0.0 as f32, c, 0.0 as f32,
        0.0 as f32, 0.0 as f32, 0.0 as f32, 1.0 as f32
    )
}

fn mat_perspective(fov_y: f32, aspect: f32, near_z: f32, far_z: f32) Mat4 = {
    val f: f32 = (1.0 as f32) / (math.tan(((fov_y as f64) * 0.5)) as f32)
    val nf: f32 = (1.0 as f32) / (near_z - far_z)
    return mat4(
        f / aspect, 0.0 as f32, 0.0 as f32, 0.0 as f32,
        0.0 as f32, f, 0.0 as f32, 0.0 as f32,
        0.0 as f32, 0.0 as f32, far_z * nf, far_z * near_z * nf,
        0.0 as f32, 0.0 as f32, -1.0 as f32, 0.0 as f32
    )
}

fn mat_look_at(eye: ecs.Vec3, center: ecs.Vec3, up_hint: ecs.Vec3) Mat4 = {
    val forward: ecs.Vec3 = vec3_normalize(vec3_sub(center, eye))
    val side: ecs.Vec3 = vec3_normalize(vec3_cross(forward, up_hint))
    val up: ecs.Vec3 = vec3_cross(side, forward)
    return mat4(
        side.x, side.y, side.z, -vec3_dot(side, eye),
        up.x, up.y, up.z, -vec3_dot(up, eye),
        -forward.x, -forward.y, -forward.z, vec3_dot(forward, eye),
        0.0 as f32, 0.0 as f32, 0.0 as f32, 1.0 as f32
    )
}

pub fn default_camera() Camera = {
    return {
        position: vec3(0.0 as f32, 1.10 as f32, 6.4 as f32),
        yaw: mstat.PI as f32,
        pitch: -0.12 as f32,
        move_speed: 4.8 as f32,
        turn_speed: 1.9 as f32
    }
}

