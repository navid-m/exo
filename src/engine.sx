fn dup_cstr(src: ref u8) ref u8 = trust {
    if src == none {
        return none
    }
    val len: usize = strlen(src)
    val dst: ref u8 = @alloc(len + 1) as ref u8
    if dst == none {
        return none
    }
    if len > 0 {
        @memcpy(dst as ref void, src as ref void, len)
    }
    @store8(@ptradd(dst, len), 0)
    return dst
}

fn read_u32_le(data: ref u8, offset: usize) u32 = trust {
    val b0: u32 = @load8(@ptradd(data, offset + (0 as usize))) as u32
    val b1: u32 = @load8(@ptradd(data, offset + (1 as usize))) as u32
    val b2: u32 = @load8(@ptradd(data, offset + (2 as usize))) as u32
    val b3: u32 = @load8(@ptradd(data, offset + (3 as usize))) as u32
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

fn write_u32_le(data: ref u8, offset: usize, value: u32) void = trust {
    @store8(@ptradd(data, offset + (0 as usize)), (value & 255) as u8)
    @store8(@ptradd(data, offset + (1 as usize)), ((value >> 8) & 255) as u8)
    @store8(@ptradd(data, offset + (2 as usize)), ((value >> 16) & 255) as u8)
    @store8(@ptradd(data, offset + (3 as usize)), ((value >> 24) & 255) as u8)
}

fn parse_accessor_count(accessors: ref void, idx: i64) i32 = trust {
    if json.arr_get(accessors, idx as usize) is some accessor {
        if json.obj_get_int(accessor, "count") is some count {
            return count as i32
        }
    }
    return 0 as i32
}

pub fn parse_glb_bytes(data: ref u8, len: usize) option[GlbModel] = trust {
    if data == none {
        return none
    }
    if len < (20 as usize) {
        return none
    }

    val magic: u32 = read_u32_le(data, 0 as usize)
    val version: u32 = read_u32_le(data, 4 as usize)
    val total_len: u32 = read_u32_le(data, 8 as usize)
    if magic != GLB_MAGIC || version != GLB_VERSION {
        return none
    }
    if ((total_len as usize) > len) {
        return none
    }

    val json_len: u32 = read_u32_le(data, 12 as usize)
    val json_type: u32 = read_u32_le(data, 16 as usize)
    if json_type != GLB_JSON_CHUNK {
        return none
    }

    val json_offset: usize = 20 as usize
    val json_end: usize = json_offset + (json_len as usize)
    if json_end > len {
        return none
    }

    val json_buf: ref u8 = @alloc((json_len as usize) + 1) as ref u8
    if json_buf == none {
        return none
    }
    @memcpy(json_buf as ref void, @ptradd(data, json_offset) as ref void, json_len as usize)
    @store8(@ptradd(json_buf, json_len as usize), 0)

    val bin_header_offset: usize = json_end
    if bin_header_offset + (8 as usize) > len {
        @free(json_buf as ref void)
        return none
    }
    val bin_len: u32 = read_u32_le(data, bin_header_offset)
    val bin_type: u32 = read_u32_le(data, bin_header_offset + (4 as usize))
    if bin_type != GLB_BIN_CHUNK {
        @free(json_buf as ref void)
        return none
    }
    if bin_header_offset + (8 as usize) + (bin_len as usize) > len {
        @free(json_buf as ref void)
        return none
    }

    if json.parse(json_buf) is some doc {
        val root: ref void = json.doc_root(doc)
        val model: mut GlbModel = empty_model()
        model.valid = true
        model.byte_length = total_len as usize
        model.json_length = json_len as usize
        model.bin_length = bin_len as usize
        model.mesh_name = dup_cstr("embedded-glb")

        if json.obj_get(root, "meshes") is some meshes {
            if json.arr_get(meshes, 0 as usize) is some mesh {
                if json.obj_get_str(mesh, "name") is some mesh_name {
                    model.mesh_name = dup_cstr(mesh_name)
                }

                if json.obj_get(mesh, "primitives") is some primitives {
                    model.primitive_count = json.arr_len(primitives) as i32
                    if json.arr_get(primitives, 0 as usize) is some primitive {
                        if json.obj_get(primitive, "attributes") is some attributes {
                            if json.obj_get(root, "accessors") is some accessors {
                                if json.obj_get_int(attributes, "POSITION") is some pos_accessor {
                                    model.vertex_count = parse_accessor_count(accessors, pos_accessor)
                                }
                                if json.obj_get_int(primitive, "indices") is some idx_accessor {
                                    model.index_count = parse_accessor_count(accessors, idx_accessor)
                                }
                            }
                            if json.obj_get_int(attributes, "NORMAL") is some _ {
                                model.has_normals = true
                            }
                            if json.obj_get_int(attributes, "TEXCOORD_0") is some _ {
                                model.has_uvs = true
                            }
                        }
                    }
                }
            }
        }

        json.doc_free(doc)
        @free(json_buf as ref void)
        return some model
    }
    @free(json_buf as ref void)
    return none
}

pub fn load_glb(path: ref u8) option[GlbModel] = trust {
    val file: ref void = fopen(path, "rb")
    if file == none {
        return none
    }

    fseek(file, 0, 2 as i32)
    val size: i64 = ftell(file)
    rewind(file)
    if size <= 0 {
        fclose(file)
        return none
    }

    val buf: ref u8 = @alloc((size as usize) + 1) as ref u8
    if buf == none {
        fclose(file)
        return none
    }

    fread(buf as ref void, 1 as usize, size as usize, file)
    @store8(@ptradd(buf, size as usize), 0)
    fclose(file)

    val model = parse_glb_bytes(buf, size as usize)
    @free(buf as ref void)
    return model
}

pub fn build_test_glb_fixture() GlbFixture = trust {
    val json_chunk: ref u8 = \\{"asset":{"version":"2.0"},"buffers":[{"byteLength":36}],"bufferViews":[{"buffer":0,"byteOffset":0,"byteLength":36}],"accessors":[{"bufferView":0,"componentType":5126,"count":3,"type":"VEC3"}],"meshes":[{"name":"fixture","primitives":[{"attributes":{"POSITION":0}}]}]}
    val json_len_raw: usize = strlen(json_chunk)
    val json_len: usize = ((json_len_raw + (3 as usize)) / (4 as usize)) * (4 as usize)
    val bin_len: usize = 36 as usize
    val total_len: usize = (12 as usize) + (8 as usize) + json_len + (8 as usize) + bin_len
    val ptr: ref u8 = @alloc(total_len + (1 as usize)) as ref u8
    @memset(ptr as ref void, 0, total_len + (1 as usize))

    write_u32_le(ptr, 0 as usize, GLB_MAGIC)
    write_u32_le(ptr, 4 as usize, GLB_VERSION)
    write_u32_le(ptr, 8 as usize, total_len as u32)
    write_u32_le(ptr, 12 as usize, json_len as u32)
    write_u32_le(ptr, 16 as usize, GLB_JSON_CHUNK)
    @memcpy(@ptradd(ptr, 20 as usize) as ref void, json_chunk as ref void, json_len_raw)

    val bin_header: usize = (20 as usize) + json_len
    write_u32_le(ptr, bin_header, bin_len as u32)
    write_u32_le(ptr, bin_header + (4 as usize), GLB_BIN_CHUNK)
    @store8(@ptradd(ptr, total_len), 0)

    return {
        ptr: ptr,
        len: total_len
    }
}

pub fn load_embedded_fixture_model() GlbModel = trust {
    val fixture: mut GlbFixture = build_test_glb_fixture()
    if parse_glb_bytes(fixture.ptr, fixture.len) is some model {
        @free(fixture.ptr as ref void)
        return model
    }
    @free(fixture.ptr as ref void)
    return empty_model()
}

fn dump_shader_log(shader: u32) void = trust {
    val log: ref u8 = @alloc(2048 as usize) as ref u8
    if log == none { return }
    @memset(log as ref void, 0, 2048 as usize)
    glGetShaderInfoLog(shader, 2047 as i32, none as ref i32, log)
    stdio.eputs(log)
    @free(log as ref void)
}

fn dump_program_log(program: u32) void = trust {
    val log: ref u8 = @alloc(2048 as usize) as ref u8
    if log == none { return }
    @memset(log as ref void, 0, 2048 as usize)
    glGetProgramInfoLog(program, 2047 as i32, none as ref i32, log)
    stdio.eputs(log)
    @free(log as ref void)
}

fn log_gl_error(stage: ref u8) void = trust {
    val error: u32 = glGetError()
    if error != GL_NO_ERROR {
        stdio.eprint("OpenGL error at {s}: 0x{x}\n", {stage, error as u64})
    }
}

fn print_gl_info() void = trust {
    val version: ref u8 = glGetString(GL_VERSION)
    val renderer: ref u8 = glGetString(GL_RENDERER)
    if version != none {
        stdio.eprint("GL version: {s}\n", {version})
    }
    if renderer != none {
        stdio.eprint("GL renderer: {s}\n", {renderer})
    }
}

fn sample_bound_pixel(label: ref u8) void = trust {
    val px: ref void = @alloc(4 as usize)
    if px == none {
        return
    }
    @memset(px, 0, 4 as usize)
    glReadPixels(SCREEN_WIDTH / (2 as i32), SCREEN_HEIGHT / (2 as i32), 1 as i32, 1 as i32, GL_RGBA, GL_UNSIGNED_BYTE, px)
    stdio.eprint(
        "{s} pixel: {d} {d} {d} {d}\n",
        {
            label,
            (@load8(px) as i64),
            (@load8(@ptradd(px, 1 as usize)) as i64),
            (@load8(@ptradd(px, 2 as usize)) as i64),
            (@load8(@ptradd(px, 3 as usize)) as i64)
        }
    )
    @free(px)
}

fn compile_shader(stage: u32, source: ref u8) u32 = trust {
    val shader: u32 = glCreateShader(stage)
    val src: mut ref u8 = source
    glShaderSource(shader, 1 as i32, @addr(src), none as ref i32)
    glCompileShader(shader)

    val its_ok: mut i32 = 0
    glGetShaderiv(shader, GL_COMPILE_STATUS, @addr(its_ok))
    if its_ok == 0 {
        dump_shader_log(shader)
        glDeleteShader(shader)
        return 0 as u32
    }
    return shader
}

fn link_program(vertex_source: ref u8, fragment_source: ref u8) u32 = trust {
    val vs: u32 = compile_shader(GL_VERTEX_SHADER, vertex_source)
    if vs == 0 as u32 {
        return 0 as u32
    }
    val fs: u32 = compile_shader(GL_FRAGMENT_SHADER, fragment_source)
    if fs == 0 as u32 {
        glDeleteShader(vs)
        return 0 as u32
    }

    val program: u32 = glCreateProgram()
    glAttachShader(program, vs)
    glAttachShader(program, fs)
    glLinkProgram(program)
    glDeleteShader(vs)
    glDeleteShader(fs)

    val its_ok: mut i32 = 0
    glGetProgramiv(program, GL_LINK_STATUS, @addr(its_ok))
    if its_ok == 0 {
        dump_program_log(program)
        glDeleteProgram(program)
        return 0 as u32
    }

    return program
}

fn make_color_texture(width: i32, height: i32) u32 = trust {
    val texture: mut u32 = 0 as u32
    glGenTextures(1 as i32, @addr(texture))
    glBindTexture(GL_TEXTURE_2D, texture)
    glTexImage2D(GL_TEXTURE_2D, 0 as i32, GL_RGBA16F as i32, width, height, 0 as i32, GL_RGBA, GL_FLOAT, none)
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR)
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR)
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE)
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE)
    return texture
}

fn create_render_targets(width: i32, height: i32) option[RenderTargets] = trust {
    val hdr_fbo: mut u32 = 0 as u32
    glGenFramebuffers(1 as i32, @addr(hdr_fbo))
    glBindFramebuffer(GL_FRAMEBUFFER, hdr_fbo)

    val hdr_color: u32 = make_color_texture(width, height)
    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, hdr_color, 0 as i32)

    if glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE {
        glBindFramebuffer(GL_FRAMEBUFFER, 0 as u32)
        return none
    }

    val blur_fbo0: mut u32 = 0 as u32
    val blur_fbo1: mut u32 = 0 as u32
    glGenFramebuffers(1 as i32, @addr(blur_fbo0))
    glGenFramebuffers(1 as i32, @addr(blur_fbo1))

    val blur_tex0: u32 = make_color_texture(width, height)
    val blur_tex1: u32 = make_color_texture(width, height)

    glBindFramebuffer(GL_FRAMEBUFFER, blur_fbo0)
    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, blur_tex0, 0 as i32)
    if glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE {
        glBindFramebuffer(GL_FRAMEBUFFER, 0 as u32)
        return none
    }

    glBindFramebuffer(GL_FRAMEBUFFER, blur_fbo1)
    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, blur_tex1, 0 as i32)
    if glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE {
        glBindFramebuffer(GL_FRAMEBUFFER, 0 as u32)
        return none
    }

    glBindFramebuffer(GL_FRAMEBUFFER, 0 as u32)
    return some {
        hdr_fbo: hdr_fbo,
        hdr_color: hdr_color,
        blur_fbo0: blur_fbo0,
        blur_tex0: blur_tex0,
        blur_fbo1: blur_fbo1,
        blur_tex1: blur_tex1
    }
}

fn set_uniform_vec3(program: u32, name: ref u8, value: Vec3) void = trust {
    val location: i32 = glGetUniformLocation(program, name)
    if location >= 0 {
        glUniform3f(location, value.x, value.y, value.z)
    }
}

fn set_uniform_f32(program: u32, name: ref u8, value: f32) void = trust {
    val location: i32 = glGetUniformLocation(program, name)
    if location >= 0 {
        glUniform1f(location, value)
    }
}

fn set_uniform_i32(program: u32, name: ref u8, value: i32) void = trust {
    val location: i32 = glGetUniformLocation(program, name)
    if location >= 0 {
        glUniform1i(location, value)
    }
}

fn bind_scene_uniforms(program: u32, scene: ShowcaseScene, time: f32) void = trust {
    val resolution_loc: i32 = glGetUniformLocation(program, "uResolution")
    if resolution_loc >= 0 {
        glUniform2f(resolution_loc, SCREEN_WIDTH as f32, SCREEN_HEIGHT as f32)
    }
    set_uniform_f32(program, "uTime", time)
    set_uniform_i32(program, "uSphereCount", scene.sphere_count)

    set_uniform_vec3(program, "uSphere0Pos", scene.sphere0.position)
    set_uniform_vec3(program, "uSphere0Color", scene.sphere0.color)
    set_uniform_f32(program, "uSphere0Radius", scene.sphere0.radius)
    set_uniform_f32(program, "uSphere0Reflectivity", scene.sphere0.reflectivity)
    set_uniform_f32(program, "uSphere0Emissive", scene.sphere0.emissive)

    set_uniform_vec3(program, "uSphere1Pos", scene.sphere1.position)
    set_uniform_vec3(program, "uSphere1Color", scene.sphere1.color)
    set_uniform_f32(program, "uSphere1Radius", scene.sphere1.radius)
    set_uniform_f32(program, "uSphere1Reflectivity", scene.sphere1.reflectivity)
    set_uniform_f32(program, "uSphere1Emissive", scene.sphere1.emissive)

    set_uniform_vec3(program, "uSphere2Pos", scene.sphere2.position)
    set_uniform_vec3(program, "uSphere2Color", scene.sphere2.color)
    set_uniform_f32(program, "uSphere2Radius", scene.sphere2.radius)
    set_uniform_f32(program, "uSphere2Reflectivity", scene.sphere2.reflectivity)
    set_uniform_f32(program, "uSphere2Emissive", scene.sphere2.emissive)

    set_uniform_vec3(program, "uSphere3Pos", scene.sphere3.position)
    set_uniform_vec3(program, "uSphere3Color", scene.sphere3.color)
    set_uniform_f32(program, "uSphere3Radius", scene.sphere3.radius)
    set_uniform_f32(program, "uSphere3Reflectivity", scene.sphere3.reflectivity)
    set_uniform_f32(program, "uSphere3Emissive", scene.sphere3.emissive)

    set_uniform_vec3(program, "uCubePos", scene.cube.position)
    set_uniform_vec3(program, "uCubeColor", scene.cube.color)
    set_uniform_f32(program, "uCubeSize", scene.cube.size)
    set_uniform_f32(program, "uCubeRotationSpeed", scene.cube.rotation_speed)
    set_uniform_f32(program, "uCubeReflectivity", scene.cube.reflectivity)
    set_uniform_f32(program, "uCubeEmissive", scene.cube.emissive)
}

val FULLSCREEN_VERTEX_SHADER: ref u8 = \\
\\ #version 330 core
\\ out vec2 vUV;
\\ const vec2 POSITIONS[3] = vec2[](
\\     vec2(-1.0, -1.0),
\\     vec2( 3.0, -1.0),
\\     vec2(-1.0,  3.0)
\\ );
\\ void main() {
\\     vec2 position = POSITIONS[gl_VertexID];
\\     vUV = position * 0.5 + 0.5;
\\     gl_Position = vec4(position, 0.0, 1.0);
\\ }
\\ 
val SCENE_FRAGMENT_SHADER: ref u8 = \\
\\ #version 330 core
\\ in vec2 vUV;
\\ layout(location = 0) out vec4 FragColor;
\\ uniform vec2 uResolution;
\\ uniform float uTime;
\\ uniform int uSphereCount;
\\ uniform vec3 uSphere0Pos;
\\ uniform vec3 uSphere0Color;
\\ uniform float uSphere0Radius;
\\ uniform float uSphere0Reflectivity;
\\ uniform float uSphere0Emissive;
\\ uniform vec3 uSphere1Pos;
\\ uniform vec3 uSphere1Color;
\\ uniform float uSphere1Radius;
\\ uniform float uSphere1Reflectivity;
\\ uniform float uSphere1Emissive;
\\ uniform vec3 uSphere2Pos;
\\ uniform vec3 uSphere2Color;
\\ uniform float uSphere2Radius;
\\ uniform float uSphere2Reflectivity;
\\ uniform float uSphere2Emissive;
\\ uniform vec3 uSphere3Pos;
\\ uniform vec3 uSphere3Color;
\\ uniform float uSphere3Radius;
\\ uniform float uSphere3Reflectivity;
\\ uniform float uSphere3Emissive;
\\ uniform vec3 uCubePos;
\\ uniform vec3 uCubeColor;
\\ uniform float uCubeSize;
\\ uniform float uCubeRotationSpeed;
\\ uniform float uCubeReflectivity;
\\ uniform float uCubeEmissive;
\\ 
\\ float sdSphere(vec3 p, vec3 c, float r) {
\\     return length(p - c) - r;
\\ }
\\ 
\\ mat2 rot(float a) {
\\     float s = sin(a);
\\     float c = cos(a);
\\     return mat2(c, -s, s, c);
\\ }
\\ 
\\ float sdBox(vec3 p, vec3 b) {
\\     vec3 q = abs(p) - b;
\\     return length(max(q, 0.0)) + min(max(q.x, max(q.y, q.z)), 0.0);
\\ }
\\ 
\\ bool hitSphere(vec3 ro, vec3 rd, vec3 center, float radius, out float t_hit, out vec3 normal) {
\\     vec3 oc = ro - center;
\\     float b = dot(oc, rd);
\\     float c = dot(oc, oc) - radius * radius;
\\     float h = b * b - c;
\\     if (h < 0.0) {
\\         return false;
\\     }
\\     h = sqrt(h);
\\     t_hit = -b - h;
\\     if (t_hit <= 0.0) {
\\         t_hit = -b + h;
\\         if (t_hit <= 0.0) {
\\             return false;
\\         }
\\     }
\\     vec3 pos = ro + rd * t_hit;
\\     normal = normalize(pos - center);
\\     return true;
\\ }
\\ 
\\ bool hitBox(vec3 ro, vec3 rd, vec3 center, vec3 half_size, float angle, out float t_hit, out vec3 normal) {
\\     vec3 local_ro = ro - center;
\\     vec3 local_rd = rd;
\\     local_ro.xz *= rot(-angle);
\\     local_rd.xz *= rot(-angle);
\\     local_ro.xy *= rot(-angle * 0.73);
\\     local_rd.xy *= rot(-angle * 0.73);
\\ 
\\     vec3 inv_rd = 1.0 / local_rd;
\\     vec3 t0 = (-half_size - local_ro) * inv_rd;
\\     vec3 t1 = ( half_size - local_ro) * inv_rd;
\\     vec3 tmin3 = min(t0, t1);
\\     vec3 tmax3 = max(t0, t1);
\\     float near_t = max(max(tmin3.x, tmin3.y), tmin3.z);
\\     float far_t = min(min(tmax3.x, tmax3.y), tmax3.z);
\\     if (far_t < max(near_t, 0.0)) {
\\         return false;
\\     }
\\     t_hit = near_t > 0.0 ? near_t : far_t;
\\     if (t_hit <= 0.0) {
\\         return false;
\\     }
\\ 
\\     vec3 hit = local_ro + local_rd * t_hit;
\\     vec3 ah = abs(hit);
\\     if (ah.x > ah.y && ah.x > ah.z) {
\\         normal = vec3(sign(hit.x), 0.0, 0.0);
\\     } else if (ah.y > ah.z) {
\\         normal = vec3(0.0, sign(hit.y), 0.0);
\\     } else {
\\         normal = vec3(0.0, 0.0, sign(hit.z));
\\     }
\\ 
\\     normal.xy *= rot(angle * 0.73);
\\     normal.xz *= rot(angle);
\\     return true;
\\ }
\\ 
\\ bool hitGround(vec3 ro, vec3 rd, out float t_hit, out vec3 normal) {
\\     if (abs(rd.y) < 0.0001) {
\\         return false;
\\     }
\\     t_hit = (-1.25 - ro.y) / rd.y;
\\     if (t_hit <= 0.0) {
\\         return false;
\\     }
\\     normal = vec3(0.0, 1.0, 0.0);
\\     return true;
\\ }
\\ 
\\ vec3 skyColor(vec3 rd) {
\\     float t = clamp(rd.y * 0.5 + 0.5, 0.0, 1.0);
\\     vec3 dusk = mix(vec3(0.06, 0.08, 0.16), vec3(0.13, 0.22, 0.40), t);
\\     float glow = pow(max(dot(rd, normalize(vec3(-0.4, 0.75, -0.2))), 0.0), 42.0);
\\     return dusk + vec3(1.8, 1.2, 0.7) * glow;
\\ }
\\ 
\\ void materialInfo(int id, out vec3 albedo, out float refl, out float emissive) {
\\     if (id == 0) { albedo = uSphere0Color; refl = uSphere0Reflectivity; emissive = uSphere0Emissive; return; }
\\     if (id == 1) { albedo = uSphere1Color; refl = uSphere1Reflectivity; emissive = uSphere1Emissive; return; }
\\     if (id == 2) { albedo = uSphere2Color; refl = uSphere2Reflectivity; emissive = uSphere2Emissive; return; }
\\     if (id == 3) { albedo = uSphere3Color; refl = uSphere3Reflectivity; emissive = uSphere3Emissive; return; }
\\     if (id == 4) { albedo = uCubeColor; refl = uCubeReflectivity; emissive = uCubeEmissive; return; }
\\     albedo = vec3(0.12, 0.13, 0.15);
\\     refl = 0.08;
\\     emissive = 0.0;
\\ }
\\ 
\\ void main() {
\\     vec2 uv = (gl_FragCoord.xy / uResolution.xy) * 2.0 - 1.0;
\\     uv.x *= uResolution.x / uResolution.y;
\\ 
\\     vec3 ro = vec3(0.0, 1.1, 5.6);
\\     vec3 ta = vec3(0.0, 0.35, 0.0);
\\     vec3 ww = normalize(ta - ro);
\\     vec3 uu = normalize(cross(ww, vec3(0.0, 1.0, 0.0)));
\\     vec3 vv = normalize(cross(uu, ww));
\\     vec3 rd = normalize(uv.x * uu + uv.y * vv + 1.55 * ww);
\\ 
\\     float nearest_t = 1e20;
\\     int material_id = -1;
\\     vec3 hit_normal = vec3(0.0);
\\     float hit_t;
\\     vec3 temp_normal;
\\ 
\\     if (hitGround(ro, rd, hit_t, temp_normal) && hit_t < nearest_t) {
\\         nearest_t = hit_t;
\\         material_id = 10;
\\         hit_normal = temp_normal;
\\     }
\\     if (hitSphere(ro, rd, uSphere0Pos, uSphere0Radius, hit_t, temp_normal) && hit_t < nearest_t) {
\\         nearest_t = hit_t;
\\         material_id = 0;
\\         hit_normal = temp_normal;
\\     }
\\     if (hitSphere(ro, rd, uSphere1Pos, uSphere1Radius, hit_t, temp_normal) && hit_t < nearest_t) {
\\         nearest_t = hit_t;
\\         material_id = 1;
\\         hit_normal = temp_normal;
\\     }
\\     if (hitSphere(ro, rd, uSphere2Pos, uSphere2Radius, hit_t, temp_normal) && hit_t < nearest_t) {
\\         nearest_t = hit_t;
\\         material_id = 2;
\\         hit_normal = temp_normal;
\\     }
\\     if (hitSphere(ro, rd, uSphere3Pos, uSphere3Radius, hit_t, temp_normal) && hit_t < nearest_t) {
\\         nearest_t = hit_t;
\\         material_id = 3;
\\         hit_normal = temp_normal;
\\     }
\\     if (hitBox(ro, rd, uCubePos, vec3(uCubeSize), uTime * uCubeRotationSpeed, hit_t, temp_normal) && hit_t < nearest_t) {
\\         nearest_t = hit_t;
\\         material_id = 4;
\\         hit_normal = temp_normal;
\\     }
\\ 
\\     vec3 color = skyColor(rd);
\\     if (material_id >= 0) {
\\         vec3 p = ro + rd * nearest_t;
\\         vec3 n = normalize(hit_normal);
\\         vec3 albedo;
\\         float refl;
\\         float emissive;
\\         materialInfo(material_id, albedo, refl, emissive);
\\ 
\\         vec3 light_dir = normalize(vec3(-0.45, 0.85, -0.35));
\\         float diff = max(dot(n, light_dir), 0.0);
\\         float fresnel = pow(1.0 - max(dot(-rd, n), 0.0), 4.0);
\\         vec3 reflection = skyColor(reflect(rd, n));
\\         vec3 base = albedo * (0.20 + diff * 0.95);
\\         vec3 spec = reflection * (refl + fresnel * 0.75);
\\         vec3 emissive_glow = albedo * emissive * (0.45 + 0.55 * fresnel);
\\ 
\\         if (material_id == 10) {
\\             float grid = smoothstep(0.0, 0.02, abs(fract(p.x * 0.3) - 0.5))
\\                        + smoothstep(0.0, 0.02, abs(fract(p.z * 0.3) - 0.5));
\\             base = mix(vec3(0.04, 0.05, 0.06), vec3(0.10, 0.11, 0.13), clamp(grid, 0.0, 1.0));
\\             spec = reflection * 0.08;
\\             emissive_glow = vec3(0.0);
\\         }
\\ 
\\         color = base + spec + emissive_glow;
\\     }
\\ 
\\     float pulse = 0.12 * sin(uTime * 1.7) + 0.12;
\\     color += vec3(0.08, 0.10, 0.14) * pulse;
\\ 
\\     FragColor = vec4(color, 1.0);
\\ }

val BLUR_FRAGMENT_SHADER: ref u8 = \\
\\ #version 330 core
\\ in vec2 vUV;
\\ out vec4 FragColor;
\\ uniform sampler2D uImage;
\\ uniform int uHorizontal;
\\ uniform int uPrefilter;
\\ void main() {
\\     vec2 texel = 1.0 / vec2(textureSize(uImage, 0));
\\     vec3 center = texture(uImage, vUV).rgb;
\\     if (uPrefilter == 1) {
\\         center = max(center - vec3(0.95), vec3(0.0));
\\     }
\\     vec3 result = center * 0.227027;
\\     vec2 dir = uHorizontal == 1 ? vec2(texel.x, 0.0) : vec2(0.0, texel.y);
\\     vec3 s1 = texture(uImage, vUV + dir * 1.384615).rgb;
\\     vec3 s2 = texture(uImage, vUV - dir * 1.384615).rgb;
\\     vec3 s3 = texture(uImage, vUV + dir * 3.230769).rgb;
\\     vec3 s4 = texture(uImage, vUV - dir * 3.230769).rgb;
\\     if (uPrefilter == 1) {
\\         s1 = max(s1 - vec3(0.95), vec3(0.0));
\\         s2 = max(s2 - vec3(0.95), vec3(0.0));
\\         s3 = max(s3 - vec3(0.95), vec3(0.0));
\\         s4 = max(s4 - vec3(0.95), vec3(0.0));
\\     }
\\     result += s1 * 0.316216;
\\     result += s2 * 0.316216;
\\     result += s3 * 0.070270;
\\     result += s4 * 0.070270;
\\     FragColor = vec4(result, 1.0);
\\ }

val COMPOSITE_FRAGMENT_SHADER: ref u8 = \\
\\ #version 330 core
\\ in vec2 vUV;
\\ out vec4 FragColor;
\\ uniform sampler2D uScene;
\\ uniform sampler2D uBloom;
\\ uniform float uExposure;
\\ uniform float uBloomStrength;
\\ void main() {
\\     vec3 scene = texture(uScene, vUV).rgb;
\\     vec3 bloom = texture(uBloom, vUV).rgb;
\\     vec3 combined = scene + bloom * 0.75;
\\     combined = min(combined * 1.15, vec3(1.0));
\\     FragColor = vec4(combined, 1.0);
\\ }

fn print_sdl_error(prefix: ref u8) void = {
    trust stdio.eprint("{s}: {s}\n", {prefix, SDL_GetError()})
}

pub fn run() i32 = trust {
    val scene: mut ShowcaseScene = build_reflection_showcase()
    scene.model = load_embedded_fixture_model()

    if scene.model.valid {
        stdio.print(
            "Loaded embedded GLB mesh {s} with {d} vertices.\n",
            {scene.model.mesh_name, scene.model.vertex_count as i64}
        )
    }

    if SDL_Init(SDL_INIT_VIDEO) != 0 {
        print_sdl_error("SDL_Init failed")
        return 1 as i32
    }

    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3 as i32)
    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 3 as i32)
    SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_CORE)
    SDL_GL_SetAttribute(SDL_GL_DOUBLEBUFFER, 1 as i32)

    val window: ref void = SDL_CreateWindow(
        "exo-engine",
        80 as i32,
        80 as i32,
        SCREEN_WIDTH,
        SCREEN_HEIGHT,
        SDL_WINDOW_OPENGL | SDL_WINDOW_SHOWN
    )
    if window == none {
        print_sdl_error("SDL_CreateWindow failed")
        SDL_Quit()
        return 1 as i32
    }

    val context: ref void = SDL_GL_CreateContext(window)
    if context == none {
        print_sdl_error("SDL_GL_CreateContext failed")
        SDL_DestroyWindow(window)
        SDL_Quit()
        return 1 as i32
    }

    if SDL_GL_MakeCurrent(window, context) != 0 {
        print_sdl_error("SDL_GL_MakeCurrent failed")
        SDL_GL_DeleteContext(context)
        SDL_DestroyWindow(window)
        SDL_Quit()
        return 1 as i32
    }
    SDL_GL_SetSwapInterval(1 as i32)
    print_gl_info()

    val vao: mut u32 = 0 as u32
    glGenVertexArrays(1 as i32, @addr(vao))
    glBindVertexArray(vao)
    glViewport(0 as i32, 0 as i32, SCREEN_WIDTH, SCREEN_HEIGHT)
    log_gl_error("vao setup")

    val scene_program: u32 = link_program(FULLSCREEN_VERTEX_SHADER, SCENE_FRAGMENT_SHADER)
    val blur_program: u32 = link_program(FULLSCREEN_VERTEX_SHADER, BLUR_FRAGMENT_SHADER)
    val composite_program: u32 = link_program(FULLSCREEN_VERTEX_SHADER, COMPOSITE_FRAGMENT_SHADER)
    stdio.eprint(
        "Program handles scene={d} blur={d} composite={d}\n",
        {scene_program as i64, blur_program as i64, composite_program as i64}
    )
    if scene_program == 0 as u32 || blur_program == 0 as u32 || composite_program == 0 as u32 {
        glDeleteVertexArrays(1 as i32, @addr(vao))
        SDL_GL_DeleteContext(context)
        SDL_DestroyWindow(window)
        SDL_Quit()
        return 1 as i32
    }

    if create_render_targets(SCREEN_WIDTH, SCREEN_HEIGHT) is some targets {
        stdio.eprint(
            "Render targets hdr={d} blur0={d} blur1={d}\n",
            {targets.hdr_fbo as i64, targets.blur_fbo0 as i64, targets.blur_fbo1 as i64}
        )
        val evt: ref SDL_Event = @alloc(@sizeof(SDL_Event) as usize) as ref SDL_Event
        if evt == none {
            stdio.eputs("Failed to allocate SDL event buffer.")
            glDeleteTextures(1 as i32, @addr(targets.hdr_color))
            glDeleteTextures(1 as i32, @addr(targets.blur_tex0))
            glDeleteTextures(1 as i32, @addr(targets.blur_tex1))
            glDeleteFramebuffers(1 as i32, @addr(targets.hdr_fbo))
            glDeleteFramebuffers(1 as i32, @addr(targets.blur_fbo0))
            glDeleteFramebuffers(1 as i32, @addr(targets.blur_fbo1))
            glDeleteProgram(scene_program)
            glDeleteProgram(blur_program)
            glDeleteProgram(composite_program)
            glDeleteVertexArrays(1 as i32, @addr(vao))
            SDL_GL_DeleteContext(context)
            SDL_DestroyWindow(window)
            SDL_Quit()
            return 1 as i32
        }

        val start_ticks: u32 = SDL_GetTicks()
        val quit: mut bool = false
        val debug_logged: mut bool = false

        for !quit {
            for {
                if SDL_PollEvent(evt) != 0 {
                    if evt.type_value == SDL_QUIT {
                        quit = true
                    }
                } else {
                    break
                }
            }

            val keys: ref u8 = SDL_GetKeyboardState(none as ref i32)
            val escape_pressed: u8 = @load(@ptradd(keys, (SDL_SCANCODE_ESCAPE as usize) * @sizeof(u8)))
            if escape_pressed != 0 {
                quit = true
            }

            val now_ticks: u32 = SDL_GetTicks()
            val time_value: f32 = ((now_ticks - start_ticks) as f32) / (1000.0 as f32)

            glBindFramebuffer(GL_FRAMEBUFFER, targets.hdr_fbo)
            glViewport(0 as i32, 0 as i32, SCREEN_WIDTH, SCREEN_HEIGHT)
            glClearColor(0.0 as f32, 0.0 as f32, 0.0 as f32, 1.0 as f32)
            glClear(GL_COLOR_BUFFER_BIT)
            glUseProgram(scene_program)
            bind_scene_uniforms(scene_program, scene, time_value)
            glDrawArrays(GL_TRIANGLES, 0 as i32, 3 as i32)
            log_gl_error("scene pass")

            val blur_passes: mut i32 = 0
            val horizontal: mut bool = true
            val first_pass: mut bool = true
            for blur_passes < 8 {
                if horizontal {
                    glBindFramebuffer(GL_FRAMEBUFFER, targets.blur_fbo0)
                } else {
                    glBindFramebuffer(GL_FRAMEBUFFER, targets.blur_fbo1)
                }
                glClear(GL_COLOR_BUFFER_BIT)
                glUseProgram(blur_program)
                set_uniform_i32(blur_program, "uImage", 0 as i32)
                if horizontal {
                    set_uniform_i32(blur_program, "uHorizontal", 1 as i32)
                } else {
                    set_uniform_i32(blur_program, "uHorizontal", 0 as i32)
                }
                if first_pass {
                    set_uniform_i32(blur_program, "uPrefilter", 1 as i32)
                } else {
                    set_uniform_i32(blur_program, "uPrefilter", 0 as i32)
                }
                glActiveTexture(GL_TEXTURE0)
                if first_pass {
                    glBindTexture(GL_TEXTURE_2D, targets.hdr_color)
                } elif horizontal {
                    glBindTexture(GL_TEXTURE_2D, targets.blur_tex1)
                } else {
                    glBindTexture(GL_TEXTURE_2D, targets.blur_tex0)
                }
                glDrawArrays(GL_TRIANGLES, 0 as i32, 3 as i32)
                horizontal = !horizontal
                if first_pass {
                    first_pass = false
                }
                blur_passes++
            }
            log_gl_error("blur pass")

            glBindFramebuffer(GL_FRAMEBUFFER, 0 as u32)
            glViewport(0 as i32, 0 as i32, SCREEN_WIDTH, SCREEN_HEIGHT)
            glClear(GL_COLOR_BUFFER_BIT)
            glUseProgram(composite_program)
            set_uniform_i32(composite_program, "uScene", 0 as i32)
            set_uniform_i32(composite_program, "uBloom", 1 as i32)
            set_uniform_f32(composite_program, "uExposure", scene.exposure)
            set_uniform_f32(composite_program, "uBloomStrength", scene.bloom_strength)
            glActiveTexture(GL_TEXTURE0)
            glBindTexture(GL_TEXTURE_2D, targets.hdr_color)
            glActiveTexture(GL_TEXTURE1)
            if horizontal {
                glBindTexture(GL_TEXTURE_2D, targets.blur_tex0)
            } else {
                glBindTexture(GL_TEXTURE_2D, targets.blur_tex1)
            }
            glDrawArrays(GL_TRIANGLES, 0 as i32, 3 as i32)
            log_gl_error("composite pass")

            if !debug_logged {
                glBindFramebuffer(GL_FRAMEBUFFER, targets.hdr_fbo)
                glReadBuffer(GL_COLOR_ATTACHMENT0)
                sample_bound_pixel("hdr")
                log_gl_error("hdr readback")
                glBindFramebuffer(GL_FRAMEBUFFER, 0 as u32)
                glReadBuffer(GL_BACK)
                sample_bound_pixel("backbuffer")
                log_gl_error("backbuffer readback")
                debug_logged = true
            }
            SDL_GL_SwapWindow(window)
        }

        @free(evt as ref void)
        glDeleteTextures(1 as i32, @addr(targets.hdr_color))
        glDeleteTextures(1 as i32, @addr(targets.blur_tex0))
        glDeleteTextures(1 as i32, @addr(targets.blur_tex1))
        glDeleteFramebuffers(1 as i32, @addr(targets.hdr_fbo))
        glDeleteFramebuffers(1 as i32, @addr(targets.blur_fbo0))
        glDeleteFramebuffers(1 as i32, @addr(targets.blur_fbo1))
        glDeleteProgram(scene_program)
        glDeleteProgram(blur_program)
        glDeleteProgram(composite_program)
        glDeleteVertexArrays(1 as i32, @addr(vao))
        SDL_GL_DeleteContext(context)
        SDL_DestroyWindow(window)
        SDL_Quit()
        return 0 as i32
    }
    stdio.eputs("Failed to create HDR/bloom render targets.")
    glDeleteProgram(scene_program)
    glDeleteProgram(blur_program)
    glDeleteProgram(composite_program)
    glDeleteVertexArrays(1 as i32, @addr(vao))
    SDL_GL_DeleteContext(context)
    SDL_DestroyWindow(window)
    SDL_Quit()
    return 1 as i32
}
