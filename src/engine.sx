link "-lSDL2"
link "-lGL"

val SCREEN_WIDTH: i32 = 1440
val SCREEN_HEIGHT: i32 = 900

val SDL_INIT_VIDEO: u32 = 0x00000020
val SDL_WINDOW_OPENGL: u32 = 0x00000002
val SDL_WINDOW_SHOWN: u32 = 0x00000004
val SDL_GL_CONTEXT_MAJOR_VERSION: i32 = 17
val SDL_GL_CONTEXT_MINOR_VERSION: i32 = 18
val SDL_GL_CONTEXT_PROFILE_MASK: i32 = 21
val SDL_GL_CONTEXT_PROFILE_CORE: i32 = 1
val SDL_GL_DOUBLEBUFFER: i32 = 5
val SDL_QUIT: u32 = 0x100
val SDL_SCANCODE_ESCAPE: i32 = 41

val GL_VERTEX_SHADER: u32 = 0x8B31
val GL_FRAGMENT_SHADER: u32 = 0x8B30
val GL_COMPILE_STATUS: u32 = 0x8B81
val GL_LINK_STATUS: u32 = 0x8B82
val GL_INFO_LOG_LENGTH: u32 = 0x8B84 
val GL_FRAMEBUFFER: u32 = 0x8D40
val GL_COLOR_ATTACHMENT0: u32 = 0x8CE0
val GL_COLOR_ATTACHMENT1: u32 = 0x8CE1
val GL_FRAMEBUFFER_COMPLETE: u32 = 0x8CD5
val GL_TEXTURE_2D: u32 = 0x0DE1
val GL_RGBA16F: u32 = 0x881A
val GL_RGBA: u32 = 0x1908
val GL_FLOAT: u32 = 0x1406
val GL_TRIANGLES: u32 = 0x0004
val GL_TEXTURE0: u32 = 0x84C0
val GL_TEXTURE1: u32 = 0x84C1
val GL_TEXTURE_MIN_FILTER: u32 = 0x2801
val GL_TEXTURE_MAG_FILTER: u32 = 0x2800
val GL_TEXTURE_WRAP_S: u32 = 0x2802
val GL_TEXTURE_WRAP_T: u32 = 0x2803
val GL_LINEAR: i32 = 0x2601
val GL_CLAMP_TO_EDGE: i32 = 0x812F
val GL_COLOR_BUFFER_BIT: u32 = 0x00004000
val GL_UNSIGNED_BYTE: u32 = 0x1401
val GL_VERSION: u32 = 0x1F02
val GL_RENDERER: u32 = 0x1F01
val GL_NO_ERROR: u32 = 0
val GL_BACK: u32 = 0x0405

val GLB_MAGIC: u32 = 0x46546C67
val GLB_VERSION: u32 = 2
val GLB_JSON_CHUNK: u32 = 0x4E4F534A
val GLB_BIN_CHUNK: u32 = 0x004E4942

