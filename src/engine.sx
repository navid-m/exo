fn vec3(x: f32, y: f32, z: f32) ecs.Vec3 = {
    return { x: x, y: y, z: z }
}

fn vec3_add(a: ecs.Vec3, b: ecs.Vec3) ecs.Vec3 = {
    return vec3(a.x + b.x, a.y + b.y, a.z + b.z)
}

fn vec3_sub(a: ecs.Vec3, b: ecs.Vec3) ecs.Vec3 = {
    return vec3(a.x - b.x, a.y - b.y, a.z - b.z)
}

fn vec3_scale(v: ecs.Vec3, s: f32) ecs.Vec3 = {
    return vec3(v.x * s, v.y * s, v.z * s)
}

fn vec3_dot(a: ecs.Vec3, b: ecs.Vec3) f32 = {
    return a.x * b.x + a.y * b.y + a.z * b.z
}

fn vec3_cross(a: ecs.Vec3, b: ecs.Vec3) ecs.Vec3 = {
    return vec3(
        a.y * b.z - a.z * b.y,
        a.z * b.x - a.x * b.z,
        a.x * b.y - a.y * b.x
    )
}

fn vec3_length(v: ecs.Vec3) f32 = {
    return math.sqrt((vec3_dot(v, v)) as f64) as f32
}

fn vec3_normalize(v: ecs.Vec3) ecs.Vec3 = {
    val len: f32 = vec3_length(v)
    if len < (0.00001 as f32) {
        return vec3(0.0 as f32, 0.0 as f32, 0.0 as f32)
    }
    return vec3_scale(v, (1.0 as f32) / len)
}

fn mat4(
    m00: f32, m01: f32, m02: f32, m03: f32,
    m10: f32, m11: f32, m12: f32, m13: f32,
    m20: f32, m21: f32, m22: f32, m23: f32,
    m30: f32, m31: f32, m32: f32, m33: f32
) Mat4 = {
    return {
        m00: m00, m01: m01, m02: m02, m03: m03,
        m10: m10, m11: m11, m12: m12, m13: m13,
        m20: m20, m21: m21, m22: m22, m23: m23,
        m30: m30, m31: m31, m32: m32, m33: m33
    }
}

fn mat_identity() Mat4 = {
    return mat4(
        1.0 as f32, 0.0 as f32, 0.0 as f32, 0.0 as f32,
        0.0 as f32, 1.0 as f32, 0.0 as f32, 0.0 as f32,
        0.0 as f32, 0.0 as f32, 1.0 as f32, 0.0 as f32,
        0.0 as f32, 0.0 as f32, 0.0 as f32, 1.0 as f32
    )
}

fn mat_mul(a: Mat4, b: Mat4) Mat4 = {
    val r00: f32 = a.m00 * b.m00 + a.m01 * b.m10 + a.m02 * b.m20 + a.m03 * b.m30
    val r01: f32 = a.m00 * b.m01 + a.m01 * b.m11 + a.m02 * b.m21 + a.m03 * b.m31
    val r02: f32 = a.m00 * b.m02 + a.m01 * b.m12 + a.m02 * b.m22 + a.m03 * b.m32
    val r03: f32 = a.m00 * b.m03 + a.m01 * b.m13 + a.m02 * b.m23 + a.m03 * b.m33
    val r10: f32 = a.m10 * b.m00 + a.m11 * b.m10 + a.m12 * b.m20 + a.m13 * b.m30
    val r11: f32 = a.m10 * b.m01 + a.m11 * b.m11 + a.m12 * b.m21 + a.m13 * b.m31
    val r12: f32 = a.m10 * b.m02 + a.m11 * b.m12 + a.m12 * b.m22 + a.m13 * b.m32
    val r13: f32 = a.m10 * b.m03 + a.m11 * b.m13 + a.m12 * b.m23 + a.m13 * b.m33
    val r20: f32 = a.m20 * b.m00 + a.m21 * b.m10 + a.m22 * b.m20 + a.m23 * b.m30
    val r21: f32 = a.m20 * b.m01 + a.m21 * b.m11 + a.m22 * b.m21 + a.m23 * b.m31
    val r22: f32 = a.m20 * b.m02 + a.m21 * b.m12 + a.m22 * b.m22 + a.m23 * b.m32
    val r23: f32 = a.m20 * b.m03 + a.m21 * b.m13 + a.m22 * b.m23 + a.m23 * b.m33
    val r30: f32 = a.m30 * b.m00 + a.m31 * b.m10 + a.m32 * b.m20 + a.m33 * b.m30
    val r31: f32 = a.m30 * b.m01 + a.m31 * b.m11 + a.m32 * b.m21 + a.m33 * b.m31
    val r32: f32 = a.m30 * b.m02 + a.m31 * b.m12 + a.m32 * b.m22 + a.m33 * b.m32
    val r33: f32 = a.m30 * b.m03 + a.m31 * b.m13 + a.m32 * b.m23 + a.m33 * b.m33

    return mat4(
        r00, r01, r02, r03,
        r10, r11, r12, r13,
        r20, r21, r22, r23,
        r30, r31, r32, r33
    )
}

fn mat_translation(offset: ecs.Vec3) Mat4 = {
    return mat4(
        1.0 as f32, 0.0 as f32, 0.0 as f32, offset.x,
        0.0 as f32, 1.0 as f32, 0.0 as f32, offset.y,
        0.0 as f32, 0.0 as f32, 1.0 as f32, offset.z,
        0.0 as f32, 0.0 as f32, 0.0 as f32, 1.0 as f32
    )
}

fn mat_scale(scale: ecs.Vec3) Mat4 = {
    return mat4(
        scale.x, 0.0 as f32, 0.0 as f32, 0.0 as f32,
        0.0 as f32, scale.y, 0.0 as f32, 0.0 as f32,
        0.0 as f32, 0.0 as f32, scale.z, 0.0 as f32,
        0.0 as f32, 0.0 as f32, 0.0 as f32, 1.0 as f32
    )
}

fn mat_rotation_y(angle: f32) Mat4 = {
    val c: f32 = math.cos(angle as f64) as f32
    val s: f32 = math.sin(angle as f64) as f32
    return mat4(
        c, 0.0 as f32, s, 0.0 as f32,
        0.0 as f32, 1.0 as f32, 0.0 as f32, 0.0 as f32,
        -s, 0.0 as f32, c, 0.0 as f32,
        0.0 as f32, 0.0 as f32, 0.0 as f32, 1.0 as f32
    )
}

fn mat_perspective(fov_y: f32, aspect: f32, near_z: f32, far_z: f32) Mat4 = {
    val f: f32 = (1.0 as f32) / (math.tan(((fov_y as f64) * 0.5)) as f32)
    val nf: f32 = (1.0 as f32) / (near_z - far_z)
    return mat4(
        f / aspect, 0.0 as f32, 0.0 as f32, 0.0 as f32,
        0.0 as f32, f, 0.0 as f32, 0.0 as f32,
        0.0 as f32, 0.0 as f32, (far_z + near_z) * nf, (2.0 as f32) * far_z * near_z * nf,
        0.0 as f32, 0.0 as f32, -1.0 as f32, 0.0 as f32
    )
}

fn mat_look_at(eye: ecs.Vec3, center: ecs.Vec3, up_hint: ecs.Vec3) Mat4 = {
    val forward: ecs.Vec3 = vec3_normalize(vec3_sub(center, eye))
    val side: ecs.Vec3 = vec3_normalize(vec3_cross(forward, up_hint))
    val up: ecs.Vec3 = vec3_cross(side, forward)
    return mat4(
        side.x, side.y, side.z, -vec3_dot(side, eye),
        up.x, up.y, up.z, -vec3_dot(up, eye),
        -forward.x, -forward.y, -forward.z, vec3_dot(forward, eye),
        0.0 as f32, 0.0 as f32, 0.0 as f32, 1.0 as f32
    )
}

pub fn default_camera() Camera = {
    return {
        position: vec3(0.0 as f32, 1.10 as f32, 6.4 as f32),
        yaw: mstat.PI as f32,
        pitch: -0.12 as f32,
        move_speed: 4.8 as f32,
        turn_speed: 1.9 as f32
    }
}

pub fn default_config() ExoConfig = {
    return {
        title: "exo-engine",
        width: SCREEN_WIDTH,
        height: SCREEN_HEIGHT
    }
}

pub fn create_app(config: ExoConfig, scene: ecs.Scene3D, camera: Camera) ExoApp = {
    return {
        config: config,
        scene: scene,
        camera: camera
    }
}

fn dup_cstr(src: ref u8) ref u8 = trust {
    if src == none {
        return none
    }
    val len: usize = strlen(src)
    val dst: ref u8 = @alloc(len + 1) as ref u8
    if dst == none {
        return none
    }
    if len > 0 {
        @memcpy(dst as ref void, src as ref void, len)
    }
    @store8(@ptradd(dst, len), 0)
    return dst
}

fn read_u32_le(data: ref u8, offset: usize) u32 = trust {
    val b0: u32 = @load8(@ptradd(data, offset + (0 as usize))) as u32
    val b1: u32 = @load8(@ptradd(data, offset + (1 as usize))) as u32
    val b2: u32 = @load8(@ptradd(data, offset + (2 as usize))) as u32
    val b3: u32 = @load8(@ptradd(data, offset + (3 as usize))) as u32
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

fn write_u32_le(data: ref u8, offset: usize, value: u32) void = trust {
    @store8(@ptradd(data, offset + (0 as usize)), (value & 255) as u8)
    @store8(@ptradd(data, offset + (1 as usize)), ((value >> 8) & 255) as u8)
    @store8(@ptradd(data, offset + (2 as usize)), ((value >> 16) & 255) as u8)
    @store8(@ptradd(data, offset + (3 as usize)), ((value >> 24) & 255) as u8)
}

fn parse_accessor_count(accessors: ref void, idx: i64) i32 = trust {
    if json.arr_get(accessors, idx as usize) is some accessor {
        if json.obj_get_int(accessor, "count") is some count {
            return count as i32
        }
    }
    return 0 as i32
}

pub fn parse_glb_bytes(data: ref u8, len: usize) option[ecs.GlbModel] = trust {
    if data == none {
        return none
    }
    if len < (20 as usize) {
        return none
    }

    val magic: u32 = read_u32_le(data, 0 as usize)
    val version: u32 = read_u32_le(data, 4 as usize)
    val total_len: u32 = read_u32_le(data, 8 as usize)
    if magic != GLB_MAGIC || version != GLB_VERSION {
        return none
    }
    if ((total_len as usize) > len) {
        return none
    }

    val json_len: u32 = read_u32_le(data, 12 as usize)
    val json_type: u32 = read_u32_le(data, 16 as usize)
    if json_type != GLB_JSON_CHUNK {
        return none
    }

    val json_offset: usize = 20 as usize
    val json_end: usize = json_offset + (json_len as usize)
    if json_end > len {
        return none
    }

    val json_buf: ref u8 = @alloc((json_len as usize) + 1) as ref u8
    if json_buf == none {
        return none
    }
    @memcpy(json_buf as ref void, @ptradd(data, json_offset) as ref void, json_len as usize)
    @store8(@ptradd(json_buf, json_len as usize), 0)

    val bin_header_offset: usize = json_end
    if bin_header_offset + (8 as usize) > len {
        @free(json_buf as ref void)
        return none
    }

    val bin_len: u32 = read_u32_le(data, bin_header_offset)
    val bin_type: u32 = read_u32_le(data, bin_header_offset + (4 as usize))
    if bin_type != GLB_BIN_CHUNK {
        @free(json_buf as ref void)
        return none
    }

    if json.parse(json_buf) is some doc {
        val root: ref void = json.doc_root(doc)
        val model: mut ecs.GlbModel = ecs.empty_model()
        model.valid = true
        model.byte_length = total_len as usize
        model.json_length = json_len as usize
        model.bin_length = bin_len as usize
        model.mesh_name = dup_cstr("embedded-glb")

        if json.obj_get(root, "meshes") is some meshes {
            if json.arr_get(meshes, 0 as usize) is some mesh {
                if json.obj_get_str(mesh, "name") is some mesh_name {
                    model.mesh_name = dup_cstr(mesh_name)
                }
                if json.obj_get(mesh, "primitives") is some primitives {
                    model.primitive_count = json.arr_len(primitives) as i32
                    if json.arr_get(primitives, 0 as usize) is some primitive {
                        if json.obj_get(primitive, "attributes") is some attributes {
                            if json.obj_get(root, "accessors") is some accessors {
                                if json.obj_get_int(attributes, "POSITION") is some pos_accessor {
                                    model.vertex_count = parse_accessor_count(accessors, pos_accessor)
                                }
                                if json.obj_get_int(primitive, "indices") is some idx_accessor {
                                    model.index_count = parse_accessor_count(accessors, idx_accessor)
                                }
                            }
                            if json.obj_get_int(attributes, "NORMAL") is some _ {
                                model.has_normals = true
                            }
                            if json.obj_get_int(attributes, "TEXCOORD_0") is some _ {
                                model.has_uvs = true
                            }
                        }
                    }
                }
            }
        }

        json.doc_free(doc)
        @free(json_buf as ref void)
        return some model
    }

    @free(json_buf as ref void)
    return none
}

pub fn load_glb(path: ref u8) option[ecs.GlbModel] = trust {
    val file: ref void = fopen(path, "rb")
    if file == none {
        return none
    }

    fseek(file, 0, 2 as i32)
    val size: i64 = ftell(file)
    rewind(file)
    if size <= 0 {
        fclose(file)
        return none
    }

    val buf: ref u8 = @alloc((size as usize) + 1) as ref u8
    if buf == none {
        fclose(file)
        return none
    }
    fread(buf as ref void, 1 as usize, size as usize, file)
    @store8(@ptradd(buf, size as usize), 0)
    fclose(file)

    val model = parse_glb_bytes(buf, size as usize)
    @free(buf as ref void)
    return model
}

pub fn build_test_glb_fixture() GlbFixture = trust {
    val json_chunk: ref u8 = \\{"asset":{"version":"2.0"},"buffers":[{"byteLength":36}],"bufferViews":[{"buffer":0,"byteOffset":0,"byteLength":36}],"accessors":[{"bufferView":0,"componentType":5126,"count":3,"type":"VEC3"}],"meshes":[{"name":"fixture","primitives":[{"attributes":{"POSITION":0}}]}]}
    val json_len_raw: usize = strlen(json_chunk)
    val json_len: usize = ((json_len_raw + (3 as usize)) / (4 as usize)) * (4 as usize)
    val bin_len: usize = 36 as usize
    val total_len: usize = (12 as usize) + (8 as usize) + json_len + (8 as usize) + bin_len
    val ptr: ref u8 = @alloc(total_len + (1 as usize)) as ref u8
    @memset(ptr as ref void, 0, total_len + (1 as usize))

    write_u32_le(ptr, 0 as usize, GLB_MAGIC)
    write_u32_le(ptr, 4 as usize, GLB_VERSION)
    write_u32_le(ptr, 8 as usize, total_len as u32)
    write_u32_le(ptr, 12 as usize, json_len as u32)
    write_u32_le(ptr, 16 as usize, GLB_JSON_CHUNK)
    @memcpy(@ptradd(ptr, 20 as usize) as ref void, json_chunk as ref void, json_len_raw)

    val bin_header: usize = (20 as usize) + json_len
    write_u32_le(ptr, bin_header, bin_len as u32)
    write_u32_le(ptr, bin_header + (4 as usize), GLB_BIN_CHUNK)
    @store8(@ptradd(ptr, total_len), 0)

    return {
        ptr: ptr,
        len: total_len
    }
}

pub fn load_embedded_fixture_model() ecs.GlbModel = trust {
    val fixture: mut GlbFixture = build_test_glb_fixture()
    if parse_glb_bytes(fixture.ptr, fixture.len) is some model {
        @free(fixture.ptr as ref void)
        return model
    }
    @free(fixture.ptr as ref void)
    return ecs.empty_model()
}

fn dump_shader_log(shader: u32) void = trust {
    val log: ref u8 = @alloc(2048 as usize) as ref u8
    if log == none { return }
    @memset(log as ref void, 0, 2048 as usize)
    gl_get_shader_info_log(shader, 2047 as i32, none as ref i32, log)
    stdio.eputs(log)
    @free(log as ref void)
}

fn dump_program_log(program: u32) void = trust {
    val log: ref u8 = @alloc(2048 as usize) as ref u8
    if log == none { return }
    @memset(log as ref void, 0, 2048 as usize)
    gl_get_program_info_log(program, 2047 as i32, none as ref i32, log)
    stdio.eputs(log)
    @free(log as ref void)
}

fn compile_shader(stage: u32, source: ref u8) u32 = trust {
    val shader: u32 = gl_create_shader(stage)
    val src: mut ref u8 = source
    gl_shader_source(shader, 1 as i32, @addr(src), none as ref i32)
    gl_compile_shader(shader)

    val its_ok: mut i32 = 0
    gl_get_shaderiv(shader, GL_COMPILE_STATUS, @addr(its_ok))
    if its_ok == 0 {
        dump_shader_log(shader)
        gl_delete_shader(shader)
        return 0 as u32
    }

    return shader
}

fn link_program(vertex_source: ref u8, fragment_source: ref u8) u32 = trust {
    val vs: u32 = compile_shader(GL_VERTEX_SHADER, vertex_source)
    if vs == 0 as u32 {
        return 0 as u32
    }

    val fs: u32 = compile_shader(GL_FRAGMENT_SHADER, fragment_source)
    if fs == 0 as u32 {
        gl_delete_shader(vs)
        return 0 as u32
    }

    val program: u32 = gl_create_program()
    gl_attach_shader(program, vs)
    gl_attach_shader(program, fs)
    gl_link_program(program)
    gl_delete_shader(vs)
    gl_delete_shader(fs)

    val its_ok: mut i32 = 0
    gl_get_programiv(program, GL_LINK_STATUS, @addr(its_ok))
    if its_ok == 0 {
        dump_program_log(program)
        gl_delete_program(program)
        return 0 as u32
    }

    return program
}

fn set_uniform_vec3(program: u32, name: ref u8, value: ecs.Vec3) void = trust {
    val location: i32 = gl_get_uniform_location(program, name)
    if location >= 0 {
        gl_uniform3f(location, value.x, value.y, value.z)
    }
}

fn set_uniform_f32(program: u32, name: ref u8, value: f32) void = trust {
    val location: i32 = gl_get_uniform_location(program, name)
    if location >= 0 {
        gl_uniform1f(location, value)
    }
}

fn set_uniform_i32(program: u32, name: ref u8, value: i32) void = trust {
    val location: i32 = gl_get_uniform_location(program, name)
    if location >= 0 {
        gl_uniform1i(location, value)
    }
}

fn set_uniform_vec2(program: u32, name: ref u8, x: f32, y: f32) void = trust {
    val location: i32 = gl_get_uniform_location(program, name)
    if location >= 0 {
        gl_uniform2f(location, x, y)
    }
}

fn set_uniform_mat4(program: u32, name: ref u8, value: Mat4) void = trust {
    val location: i32 = gl_get_uniform_location(program, name)
    if location >= 0 {
        gl_uniform_matrix4fv(location, 1 as i32, 1 as u8, @addr(value.m00))
    }
}

fn store_f32(base: ref void, index: usize, value: f32) void = trust {
    val slot: mut ref F32Slot = @ptradd(base, index * (@sizeof(f32) as usize)) as mut ref F32Slot
    slot.value = value
}

fn store_u32(base: ref void, index: usize, value: u32) void = trust {
    val slot: mut ref U32Slot = @ptradd(base, index * (@sizeof(u32) as usize)) as mut ref U32Slot
    slot.value = value
}

fn write_vertex(base: ref void, vertex_index: usize, position: ecs.Vec3, normal: ecs.Vec3) void = trust {
    val offset: usize = vertex_index * (6 as usize)
    store_f32(base, offset + (0 as usize), position.x)
    store_f32(base, offset + (1 as usize), position.y)
    store_f32(base, offset + (2 as usize), position.z)
    store_f32(base, offset + (3 as usize), normal.x)
    store_f32(base, offset + (4 as usize), normal.y)
    store_f32(base, offset + (5 as usize), normal.z)
}

fn upload_mesh(vertices: ref void, vertex_float_count: usize, indices: ref void, index_count: i32) MeshGPU = trust {
    val mesh: mut MeshGPU = {
        vao: 0 as u32,
        vbo: 0 as u32,
        ebo: 0 as u32,
        index_count: index_count
    }

    gl_gen_vertex_arrays(1 as i32, @addr(mesh.vao))
    gl_gen_buffers(1 as i32, @addr(mesh.vbo))
    gl_gen_buffers(1 as i32, @addr(mesh.ebo))

    gl_bind_vertex_array(mesh.vao)
    gl_bind_buffer(GL_ARRAY_BUFFER, mesh.vbo)
    gl_buffer_data(
        GL_ARRAY_BUFFER,
        (vertex_float_count * (@sizeof(f32) as usize)) as i64,
        vertices,
        GL_STATIC_DRAW
    )
    gl_bind_buffer(GL_ELEMENT_ARRAY_BUFFER, mesh.ebo)
    gl_buffer_data(
        GL_ELEMENT_ARRAY_BUFFER,
        ((index_count as usize) * (@sizeof(u32) as usize)) as i64,
        indices,
        GL_STATIC_DRAW
    )

    gl_enable_vertex_attrib_array(0 as u32)
    gl_vertex_attrib_pointer(
        0 as u32,
        3 as i32,
        GL_FLOAT,
        GL_FALSE,
        (6 * (@sizeof(f32) as i32)),
        none as ref void
    )
    gl_enable_vertex_attrib_array(1 as u32)
    gl_vertex_attrib_pointer(
        1 as u32,
        3 as i32,
        GL_FLOAT,
        GL_FALSE,
        (6 * (@sizeof(f32) as i32)),
        @ptradd(none as ref void, 3 * (@sizeof(f32) as usize)) as ref void
    )

    gl_bind_vertex_array(0 as u32)
    return mesh
}

fn destroy_mesh(mesh: MeshGPU) void = trust {
    if mesh.ebo != 0 as u32 {
        gl_delete_buffers(1 as i32, @addr(mesh.ebo))
    }
    if mesh.vbo != 0 as u32 {
        gl_delete_buffers(1 as i32, @addr(mesh.vbo))
    }
    if mesh.vao != 0 as u32 {
        gl_delete_vertex_arrays(1 as i32, @addr(mesh.vao))
    }
}

fn render_target_valid(target: RenderTarget) bool = {
    return target.framebuffer != 0 as u32 &&
           target.color_texture != 0 as u32 &&
           target.depth_rbo != 0 as u32
}

fn destroy_render_target(target: RenderTarget) void = trust {
    if target.depth_rbo != 0 as u32 {
        gl_delete_renderbuffers(1 as i32, @addr(target.depth_rbo))
    }
    if target.color_texture != 0 as u32 {
        gl_delete_textures(1 as i32, @addr(target.color_texture))
    }
    if target.framebuffer != 0 as u32 {
        gl_delete_framebuffers(1 as i32, @addr(target.framebuffer))
    }
}

fn create_render_target(width: i32, height: i32) RenderTarget = trust {
    val target: mut RenderTarget = {
        framebuffer: 0 as u32,
        color_texture: 0 as u32,
        depth_rbo: 0 as u32,
        width: width,
        height: height
    }

    gl_gen_framebuffers(1 as i32, @addr(target.framebuffer))
    gl_bind_framebuffer(GL_FRAMEBUFFER, target.framebuffer)

    gl_gen_textures(1 as i32, @addr(target.color_texture))
    gl_bind_texture(GL_TEXTURE_2D, target.color_texture)
    gl_tex_image_2d(GL_TEXTURE_2D, 0 as i32, GL_RGBA16F as i32, width, height, 0 as i32, GL_RGBA, GL_FLOAT, none as ref void)
    gl_tex_parameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR as i32)
    gl_tex_parameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR as i32)
    gl_tex_parameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE as i32)
    gl_tex_parameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE as i32)
    gl_framebuffer_texture_2d(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, target.color_texture, 0 as i32)

    gl_gen_renderbuffers(1 as i32, @addr(target.depth_rbo))
    gl_bind_renderbuffer(GL_RENDERBUFFER, target.depth_rbo)
    gl_renderbuffer_storage(GL_RENDERBUFFER, GL_DEPTH_COMPONENT24, width, height)
    gl_framebuffer_renderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, target.depth_rbo)

    if gl_check_framebuffer_status(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE {
        gl_bind_framebuffer(GL_FRAMEBUFFER, 0 as u32)
        destroy_render_target(target)
        return {
            framebuffer: 0 as u32,
            color_texture: 0 as u32,
            depth_rbo: 0 as u32,
            width: width,
            height: height
        }
    }

    gl_bind_framebuffer(GL_FRAMEBUFFER, 0 as u32)
    gl_bind_texture(GL_TEXTURE_2D, 0 as u32)
    gl_bind_renderbuffer(GL_RENDERBUFFER, 0 as u32)
    return target
}

fn create_post_vao() u32 = trust {
    val vao: mut u32 = 0 as u32
    gl_gen_vertex_arrays(1 as i32, @addr(vao))
    return vao
}

fn cube_face(
    vertices: ref void,
    indices: ref void,
    face_index: i32,
    p0: ecs.Vec3,
    p1: ecs.Vec3,
    p2: ecs.Vec3,
    p3: ecs.Vec3,
    normal: ecs.Vec3
) void = trust {
    val base_vertex: usize = (face_index as usize) * (4 as usize)
    val base_index: usize = (face_index as usize) * (6 as usize)
    write_vertex(vertices, base_vertex + (0 as usize), p0, normal)
    write_vertex(vertices, base_vertex + (1 as usize), p1, normal)
    write_vertex(vertices, base_vertex + (2 as usize), p2, normal)
    write_vertex(vertices, base_vertex + (3 as usize), p3, normal)

    store_u32(indices, base_index + (0 as usize), (base_vertex + (0 as usize)) as u32)
    store_u32(indices, base_index + (1 as usize), (base_vertex + (1 as usize)) as u32)
    store_u32(indices, base_index + (2 as usize), (base_vertex + (2 as usize)) as u32)
    store_u32(indices, base_index + (3 as usize), (base_vertex + (0 as usize)) as u32)
    store_u32(indices, base_index + (4 as usize), (base_vertex + (2 as usize)) as u32)
    store_u32(indices, base_index + (5 as usize), (base_vertex + (3 as usize)) as u32)
}

fn build_cube_mesh() MeshGPU = trust {
    val vertex_float_count: usize = 24 as usize * 6 as usize
    val index_count: i32 = 36 as i32
    val vertices: ref void = @alloc(vertex_float_count * (@sizeof(f32) as usize))
    val indices: ref void = @alloc((index_count as usize) * (@sizeof(u32) as usize))
    if vertices == none || indices == none {
        if vertices != none { @free(vertices) }
        if indices != none { @free(indices) }
        return {
            vao: 0 as u32,
            vbo: 0 as u32,
            ebo: 0 as u32,
            index_count: 0 as i32
        }
    }

    cube_face(
        vertices, indices, 0 as i32,
        vec3(-0.5 as f32, -0.5 as f32, 0.5 as f32),
        vec3(0.5 as f32, -0.5 as f32, 0.5 as f32),
        vec3(0.5 as f32, 0.5 as f32, 0.5 as f32),
        vec3(-0.5 as f32, 0.5 as f32, 0.5 as f32),
        vec3(0.0 as f32, 0.0 as f32, 1.0 as f32)
    )
    cube_face(
        vertices, indices, 1 as i32,
        vec3(0.5 as f32, -0.5 as f32, -0.5 as f32),
        vec3(-0.5 as f32, -0.5 as f32, -0.5 as f32),
        vec3(-0.5 as f32, 0.5 as f32, -0.5 as f32),
        vec3(0.5 as f32, 0.5 as f32, -0.5 as f32),
        vec3(0.0 as f32, 0.0 as f32, -1.0 as f32)
    )
    cube_face(
        vertices, indices, 2 as i32,
        vec3(-0.5 as f32, -0.5 as f32, -0.5 as f32),
        vec3(-0.5 as f32, -0.5 as f32, 0.5 as f32),
        vec3(-0.5 as f32, 0.5 as f32, 0.5 as f32),
        vec3(-0.5 as f32, 0.5 as f32, -0.5 as f32),
        vec3(-1.0 as f32, 0.0 as f32, 0.0 as f32)
    )
    cube_face(
        vertices, indices, 3 as i32,
        vec3(0.5 as f32, -0.5 as f32, 0.5 as f32),
        vec3(0.5 as f32, -0.5 as f32, -0.5 as f32),
        vec3(0.5 as f32, 0.5 as f32, -0.5 as f32),
        vec3(0.5 as f32, 0.5 as f32, 0.5 as f32),
        vec3(1.0 as f32, 0.0 as f32, 0.0 as f32)
    )
    cube_face(
        vertices, indices, 4 as i32,
        vec3(-0.5 as f32, 0.5 as f32, 0.5 as f32),
        vec3(0.5 as f32, 0.5 as f32, 0.5 as f32),
        vec3(0.5 as f32, 0.5 as f32, -0.5 as f32),
        vec3(-0.5 as f32, 0.5 as f32, -0.5 as f32),
        vec3(0.0 as f32, 1.0 as f32, 0.0 as f32)
    )
    cube_face(
        vertices, indices, 5 as i32,
        vec3(-0.5 as f32, -0.5 as f32, -0.5 as f32),
        vec3(0.5 as f32, -0.5 as f32, -0.5 as f32),
        vec3(0.5 as f32, -0.5 as f32, 0.5 as f32),
        vec3(-0.5 as f32, -0.5 as f32, 0.5 as f32),
        vec3(0.0 as f32, -1.0 as f32, 0.0 as f32)
    )

    val mesh: MeshGPU = upload_mesh(vertices, vertex_float_count, indices, index_count)
    @free(vertices)
    @free(indices)
    return mesh
}

fn build_sphere_mesh(lat_segments: i32, lon_segments: i32) MeshGPU = trust {
    val vertex_count: i32 = (lat_segments + 1) * (lon_segments + 1)
    val index_count: i32 = lat_segments * lon_segments * 6
    val vertex_float_count: usize = (vertex_count as usize) * (6 as usize)
    val vertices: ref void = @alloc(vertex_float_count * (@sizeof(f32) as usize))
    val indices: ref void = @alloc((index_count as usize) * (@sizeof(u32) as usize))
    if vertices == none || indices == none {
        if vertices != none { @free(vertices) }
        if indices != none { @free(indices) }
        return {
            vao: 0 as u32,
            vbo: 0 as u32,
            ebo: 0 as u32,
            index_count: 0 as i32
        }
    }

    for (iy = 0; iy <= lat_segments; iy++) {
        val v: f32 = (iy as f32) / (lat_segments as f32)
        val theta: f64 = (v as f64) * mstat.PI
        val y: f32 = math.cos(theta) as f32
        val ring_r: f32 = math.sin(theta) as f32

        for (ix = 0; ix <= lon_segments; ix++) {
            val u: f32 = (ix as f32) / (lon_segments as f32)
            val phi: f64 = (u as f64) * ((2.0 as f64) * mstat.PI)
            val x: f32 = (math.cos(phi) as f32) * ring_r
            val z: f32 = (math.sin(phi) as f32) * ring_r
            val normal: ecs.Vec3 = vec3(x, y, z)
            val vertex_index: usize = ((iy * (lon_segments + 1)) + ix) as usize
            write_vertex(vertices, vertex_index, normal, normal)
        }
    }

    val row_stride: i32 = lon_segments + 1
    for (face_y = 0; face_y < lat_segments; face_y++) {
        for (face_x = 0; face_x < lon_segments; face_x++) {
            val a: u32 = ((face_y * row_stride) + face_x) as u32
            val b: u32 = (((face_y + 1) * row_stride) + face_x) as u32
            val c: u32 = a + 1
            val d: u32 = b + 1
            val index_base: usize = (((face_y * lon_segments) + face_x) * 6) as usize
            store_u32(indices, index_base + (0 as usize), a)
            store_u32(indices, index_base + (1 as usize), b)
            store_u32(indices, index_base + (2 as usize), c)
            store_u32(indices, index_base + (3 as usize), c)
            store_u32(indices, index_base + (4 as usize), b)
            store_u32(indices, index_base + (5 as usize), d)
        }
    }

    val mesh: MeshGPU = upload_mesh(vertices, vertex_float_count, indices, index_count)
    @free(vertices)
    @free(indices)
    return mesh
}

fn build_quad_mesh() MeshGPU = trust {
    val vertex_float_count: usize = (4 as usize) * (6 as usize)
    val index_count: i32 = 6 as i32
    val vertices: ref void = @alloc(vertex_float_count * (@sizeof(f32) as usize))
    val indices: ref void = @alloc((index_count as usize) * (@sizeof(u32) as usize))
    if vertices == none || indices == none {
        if vertices != none { @free(vertices) }
        if indices != none { @free(indices) }
        return { vao: 0 as u32, vbo: 0 as u32, ebo: 0 as u32, index_count: 0 as i32 }
    }
    val n: ecs.Vec3 = vec3(0.0 as f32, 0.0 as f32, 1.0 as f32)
    write_vertex(vertices, 0 as usize, vec3(-0.5 as f32, -0.5 as f32, 0.0 as f32), n)
    write_vertex(vertices, 1 as usize, vec3( 0.5 as f32, -0.5 as f32, 0.0 as f32), n)
    write_vertex(vertices, 2 as usize, vec3( 0.5 as f32,  0.5 as f32, 0.0 as f32), n)
    write_vertex(vertices, 3 as usize, vec3(-0.5 as f32,  0.5 as f32, 0.0 as f32), n)
    store_u32(indices, 0 as usize, 0 as u32)
    store_u32(indices, 1 as usize, 1 as u32)
    store_u32(indices, 2 as usize, 2 as u32)
    store_u32(indices, 3 as usize, 0 as u32)
    store_u32(indices, 4 as usize, 2 as u32)
    store_u32(indices, 5 as usize, 3 as u32)
    val mesh: MeshGPU = upload_mesh(vertices, vertex_float_count, indices, index_count)
    @free(vertices)
    @free(indices)
    return mesh
}

fn mesh_valid(mesh: MeshGPU) bool = {
    return mesh.vao != 0 as u32 && mesh.index_count > 0
}

fn camera_forward(camera: Camera) ecs.Vec3 = {
    val yaw_f64: f64 = camera.yaw as f64
    val pitch_f64: f64 = camera.pitch as f64
    val cp: f32 = (math.cos(pitch_f64)) as f32
    return vec3(
        (math.sin(yaw_f64) as f32) * cp,
        (math.sin(pitch_f64)) as f32,
        (math.cos(yaw_f64) as f32) * cp
    )
}

fn update_camera(camera: mut Camera, dt: f32, keys: ref u8) void = trust {
    val yaw_step: f32 = camera.turn_speed * dt
    val move_step: f32 = camera.move_speed * dt

    val key_w: u8 = @load8(@ptradd(keys, SDL_SCANCODE_W as usize))
    val key_a: u8 = @load8(@ptradd(keys, SDL_SCANCODE_A as usize))
    val key_s: u8 = @load8(@ptradd(keys, SDL_SCANCODE_S as usize))
    val key_d: u8 = @load8(@ptradd(keys, SDL_SCANCODE_D as usize))
    val key_left: u8 = @load8(@ptradd(keys, SDL_SCANCODE_LEFT as usize))
    val key_right: u8 = @load8(@ptradd(keys, SDL_SCANCODE_RIGHT as usize))
    val key_up: u8 = @load8(@ptradd(keys, SDL_SCANCODE_UP as usize))
    val key_down: u8 = @load8(@ptradd(keys, SDL_SCANCODE_DOWN as usize))

    if key_left != 0 {
        camera.yaw = camera.yaw + yaw_step
    }
    if key_right != 0 {
        camera.yaw = camera.yaw - yaw_step
    }
    if key_up != 0 {
        camera.pitch = camera.pitch + yaw_step * (0.70 as f32)
    }
    if key_down != 0 {
        camera.pitch = camera.pitch - yaw_step * (0.70 as f32)
    }

    if camera.pitch > (1.2 as f32) {
        camera.pitch = 1.2 as f32
    }
    if camera.pitch < (-1.2 as f32) {
        camera.pitch = -1.2 as f32
    }

    val forward: ecs.Vec3 = camera_forward(camera)
    val flat_forward: ecs.Vec3 = vec3_normalize(vec3(forward.x, 0.0 as f32, forward.z))
    val right: ecs.Vec3 = vec3_normalize(vec3(-flat_forward.z, 0.0 as f32, flat_forward.x))

    if key_w != 0 {
        camera.position = vec3_add(camera.position, vec3_scale(flat_forward, move_step))
    }
    if key_s != 0 {
        camera.position = vec3_sub(camera.position, vec3_scale(flat_forward, move_step))
    }
    if key_a != 0 {
        camera.position = vec3_sub(camera.position, vec3_scale(right, move_step))
    }
    if key_d != 0 {
        camera.position = vec3_add(camera.position, vec3_scale(right, move_step))
    }
}

val SCENE_VERTEX_SHADER: ref u8 = \\
\\ #version 330 core
\\ layout(location = 0) in vec3 aPosition;
\\ layout(location = 1) in vec3 aNormal;
\\ uniform mat4 uModel;
\\ uniform mat4 uViewProj;
\\ out vec3 vWorldPos;
\\ out vec3 vWorldNormal;
\\ void main() {
\\     vec4 world = uModel * vec4(aPosition, 1.0);
\\     vWorldPos = world.xyz;
\\     vWorldNormal = normalize((uModel * vec4(aNormal, 0.0)).xyz);
\\     gl_Position = uViewProj * world;
\\ }

val SCENE_FRAGMENT_SHADER: ref u8 = \\
\\ #version 330 core
\\ in vec3 vWorldPos;
\\ in vec3 vWorldNormal;
\\ out vec4 FragColor;
\\ uniform vec3 uColor;
\\ uniform vec3 uCameraPos;
\\ uniform float uReflective;
\\ uniform float uGlow;
\\ uniform float uAlpha;
\\ uniform vec3 uLightPos;
\\ uniform vec3 uLightColor;
\\ uniform float uLightIntensity;
\\ uniform float uLightRadius;
\\ vec3 sky_color(vec3 d) {
\\     float t = clamp(d.y * 0.5 + 0.5, 0.0, 1.0);
\\     return mix(vec3(0.05, 0.08, 0.14), vec3(0.26, 0.48, 0.84), t);
\\ }
\\ void main() {
\\     vec3 n = normalize(vWorldNormal);
\\     vec3 view_dir = normalize(uCameraPos - vWorldPos);
\\     vec3 light_dir = normalize(vec3(-0.50, 0.82, 0.28));
\\     float diff = max(dot(n, light_dir), 0.0);
\\     float hemi = n.y * 0.5 + 0.5;
\\     vec3 half_vec = normalize(light_dir + view_dir);
\\     float spec = pow(max(dot(n, half_vec), 0.0), 36.0);
\\     vec3 ambient = mix(vec3(0.07, 0.09, 0.13), sky_color(vec3(0.0, hemi * 2.0 - 1.0, 0.0)) * 0.28, hemi);
\\     vec3 base = uColor * (0.30 + diff * 0.68) + ambient * 0.35;
\\     vec3 highlight = vec3(1.0, 0.98, 0.94) * spec * (0.06 + uReflective * 0.12);
\\     vec3 glow = uColor * uGlow * 0.10;
\\     vec3 to_light = uLightPos - vWorldPos;
\\     float dist = length(to_light);
\\     float att = 1.0 / (1.0 + (dist * dist) / (uLightRadius * uLightRadius));
\\     vec3 pl_dir = normalize(to_light);
\\     float pdiff = max(dot(n, pl_dir), 0.0);
\\     vec3 phalf = normalize(pl_dir + view_dir);
\\     float pspec = pow(max(dot(n, phalf), 0.0), 48.0);
\\     vec3 point_contrib = uLightColor * uLightIntensity * att * (uColor * pdiff * 0.55 + vec3(1.0, 0.98, 0.96) * pspec * (0.08 + uReflective * 0.14));
\\     FragColor = vec4(base + highlight + glow + point_contrib, uAlpha);
\\ }

val FLOOR_VERTEX_SHADER: ref u8 = \\
\\ #version 330 core
\\ layout(location = 0) in vec3 aPosition;
\\ layout(location = 1) in vec3 aNormal;
\\ uniform mat4 uModel;
\\ uniform mat4 uViewProj;
\\ uniform mat4 uReflectViewProj;
\\ out vec3 vWorldPos;
\\ out vec3 vWorldNormal;
\\ out vec4 vReflectClip;
\\ void main() {
\\     vec4 world = uModel * vec4(aPosition, 1.0);
\\     vWorldPos = world.xyz;
\\     vWorldNormal = normalize((uModel * vec4(aNormal, 0.0)).xyz);
\\     vReflectClip = uReflectViewProj * world;
\\     gl_Position = uViewProj * world;
\\ }

val FLOOR_FRAGMENT_SHADER: ref u8 = \\
\\ #version 330 core
\\ in vec3 vWorldPos;
\\ in vec3 vWorldNormal;
\\ in vec4 vReflectClip;
\\ out vec4 FragColor;
\\ uniform sampler2D uReflectionTex;
\\ uniform vec3 uCameraPos;
\\ vec3 sky_color(vec3 d) {
\\     float t = clamp(d.y * 0.5 + 0.5, 0.0, 1.0);
\\     return mix(vec3(0.05, 0.08, 0.14), vec3(0.26, 0.48, 0.84), t);
\\ }
\\ void main() {
\\     vec3 n = normalize(vWorldNormal);
\\     vec3 view_dir = normalize(uCameraPos - vWorldPos);
\\     vec2 uv = vReflectClip.xy / max(vReflectClip.w, 0.0001);
\\     uv = uv * 0.5 + 0.5;
\\     vec3 reflection = sky_color(reflect(-view_dir, n));
\\     if (uv.x >= 0.0 && uv.x <= 1.0 && uv.y >= 0.0 && uv.y <= 1.0) {
\\         reflection = texture(uReflectionTex, uv).rgb;
\\     }
\\     float fresnel = pow(1.0 - max(dot(view_dir, n), 0.0), 5.0);
\\     vec3 tint = vec3(0.03, 0.06, 0.08);
\\     vec3 color = mix(tint, reflection, 0.42 + fresnel * 0.36);
\\     vec3 highlight = vec3(1.0, 0.98, 0.95) * pow(max(dot(reflect(-view_dir, n), vec3(0.0, 1.0, 0.0)), 0.0), 18.0) * 0.04;
\\     FragColor = vec4(color + highlight, 0.58);
\\ }

val POST_VERTEX_SHADER: ref u8 = \\
\\ #version 330 core
\\ out vec2 vUv;
\\ void main() {
\\     vec2 pos;
\\     if (gl_VertexID == 0) {
\\         pos = vec2(-1.0, -1.0);
\\     } else if (gl_VertexID == 1) {
\\         pos = vec2(3.0, -1.0);
\\     } else {
\\         pos = vec2(-1.0, 3.0);
\\     }
\\     vUv = pos * 0.5 + 0.5;
\\     gl_Position = vec4(pos, 0.0, 1.0);
\\ }

val POST_FRAGMENT_SHADER: ref u8 = \\
\\ #version 330 core
\\ in vec2 vUv;
\\ out vec4 FragColor;
\\ uniform sampler2D uSceneTex;
\\ uniform vec2 uTexelSize;
\\ uniform float uExposure;
\\ vec3 bright_sample(vec2 uv) {
\\     vec3 c = texture(uSceneTex, uv).rgb;
\\     float m = max(max(c.r, c.g), c.b);
\\     float gain = max(m - 1.15, 0.0);
\\     return c * gain * 0.65;
\\ }
\\ void main() {
\\     vec3 scene = texture(uSceneTex, vUv).rgb;
\\     vec2 tx = uTexelSize;
\\     vec3 bloom = bright_sample(vUv) * 0.10;
\\     bloom += bright_sample(vUv + vec2(tx.x * 2.0, 0.0)) * 0.07;
\\     bloom += bright_sample(vUv - vec2(tx.x * 2.0, 0.0)) * 0.07;
\\     bloom += bright_sample(vUv + vec2(0.0, tx.y * 2.0)) * 0.07;
\\     bloom += bright_sample(vUv - vec2(0.0, tx.y * 2.0)) * 0.07;
\\     bloom += bright_sample(vUv + vec2(tx.x * 3.0, tx.y * 3.0)) * 0.05;
\\     bloom += bright_sample(vUv + vec2(-tx.x * 3.0, tx.y * 3.0)) * 0.05;
\\     bloom += bright_sample(vUv + vec2(tx.x * 3.0, -tx.y * 3.0)) * 0.05;
\\     bloom += bright_sample(vUv + vec2(-tx.x * 3.0, -tx.y * 3.0)) * 0.05;
\\     vec3 hdr = scene + bloom;
\\     vec3 mapped = vec3(1.0) - exp(-hdr * uExposure);
\\     mapped = pow(mapped, vec3(1.0 / 2.2));
\\     FragColor = vec4(mapped, 1.0);
\\ }

val GLOW_VERTEX_SHADER: ref u8 = \\
\\ #version 330 core
\\ layout(location = 0) in vec3 aPosition;
\\ layout(location = 1) in vec3 aNormal;
\\ uniform mat4 uViewProj;
\\ uniform vec3 uBillboardPos;
\\ uniform vec2 uBillboardSize;
\\ uniform vec3 uCameraRight;
\\ uniform vec3 uCameraUp;
\\ out vec3 vLocalPos;
\\ void main() {
\\     vLocalPos = aPosition;
\\     vec3 world_pos = uBillboardPos
\\         + uCameraRight * (aPosition.x * uBillboardSize.x)
\\         + uCameraUp    * (aPosition.y * uBillboardSize.y);
\\     gl_Position = uViewProj * vec4(world_pos, 1.0);
\\ }

val GLOW_FRAGMENT_SHADER: ref u8 = \\
\\ #version 330 core
\\ in vec3 vLocalPos;
\\ out vec4 FragColor;
\\ uniform vec3 uGlowColor;
\\ uniform float uGlowIntensity;
\\ uniform float uAlpha;
\\ void main() {
\\     float r = length(vLocalPos.xy) * 2.0;
\\     float fade = pow(max(1.0 - r, 0.0), 2.0);
\\     FragColor = vec4(uGlowColor * uGlowIntensity, uAlpha * fade);
\\ }

fn model_matrix_scaled(position: ecs.Vec3, scale: ecs.Vec3, rotation_y: f32) Mat4 = {
    return mat_mul(
        mat_translation(position),
        mat_mul(
            mat_rotation_y(rotation_y),
            mat_scale(scale)
        )
    )
}

fn model_matrix(position: ecs.Vec3, uniform_scale: f32, rotation_y: f32) Mat4 = {
    return model_matrix_scaled(position, vec3(uniform_scale, uniform_scale, uniform_scale), rotation_y)
}

fn reflect_position_y(position: ecs.Vec3, plane_y: f32) ecs.Vec3 = {
    return vec3(position.x, ((2.0 as f32) * plane_y) - position.y, position.z)
}

fn mirrored_camera(camera: Camera, plane_y: f32) Camera = {
    return {
        position: reflect_position_y(camera.position, plane_y),
        yaw: camera.yaw,
        pitch: -camera.pitch,
        move_speed: camera.move_speed,
        turn_speed: camera.turn_speed
    }
}

fn view_projection(camera: Camera, width: i32, height: i32) Mat4 = {
    val aspect: f32 = (width as f32) / (height as f32)
    val projection: Mat4 = mat_perspective((60.0 as f32) * ((mstat.PI as f32) / (180.0 as f32)), aspect, 0.1 as f32, 100.0 as f32)
    val center: ecs.Vec3 = vec3_add(camera.position, camera_forward(camera))
    val view: Mat4 = mat_look_at(camera.position, center, vec3(0.0 as f32, 1.0 as f32, 0.0 as f32))
    return mat_mul(projection, view)
}

fn draw_mesh(program: u32, mesh: MeshGPU, model: Mat4, view_proj: Mat4, color: ecs.Vec3, camera_pos: ecs.Vec3, reflective: f32, glow: f32, alpha: f32, light: ecs.PointLight) void = trust {
    set_uniform_mat4(program, "uModel", model)
    set_uniform_mat4(program, "uViewProj", view_proj)
    set_uniform_vec3(program, "uColor", color)
    set_uniform_vec3(program, "uCameraPos", camera_pos)
    set_uniform_f32(program, "uReflective", reflective)
    set_uniform_f32(program, "uGlow", glow)
    set_uniform_f32(program, "uAlpha", alpha)
    set_uniform_vec3(program, "uLightPos", light.position)
    set_uniform_vec3(program, "uLightColor", light.color)
    set_uniform_f32(program, "uLightIntensity", light.intensity)
    set_uniform_f32(program, "uLightRadius", light.radius)
    gl_bind_vertex_array(mesh.vao)
    gl_draw_elements(GL_TRIANGLES, mesh.index_count, GL_UNSIGNED_INT, none as ref void)
}

fn draw_billboard(program: u32, mesh: MeshGPU, pos: ecs.Vec3, width: f32, height: f32, view_proj: Mat4, cam_right: ecs.Vec3, cam_up: ecs.Vec3, color: ecs.Vec3, intensity: f32, alpha: f32) void = trust {
    set_uniform_mat4(program, "uViewProj", view_proj)
    set_uniform_vec3(program, "uBillboardPos", pos)
    set_uniform_vec2(program, "uBillboardSize", width, height)
    set_uniform_vec3(program, "uCameraRight", cam_right)
    set_uniform_vec3(program, "uCameraUp", cam_up)
    set_uniform_vec3(program, "uGlowColor", color)
    set_uniform_f32(program, "uGlowIntensity", intensity)
    set_uniform_f32(program, "uAlpha", alpha)
    gl_bind_vertex_array(mesh.vao)
    gl_draw_elements(GL_TRIANGLES, mesh.index_count, GL_UNSIGNED_INT, none as ref void)
    gl_bind_vertex_array(0 as u32)
}

fn draw_demo_cubes(program: u32, cube_mesh: MeshGPU, scene: ecs.Scene3D, camera: Camera, view_proj: Mat4, time: f32, glow_scale: f32) void = trust {
    draw_mesh(
        program,
        cube_mesh,
        model_matrix(scene.cube0.position, scene.cube0.size, time * scene.cube0.rotation_speed),
        view_proj,
        scene.cube0.color,
        camera.position,
        0.08 as f32,
        glow_scale * (0.02 as f32),
        1.0 as f32,
        scene.light
    )
    draw_mesh(
        program,
        cube_mesh,
        model_matrix(scene.cube1.position, scene.cube1.size, time * scene.cube1.rotation_speed),
        view_proj,
        scene.cube1.color,
        camera.position,
        0.10 as f32,
        glow_scale * (0.02 as f32),
        1.0 as f32,
        scene.light
    )
}

fn draw_floor(program: u32, mesh: MeshGPU, model: Mat4, view_proj: Mat4, reflect_view_proj: Mat4, camera: Camera, reflection_target: RenderTarget) void = trust {
    gl_use_program(program)
    set_uniform_mat4(program, "uModel", model)
    set_uniform_mat4(program, "uViewProj", view_proj)
    set_uniform_mat4(program, "uReflectViewProj", reflect_view_proj)
    set_uniform_vec3(program, "uCameraPos", camera.position)
    set_uniform_i32(program, "uReflectionTex", 0 as i32)
    gl_active_texture(GL_TEXTURE0)
    gl_bind_texture(GL_TEXTURE_2D, reflection_target.color_texture)
    gl_bind_vertex_array(mesh.vao)
    gl_draw_elements(GL_TRIANGLES, mesh.index_count, GL_UNSIGNED_INT, none as ref void)
    gl_bind_vertex_array(0 as u32)
    gl_bind_texture(GL_TEXTURE_2D, 0 as u32)
}

fn render_reflection_scene(program: u32, cube_mesh: MeshGPU, scene: ecs.Scene3D, camera: Camera, width: i32, height: i32, time: f32, plane_y: f32) void = trust {
    val mirrored: Camera = mirrored_camera(camera, plane_y)
    val reflect_vp: Mat4 = view_projection(mirrored, width, height)
    gl_use_program(program)
    draw_demo_cubes(program, cube_mesh, scene, mirrored, reflect_vp, time, 0.60 as f32)
}

fn render_scene(scene_program: u32, floor_program: u32, cube_mesh: MeshGPU, _: MeshGPU, scene: ecs.Scene3D, camera: Camera, width: i32, height: i32, time: f32, reflection_target: RenderTarget) void = trust {
    val vp: Mat4 = view_projection(camera, width, height)
    val floor_y: f32 = -0.18 as f32
    val floor_position: ecs.Vec3 = vec3(0.0 as f32, floor_y - (0.08 as f32), -1.45 as f32)
    val floor_scale: ecs.Vec3 = vec3(7.8 as f32, 0.16 as f32, 7.8 as f32)
    val reflect_vp: Mat4 = view_projection(mirrored_camera(camera, floor_y), width, height)
    draw_demo_cubes(scene_program, cube_mesh, scene, camera, vp, time, 1.00 as f32)
    gl_enable(GL_BLEND)
    gl_blend_func(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA)
    draw_floor(
        floor_program,
        cube_mesh,
        model_matrix_scaled(floor_position, floor_scale, 0.0 as f32),
        vp,
        reflect_vp,
        camera,
        reflection_target
    )
    gl_disable(GL_BLEND)
}

fn render_post_process(program: u32, quad_vao: u32, target: RenderTarget) void = trust {
    gl_bind_framebuffer(GL_FRAMEBUFFER, 0 as u32)
    gl_disable(GL_DEPTH_TEST)
    gl_use_program(program)
    gl_active_texture(GL_TEXTURE0)
    gl_bind_texture(GL_TEXTURE_2D, target.color_texture)
    set_uniform_i32(program, "uSceneTex", 0 as i32)
    set_uniform_vec2(program, "uTexelSize", (1.0 as f32) / (target.width as f32), (1.0 as f32) / (target.height as f32))
    set_uniform_f32(program, "uExposure", 0.86 as f32)
    gl_bind_vertex_array(quad_vao)
    gl_draw_arrays(GL_TRIANGLES, 0 as i32, 3 as i32)
    gl_bind_vertex_array(0 as u32)
    gl_bind_texture(GL_TEXTURE_2D, 0 as u32)
    gl_enable(GL_DEPTH_TEST)
}

fn print_sdl_error(prefix: ref u8) void = {
    trust stdio.eprint("{s}: {s}\n", {prefix, sdl_get_error()})
}

pub fn run_app(app0: ExoApp) i32 = trust {
    val app: mut ExoApp = app0

    if sdl_init(SDL_INIT_VIDEO) != 0 {
        print_sdl_error("SDL_Init failed")
        return 1 as i32
    }

    sdl_gl_set_attribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3 as i32)
    sdl_gl_set_attribute(SDL_GL_CONTEXT_MINOR_VERSION, 3 as i32)
    sdl_gl_set_attribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_CORE)
    sdl_gl_set_attribute(SDL_GL_DOUBLEBUFFER, 1 as i32)

    val window: ref void = sdl_create_window(
        app.config.title,
        80 as i32,
        80 as i32,
        app.config.width,
        app.config.height,
        SDL_WINDOW_OPENGL | SDL_WINDOW_SHOWN
    )
    if window == none {
        print_sdl_error("SDL_CreateWindow failed")
        sdl_quit()
        return 1 as i32
    }

    val context: ref void = sdl_gl_create_context(window)
    if context == none {
        print_sdl_error("SDL_GL_CreateContext failed")
        sdl_destroy_window(window)
        sdl_quit()
        return 1 as i32
    }

    if sdl_gl_make_current(window, context) != 0 {
        print_sdl_error("SDL_GL_MakeCurrent failed")
        sdl_gl_delete_context(context)
        sdl_destroy_window(window)
        sdl_quit()
        return 1 as i32
    }

    sdl_gl_set_swap_interval(1 as i32)
    gl_viewport(0 as i32, 0 as i32, app.config.width, app.config.height)
    gl_enable(GL_DEPTH_TEST)

    val scene_program: u32 = link_program(SCENE_VERTEX_SHADER, SCENE_FRAGMENT_SHADER)
    if scene_program == 0 as u32 {
        sdl_gl_delete_context(context)
        sdl_destroy_window(window)
        sdl_quit()
        return 1 as i32
    }

    val floor_program: u32 = link_program(FLOOR_VERTEX_SHADER, FLOOR_FRAGMENT_SHADER)
    if floor_program == 0 as u32 {
        gl_delete_program(scene_program)
        sdl_gl_delete_context(context)
        sdl_destroy_window(window)
        sdl_quit()
        return 1 as i32
    }

    val glow_program: u32 = link_program(GLOW_VERTEX_SHADER, GLOW_FRAGMENT_SHADER)
    if glow_program == 0 as u32 {
        gl_delete_program(floor_program)
        gl_delete_program(scene_program)
        sdl_gl_delete_context(context)
        sdl_destroy_window(window)
        sdl_quit()
        return 1 as i32
    }

    val reflection_target: RenderTarget = create_render_target(app.config.width, app.config.height)
    if !render_target_valid(reflection_target) {
        destroy_render_target(reflection_target)
        gl_delete_program(glow_program)
        gl_delete_program(floor_program)
        gl_delete_program(scene_program)
        sdl_gl_delete_context(context)
        sdl_destroy_window(window)
        sdl_quit()
        return 1 as i32
    }

    val cube_mesh: MeshGPU = build_cube_mesh()
    val sphere_mesh: MeshGPU = build_sphere_mesh(16 as i32, 24 as i32)
    val quad_mesh: MeshGPU = build_quad_mesh()
    if !mesh_valid(cube_mesh) || !mesh_valid(sphere_mesh) || !mesh_valid(quad_mesh) {
        destroy_mesh(quad_mesh)
        destroy_mesh(sphere_mesh)
        destroy_mesh(cube_mesh)
        destroy_render_target(reflection_target)
        gl_delete_program(glow_program)
        gl_delete_program(floor_program)
        gl_delete_program(scene_program)
        sdl_gl_delete_context(context)
        sdl_destroy_window(window)
        sdl_quit()
        return 1 as i32
    }

    val evt: ref SDLEvent = @alloc(@sizeof(SDLEvent) as usize) as ref SDLEvent
    if evt == none {
        destroy_mesh(quad_mesh)
        destroy_mesh(sphere_mesh)
        destroy_mesh(cube_mesh)
        destroy_render_target(reflection_target)
        gl_delete_program(glow_program)
        gl_delete_program(floor_program)
        gl_delete_program(scene_program)
        sdl_gl_delete_context(context)
        sdl_destroy_window(window)
        sdl_quit()
        return 1 as i32
    }

    val start_ticks: u32 = sdl_get_ticks()
    val last_ticks: mut u32 = start_ticks
    val quit: mut bool = false

    for !quit {
        for {
            if sdl_poll_event(evt) != 0 {
                if evt.type_value == SDL_QUIT {
                    quit = true
                }
            } else {
                break
            }
        }

        val keys: ref u8 = sdl_get_keyboard_state(none as ref i32)
        val escape_pressed: u8 = @load8(@ptradd(keys, SDL_SCANCODE_ESCAPE as usize))
        if escape_pressed != 0 {
            quit = true
        }

        val now_ticks: u32 = sdl_get_ticks()
        val dt_raw: f32 = ((now_ticks - last_ticks) as f32) / (1000.0 as f32)
        val dt: f32 = math.fclamp(dt_raw as f64, 0.0, 0.05) as f32
        val time_value: f32 = ((now_ticks - start_ticks) as f32) / (1000.0 as f32)
        last_ticks = now_ticks

        update_camera(app.camera, dt, keys)

        gl_bind_framebuffer(GL_FRAMEBUFFER, reflection_target.framebuffer)
        gl_enable(GL_DEPTH_TEST)
        gl_viewport(0 as i32, 0 as i32, reflection_target.width, reflection_target.height)
        gl_clear_color(0.05 as f32, 0.08 as f32, 0.14 as f32, 1.0 as f32)
        gl_clear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT)
        render_reflection_scene(scene_program, cube_mesh, app.scene, app.camera, reflection_target.width, reflection_target.height, time_value, -0.18 as f32)

        gl_bind_framebuffer(GL_FRAMEBUFFER, 0 as u32)
        gl_enable(GL_DEPTH_TEST)
        gl_viewport(0 as i32, 0 as i32, app.config.width, app.config.height)
        gl_clear_color(0.09 as f32, 0.15 as f32, 0.30 as f32, 1.0 as f32)
        gl_clear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT)
        render_scene(scene_program, floor_program, cube_mesh, sphere_mesh, app.scene, app.camera, app.config.width, app.config.height, time_value, reflection_target)
        val lp: ecs.Vec3 = app.scene.light.position
        val lc: ecs.Vec3 = app.scene.light.color
        val gvp: Mat4 = view_projection(app.camera, app.config.width, app.config.height)
        val cam_fwd: ecs.Vec3 = camera_forward(app.camera)
        val world_up_v: ecs.Vec3 = vec3(0.0 as f32, 1.0 as f32, 0.0 as f32)
        val cam_right: ecs.Vec3 = vec3_normalize(vec3_cross(cam_fwd, world_up_v))
        val cam_up: ecs.Vec3 = vec3_cross(cam_right, cam_fwd)
        gl_enable(GL_BLEND)
        gl_blend_func(GL_SRC_ALPHA, GL_ONE)
        gl_use_program(glow_program)
        draw_billboard(glow_program, quad_mesh, lp, 0.38 as f32, 0.38 as f32, gvp, cam_right, cam_up, lc, 4.0 as f32, 0.90 as f32)
        draw_billboard(glow_program, quad_mesh, lp, 1.30 as f32, 1.30 as f32, gvp, cam_right, cam_up, lc, 1.2 as f32, 0.55 as f32)
        draw_billboard(glow_program, quad_mesh, lp, 9.0 as f32, 0.24 as f32, gvp, cam_right, cam_up, lc, 1.4 as f32, 0.45 as f32)
        draw_billboard(glow_program, quad_mesh, lp, 0.24 as f32, 9.0 as f32, gvp, cam_right, cam_up, lc, 1.4 as f32, 0.45 as f32)
        gl_blend_func(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA)
        gl_disable(GL_BLEND)
        sdl_gl_swap_window(window)
    }

    @free(evt as ref void)
    destroy_mesh(quad_mesh)
    destroy_mesh(sphere_mesh)
    destroy_mesh(cube_mesh)
    destroy_render_target(reflection_target)
    gl_delete_program(glow_program)
    gl_delete_program(floor_program)
    gl_delete_program(scene_program)
    sdl_gl_delete_context(context)
    sdl_destroy_window(window)
    sdl_quit()
    return 0 as i32
}
