}

pub type ExoApp = {
    config: ExoConfig
    scene: mut ecs.Scene3D
    scenes: mut list[ecs.Scene3D]
    active_scene_index: mut usize
    next_scene_key: i32
    camera: mut Camera
    input: InputConfig
    audio: AudioMixerConfig
}

pub spec SceneUpdater = {
    pub fn su_update(u: mut self, scene: mut ecs.Scene3D, dt: f32, time: f32) void
}

type (SceneUpdater) NoSceneUpdater = {
    _unused: u8
}

pub fn (NoSceneUpdater) su_update(_: mut self, _: mut ecs.Scene3D, _: f32, _: f32) void = {}

