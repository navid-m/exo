type Mat4 = {
    m00: f32
    m01: f32
    m02: f32
    m03: f32
    m10: f32
    m11: f32
    m12: f32
    m13: f32
    m20: f32
    m21: f32
    m22: f32
    m23: f32
    m30: f32
    m31: f32
    m32: f32
    m33: f32
}

type MeshGPU = {
    vao: u32
    vbo: u32
    ebo: u32
    index_count: i32
}

type RenderTarget = {
    framebuffer: u32
    color_texture: u32
    depth_rbo: u32
    width: i32
    height: i32
}

type F32Slot = { value: mut f32 }
type U32Slot = { value: mut u32 }

pub type GlbFixture = {
    ptr: ref u8
    len: usize
}

