pub type Vec3 = {
    x: f32
    y: f32
    z: f32
}

pub type SphereEntity = {
    position: Vec3
    color: Vec3
    radius: f32
    reflectivity: f32
    emissive: f32
}

pub type CubeEntity = {
    position: Vec3
    color: Vec3
    size: f32
    rotation_speed: f32
    reflectivity: f32
    emissive: f32
}

pub type GlbModel = {
    valid: mut bool
    byte_length: mut usize
    json_length: mut usize
    bin_length: mut usize
    mesh_name: mut ref u8
    primitive_count: mut i32
    vertex_count: mut i32
    index_count: mut i32
    has_normals: mut bool
    has_uvs: mut bool
}

pub type ShowcaseScene = {
    hdr_enabled: bool
    bloom_enabled: bool
    exposure: f32
    bloom_strength: f32
    sphere_count: i32
    sphere0: SphereEntity
    sphere1: SphereEntity
    sphere2: SphereEntity
    sphere3: SphereEntity
    cube: CubeEntity
    model: mut GlbModel
}

pub type GlbFixture = {
    ptr: ref u8
    len: usize
}

pub type RenderTargets = {
    hdr_fbo: u32
    hdr_color: u32
    blur_fbo0: u32
    blur_tex0: u32
    blur_fbo1: u32
    blur_tex1: u32
}

fn vec3(x: f32, y: f32, z: f32) Vec3 = {
    return { x: x, y: y, z: z }
}

pub fn empty_model() GlbModel = {
    return {
        valid: false,
        byte_length: 0 as usize,
        json_length: 0 as usize,
        bin_length: 0 as usize,
        mesh_name: "",
        primitive_count: 0 as i32,
        vertex_count: 0 as i32,
        index_count: 0 as i32,
        has_normals: false,
        has_uvs: false
    }
}

