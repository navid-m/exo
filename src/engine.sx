type Mat4 = {
    m00: f32
    m01: f32
    m02: f32
    m03: f32
    m10: f32
    m11: f32
    m12: f32
    m13: f32
    m20: f32
    m21: f32
    m22: f32
    m23: f32
    m30: f32
    m31: f32
    m32: f32
    m33: f32
}

type MeshGPU = {
    raw: ref void
    index_count: i32
}

type F32Slot = { value: mut f32 }
type U32Slot = { value: mut u32 }

pub type GlbFixture = {
    ptr: ref u8
    len: usize
}

pub type Camera = {
    position: mut ecs.Vec3
    yaw: mut f32
    pitch: mut f32
    move_speed: f32
    turn_speed: f32
}

pub type ExoConfig = {
    title: ref u8
    width: i32
    height: i32
    shaders: ExoShaderConfig
}

pub type ShaderProgramConfig = {
    vertex_path: ref u8
    fragment_path: ref u8
}

pub type ExoShaderConfig = {
    scene: ShaderProgramConfig
    floor: ShaderProgramConfig
    glow: ShaderProgramConfig
    fxaa: ShaderProgramConfig
    water: ShaderProgramConfig
}

pub type KeyBindings = {
    move_forward: i32
    move_back: i32
    move_left: i32
    move_right: i32
    turn_left: i32
    turn_right: i32
    look_up: i32
    look_down: i32
}

pub type MouseConfig = {
    enabled: bool
    sensitivity_x: f32
    sensitivity_y: f32
