    }
}

fn fallback_scene() ecs.Scene3D = {
    return ecs.new_scene(ecs.default_light())
}

fn first_scene(scenes: list[ecs.Scene3D]) ecs.Scene3D = {
    if @get(scenes, 0 as usize) is some scene {
        return scene
    }
    return fallback_scene()
}

pub fn create_scene_app(
    config: ExoConfig,
    scenes: list[ecs.Scene3D],
    camera: Camera,
    input: InputConfig,
    next_scene_key: i32,
    audio: AudioMixerConfig
) ExoApp = {
    return {
        config: config,
        scene: first_scene(scenes),
        scenes: scenes,
        active_scene_index: 0 as usize,
        next_scene_key: next_scene_key,
        camera: camera,
        input: input,
        audio: audio
    }
}

pub fn create_app(config: ExoConfig, scene: ecs.Scene3D, camera: Camera, input: InputConfig) ExoApp = {
    val scenes: mut list[ecs.Scene3D] = []
    @append(scenes, scene)
    return create_scene_app(config, scenes, camera, input, SDL_SCANCODE_X, default_audio_mixer())
}

pub type ExoAppBuilder = {
    title: mut ref u8
    width: mut i32
    height: mut i32
    shaders: mut ExoShaderConfig
    scenes: mut list[ecs.Scene3D]
    camera: mut Camera
    input: mut InputConfig
    next_scene_key: mut i32
    audio: mut AudioMixerConfig
}

pub fn new_app() ExoAppBuilder = {
    val cfg: ExoConfig = default_config()
    return {
        title: cfg.title,
        width: cfg.width,
        height: cfg.height,
        shaders: cfg.shaders,
        scenes: [],
        camera: default_camera(),
        input: default_input_config(),
        next_scene_key: SDL_SCANCODE_X,
        audio: default_audio_mixer()
    }
}

pub fn build_app(builder: ExoAppBuilder) ExoApp = {
    val config: ExoConfig = {
        title: builder.title,
        width: builder.width,
        height: builder.height,
        shaders: builder.shaders
    }
    return create_scene_app(
        config,
        builder.scenes,
        builder.camera,
        builder.input,
        builder.next_scene_key,
        builder.audio
    )
}

pub fn with_title(app: mut ExoAppBuilder, title: ref u8) void = {
    app.title = title
}

pub fn with_resolution(app: mut ExoAppBuilder, width: i32, height: i32) void = {
    app.width = width
    app.height = height
}

pub fn with_shaders(app: mut ExoAppBuilder, shaders: ExoShaderConfig) void = {
    app.shaders = shaders
}

pub fn with_scene_list(app: mut ExoAppBuilder, scenes: list[ecs.Scene3D]) void = {
    app.scenes = scenes
}

pub fn with_camera(app: mut ExoAppBuilder, camera: Camera) void = {
    app.camera = camera
}

pub fn with_default_camera(app: mut ExoAppBuilder) void = {
    app.camera = default_camera()
}

pub fn with_input(app: mut ExoAppBuilder, input: InputConfig) void = {
    app.input = input
}

pub fn with_next_scene_key(app: mut ExoAppBuilder, key: i32) void = {
    app.next_scene_key = key
}

pub fn with_audio(app: mut ExoAppBuilder, audio: AudioMixerConfig) void = {
    app.audio = audio
}

fn dup_cstr(src: ref u8) ref u8 = trust {
    if src == none {
        return none
    }
    val len: usize = string.len_raw(src)
    val dst: ref u8 = @alloc(len + (1 as usize)) as ref u8
    if dst == none {
        return none
    }
    if len > 0 {
        @memcpy(dst as ref void, src as ref void, len)
    }
    @store8(@ptradd(dst, len), 0)
    return dst
}

fn parse_accessor_count(accessors: ref void, idx: i64) i32 = trust {
    if json.arr_get(accessors, idx as usize) is some accessor {
        if json.obj_get_int(accessor, "count") is some count {
            return count as i32
        }
    }
    return 0 as i32
}

fn parse_accessor_offset(accessors: ref void, buffer_views: ref void, idx: i64) usize = trust {
    val offset: mut usize = 0 as usize
    if json.arr_get(accessors, idx as usize) is some accessor {
        if json.obj_get_int(accessor, "byteOffset") is some acc_off {
            offset = offset + (acc_off as usize)
        }
        if json.obj_get_int(accessor, "bufferView") is some bv_idx {
            if json.arr_get(buffer_views, bv_idx as usize) is some bv {
                if json.obj_get_int(bv, "byteOffset") is some bv_off {
                    offset = offset + (bv_off as usize)
                }
            }
        }
    }
    return offset
}

/// Walk the raw GLB position data and compute XYZ bounding box, storing results on the model.
pub fn compute_glb_bounds(model: mut ref ecs.GlbModel) void = trust {
    if !model.valid || model.vertex_count <= (0 as i32) || model.raw_bytes == none || model.bin_length == (0 as usize) {
        return
    }
    val data: ref u8 = model.raw_bytes
    val json_offset: usize = 20 as usize
    val json_len: u32 = bin.read_u32_le(data, 12 as usize)
    val json_buf: ref u8 = @alloc((json_len as usize) + (1 as usize)) as ref u8
    if json_buf == none { return }
    @memcpy(json_buf as ref void, @ptradd(data, json_offset) as ref void, json_len as usize)
    @store8(@ptradd(json_buf, json_len as usize), 0)
    if json.parse(json_buf) is some doc {
        val root: ref void = json.doc_root(doc)
        val vc: usize = model.vertex_count as usize
        val pos_offset: mut usize = 0 as usize
        if json.obj_get(root, "accessors") is some accessors {
            if json.obj_get(root, "bufferViews") is some buffer_views {
                if json.obj_get(root, "meshes") is some meshes {
                    if json.arr_get(meshes, 0 as usize) is some mesh {
                        if json.obj_get(mesh, "primitives") is some primitives {
                            if json.arr_get(primitives, 0 as usize) is some prim {
                                if json.obj_get(prim, "attributes") is some attrs {
                                    if json.obj_get_int(attrs, "POSITION") is some pi {
                                        pos_offset = parse_accessor_offset(accessors, buffer_views, pi)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        val bin_base: ref void = @ptradd(data, (json_offset + (json_len as usize) + (8 as usize)) as usize)
        val vi: mut usize = 0 as usize
        val min_x: mut f32 = 1e30 as f32
        val max_x: mut f32 = -1e30 as f32
        val min_y: mut f32 = 1e30 as f32
        val max_y: mut f32 = -1e30 as f32
        val min_z: mut f32 = 1e30 as f32
        val max_z: mut f32 = -1e30 as f32
        for vi < vc {
            val p: ref f32 = @ptradd(bin_base, pos_offset + vi * (12 as usize)) as ref f32
            val px: f32 = read_f32(p, 0 as usize)
            val py: f32 = read_f32(p, 1 as usize)
            val pz: f32 = read_f32(p, 2 as usize)
            if px < min_x { min_x = px }
            if px > max_x { max_x = px }
            if py < min_y { min_y = py }
            if py > max_y { max_y = py }
            if pz < min_z { min_z = pz }
            if pz > max_z { max_z = pz }
            vi = vi + (1 as usize)
        }
        model.bounds_min_x = min_x
        model.bounds_max_x = max_x
        model.bounds_min_y = min_y
        model.bounds_max_y = max_y
        model.bounds_min_z = min_z
        model.bounds_max_z = max_z
        json.doc_free(doc)
    }
    @free(json_buf as ref void)
}

/// Upload a parsed GlbModel's binary geometry to the GPU.
/// If the model has no normals, synthesises a flat up-normal.
fn upload_glb_model(runtime: ref void, model: ecs.GlbModel) MeshGPU = trust {
    if !model.valid || model.vertex_count <= (0 as i32) || model.raw_bytes == none || model.bin_length == (0 as usize) {
        return { raw: none as ref void, index_count: 0 as i32 }
    }
    val data: ref u8 = model.raw_bytes
    val json_offset: usize = 20 as usize
    val json_len: u32 = bin.read_u32_le(data, 12 as usize)
    val json_buf: ref u8 = @alloc((json_len as usize) + (1 as usize)) as ref u8
    if json_buf == none {
        return { raw: none as ref void, index_count: 0 as i32 }
    }
    @memcpy(json_buf as ref void, @ptradd(data, json_offset) as ref void, json_len as usize)
    @store8(@ptradd(json_buf, json_len as usize), 0)
    val result: mut MeshGPU = { raw: none as ref void, index_count: 0 as i32 }
    if json.parse(json_buf) is some doc {
        val root: ref void = json.doc_root(doc)
        val vc: usize = model.vertex_count as usize
        val ic: usize = model.index_count as usize
        val vertex_float_count: usize = vc * (8 as usize)
        val vertices: ref void = @alloc(vertex_float_count * (@sizeof(f32) as usize))
        val actual_ic: mut usize = vc 

        if ic > (0 as usize) { actual_ic = ic }

        val indices: ref void = @alloc(actual_ic * (@sizeof(u32) as usize))
        if vertices != none && indices != none {
            val bin_base: ref void = @ptradd(data, (json_offset + (json_len as usize) + (8 as usize)) as usize)
            val pos_offset: mut usize = 0 as usize
            val nrm_offset: mut usize = 0 as usize
            val uv_offset:  mut usize = 0 as usize
            val idx_offset: mut usize = 0 as usize
            val has_nrm: mut bool = false
            val has_uv:  mut bool = false
            if json.obj_get(root, "accessors") is some accessors {
                if json.obj_get(root, "bufferViews") is some buffer_views {
                    if json.obj_get(root, "meshes") is some meshes {
                        if json.arr_get(meshes, 0 as usize) is some mesh {
                            if json.obj_get(mesh, "primitives") is some primitives {
                                if json.arr_get(primitives, 0 as usize) is some prim {
                                    if json.obj_get(prim, "attributes") is some attrs {
                                        if json.obj_get_int(attrs, "POSITION") is some pi {
                                            pos_offset = parse_accessor_offset(accessors, buffer_views, pi)
                                        }
                                        if json.obj_get_int(attrs, "NORMAL") is some ni {
                                            nrm_offset = parse_accessor_offset(accessors, buffer_views, ni)
                                            has_nrm = true
                                        }
                                        if json.obj_get_int(attrs, "TEXCOORD_0") is some ti {
                                            uv_offset = parse_accessor_offset(accessors, buffer_views, ti)
                                            has_uv = true
                                        }
                                    }
                                    if json.obj_get_int(prim, "indices") is some ii {
                                        idx_offset = parse_accessor_offset(accessors, buffer_views, ii)
                                    }
                                }
                            }
                        }
                    }
                }
            }
            val vi: mut usize = 0 as usize
            for vi < vc {
                val p: ref f32 = @ptradd(bin_base, pos_offset + vi * (12 as usize)) as ref f32
                val px: f32 = read_f32(p, 0 as usize)
                val py: f32 = read_f32(p, 1 as usize)
                val pz: f32 = read_f32(p, 2 as usize)
                val nx: mut f32 = 0.0 as f32
                val ny: mut f32 = 1.0 as f32
                val nz: mut f32 = 0.0 as f32
                if has_nrm {
                    val n: ref f32 = @ptradd(bin_base, nrm_offset + vi * (12 as usize)) as ref f32
                    nx = read_f32(n, 0 as usize)
                    ny = read_f32(n, 1 as usize)
                    nz = read_f32(n, 2 as usize)
                }
                val tu: mut f32 = 0.0 as f32
                val tv: mut f32 = 0.0 as f32
                if has_uv {
                    val t: ref f32 = @ptradd(bin_base, uv_offset + vi * (8 as usize)) as ref f32
                    tu = read_f32(t, 0 as usize)
                    tv = read_f32(t, 1 as usize)
                }
                write_vertex_uv(vertices, vi, vec3(px, py, pz), vec3(nx, ny, nz), tu, tv)
                vi = vi + (1 as usize)
            }
            val use_u16: mut bool = false
            if json.parse(json_buf) is some doc2 {
                val root2: ref void = json.doc_root(doc2)
                if json.obj_get(root2, "accessors") is some accessors2 {
                    if json.obj_get(root2, "meshes") is some meshes2 {
                        if json.arr_get(meshes2, 0 as usize) is some mesh2 {
                            if json.obj_get(mesh2, "primitives") is some prims2 {
                                if json.arr_get(prims2, 0 as usize) is some prim2 {
                                    if json.obj_get_int(prim2, "indices") is some ii2 {
                                        if json.arr_get(accessors2, ii2 as usize) is some acc {
                                            if json.obj_get_int(acc, "componentType") is some ct {
                                                if ct == (5123 as i64) {
                                                    use_u16 = true
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                json.doc_free(doc2)
            }
            val ii: mut usize = 0 as usize
            if ic > (0 as usize) {
                for ii < ic {
                    val idx_val: mut u32 = 0 as u32
                    if use_u16 {
                        val slot: ref void = @ptradd(bin_base, idx_offset + ii * (2 as usize))
                        val lo: u8 = @load8(slot as ref u8)
                        val hi: u8 = @load8(@ptradd(slot, 1 as usize) as ref u8)
                        idx_val = (lo as u32) | ((hi as u32) << (8 as u32))
                    } else {
                        val slot: ref void = @ptradd(bin_base, idx_offset + ii * (4 as usize))
                        idx_val = bin.read_u32_le(slot as ref u8, 0 as usize)
                    }
                    store_u32(indices, ii, idx_val)
                    ii = ii + (1 as usize)
                }
            } else {
                for ii < vc {
                    store_u32(indices, ii, ii as u32)
                    ii = ii + (1 as usize)
                }
            }
            result = upload_mesh(runtime, vertices, vertex_float_count, indices, actual_ic as i32)
        }
        if vertices != none { @free(vertices) }
        if indices != none { @free(indices) }
        json.doc_free(doc)
    }
    @free(json_buf as ref void)
    return result
}

pub fn parse_glb_bytes(data: ref u8, len: usize) option[ecs.GlbModel] = trust {
    if data == none {
        return none
    }
    if len < (20 as usize) {
        return none
    }
    val magic: u32 = bin.read_u32_le(data, 0 as usize)
    val version: u32 = bin.read_u32_le(data, 4 as usize)
    val total_len: u32 = bin.read_u32_le(data, 8 as usize)
    if magic != GLB_MAGIC || version != GLB_VERSION {
        return none
    }
    val total_len_usize: usize = total_len as usize
    if total_len_usize > len {
        return none
    }
    val json_len: u32 = bin.read_u32_le(data, 12 as usize)
    val json_type: u32 = bin.read_u32_le(data, 16 as usize)
    if json_type != GLB_JSON_CHUNK {
        return none
    }
    val json_offset: usize = 20 as usize
    val json_end: usize = json_offset + (json_len as usize)
    if json_end > len {
        return none
    }
    val json_buf: ref u8 = @alloc((json_len as usize) + (1 as usize)) as ref u8
    if json_buf == none {
        return none
    }
    @memcpy(json_buf as ref void, @ptradd(data, json_offset) as ref void, json_len as usize)
    @store8(@ptradd(json_buf, json_len as usize), 0)
    val bin_header_offset: usize = json_end
    if bin_header_offset + (8 as usize) > len {
        @free(json_buf as ref void)
        return none
    }
    val bin_len: u32 = bin.read_u32_le(data, bin_header_offset)
    val bin_type: u32 = bin.read_u32_le(data, bin_header_offset + (4 as usize))
    if bin_type != GLB_BIN_CHUNK {
        @free(json_buf as ref void)
        return none
    }
    if json.parse(json_buf) is some doc {
        val root: ref void = json.doc_root(doc)
        val model: mut ecs.GlbModel = ecs.empty_model()
        model.valid = true
        model.byte_length = total_len as usize
        model.json_length = json_len as usize
        model.bin_length = bin_len as usize
        model.mesh_name = dup_cstr("embedded-glb")
        if json.obj_get(root, "meshes") is some meshes {
            if json.arr_get(meshes, 0 as usize) is some mesh {
                if json.obj_get_str(mesh, "name") is some mesh_name {
                    model.mesh_name = dup_cstr(mesh_name)
                }
                if json.obj_get(mesh, "primitives") is some primitives {
                    model.primitive_count = json.arr_len(primitives) as i32
                    if json.arr_get(primitives, 0 as usize) is some primitive {
                        if json.obj_get(primitive, "attributes") is some attributes {
                            if json.obj_get(root, "accessors") is some accessors {
                                if json.obj_get_int(attributes, "POSITION") is some pos_accessor {
                                    model.vertex_count = parse_accessor_count(accessors, pos_accessor)
                                }
                                if json.obj_get_int(primitive, "indices") is some idx_accessor {
                                    model.index_count = parse_accessor_count(accessors, idx_accessor)
                                }
                            }
                            if json.obj_get_int(attributes, "NORMAL") is some _ {
                                model.has_normals = true
                            }
                            if json.obj_get_int(attributes, "TEXCOORD_0") is some _ {
                                model.has_uvs = true
                            }
                        }
                    }
                }
            }
        }
        json.doc_free(doc)
        @free(json_buf as ref void)
        val raw_copy: ref u8 = @alloc(len) as ref u8
        if raw_copy != none {
            @memcpy(raw_copy as ref void, data as ref void, len)
            model.raw_bytes = raw_copy
            model.raw_bytes_len = len
        }
        val json_buf2: ref u8 = @alloc((json_len as usize) + (1 as usize)) as ref u8
        if json_buf2 != none {
            @memcpy(json_buf2 as ref void, @ptradd(data, json_offset) as ref void, json_len as usize)
            @store8(@ptradd(json_buf2, json_len as usize), 0)
            if json.parse(json_buf2) is some doc2 {
                val root2: ref void = json.doc_root(doc2)
                val bin_data_offset: usize = json_end + (8 as usize)
                if json.obj_get(root2, "images") is some images {
                    if json.arr_get(images, 0 as usize) is some img {
                        if json.obj_get_int(img, "bufferView") is some bv_idx {
                            if json.obj_get(root2, "bufferViews") is some bvs {
                                if json.arr_get(bvs, bv_idx as usize) is some bv {
                                    val img_off: mut i64 = 0
                                    val img_len: mut i64 = 0
                                    if json.obj_get_int(bv, "byteOffset") is some o { img_off = o }
                                    if json.obj_get_int(bv, "byteLength") is some l { img_len = l }
                                    if img_len > (0 as i64) {
                                        model.texture_offset = bin_data_offset + (img_off as usize)
                                        model.texture_length = img_len as usize
                                    }
                                }
                            }
                        }
                    }
                }
                json.doc_free(doc2)
            }
            @free(json_buf2 as ref void)
        }
        return some model
    }
    @free(json_buf as ref void)
    return none
}

pub fn load_glb(path: ref u8) option[ecs.GlbModel] = trust {
    val file: ref void = fopen(path, "rb")
    if file == none {
        return none
    }
    fseek(file, 0, 2 as i32)
    val size: i64 = ftell(file)
    rewind(file)
    if size <= 0 {
        fclose(file)
        return none
    }
    val buf: ref u8 = @alloc((size as usize) + (1 as usize)) as ref u8
    if buf == none {
        fclose(file)
        return none
    }
    fread(buf as ref void, 1 as usize, size as usize, file)
    @store8(@ptradd(buf, size as usize), 0)
    fclose(file)
    val model = parse_glb_bytes(buf, size as usize)
    @free(buf as ref void)
    return model
}

pub fn build_test_glb_fixture() GlbFixture = trust {
    val json_chunk: ref u8 = \\{"asset":{"version":"2.0"},"buffers":[{"byteLength":36}],"bufferViews":[{"buffer":0,"byteOffset":0,"byteLength":36}],"accessors":[{"bufferView":0,"componentType":5126,"count":3,"type":"VEC3"}],"meshes":[{"name":"fixture","primitives":[{"attributes":{"POSITION":0}}]}]}
    val json_len_raw: usize = string.len_raw(json_chunk)
    val json_len: usize = ((json_len_raw + (3 as usize)) / (4 as usize)) * (4 as usize)
    val bin_len: usize = 36 as usize
    val total_len: usize = (12 as usize) + (8 as usize) + json_len + (8 as usize) + bin_len
    val ptr: ref u8 = @alloc(total_len + (1 as usize)) as ref u8
    @memset(ptr as ref void, 0, total_len + (1 as usize))
    bin.write_u32_le(ptr, 0 as usize, GLB_MAGIC)
    bin.write_u32_le(ptr, 4 as usize, GLB_VERSION)
    bin.write_u32_le(ptr, 8 as usize, total_len as u32)
    bin.write_u32_le(ptr, 12 as usize, json_len as u32)
    bin.write_u32_le(ptr, 16 as usize, GLB_JSON_CHUNK)
    @memcpy(@ptradd(ptr, 20 as usize) as ref void, json_chunk as ref void, json_len_raw)
    val bin_header: usize = (20 as usize) + json_len
    bin.write_u32_le(ptr, bin_header, bin_len as u32)
    bin.write_u32_le(ptr, bin_header + (4 as usize), GLB_BIN_CHUNK)
    @store8(@ptradd(ptr, total_len), 0)
    return {
        ptr: ptr,
        len: total_len
    }
}

pub fn load_embedded_fixture_model() ecs.GlbModel = trust {
    val fixture: mut GlbFixture = build_test_glb_fixture()
    if parse_glb_bytes(fixture.ptr, fixture.len) is some model {
        @free(fixture.ptr as ref void)
        return model
    }
    @free(fixture.ptr as ref void)
    return ecs.empty_model()
}

fn store_f32(base: ref void, index: usize, value: f32) void = trust {
    val slot: mut ref F32Slot = @ptradd(base, index * (@sizeof(f32) as usize)) as mut ref F32Slot
    slot.value = value
}

fn store_u32(base: ref void, index: usize, value: u32) void = trust {
    val slot: mut ref U32Slot = @ptradd(base, index * (@sizeof(u32) as usize)) as mut ref U32Slot
    slot.value = value
}

fn write_vertex(base: ref void, vertex_index: usize, position: ecs.Vec3, normal: ecs.Vec3) void = trust {
    val offset: usize = vertex_index * (8 as usize)
    store_f32(base, offset + (0 as usize), position.x)
    store_f32(base, offset + (1 as usize), position.y)
    store_f32(base, offset + (2 as usize), position.z)
    store_f32(base, offset + (3 as usize), normal.x)
    store_f32(base, offset + (4 as usize), normal.y)
    store_f32(base, offset + (5 as usize), normal.z)
    store_f32(base, offset + (6 as usize), 0.0 as f32)
    store_f32(base, offset + (7 as usize), 0.0 as f32)
}

fn write_vertex_uv(base: ref void, vertex_index: usize, position: ecs.Vec3, normal: ecs.Vec3, u: f32, v: f32) void = trust {
    val offset: usize = vertex_index * (8 as usize)
    store_f32(base, offset + (0 as usize), position.x)
    store_f32(base, offset + (1 as usize), position.y)
    store_f32(base, offset + (2 as usize), position.z)
    store_f32(base, offset + (3 as usize), normal.x)
    store_f32(base, offset + (4 as usize), normal.y)
    store_f32(base, offset + (5 as usize), normal.z)
    store_f32(base, offset + (6 as usize), u)
    store_f32(base, offset + (7 as usize), v)
}

fn upload_mesh(runtime: ref void, vertices: ref void, vertex_float_count: usize, indices: ref void, index_count: i32) MeshGPU = trust {
    val raw: ref void = exo_sdl3_create_mesh(
        runtime,
        vertices,
        (vertex_float_count * (@sizeof(f32) as usize)) as u32,
        indices,
        ((index_count as usize) * (@sizeof(u32) as usize)) as u32,
        index_count as u32
    )
    return { raw: raw, index_count: index_count }
}

fn destroy_mesh(runtime: ref void, mesh: MeshGPU) void = trust {
    if mesh.raw != none {
        exo_sdl3_destroy_mesh(runtime, mesh.raw)
    }
}

fn cube_face(
    vertices: ref void,
    indices: ref void,
    face_index: i32,
    p0: ecs.Vec3,
    p1: ecs.Vec3,
    p2: ecs.Vec3,
    p3: ecs.Vec3,
    normal: ecs.Vec3
) void = trust {
    val base_vertex: usize = (face_index as usize) * (4 as usize)
    val base_index: usize = (face_index as usize) * (6 as usize)
    write_vertex(vertices, base_vertex + (0 as usize), p0, normal)
    write_vertex(vertices, base_vertex + (1 as usize), p1, normal)
    write_vertex(vertices, base_vertex + (2 as usize), p2, normal)
    write_vertex(vertices, base_vertex + (3 as usize), p3, normal)
    store_u32(indices, base_index + (0 as usize), (base_vertex + (0 as usize)) as u32)
    store_u32(indices, base_index + (1 as usize), (base_vertex + (1 as usize)) as u32)
    store_u32(indices, base_index + (2 as usize), (base_vertex + (2 as usize)) as u32)
    store_u32(indices, base_index + (3 as usize), (base_vertex + (0 as usize)) as u32)
    store_u32(indices, base_index + (4 as usize), (base_vertex + (2 as usize)) as u32)
    store_u32(indices, base_index + (5 as usize), (base_vertex + (3 as usize)) as u32)
}

fn build_cube_mesh(runtime: ref void) MeshGPU = trust {
    val vertex_float_count: usize = 24 as usize * 8 as usize
    val index_count: i32 = 36 as i32
    val vertices: ref void = @alloc(vertex_float_count * (@sizeof(f32) as usize))
    val indices: ref void = @alloc((index_count as usize) * (@sizeof(u32) as usize))
    if vertices == none || indices == none {
        if vertices != none { @free(vertices) }
        if indices != none { @free(indices) }
        return { raw: none as ref void, index_count: 0 as i32 }
    }
    cube_face(
        vertices, indices, 0 as i32,
        vec3(-0.5 as f32, -0.5 as f32, 0.5 as f32),
        vec3(0.5 as f32, -0.5 as f32, 0.5 as f32),
        vec3(0.5 as f32, 0.5 as f32, 0.5 as f32),
        vec3(-0.5 as f32, 0.5 as f32, 0.5 as f32),
        vec3(0.0 as f32, 0.0 as f32, 1.0 as f32)
    )
    cube_face(
        vertices, indices, 1 as i32,
        vec3(0.5 as f32, -0.5 as f32, -0.5 as f32),
        vec3(-0.5 as f32, -0.5 as f32, -0.5 as f32),
        vec3(-0.5 as f32, 0.5 as f32, -0.5 as f32),
        vec3(0.5 as f32, 0.5 as f32, -0.5 as f32),
        vec3(0.0 as f32, 0.0 as f32, -1.0 as f32)
    )
    cube_face(
        vertices, indices, 2 as i32,
        vec3(-0.5 as f32, -0.5 as f32, -0.5 as f32),
        vec3(-0.5 as f32, -0.5 as f32, 0.5 as f32),
        vec3(-0.5 as f32, 0.5 as f32, 0.5 as f32),
        vec3(-0.5 as f32, 0.5 as f32, -0.5 as f32),
        vec3(-1.0 as f32, 0.0 as f32, 0.0 as f32)
    )
    cube_face(
        vertices, indices, 3 as i32,
        vec3(0.5 as f32, -0.5 as f32, 0.5 as f32),
        vec3(0.5 as f32, -0.5 as f32, -0.5 as f32),
        vec3(0.5 as f32, 0.5 as f32, -0.5 as f32),
        vec3(0.5 as f32, 0.5 as f32, 0.5 as f32),
        vec3(1.0 as f32, 0.0 as f32, 0.0 as f32)
    )
    cube_face(
        vertices, indices, 4 as i32,
        vec3(-0.5 as f32, 0.5 as f32, 0.5 as f32),
        vec3(0.5 as f32, 0.5 as f32, 0.5 as f32),
        vec3(0.5 as f32, 0.5 as f32, -0.5 as f32),
        vec3(-0.5 as f32, 0.5 as f32, -0.5 as f32),
        vec3(0.0 as f32, 1.0 as f32, 0.0 as f32)
    )
    cube_face(
        vertices, indices, 5 as i32,
        vec3(-0.5 as f32, -0.5 as f32, -0.5 as f32),
        vec3(0.5 as f32, -0.5 as f32, -0.5 as f32),
        vec3(0.5 as f32, -0.5 as f32, 0.5 as f32),
        vec3(-0.5 as f32, -0.5 as f32, 0.5 as f32),
        vec3(0.0 as f32, -1.0 as f32, 0.0 as f32)
    )
    val mesh: MeshGPU = upload_mesh(runtime, vertices, vertex_float_count, indices, index_count)
    @free(vertices)
    @free(indices)
    return mesh
}

fn build_sphere_mesh(runtime: ref void, lat_segments: i32, lon_segments: i32) MeshGPU = trust {
    val vertex_count: i32 = (lat_segments + 1 as i32) * (lon_segments + 1 as i32)
    val index_count: i32 = lat_segments * lon_segments * 6 as i32
    val vertex_float_count: usize = (vertex_count as usize) * (8 as usize)
    val vertices: ref void = @alloc(vertex_float_count * (@sizeof(f32) as usize))
    val indices: ref void = @alloc((index_count as usize) * (@sizeof(u32) as usize))
    if vertices == none || indices == none {
        if vertices != none { @free(vertices) }
        if indices != none { @free(indices) }
        return { raw: none as ref void, index_count: 0 as i32 }
    }
    for (iy = 0; iy <= lat_segments; iy++) {
        val v: f32 = (iy as f32) / (lat_segments as f32)
        val theta: f64 = (v as f64) * mstat.PI
        val y: f32 = math.cos(theta) as f32
        val ring_r: f32 = math.sin(theta) as f32
        for (ix = 0; ix <= lon_segments; ix++) {
            val u: f32 = (ix as f32) / (lon_segments as f32)
            val phi: f64 = (u as f64) * ((2.0 as f64) * mstat.PI)
            val x: f32 = (math.cos(phi) as f32) * ring_r
            val z: f32 = (math.sin(phi) as f32) * ring_r
            val normal: ecs.Vec3 = vec3(x, y, z)
            val vertex_index: usize = ((iy * (lon_segments + 1 as i32)) + ix) as usize
            write_vertex(vertices, vertex_index, normal, normal)
        }
    }
    val row_stride: i32 = lon_segments + 1 as i32
    for (face_y = 0; face_y < lat_segments; face_y++) {
        for (face_x = 0; face_x < lon_segments; face_x++) {
            val a: u32 = ((face_y * row_stride) + face_x) as u32
            val b: u32 = (((face_y + 1 as i32) * row_stride) + face_x) as u32
            val c: u32 = a + (1 as u32)
            val d: u32 = b + (1 as u32)
            val index_base: usize = (((face_y * lon_segments) + face_x) * 6 as i32) as usize
            store_u32(indices, index_base + (0 as usize), a)
            store_u32(indices, index_base + (1 as usize), b)
            store_u32(indices, index_base + (2 as usize), c)
            store_u32(indices, index_base + (3 as usize), c)
            store_u32(indices, index_base + (4 as usize), b)
            store_u32(indices, index_base + (5 as usize), d)
        }
    }
    val mesh: MeshGPU = upload_mesh(runtime, vertices, vertex_float_count, indices, index_count)
    @free(vertices)
    @free(indices)
    return mesh
}

fn build_quad_mesh(runtime: ref void) MeshGPU = trust {
    val vertex_float_count: usize = (4 as usize) * (8 as usize)
    val index_count: i32 = 6 as i32
    val vertices: ref void = @alloc(vertex_float_count * (@sizeof(f32) as usize))
    val indices: ref void = @alloc((index_count as usize) * (@sizeof(u32) as usize))
    if vertices == none || indices == none {
        if vertices != none { @free(vertices) }
        if indices != none { @free(indices) }
        return { raw: none as ref void, index_count: 0 as i32 }
    }
    val n: ecs.Vec3 = vec3(0.0 as f32, 0.0 as f32, 1.0 as f32)
    write_vertex(vertices, 0 as usize, vec3(-0.5 as f32, -0.5 as f32, 0.0 as f32), n)
    write_vertex(vertices, 1 as usize, vec3( 0.5 as f32, -0.5 as f32, 0.0 as f32), n)
    write_vertex(vertices, 2 as usize, vec3( 0.5 as f32,  0.5 as f32, 0.0 as f32), n)
    write_vertex(vertices, 3 as usize, vec3(-0.5 as f32,  0.5 as f32, 0.0 as f32), n)
    store_u32(indices, 0 as usize, 0 as u32)
    store_u32(indices, 1 as usize, 1 as u32)
    store_u32(indices, 2 as usize, 2 as u32)
    store_u32(indices, 3 as usize, 0 as u32)
    store_u32(indices, 4 as usize, 2 as u32)
    store_u32(indices, 5 as usize, 3 as u32)
    val mesh: MeshGPU = upload_mesh(runtime, vertices, vertex_float_count, indices, index_count)
    @free(vertices)
    @free(indices)
    return mesh
}

fn mesh_valid(mesh: MeshGPU) bool = {
    return mesh.raw != none && mesh.index_count > (0 as i32)
}

fn camera_forward(camera: Camera) ecs.Vec3 = {
    val yaw_f64: f64 = camera.yaw as f64
    val pitch_f64: f64 = camera.pitch as f64
    val cp: f32 = (math.cos(pitch_f64)) as f32
    return vec3(
        (math.sin(yaw_f64) as f32) * cp,
        (math.sin(pitch_f64) as f32),
        (math.cos(yaw_f64) as f32) * cp
    )
}

fn update_camera(camera: mut Camera, input: InputConfig, dt: f32, keys: ref u8, mouse_dx: f32, mouse_dy: f32) void = trust {
    val yaw_step:   f32 = camera.turn_speed * dt
    val move_step:  f32 = camera.move_speed * dt
    val key_fwd:    u8 = @load8(@ptradd(keys, input.keys.move_forward as usize))
    val key_back:   u8 = @load8(@ptradd(keys, input.keys.move_back    as usize))
    val key_left:   u8 = @load8(@ptradd(keys, input.keys.move_left    as usize))
    val key_right:  u8 = @load8(@ptradd(keys, input.keys.move_right   as usize))
    val key_tleft:  u8 = @load8(@ptradd(keys, input.keys.turn_left    as usize))
    val key_tright: u8 = @load8(@ptradd(keys, input.keys.turn_right   as usize))
    val key_up:     u8 = @load8(@ptradd(keys, input.keys.look_up      as usize))
    val key_down:   u8 = @load8(@ptradd(keys, input.keys.look_down    as usize))
    if key_tleft  != 0 { camera.yaw = camera.yaw + yaw_step }
    if key_tright != 0 { camera.yaw = camera.yaw - yaw_step }
    if key_up     != 0 { camera.pitch = camera.pitch + yaw_step * (0.70 as f32) }
    if key_down   != 0 { camera.pitch = camera.pitch - yaw_step * (0.70 as f32) }
    if input.mouse.enabled {
        camera.yaw = camera.yaw - mouse_dx * input.mouse.sensitivity_x
        if input.mouse.invert_y {
            camera.pitch = camera.pitch + mouse_dy * input.mouse.sensitivity_y
        } else {
            camera.pitch = camera.pitch - mouse_dy * input.mouse.sensitivity_y
        }
    }
    if camera.pitch > (1.2 as f32) { camera.pitch = 1.2 as f32 }
    if camera.pitch < (-1.2 as f32) { camera.pitch = -1.2 as f32 }
    val forward: ecs.Vec3 = camera_forward(camera)
    val flat_fwd: ecs.Vec3 = vec3_normalize(vec3(forward.x, 0.0 as f32, forward.z))
    val right_v: ecs.Vec3 = vec3_normalize(vec3(-flat_fwd.z, 0.0 as f32, flat_fwd.x))
    if key_fwd != 0 { camera.position = vec3_add(camera.position, vec3_scale(flat_fwd, move_step)) }
    if key_back != 0 { camera.position = vec3_sub(camera.position, vec3_scale(flat_fwd, move_step)) }
    if key_left != 0 { camera.position = vec3_sub(camera.position, vec3_scale(right_v, move_step)) }
    if key_right != 0 { camera.position = vec3_add(camera.position, vec3_scale(right_v, move_step)) }
}

fn model_matrix_scaled(position: ecs.Vec3, scale: ecs.Vec3, rotation_y: f32) Mat4 = {
    return mat_mul(mat_translation(position), mat_mul(mat_rotation_y(rotation_y), mat_scale(scale)))
}

fn model_matrix(position: ecs.Vec3, uniform_scale: f32, rotation_y: f32) Mat4 = {
    return model_matrix_scaled(position, vec3(uniform_scale, uniform_scale, uniform_scale), rotation_y)
}

fn reflect_position_y(position: ecs.Vec3, plane_y: f32) ecs.Vec3 = {
    return vec3(position.x, ((2.0 as f32) * plane_y) - position.y, position.z)
}

fn mirrored_camera(camera: Camera, plane_y: f32) Camera = {
    return {
        position: reflect_position_y(camera.position, plane_y),
        yaw: camera.yaw,
        pitch: -camera.pitch,
        move_speed: camera.move_speed,
        turn_speed: camera.turn_speed
    }
}

fn view_projection(camera: Camera, width: i32, height: i32) Mat4 = {
    val aspect: f32 = (width as f32) / (height as f32)
    val projection: Mat4 = mat_perspective((60.0 as f32) * ((mstat.PI as f32) / (180.0 as f32)), aspect, 0.1 as f32, 100.0 as f32)
    val center: ecs.Vec3 = vec3_add(camera.position, camera_forward(camera))
    val view: Mat4 = mat_look_at(camera.position, center, vec3(0.0 as f32, 1.0 as f32, 0.0 as f32))
    return mat_mul(projection, view)
}

fn draw_mesh(runtime: ref void, mesh: MeshGPU, model: Mat4, view_proj: Mat4, color: ecs.Vec3, camera_pos: ecs.Vec3, reflective: f32, glow: f32, alpha: f32, light: ecs.PointLight) void = trust {
    exo_sdl3_draw_scene_mesh(
        runtime,
        mesh.raw,
        @addr(model.m00),
        @addr(view_proj.m00),
        @addr(color.x),
        @addr(camera_pos.x),
        reflective,
        glow,
        alpha,
        @addr(light.position.x),
        @addr(light.color.x),
        light.intensity,
        light.radius
    )
}

fn draw_billboard(runtime: ref void, mesh: MeshGPU, pos: ecs.Vec3, width: f32, height: f32, view_proj: Mat4, cam_right: ecs.Vec3, cam_up: ecs.Vec3, color: ecs.Vec3, intensity: f32, alpha: f32) void = trust {
    exo_sdl3_draw_glow(
        runtime,
        mesh.raw,
        @addr(view_proj.m00),
        @addr(pos.x),
        width,
        height,
        @addr(cam_right.x),
        @addr(cam_up.x),
        @addr(color.x),
        intensity,
        alpha
    )
}

fn draw_typed_entities[E: ecs.SceneEntity](runtime: ref void, mesh: MeshGPU, entities: list[E], camera: Camera, view_proj: Mat4, time: f32, glow_scale: f32, light: ecs.PointLight) void = trust {
    for entity in entities {
        val mm: Mat4 = model_matrix(E.se_position(entity), E.se_scale(entity), E.se_rotation(entity, time))
        draw_mesh(runtime, mesh, mm, view_proj, E.se_color(entity), camera.position, E.se_reflective(entity), glow_scale * (0.025 as f32), 1.0 as f32, light)
    }
}

fn draw_scene_entities(runtime: ref void, cube_mesh: MeshGPU, sphere_mesh: MeshGPU, scene: ecs.Scene3D, camera: Camera, view_proj: Mat4, time: f32, glow_scale: f32) void = trust {
    draw_typed_entities[ecs.SphereEntity](runtime, sphere_mesh, scene.spheres, camera, view_proj, time, glow_scale, scene.light)
    draw_typed_entities[ecs.CubeEntity](runtime, cube_mesh, scene.cubes, camera, view_proj, time, glow_scale, scene.light)
}

fn draw_floor(runtime: ref void, mesh: MeshGPU, model: Mat4, view_proj: Mat4, reflect_view_proj: Mat4, camera: Camera) void = trust {
    exo_sdl3_draw_floor(runtime, mesh.raw, @addr(model.m00), @addr(view_proj.m00), @addr(reflect_view_proj.m00), @addr(camera.position.x))
}

fn draw_water(runtime: ref void, mesh: MeshGPU, model: Mat4, view_proj: Mat4, reflect_view_proj: Mat4, camera: Camera, color: ecs.Vec3, wave_offset: f32, wave_amplitude: f32, wave_frequency: f32, light: ecs.PointLight, corner_radius: f32, size_x: f32, size_z: f32) void = trust {
    if runtime == none || mesh.raw == none {
        return
    }
    val rt: ref ExoSDL3Runtime = runtime as ref ExoSDL3Runtime
    if rt.water_pipeline == none {
        return
    }
    val vu: mut WaterVertexUniforms = {
        model:      transpose_mat4_ptr(@addr(model.m00)),
        view_proj:  transpose_mat4_ptr(@addr(view_proj.m00)),
        reflect_vp: transpose_mat4_ptr(@addr(reflect_view_proj.m00)),
        time_wave:  { x: wave_offset, y: wave_amplitude, z: wave_frequency, w: 0.0 as f32 }
    }
    val light_dir: ecs.Vec3 = vec3_normalize(vec3_sub(light.position, vec3(0.0 as f32, 0.0 as f32, 0.0 as f32)))
    val fu: mut WaterFragmentUniforms = {
        camera_pos:   { x: camera.position.x, y: camera.position.y, z: camera.position.z, w: wave_offset },
        water_color:  { x: color.x, y: color.y, z: color.z, w: 0.0 as f32 },
        light_dir:    { x: light_dir.x, y: light_dir.y, z: light_dir.z, w: light.intensity },
        water_params: { x: corner_radius, y: size_x, z: size_z, w: 0.0 as f32 }
    }
    SDL_BindGPUGraphicsPipeline(rt.current_pass, rt.water_pipeline)
    SDL_PushGPUVertexUniformData(rt.command_buffer, 0 as u32, @addr(vu) as ref void, @sizeof(WaterVertexUniforms) as u32)
    SDL_PushGPUFragmentUniformData(rt.command_buffer, 0 as u32, @addr(fu) as ref void, @sizeof(WaterFragmentUniforms) as u32)
    val normal_tex: mut ref void = rt.reflection_color
    
    if rt.normal_map_texture != none { normal_tex = rt.normal_map_texture }
    val bindings_raw: ref void = @alloc(2 as usize * @sizeof(SDLGPUTextureSamplerBinding) as usize)
    val b0: mut ref SDLGPUTextureSamplerBinding = bindings_raw as mut ref SDLGPUTextureSamplerBinding
    val b1: mut ref SDLGPUTextureSamplerBinding = @ptradd(bindings_raw, @sizeof(SDLGPUTextureSamplerBinding) as usize) as mut ref SDLGPUTextureSamplerBinding
    b0.texture = rt.reflection_color
    b0.sampler = rt.linear_sampler
    b1.texture = normal_tex
    b1.sampler = rt.repeat_sampler
    SDL_BindGPUFragmentSamplers(rt.current_pass, 0 as u32, bindings_raw as ref SDLGPUTextureSamplerBinding, 2 as u32)
    @free(bindings_raw)
    exo_bind_mesh(rt, mesh.raw as ref ExoSDL3Mesh)
    SDL_DrawGPUIndexedPrimitives(rt.current_pass, mesh.index_count as u32, 1 as u32, 0 as u32, 0 as i32, 0 as u32)
}

fn render_reflection_scene(runtime: ref void, cube_mesh: MeshGPU, sphere_mesh: MeshGPU, scene: ecs.Scene3D, camera: Camera, width: i32, height: i32, time: f32, plane_y: f32) void = trust {
    val mirror_y: mut f32 = plane_y
    if scene.water is some water { mirror_y = water.y }
    val mirrored: Camera = mirrored_camera(camera, mirror_y)
    val reflect_vp: Mat4 = view_projection(mirrored, width, height)
    draw_scene_entities(runtime, cube_mesh, sphere_mesh, scene, mirrored, reflect_vp, time, 0.60 as f32)
}

fn render_scene(runtime: ref void, cube_mesh: MeshGPU, sphere_mesh: MeshGPU, quad_mesh: MeshGPU, glb_mesh: MeshGPU, scene: ecs.Scene3D, camera: Camera, width: i32, height: i32, time: f32) void = trust {
    val vp: Mat4 = view_projection(camera, width, height)
    val floor_y: f32 = -0.18 as f32
    val floor_position: ecs.Vec3 = vec3(0.0 as f32, floor_y - (0.08 as f32), -1.45 as f32)
    val floor_scale: ecs.Vec3 = vec3(7.8 as f32, 0.16 as f32, 7.8 as f32)
    val reflect_vp: Mat4 = view_projection(mirrored_camera(camera, floor_y), width, height)
    draw_scene_entities(runtime, cube_mesh, sphere_mesh, scene, camera, vp, time, 1.00 as f32)
    if mesh_valid(glb_mesh) {
        val glb_mm: Mat4 = model_matrix(vec3(0.0 as f32, 0.0 as f32, 0.0 as f32), scene.model_scale, 0.0 as f32)
        draw_mesh(runtime, glb_mesh, glb_mm, vp, scene.light.color, camera.position, 0.05 as f32, 0.0 as f32, 1.0 as f32, scene.light)
    }
    if scene.floor is some _ {
        draw_floor(runtime, cube_mesh, model_matrix_scaled(floor_position, floor_scale, 0.0 as f32), vp, reflect_vp, camera)
    }
    if scene.water is some water {
        val wave_offset: f32 = time * water.wave_speed
        val fit_x: mut f32 = water.size_x
        val fit_z: mut f32 = water.size_z
        val fit_ox: mut f32 = water.offset_x
        val fit_oz: mut f32 = water.offset_z
        val fit_y: mut f32 = water.y
        if fit_x == (0.0 as f32) && fit_z == (0.0 as f32) && scene.model.valid {
            val s: f32 = scene.model_scale
            fit_x  = (scene.model.bounds_max_x - scene.model.bounds_min_x) * s * water.fit_scale
            fit_z  = (scene.model.bounds_max_z - scene.model.bounds_min_z) * s * water.fit_scale
            fit_ox = ((scene.model.bounds_min_x + scene.model.bounds_max_x) * 0.5 as f32) * s
            fit_oz = ((scene.model.bounds_min_z + scene.model.bounds_max_z) * 0.5 as f32) * s
            fit_y  = scene.model.bounds_max_y * s + water.y
        }
        val water_position: ecs.Vec3 = vec3(fit_ox, fit_y, fit_oz)
        val water_scale: ecs.Vec3 = vec3(fit_x, 0.04 as f32, fit_z)
        val water_model: Mat4 = model_matrix_scaled(water_position, water_scale, 0.0 as f32)
        val reflect_water_vp: Mat4 = view_projection(mirrored_camera(camera, fit_y), width, height)
        draw_water(runtime, cube_mesh, water_model, vp, reflect_water_vp, camera, water.color, wave_offset, water.wave_amplitude, water.wave_frequency, scene.light, water.corner_radius, fit_x, fit_z)
    }
    val light_pos: ecs.Vec3 = scene.light.position
    val light_color: ecs.Vec3 = scene.light.color
    val cam_fwd: ecs.Vec3 = camera_forward(camera)
    val world_up_v: ecs.Vec3 = vec3(0.0 as f32, 1.0 as f32, 0.0 as f32)
    val cam_right: ecs.Vec3 = vec3_normalize(vec3_cross(cam_fwd, world_up_v))
    val cam_up: ecs.Vec3 = vec3_normalize(vec3_cross(cam_right, cam_fwd))
    draw_billboard(runtime, quad_mesh, light_pos, 1.05 as f32, 1.05 as f32, vp, cam_right, cam_up, light_color, 1.4 as f32, 0.62 as f32)
}

fn print_sdl_error(prefix: ref u8) void = {
    trust stdio.eprint("{s}: {s}\n", {prefix, exo_sdl3_get_error()})
}

fn audio_enabled(config: AudioMixerConfig) bool = {
    if config.sample.path == none {
        return false
    }
    return string.len_raw(config.sample.path) > (0 as usize)
}

fn init_runtime_audio(config: AudioMixerConfig) RuntimeAudioMixer = trust {
    val runtime: mut RuntimeAudioMixer = {
        initialized: false,
        sample_audio: none as ref void
    }
    if !audio_enabled(config) {
        return runtime
    }
    runtime.sample_audio = exo_sdl3_create_audio(config.sample.path, config.music_volume)
    if runtime.sample_audio == none {
        return runtime
    }
    runtime.initialized = true
    return runtime
}

fn shutdown_runtime_audio(runtime: RuntimeAudioMixer) void = trust {
    if runtime.sample_audio != none {
        exo_sdl3_destroy_audio(runtime.sample_audio)
    }
}

fn play_runtime_audio(config: AudioMixerConfig, runtime: RuntimeAudioMixer) bool = trust {
    if !runtime.initialized || runtime.sample_audio == none {
        return false
    }
    return exo_sdl3_play_audio(runtime.sample_audio, config.sample.loops, config.music_volume)
}

fn set_active_scene(app: mut ExoApp, index: usize) void = {
    if @get(app.scenes, index) is some scene {
        app.active_scene_index = index
        app.scene = scene
    }
}

fn cycle_scene(app: mut ExoApp) void = {
    val count: usize = @len(app.scenes)
    if count <= (1 as usize) {
        return
    }
    val next_index: usize = app.active_scene_index + (1 as usize)
    if next_index >= count {
        set_active_scene(app, 0 as usize)
        return
    }
    set_active_scene(app, next_index)
}

fn run_app_internal[U: SceneUpdater](app0: ExoApp, updater0: U) i32 = trust {
    val app: mut ExoApp = app0
    val updater: U = updater0
    val runtime: ref void = exo_sdl3_create_runtime(app.config.title, app.config.width, app.config.height, app.config.shaders)
    if runtime == none {
        print_sdl_error("SDL3 runtime init failed")
        return 1 as i32
    }
    if app.input.mouse.enabled {
        if !exo_sdl3_set_relative_mouse_mode(runtime, true) {
            print_sdl_error("SDL_SetWindowRelativeMouseMode failed")
            exo_sdl3_destroy_runtime(runtime)
            return 1 as i32
        }
    }
    val cube_mesh: MeshGPU = build_cube_mesh(runtime)
    val sphere_mesh: MeshGPU = build_sphere_mesh(runtime, 16 as i32, 24 as i32)
    val quad_mesh: MeshGPU = build_quad_mesh(runtime)
    if !mesh_valid(cube_mesh) || !mesh_valid(sphere_mesh) || !mesh_valid(quad_mesh) {
        destroy_mesh(runtime, quad_mesh)
        destroy_mesh(runtime, sphere_mesh)
        destroy_mesh(runtime, cube_mesh)
        exo_sdl3_destroy_runtime(runtime)
        return 1 as i32
    }
    val glb_mesh: mut MeshGPU = { raw: none as ref void, index_count: 0 as i32 }
    if app.scene.model.valid && app.scene.model.raw_bytes != none && app.scene.model.bin_length > (0 as usize) {
        glb_mesh = upload_glb_model(runtime, app.scene.model)
        val rt: mut ref ExoSDL3Runtime = runtime as mut ref ExoSDL3Runtime
        upload_glb_texture(rt, app.scene.model)
    }
    val last_scene_index: mut usize = app.active_scene_index
    val audio_runtime: RuntimeAudioMixer = init_runtime_audio(app.audio)
    if audio_enabled(app.audio) && !audio_runtime.initialized {
        print_sdl_error("SDL3 audio init failed")
        destroy_mesh(runtime, quad_mesh)
        destroy_mesh(runtime, sphere_mesh)
        destroy_mesh(runtime, cube_mesh)
        exo_sdl3_destroy_runtime(runtime)
        return 1 as i32
    }
    val start_ticks: u64 = exo_sdl3_get_ticks()
    val last_ticks: mut u64 = start_ticks
    val quit: mut bool = false
    val exit_code: mut i32 = 0 as i32
    val prev_scene_key: mut u8 = 0 as u8
    val prev_audio_key: mut u8 = 0 as u8
    for !quit {
        if exo_sdl3_poll_quit() {
            quit = true
        }
        val keys: ref u8 = exo_sdl3_get_keyboard_state()
        val quit_pressed: u8 = @load8(@ptradd(keys, app.input.quit_key as usize))
        val scene_pressed: u8 = @load8(@ptradd(keys, app.next_scene_key as usize))
        val audio_pressed: u8 = @load8(@ptradd(keys, app.audio.trigger_key as usize))
        if quit_pressed != 0 {
            quit = true
        }
        if scene_pressed != 0 && prev_scene_key == 0 {
            cycle_scene(app)
            // Re-upload GLB mesh when scene changes
            if app.active_scene_index != last_scene_index {
                destroy_mesh(runtime, glb_mesh)
                glb_mesh = { raw: none as ref void, index_count: 0 as i32 }
                if app.scene.model.valid && app.scene.model.raw_bytes != none && app.scene.model.bin_length > (0 as usize) {
                    glb_mesh = upload_glb_model(runtime, app.scene.model)
                    val rt2: mut ref ExoSDL3Runtime = runtime as mut ref ExoSDL3Runtime
                    upload_glb_texture(rt2, app.scene.model)
                } else {
                    val rt2: mut ref ExoSDL3Runtime = runtime as mut ref ExoSDL3Runtime
                    if rt2.glb_texture != none {
                        SDL_ReleaseGPUTexture(rt2.device, rt2.glb_texture)
                        rt2.glb_texture = none
                    }
                }
                last_scene_index = app.active_scene_index
            }
        }
        if audio_pressed != 0 && prev_audio_key == 0 {
            if !play_runtime_audio(app.audio, audio_runtime) {
                print_sdl_error("SDL3 audio play failed")
            }
        }
        prev_scene_key = scene_pressed
        prev_audio_key = audio_pressed

        val mx: mut f32 = 0.0 as f32
        val my: mut f32 = 0.0 as f32
        exo_sdl3_get_relative_mouse_state(@addr(mx), @addr(my))

        val now_ticks: u64 = exo_sdl3_get_ticks()
        val dt_raw: f32 = ((now_ticks - last_ticks) as f32) / (1000.0 as f32)
        val dt: f32 = math.fclamp(dt_raw as f64, 0.0, 0.05) as f32
        val time_value: f32 = ((now_ticks - start_ticks) as f32) / (1000.0 as f32)
        last_ticks = now_ticks
        update_camera(app.camera, app.input, dt, keys, mx, my)
        U.su_update(updater, app.scene, dt, time_value)

        val frame_w: mut u32 = app.config.width as u32
        val frame_h: mut u32 = app.config.height as u32
        if !exo_sdl3_begin_frame(runtime, @addr(frame_w), @addr(frame_h)) {
            print_sdl_error("SDL3 begin frame failed")
            exit_code = 1 as i32
            break
        }
        if !exo_sdl3_begin_reflection_pass(runtime, 0.05 as f32, 0.08 as f32, 0.14 as f32, 1.0 as f32) {
            print_sdl_error("SDL3 reflection pass failed")
            exit_code = 1 as i32
            break
        }
        render_reflection_scene(runtime, cube_mesh, sphere_mesh, app.scene, app.camera, frame_w as i32, frame_h as i32, time_value, -0.18 as f32)
        if !exo_sdl3_begin_scene_pass(runtime, 0.09 as f32, 0.15 as f32, 0.30 as f32, 1.0 as f32) {
            print_sdl_error("SDL3 scene pass failed")
            exit_code = 1 as i32
            break
        }
        render_scene(runtime, cube_mesh, sphere_mesh, quad_mesh, glb_mesh, app.scene, app.camera, frame_w as i32, frame_h as i32, time_value)
        if !exo_sdl3_apply_fxaa(runtime) {
            print_sdl_error("SDL3 FXAA pass failed")
            exit_code = 1 as i32
            break
        }
        exo_sdl3_end_pass(runtime)
        if !exo_sdl3_submit_frame(runtime) {
            print_sdl_error("SDL3 submit frame failed")
            exit_code = 1 as i32
            break
        }
    }
    shutdown_runtime_audio(audio_runtime)
    destroy_mesh(runtime, glb_mesh)
    destroy_mesh(runtime, quad_mesh)
    destroy_mesh(runtime, sphere_mesh)
    destroy_mesh(runtime, cube_mesh)
    exo_sdl3_destroy_runtime(runtime)
    return exit_code
}

pub fn run_app_with_scene_updater[U: SceneUpdater](app: ExoApp, updater: U) i32 = trust {
    return run_app_internal[U](app, updater)
}

pub fn run_app(app0: ExoApp) i32 = trust {
    val updater: NoSceneUpdater = {
        _unused: 0 as u8
    }
    return run_app_internal[NoSceneUpdater](app0, updater)
}
