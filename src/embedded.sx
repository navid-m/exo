val string = use("std/string")

/// A compile-time embedded engine asset.
pub type EmbeddedAsset = {
    key: ref u8
    data: ref u8
    len: usize
}

val scene_vert_spv = @embed("../assets/shaders/scene.vert.spv")
val scene_frag_spv = @embed("../assets/shaders/scene.frag.spv")
val instanced_vert_spv = @embed("../assets/shaders/instanced.vert.spv")
val instanced_frag_spv = @embed("../assets/shaders/instanced.frag.spv")
val sky_frag_spv = @embed("../assets/shaders/sky.frag.spv")
val floor_vert_spv = @embed("../assets/shaders/floor.vert.spv")
val floor_frag_spv = @embed("../assets/shaders/floor.frag.spv")
val glow_vert_spv = @embed("../assets/shaders/glow.vert.spv")
val glow_frag_spv = @embed("../assets/shaders/glow.frag.spv")
val water_vert_spv = @embed("../assets/shaders/water.vert.spv")
val water_frag_spv = @embed("../assets/shaders/water.frag.spv")
val fullscreen_vert_spv = @embed("../assets/shaders/fullscreen.vert.spv")
val bloom_threshold_frag_spv = @embed("../assets/shaders/bloom_threshold.frag.spv")
val bloom_blur_frag_spv = @embed("../assets/shaders/bloom_blur.frag.spv")
val godrays_frag_spv = @embed("../assets/shaders/godrays.frag.spv")
val sharpen_frag_spv = @embed("../assets/shaders/sharpen.frag.spv")
val flare_frag_spv = @embed("../assets/shaders/flare.frag.spv")
val taa_frag_spv = @embed("../assets/shaders/taa.frag.spv")
val composite_frag_spv = @embed("../assets/shaders/composite.frag.spv")

val scene_vert_msl = @embed("../assets/shaders/scene.vert.msl")
val scene_frag_msl = @embed("../assets/shaders/scene.frag.msl")
val instanced_vert_msl = @embed("../assets/shaders/instanced.vert.msl")
val instanced_frag_msl = @embed("../assets/shaders/instanced.frag.msl")
val sky_frag_msl = @embed("../assets/shaders/sky.frag.msl")
val floor_vert_msl = @embed("../assets/shaders/floor.vert.msl")
val floor_frag_msl = @embed("../assets/shaders/floor.frag.msl")
val glow_vert_msl = @embed("../assets/shaders/glow.vert.msl")
val glow_frag_msl = @embed("../assets/shaders/glow.frag.msl")
val water_vert_msl = @embed("../assets/shaders/water.vert.msl")
val water_frag_msl = @embed("../assets/shaders/water.frag.msl")
val fullscreen_vert_msl = @embed("../assets/shaders/fullscreen.vert.msl")
val bloom_threshold_frag_msl = @embed("../assets/shaders/bloom_threshold.frag.msl")
val bloom_blur_frag_msl = @embed("../assets/shaders/bloom_blur.frag.msl")
val godrays_frag_msl = @embed("../assets/shaders/godrays.frag.msl")
val sharpen_frag_msl = @embed("../assets/shaders/sharpen.frag.msl")
val flare_frag_msl = @embed("../assets/shaders/flare.frag.msl")
val taa_frag_msl = @embed("../assets/shaders/taa.frag.msl")
val composite_frag_msl = @embed("../assets/shaders/composite.frag.msl")

val default_font = @embed("../assets/fonts/default.png")
val normal_map = @embed("../assets/normal_map.jpg")
val example_sound = @embed("../assets/example_sound.wav")

fn asset(key: ref u8, data: ref u8, len: i64) EmbeddedAsset = {
    return {
        key: key,
        data: data,
        len: len as usize
    }
}

fn key_matches(a: ref u8, b: ref u8) bool = trust {
    if string.raw_cmp(a, b) == 0 {
        return true
    }
    val ai: mut ref u8 = a
    val bi: mut ref u8 = b
    if string.len_raw(ai) > 2 && @load8(ai) == (46 as u8) && @load8(@ptradd(ai, 1)) == (47 as u8) {
        ai = @ptradd(ai, 2) as ref u8
    }
    if string.len_raw(bi) > 2 && @load8(bi) == (46 as u8) && @load8(@ptradd(bi, 1)) == (47 as u8) {
        bi = @ptradd(bi, 2) as ref u8
    }
    return string.raw_cmp(ai, bi) == 0
}

/// Look up an embedded asset by the path that would normally be used on disk.
pub fn find(key: ref u8) option[EmbeddedAsset] = trust {
    val assets: mut list[EmbeddedAsset] = []
    @append(
        assets,
        asset(
            "./assets/shaders/scene.vert.spv",
            scene_vert_spv,
            @embedlen("../assets/shaders/scene.vert.spv")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/scene.frag.spv",
            scene_frag_spv,
            @embedlen("../assets/shaders/scene.frag.spv")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/instanced.vert.spv",
            instanced_vert_spv,
            @embedlen("../assets/shaders/instanced.vert.spv")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/instanced.frag.spv",
            instanced_frag_spv,
            @embedlen("../assets/shaders/instanced.frag.spv")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/sky.frag.spv",
            sky_frag_spv,
            @embedlen("../assets/shaders/sky.frag.spv")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/floor.vert.spv",
            floor_vert_spv,
            @embedlen("../assets/shaders/floor.vert.spv")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/floor.frag.spv",
            floor_frag_spv,
            @embedlen("../assets/shaders/floor.frag.spv")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/glow.vert.spv",
            glow_vert_spv,
            @embedlen("../assets/shaders/glow.vert.spv")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/glow.frag.spv",
            glow_frag_spv,
            @embedlen("../assets/shaders/glow.frag.spv")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/water.vert.spv",
            water_vert_spv,
            @embedlen("../assets/shaders/water.vert.spv")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/water.frag.spv",
            water_frag_spv,
            @embedlen("../assets/shaders/water.frag.spv")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/fullscreen.vert.spv",
            fullscreen_vert_spv,
            @embedlen("../assets/shaders/fullscreen.vert.spv")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/bloom_threshold.frag.spv",
            bloom_threshold_frag_spv,
            @embedlen("../assets/shaders/bloom_threshold.frag.spv")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/bloom_blur.frag.spv",
            bloom_blur_frag_spv,
            @embedlen("../assets/shaders/bloom_blur.frag.spv")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/godrays.frag.spv",
            godrays_frag_spv,
            @embedlen("../assets/shaders/godrays.frag.spv")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/sharpen.frag.spv",
            sharpen_frag_spv,
            @embedlen("../assets/shaders/sharpen.frag.spv")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/flare.frag.spv",
            flare_frag_spv,
            @embedlen("../assets/shaders/flare.frag.spv")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/taa.frag.spv",
            taa_frag_spv,
            @embedlen("../assets/shaders/taa.frag.spv")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/composite.frag.spv",
            composite_frag_spv,
            @embedlen("../assets/shaders/composite.frag.spv")
        )
    )

    @append(
        assets,
        asset(
            "./assets/shaders/scene.vert.msl",
            scene_vert_msl,
            @embedlen("../assets/shaders/scene.vert.msl")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/scene.frag.msl",
            scene_frag_msl,
            @embedlen("../assets/shaders/scene.frag.msl")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/instanced.vert.msl",
            instanced_vert_msl,
            @embedlen("../assets/shaders/instanced.vert.msl")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/instanced.frag.msl",
            instanced_frag_msl,
            @embedlen("../assets/shaders/instanced.frag.msl")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/sky.frag.msl",
            sky_frag_msl,
            @embedlen("../assets/shaders/sky.frag.msl")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/floor.vert.msl",
            floor_vert_msl,
            @embedlen("../assets/shaders/floor.vert.msl")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/floor.frag.msl",
            floor_frag_msl,
            @embedlen("../assets/shaders/floor.frag.msl")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/glow.vert.msl",
            glow_vert_msl,
            @embedlen("../assets/shaders/glow.vert.msl")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/glow.frag.msl",
            glow_frag_msl,
            @embedlen("../assets/shaders/glow.frag.msl")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/water.vert.msl",
            water_vert_msl,
            @embedlen("../assets/shaders/water.vert.msl")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/water.frag.msl",
            water_frag_msl,
            @embedlen("../assets/shaders/water.frag.msl")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/fullscreen.vert.msl",
            fullscreen_vert_msl,
            @embedlen("../assets/shaders/fullscreen.vert.msl")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/bloom_threshold.frag.msl",
            bloom_threshold_frag_msl,
            @embedlen("../assets/shaders/bloom_threshold.frag.msl")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/bloom_blur.frag.msl",
            bloom_blur_frag_msl,
            @embedlen("../assets/shaders/bloom_blur.frag.msl")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/godrays.frag.msl",
            godrays_frag_msl,
            @embedlen("../assets/shaders/godrays.frag.msl")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/sharpen.frag.msl",
            sharpen_frag_msl,
            @embedlen("../assets/shaders/sharpen.frag.msl")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/flare.frag.msl",
            flare_frag_msl,
            @embedlen("../assets/shaders/flare.frag.msl")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/taa.frag.msl",
            taa_frag_msl,
            @embedlen("../assets/shaders/taa.frag.msl")
        )
    )
    @append(
        assets,
        asset(
            "./assets/shaders/composite.frag.msl",
            composite_frag_msl,
            @embedlen("../assets/shaders/composite.frag.msl")
        )
    )

    @append(
        assets,
        asset("./assets/fonts/default.png", default_font, @embedlen("../assets/fonts/default.png"))
    )
    @append(
        assets,
        asset("./assets/normal_map.png", normal_map, @embedlen("../assets/normal_map.jpg"))
    )
    @append(
        assets,
        asset("./assets/example_sound.wav", example_sound, @embedlen("../assets/example_sound.wav"))
    )

    for entry in assets {
        if key_matches(entry.key, key) {
            return some entry
        }
    }
    return none
}
