val math    = use("math.sx")
val ecs     = use("../ecs.sx")
val stdmath = use("std/math")
val string  = use("std/string")

fn mat_at(items: list[math.Mat4], index: usize) math.Mat4 = trust {
    if @get(items, index) is some value {
        return value
    }
    return math.mat4_identity()
}

fn vec3_at(items: list[math.Vec3], index: usize) math.Vec3 = trust {
    if @get(items, index) is some value {
        return value
    }
    return math.vec3(0.0 as f32, 0.0 as f32, 0.0 as f32)
}

fn quat_at(items: list[math.Vec4f], index: usize) math.Vec4f = trust {
    if @get(items, index) is some value {
        return value
    }
    return math.quat(0.0 as f32, 0.0 as f32, 0.0 as f32, 1.0 as f32)
}

fn bool_at(items: list[bool], index: usize) bool = trust {
    if @get(items, index) is some value {
        return value
    }
    return false
}

type AnimSample = {
    a: usize
    b: usize
    t: f32
}

fn component_size(component_type: i32) usize = {
    if component_type == (5120 as i32) || component_type == (5121 as i32) {
        return 1 as usize
    }
    if component_type == (5122 as i32) || component_type == (5123 as i32) {
        return 2 as usize
    }
    return 4 as usize
}

/// Read one component of an accessor as a float.
pub fn accessor_f32(
    asset: ecs.ModelAsset,
    accessor_index: i32,
    element: usize,
    component: usize
) f32 = trust {
    if accessor_index < (0 as i32) || asset.raw_bytes == none {
        return 0.0 as f32
    }
    if @get(asset.accessors, accessor_index as usize) is some acc {
        if element >= (acc.count as usize) {
            return 0.0 as f32
        }
        if component >= (acc.components as usize) {
            return 0.0 as f32
        }
        val offset: usize = acc.offset + element * acc.stride + component * component_size(acc.component_type)
        val ptr: ref u8 = @ptradd(asset.raw_bytes, offset) as ref u8
        if acc.component_type == (5126 as i32) {
            return math.read_f32(@ptradd(ptr, 0 as usize) as ref f32, 0 as usize)
        }
        if acc.component_type == (5121 as i32) {
            val raw: f32 = @load8(ptr) as f32
            if acc.normalized {
                return raw / (255.0 as f32)
            }
            return raw
        }
        if acc.component_type == (5123 as i32) {
            val raw: f32 = @load16(ptr) as f32
            if acc.normalized {
                return raw / (65535.0 as f32)
            }
            return raw
        }
        if acc.component_type == (5120 as i32) {
            return @load8(ptr) as i8 as f32
        }
        if acc.component_type == (5122 as i32) {
            return @load16(ptr) as i16 as f32
        }
        if acc.component_type == (5125 as i32) {
            return @load32(ptr) as u32 as f32
        }
    }
    return 0.0 as f32
}

fn accessor_count(asset: ecs.ModelAsset, accessor_index: i32) usize = trust {
    if accessor_index >= (0 as i32) {
        if @get(asset.accessors, accessor_index as usize) is some acc {
            return acc.count as usize
        }
    }
    return 0 as usize
}

fn channel_time(asset: ecs.ModelAsset, channel: ecs.ModelAnimChannel, index: usize) f32 = trust {
    return accessor_f32(asset, channel.input, index, 0 as usize)
}

fn sample_index(
    asset: ecs.ModelAsset,
    channel: ecs.ModelAnimChannel,
    time: f32
) AnimSample = trust {
    val count: usize = accessor_count(asset, channel.input)
    if count == (0 as usize) {
        return { a: 0 as usize, b: 0 as usize, t: 0.0 as f32 }
    }
    if count == (1 as usize) {
        return { a: 0 as usize, b: 0 as usize, t: 0.0 as f32 }
    }
    val first: f32 = channel_time(asset, channel, 0 as usize)
    val last: f32 = channel_time(asset, channel, count - (1 as usize))
    if time <= first {
        return { a: 0 as usize, b: 0 as usize, t: 0.0 as f32 }
    }
    if time >= last {
        return { a: count - (1 as usize), b: count - (1 as usize), t: 0.0 as f32 }
    }
    val index: mut usize = 0 as usize
    for index < count - (1 as usize) {
        val a: f32 = channel_time(asset, channel, index)
        val b: f32 = channel_time(asset, channel, index + (1 as usize))
        if time >= a && time <= b {
            if channel.interpolation == (1 as i32) || b <= a {
                return { a: index, b: index, t: 0.0 as f32 }
            }
            return { a: index, b: index + (1 as usize), t: (time - a) / (b - a) }
        }
        index = index + (1 as usize)
    }
    return { a: count - (1 as usize), b: count - (1 as usize), t: 0.0 as f32 }
}

fn sample_vec3(asset: ecs.ModelAsset, channel: ecs.ModelAnimChannel, time: f32) math.Vec3 = trust {
    val sampled: AnimSample = sample_index(asset, channel, time)
    val a: usize = sampled.a
    val b: usize = sampled.b
    val t: f32 = sampled.t
    val ax: f32 = accessor_f32(asset, channel.output, a, 0 as usize)
    val ay: f32 = accessor_f32(asset, channel.output, a, 1 as usize)
    val az: f32 = accessor_f32(asset, channel.output, a, 2 as usize)
    if t <= (0.0 as f32) || a == b {
        return math.vec3(ax, ay, az)
    }
    val bx: f32 = accessor_f32(asset, channel.output, b, 0 as usize)
    val by: f32 = accessor_f32(asset, channel.output, b, 1 as usize)
    val bz: f32 = accessor_f32(asset, channel.output, b, 2 as usize)
    return math.vec3(
        ax + (bx - ax) * t,
        ay + (by - ay) * t,
        az + (bz - az) * t
    )
}

fn sample_quat(asset: ecs.ModelAsset, channel: ecs.ModelAnimChannel, time: f32) math.Vec4f = trust {
    val sampled: AnimSample = sample_index(asset, channel, time)
    val a: usize = sampled.a
    val b: usize = sampled.b
    val t: f32 = sampled.t
    val av: math.Vec4f = math.quat(
        accessor_f32(asset, channel.output, a, 0 as usize),
        accessor_f32(asset, channel.output, a, 1 as usize),
        accessor_f32(asset, channel.output, a, 2 as usize),
        accessor_f32(asset, channel.output, a, 3 as usize)
    )
    if t <= (0.0 as f32) || a == b {
        return math.quat_normalize(av)
    }
    val bv: math.Vec4f = math.quat(
        accessor_f32(asset, channel.output, b, 0 as usize),
        accessor_f32(asset, channel.output, b, 1 as usize),
        accessor_f32(asset, channel.output, b, 2 as usize),
        accessor_f32(asset, channel.output, b, 3 as usize)
    )
    return math.quat_normalize(math.quat_slerp(av, bv, t))
}

/// Find an animation clip by name. Returns -1 when it is not present.
pub fn find_animation(asset: ecs.ModelAsset, name: ref u8) i32 = trust {
    val index: mut usize = 0 as usize
    for animation in asset.animations {
        if animation.name != none && string.raw_cmp(animation.name, name) == (0 as i64) {
            return index as i32
        }
        index = index + (1 as usize)
    }
    return -1 as i32
}

pub fn animation_duration(asset: ecs.ModelAsset, animation_index: i32) f32 = trust {
    if animation_index >= (0 as i32) {
        if @get(asset.animations, animation_index as usize) is some animation {
            return animation.duration
        }
    }
    return 0.0 as f32
}

fn local_matrix(node: ecs.ModelNode) math.Mat4 = {
    if node.has_matrix {
        return node.matrix
    }
    return math.mat_from_trs(node.translation, node.rotation, node.scale)
}

/// Compute every node's global transform, applying an animation clip when one
/// is supplied. The returned list is indexed by node index.
pub fn compute_globals(
    asset: ecs.ModelAsset,
    animation_index: i32,
    time: f32
) list[math.Mat4] = trust {
    val count: usize = @len(asset.nodes)
    val local: mut list[math.Mat4] = []
    val translations: mut list[math.Vec3] = []
    val rotations: mut list[math.Vec4f] = []
    val scales: mut list[math.Vec3] = []
    val overridden: mut list[bool] = []
    val index: mut usize = 0 as usize
    for node in asset.nodes {
        @append(local, local_matrix(node))
        @append(translations, node.translation)
        @append(rotations, node.rotation)
        @append(scales, node.scale)
        @append(overridden, false)
        index = index + (1 as usize)
    }

    if animation_index >= (0 as i32) {
        if @get(asset.animations, animation_index as usize) is some animation {
            val clip_time: mut f32 = time
            if animation.duration > (0.0 as f32) {
                val wraps: f32 = stdmath.floor((clip_time / animation.duration) as f64) as f32
                clip_time = clip_time - wraps * animation.duration
            }
            for channel in animation.channels {
                if channel.node >= (0 as i32) && (channel.node as usize) < count {
                    val node_index: usize = channel.node as usize
                    if channel.path == (0 as i32) {
                        @set(translations, node_index, sample_vec3(asset, channel, clip_time))
                        @set(overridden, node_index, true)
                    } elif channel.path == (1 as i32) {
                        @set(rotations, node_index, sample_quat(asset, channel, clip_time))
                        @set(overridden, node_index, true)
                    } elif channel.path == (2 as i32) {
                        @set(scales, node_index, sample_vec3(asset, channel, clip_time))
                        @set(overridden, node_index, true)
                    }
                }
            }
            index = 0 as usize
            for index < count {
                if bool_at(overridden, index) {
                    @set(
                        local,
                        index,
                        math.mat_from_trs(
                            vec3_at(translations, index),
                            quat_at(rotations, index),
                            vec3_at(scales, index)
                        )
                    )
                }
                index = index + (1 as usize)
            }
        }
    }

    val globals: mut list[math.Mat4] = []
    val resolved: mut list[bool] = []
    index = 0 as usize
    for index < count {
        @append(globals, math.mat4_identity())
        @append(resolved, false)
        index = index + (1 as usize)
    }

    val remaining: mut i32 = count as i32
    val pass: mut i32 = 0 as i32
    for pass < (count as i32) && remaining > (0 as i32) {
        index = 0 as usize
        for node in asset.nodes {
            if !bool_at(resolved, index) {
                if node.parent < (0 as i32) {
                    @set(globals, index, mat_at(local, index))
                    @set(resolved, index, true)
                    remaining = remaining - (1 as i32)
                } elif bool_at(resolved, node.parent as usize) {
                    @set(
                        globals,
                        index,
                        math.mat_mul(mat_at(globals, node.parent as usize), mat_at(local, index))
                    )
                    @set(resolved, index, true)
                    remaining = remaining - (1 as i32)
                }
            }
            index = index + (1 as usize)
        }
        pass = pass + (1 as i32)
    }
    return globals
}

fn inverse_bind_matrix(skin: ecs.ModelSkin, joint: usize) math.Mat4 = trust {
    val base: usize = joint * (16 as usize)
    if skin.inverse_bind == none {
        return math.mat4_identity()
    }
    return math.mat4(
        math.read_f32(skin.inverse_bind, base + (0 as usize)),
        math.read_f32(skin.inverse_bind, base + (4 as usize)),
        math.read_f32(skin.inverse_bind, base + (8 as usize)),
        math.read_f32(skin.inverse_bind, base + (12 as usize)),
        math.read_f32(skin.inverse_bind, base + (1 as usize)),
        math.read_f32(skin.inverse_bind, base + (5 as usize)),
        math.read_f32(skin.inverse_bind, base + (9 as usize)),
        math.read_f32(skin.inverse_bind, base + (13 as usize)),
        math.read_f32(skin.inverse_bind, base + (2 as usize)),
        math.read_f32(skin.inverse_bind, base + (6 as usize)),
        math.read_f32(skin.inverse_bind, base + (10 as usize)),
        math.read_f32(skin.inverse_bind, base + (14 as usize)),
        math.read_f32(skin.inverse_bind, base + (3 as usize)),
        math.read_f32(skin.inverse_bind, base + (7 as usize)),
        math.read_f32(skin.inverse_bind, base + (11 as usize)),
        math.read_f32(skin.inverse_bind, base + (15 as usize))
    )
}

fn joint_at(items: list[i32], index: usize) i32 = trust {
    if @get(items, index) is some value {
        return value
    }
    return 0 as i32
}

/// Flatten all skins into one list of joint matrices. A skin's `joint_offset`
/// is the base index into this list.
pub fn compute_joint_matrices(
    asset: ecs.ModelAsset,
    globals: list[math.Mat4]
) list[math.Mat4] = trust {
    val result: mut list[math.Mat4] = []
    for skin in asset.skins {
        val joint: mut usize = 0 as usize
        for joint < @len(skin.joints) {
            val node_index: i32 = joint_at(skin.joints, joint)
            val global: math.Mat4 = mat_at(globals, node_index as usize)
            val ibm: math.Mat4 = inverse_bind_matrix(skin, joint)
            @append(result, math.mat_mul(global, ibm))
            joint = joint + (1 as usize)
        }
    }
    return result
}

fn matrix_at(items: list[math.Mat4], index: usize) math.Mat4 = trust {
    if @get(items, index) is some value {
        return value
    }
    return math.mat4_identity()
}

/// CPU-skin a combined model vertex buffer. Vertices must be laid out in the
/// same order as `asset.meshes`, 8 floats per vertex.
pub fn skin_vertices(
    asset: ecs.ModelAsset,
    animation_index: i32,
    time: f32,
    base: ref f32,
    out: ref f32
) void = trust {
    val globals: list[math.Mat4] = compute_globals(asset, animation_index, time)
    val joint_matrices: list[math.Mat4] = compute_joint_matrices(asset, globals)
    val vertex_base: mut usize = 0 as usize
    for mesh in asset.meshes {
        val skin_offset: mut usize = 0 as usize
        val skinned_mesh: mut bool = false
        if mesh.skin >= (0 as i32) {
            if @get(asset.skins, mesh.skin as usize) is some skin {
                skin_offset = skin.joint_offset
                skinned_mesh = true
            }
        }
        val vertex: mut usize = 0 as usize
        for vertex < mesh.vertex_count {
            val source: usize = (vertex_base + vertex) * (8 as usize)
            val target: usize = (vertex_base + vertex) * (8 as usize)
            if skinned_mesh && mesh.joints != none && mesh.weights != none {
                val px: f32 = math.read_f32(base, source + (0 as usize))
                val py: f32 = math.read_f32(base, source + (1 as usize))
                val pz: f32 = math.read_f32(base, source + (2 as usize))
                val nx: f32 = math.read_f32(base, source + (3 as usize))
                val ny: f32 = math.read_f32(base, source + (4 as usize))
                val nz: f32 = math.read_f32(base, source + (5 as usize))
                val m00: mut f32 = 0.0 as f32
                val m01: mut f32 = 0.0 as f32
                val m02: mut f32 = 0.0 as f32
                val m03: mut f32 = 0.0 as f32
                val m10: mut f32 = 0.0 as f32
                val m11: mut f32 = 0.0 as f32
                val m12: mut f32 = 0.0 as f32
                val m13: mut f32 = 0.0 as f32
                val m20: mut f32 = 0.0 as f32
                val m21: mut f32 = 0.0 as f32
                val m22: mut f32 = 0.0 as f32
                val m23: mut f32 = 0.0 as f32
                val influence: mut usize = 0 as usize
                for influence < (4 as usize) {
                    val weight: f32 = math.read_f32(mesh.weights, vertex * (4 as usize) + influence)
                    if weight > (0.0 as f32) {
                        val joint_slot: usize = (vertex * (4 as usize) + influence)
                        val joint: u16 = @load16(@ptradd(
                                mesh.joints as ref void,
                                joint_slot * (2 as usize)
                            ) as ref u8) as u16
                        val matrix: math.Mat4 = matrix_at(
                            joint_matrices,
                            skin_offset + (joint as usize)
                        )
                        m00 = m00 + matrix.m00 * weight
                        m01 = m01 + matrix.m01 * weight
                        m02 = m02 + matrix.m02 * weight
                        m03 = m03 + matrix.m03 * weight
                        m10 = m10 + matrix.m10 * weight
                        m11 = m11 + matrix.m11 * weight
                        m12 = m12 + matrix.m12 * weight
                        m13 = m13 + matrix.m13 * weight
                        m20 = m20 + matrix.m20 * weight
                        m21 = m21 + matrix.m21 * weight
                        m22 = m22 + matrix.m22 * weight
                        m23 = m23 + matrix.m23 * weight
                    }
                    influence = influence + (1 as usize)
                }
                val ox: f32 = m00 * px + m01 * py + m02 * pz + m03
                val oy: f32 = m10 * px + m11 * py + m12 * pz + m13
                val oz: f32 = m20 * px + m21 * py + m22 * pz + m23
                val onx: f32 = m00 * nx + m01 * ny + m02 * nz
                val ony: f32 = m10 * nx + m11 * ny + m12 * nz
                val onz: f32 = m20 * nx + m21 * ny + m22 * nz
                val nlen: f32 = stdmath.sqrt((onx * onx + ony * ony + onz * onz) as f64) as f32
                val inv_len: mut f32 = 0.0 as f32
                if nlen > (0.000001 as f32) {
                    inv_len = (1.0 as f32) / nlen
                }
                math.store_f32(out, target + (0 as usize), ox)
                math.store_f32(out, target + (1 as usize), oy)
                math.store_f32(out, target + (2 as usize), oz)
                math.store_f32(out, target + (3 as usize), onx * inv_len)
                math.store_f32(out, target + (4 as usize), ony * inv_len)
                math.store_f32(out, target + (5 as usize), onz * inv_len)
                math.store_f32(
                    out,
                    target + (6 as usize),
                    math.read_f32(base, source + (6 as usize))
                )
                math.store_f32(
                    out,
                    target + (7 as usize),
                    math.read_f32(base, source + (7 as usize))
                )
            } else {
                math.store_f32(
                    out,
                    target + (0 as usize),
                    math.read_f32(base, source + (0 as usize))
                )
                math.store_f32(
                    out,
                    target + (1 as usize),
                    math.read_f32(base, source + (1 as usize))
                )
                math.store_f32(
                    out,
                    target + (2 as usize),
                    math.read_f32(base, source + (2 as usize))
                )
                math.store_f32(
                    out,
                    target + (3 as usize),
                    math.read_f32(base, source + (3 as usize))
                )
                math.store_f32(
                    out,
                    target + (4 as usize),
                    math.read_f32(base, source + (4 as usize))
                )
                math.store_f32(
                    out,
                    target + (5 as usize),
                    math.read_f32(base, source + (5 as usize))
                )
                math.store_f32(
                    out,
                    target + (6 as usize),
                    math.read_f32(base, source + (6 as usize))
                )
                math.store_f32(
                    out,
                    target + (7 as usize),
                    math.read_f32(base, source + (7 as usize))
                )
            }
            vertex = vertex + (1 as usize)
        }
        vertex_base = vertex_base + mesh.vertex_count
    }
}

pub fn has_skinning(asset: ecs.ModelAsset) bool = {
    return asset.has_skinning
}
