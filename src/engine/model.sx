val math      = use("math.sx")
val ecs       = use("../ecs.sx")
val animation = use("animation.sx")
val io        = use("io.sx")
val glb       = use("glb.sx")
val json      = use("std/json")
val string    = use("std/string")
val bin       = use("std/encoding/binary")
val mem       = use("../mem.sx")

val GLB_MAGIC: u32 = 0x46546C67
val GLB_VERSION: u32 = 2
val GLB_JSON_CHUNK: u32 = 0x4E4F534A
val GLB_BIN_CHUNK: u32 = 0x004E4942

fn obj_int(obj: json.JsonValue, key: string.StringView, fallback: i64) i32 = trust {
    if json.object_get_int(obj, key) is some value {
        return value as i32
    }
    return fallback as i32
}

fn obj_bool(obj: json.JsonValue, key: string.StringView, fallback: bool) bool = trust {
    if json.object_get_bool(obj, key) is some value {
        return value
    }
    return fallback
}

fn arr_f32(arr: json.JsonValue, index: usize) f32 = trust {
    if json.array_get(arr, index as i64) is some value {
        return json.as_float(value) as f32
    }
    return 0.0 as f32
}

fn obj_vec3(obj: json.JsonValue, key: string.StringView, x: f32, y: f32, z: f32) math.Vec3 = trust {
    if json.object_get(obj, key) is some arr {
        return math.vec3(
            arr_f32(arr, 0 as usize),
            arr_f32(arr, 1 as usize),
            arr_f32(arr, 2 as usize)
        )
    }
    return math.vec3(x, y, z)
}

fn obj_quat(obj: json.JsonValue, key: string.StringView) math.Vec4f = trust {
    if json.object_get(obj, key) is some arr {
        return math.quat(
            arr_f32(arr, 0 as usize),
            arr_f32(arr, 1 as usize),
            arr_f32(arr, 2 as usize),
            arr_f32(arr, 3 as usize)
        )
    }
    return math.quat(0.0 as f32, 0.0 as f32, 0.0 as f32, 1.0 as f32)
}

fn obj_matrix(obj: json.JsonValue, key: string.StringView) math.Mat4 = trust {
    if json.object_get(obj, key) is some arr {
        return math.mat4(
            arr_f32(
                arr,
                0 as usize
            ), arr_f32(arr, 4 as usize), arr_f32(arr, 8 as usize), arr_f32(arr, 12 as usize),
            arr_f32(
                arr,
                1 as usize
            ), arr_f32(arr, 5 as usize), arr_f32(arr, 9 as usize), arr_f32(arr, 13 as usize),
            arr_f32(
                arr,
                2 as usize
            ), arr_f32(arr, 6 as usize), arr_f32(arr, 10 as usize), arr_f32(arr, 14 as usize),
            arr_f32(
                arr,
                3 as usize
            ), arr_f32(arr, 7 as usize), arr_f32(arr, 11 as usize), arr_f32(arr, 15 as usize)
        )
    }
    return math.mat4_identity()
}

fn component_count(type_name: string.StringView) i32 = trust {
    if type_name.ptr == none {
        return 0 as i32
    }
    if string.eql(type_name, "SCALAR") {
        return 1 as i32
    }
    if string.eql(type_name, "VEC2") {
        return 2 as i32
    }
    if string.eql(type_name, "VEC3") {
        return 3 as i32
    }
    if string.eql(type_name, "VEC4") {
        return 4 as i32
    }
    if string.eql(type_name, "MAT4") {
        return 16 as i32
    }
    return 0 as i32
}

fn component_size(component_type: i32) usize = {
    if component_type == (5120 as i32) || component_type == (5121 as i32) {
        return 1 as usize
    }
    if component_type == (5122 as i32) || component_type == (5123 as i32) {
        return 2 as usize
    }
    return 4 as usize
}

fn build_accessor(root: json.JsonValue, bin_offset: usize, index: usize) ecs.ModelAccessor = trust {
    val result: mut ecs.ModelAccessor = {
        offset: 0 as usize,
        count: 0 as i32,
        component_type: 5126 as i32,
        components: 0 as i32,
        stride: 0 as usize,
        normalized: false
    }
    if json.object_get(root, "accessors") is some accessors {
        if json.array_get(accessors, index as i64) is some accessor {
            result.count = obj_int(accessor, "count", 0)
            result.component_type = obj_int(accessor, "componentType", 5126)
            if json.object_get_str(accessor, "type") is some type_name {
                result.components = component_count(type_name)
            }
            result.normalized = obj_bool(accessor, "normalized", false)
            val accessor_offset: usize = obj_int(accessor, "byteOffset", 0) as usize
            if json.object_get_int(accessor, "bufferView") is some buffer_view_index {
                if json.object_get(root, "bufferViews") is some buffer_views {
                    if json.array_get(buffer_views, buffer_view_index) is some buffer_view {
                        val view_offset: usize = obj_int(buffer_view, "byteOffset", 0) as usize
                        val view_stride: i32 = obj_int(buffer_view, "byteStride", 0)
                        result.offset = bin_offset + view_offset + accessor_offset
                        if view_stride > (0 as i32) {
                            result.stride = view_stride as usize
                        }
                    }
                }
            }
            if result.stride == (0 as usize) {
                result.stride = (result.components as usize) * component_size(result.component_type)
            }
        }
    }
    return result
}

fn read_node(root: json.JsonValue, index: usize) ecs.ModelNode = trust {
    val result: mut ecs.ModelNode = {
        translation: math.vec3(0.0 as f32, 0.0 as f32, 0.0 as f32),
        rotation: math.quat(0.0 as f32, 0.0 as f32, 0.0 as f32, 1.0 as f32),
        scale: math.vec3(1.0 as f32, 1.0 as f32, 1.0 as f32),
        matrix: math.mat4_identity(),
        has_matrix: false,
        parent: -1 as i32,
        mesh: -1 as i32,
        skin: -1 as i32
    }
    if json.object_get(root, "nodes") is some nodes {
        if json.array_get(nodes, index as i64) is some node {
            result.mesh = obj_int(node, "mesh", -1)
            result.skin = obj_int(node, "skin", -1)
            if json.object_get(node, "matrix") is some _ {
                result.matrix = obj_matrix(node, "matrix")
                result.has_matrix = true
            } else {
                result.translation = obj_vec3(
                    node,
                    "translation",
                    0.0 as f32,
                    0.0 as f32,
                    0.0 as f32
                )
                result.rotation = obj_quat(node, "rotation")
                result.scale = obj_vec3(node, "scale", 1.0 as f32, 1.0 as f32, 1.0 as f32)
            }
        }
    }
    return result
}

type ImageTable = {
    offsets: list[usize]
    lengths: list[usize]
}

fn parse_nodes(root: json.JsonValue) list[ecs.ModelNode] = trust {
    val result: mut list[ecs.ModelNode] = mem.persistent[ecs.ModelNode]()
    if json.object_get(root, "nodes") is some nodes {
        val node_count: usize = json.len(nodes) as usize
        val index: mut usize = 0 as usize
        for index < node_count {
            @append(result, read_node(root, index))
            index = index + (1 as usize)
        }
        val parent_index: mut usize = 0 as usize
        for parent_index < node_count {
            if json.array_get(nodes, parent_index as i64) is some node {
                if json.object_get(node, "children") is some children {
                    val child_index: mut usize = 0 as usize
                    for child_index < json.len(children) as usize {
                        if json.array_get(children, child_index as i64) is some child_value {
                            val child: i32 = json.as_int(child_value) as i32
                            if child >= (0 as i32) && (child as usize) < node_count {
                                if @get(result, child as usize) is some child_node {
                                    val updated: mut ecs.ModelNode = child_node
                                    updated.parent = parent_index as i32
                                    @set(result, child as usize, updated)
                                }
                            }
                        }
                        child_index = child_index + (1 as usize)
                    }
                }
            }
            parent_index = parent_index + (1 as usize)
        }
    }
    return result
}

fn read_u32_component(
    asset: ecs.ModelAsset,
    accessor_index: i32,
    element: usize,
    component: usize
) u32 = trust {
    if accessor_index < (0 as i32) || asset.raw_bytes == none {
        return 0 as u32
    }
    if @get(asset.accessors, accessor_index as usize) is some acc {
        if element >= (acc.count as usize) || component >= (acc.components as usize) {
            return 0 as u32
        }
        val offset: usize = acc.offset + element * acc.stride + component * component_size(acc.component_type)
        val ptr: ref u8 = @ptradd(asset.raw_bytes, offset) as ref u8
        if acc.component_type == (5121 as i32) {
            return @load8(ptr) as u32
        }
        if acc.component_type == (5123 as i32) {
            return (@load16(ptr) as u16) as u32
        }
        if acc.component_type == (5125 as i32) {
            return bin.read_u32_le(ptr, 0 as usize)
        }
    }
    return 0 as u32
}

fn read_u32_value(asset: ecs.ModelAsset, accessor_index: i32, element: usize) u32 = trust {
    return read_u32_component(asset, accessor_index, element, 0 as usize)
}

fn parse_skins(asset: ecs.ModelAsset, root: json.JsonValue) list[ecs.ModelSkin] = trust {
    val result: mut list[ecs.ModelSkin] = mem.persistent[ecs.ModelSkin]()
    if json.object_get(root, "skins") is some skins {
        val total: mut usize = 0 as usize
        val index: mut usize = 0 as usize
        for index < json.len(skins) as usize {
            if json.array_get(skins, index as i64) is some skin_obj {
                val skin: mut ecs.ModelSkin = {
                    joints: mem.persistent[i32](),
                    inverse_bind: none as ref f32,
                    inverse_bind_count: 0 as usize,
                    joint_offset: total
                }
                if json.object_get(skin_obj, "joints") is some joints {
                    val joint_index: mut usize = 0 as usize
                    for joint_index < json.len(joints) as usize {
                        if json.array_get(joints, joint_index as i64) is some joint_value {
                            @append(skin.joints, json.as_int(joint_value) as i32)
                        }
                        joint_index = joint_index + (1 as usize)
                    }
                }
                if json.object_get_int(skin_obj, "inverseBindMatrices") is some ibm_accessor {
                    if @get(asset.accessors, ibm_accessor as usize) is some ibm_acc {
                        val matrix_count: usize = ibm_acc.count as usize
                        val float_count: usize = matrix_count * (16 as usize)
                        val inverse_bind: ref f32 = @alloc(float_count * (@sizeof(f32) as usize)) as ref f32
                        if inverse_bind != none {
                            val matrix_index: mut usize = 0 as usize
                            for matrix_index < matrix_count {
                                val component: mut usize = 0 as usize
                                for component < (16 as usize) {
                                    math.store_f32(
                                        inverse_bind,
                                        matrix_index * (16 as usize) + component,
                                        animation.accessor_f32(
                                            asset,
                                            ibm_accessor as i32,
                                            matrix_index,
                                            component
                                        )
                                    )
                                    component = component + (1 as usize)
                                }
                                matrix_index = matrix_index + (1 as usize)
                            }
                            skin.inverse_bind = inverse_bind
                            skin.inverse_bind_count = matrix_count
                        }
                    }
                }
                total = total + @len(skin.joints)
                @append(result, skin)
            }
            index = index + (1 as usize)
        }
    }
    return result
}

fn parse_images(root: json.JsonValue, bin_offset: usize) ImageTable = trust {
    val offsets: mut list[usize] = mem.persistent[usize]()
    val lengths: mut list[usize] = mem.persistent[usize]()
    if json.object_get(root, "images") is some images {
        val index: mut usize = 0 as usize
        for index < json.len(images) as usize {
            val offset: mut usize = 0 as usize
            val length: mut usize = 0 as usize
            if json.array_get(images, index as i64) is some image {
                if json.object_get_int(image, "bufferView") is some view_index {
                    if json.object_get(root, "bufferViews") is some buffer_views {
                        if json.array_get(buffer_views, view_index) is some buffer_view {
                            offset = bin_offset + (obj_int(buffer_view, "byteOffset", 0) as usize)
                            length = obj_int(buffer_view, "byteLength", 0) as usize
                        }
                    }
                }
            }
            @append(offsets, offset)
            @append(lengths, length)
            index = index + (1 as usize)
        }
    }
    return { offsets: offsets, lengths: lengths }
}

fn parse_materials(root: json.JsonValue) list[i32] = trust {
    val result: mut list[i32] = mem.persistent[i32]()
    if json.object_get(root, "materials") is some materials {
        val index: mut usize = 0 as usize
        for index < json.len(materials) as usize {
            val image_index: mut i32 = -1 as i32
            if json.array_get(materials, index as i64) is some material {
                if json.object_get(material, "pbrMetallicRoughness") is some pbr {
                    if json.object_get(pbr, "baseColorTexture") is some base_color {
                        if json.object_get_int(base_color, "index") is some texture_index {
                            if json.object_get(root, "textures") is some textures {
                                if json.array_get(textures, texture_index) is some texture {
                                    if json.object_get_int(texture, "source") is some source {
                                        image_index = source as i32
                                    }
                                }
                            }
                        }
                    }
                }
            }
            @append(result, image_index)
            index = index + (1 as usize)
        }
    }
    return result
}

fn read_vec3(asset: ecs.ModelAsset, accessor_index: i32, element: usize) math.Vec3 = trust {
    return math.vec3(
        animation.accessor_f32(asset, accessor_index, element, 0 as usize),
        animation.accessor_f32(asset, accessor_index, element, 1 as usize),
        animation.accessor_f32(asset, accessor_index, element, 2 as usize)
    )
}

fn read_vec2(asset: ecs.ModelAsset, accessor_index: i32, element: usize) math.Vec3 = trust {
    return math.vec3(
        animation.accessor_f32(asset, accessor_index, element, 0 as usize),
        animation.accessor_f32(asset, accessor_index, element, 1 as usize),
        0.0 as f32
    )
}

fn parse_meshes(asset: ecs.ModelAsset, root: json.JsonValue) list[ecs.ModelMesh] = trust {
    val result: mut list[ecs.ModelMesh] = mem.persistent[ecs.ModelMesh]()
    val meshes_value: mut json.JsonValue = glb.empty_json()
    if json.object_get(root, "meshes") is some value {
        meshes_value = value
    } else {
        return result
    }
    val mesh_count: usize = json.len(meshes_value) as usize
    val mesh_node: mut list[i32] = mem.persistent[i32]()
    val mesh_skin: mut list[i32] = mem.persistent[i32]()
    val mesh_index: mut usize = 0 as usize
    for mesh_index < mesh_count {
        @append(mesh_node, -1 as i32)
        @append(mesh_skin, -1 as i32)
        mesh_index = mesh_index + (1 as usize)
    }
    val node_index: mut usize = 0 as usize
    for node in asset.nodes {
        if node.mesh >= (0 as i32) && (node.mesh as usize) < mesh_count {
            @set(mesh_node, node.mesh as usize, node_index as i32)
            @set(mesh_skin, node.mesh as usize, node.skin)
        }
        node_index = node_index + (1 as usize)
    }

    val globals: list[math.Mat4] = animation.compute_globals(asset, -1 as i32, 0.0 as f32)

    mesh_index = 0 as usize
    for mesh_index < mesh_count {
        if json.array_get(meshes_value, mesh_index as i64) is some mesh_obj {
            val skin_index: mut i32 = -1 as i32
            if @get(mesh_skin, mesh_index) is some value {
                skin_index = value
            }
            val node_global: mut math.Mat4 = math.mat4_identity()
            if @get(mesh_node, mesh_index) is some node_value {
                if node_value >= (0 as i32) {
                    if @get(globals, node_value as usize) is some global_value {
                        node_global = global_value
                    }
                }
            }
            if json.object_get(mesh_obj, "primitives") is some primitives {
                val primitive_index: mut usize = 0 as usize
                for primitive_index < json.len(primitives) as usize {
                    if json.array_get(primitives, primitive_index as i64) is some primitive {
                        if json.object_get(primitive, "attributes") is some attributes {
                            val position_accessor: i32 = obj_int(attributes, "POSITION", -1)
                            if position_accessor >= (0 as i32) {
                                if @get(
                                    asset.accessors,
                                    position_accessor as usize
                                ) is some pos_acc {
                                    val vertex_count: usize = pos_acc.count as usize
                                    val normal_accessor: i32 = obj_int(attributes, "NORMAL", -1)
                                    val uv_accessor: i32 = obj_int(attributes, "TEXCOORD_0", -1)
                                    val joints_accessor: i32 = obj_int(attributes, "JOINTS_0", -1)
                                    val weights_accessor: i32 = obj_int(attributes, "WEIGHTS_0", -1)
                                    val material_index: i32 = obj_int(primitive, "material", -1)
                                    val vertex_floats: usize = vertex_count * (8 as usize)
                                    val vertices: ref f32 = @alloc(vertex_floats * (@sizeof(f32) as usize)) as ref f32
                                    val vertex: mut usize = 0 as usize
                                    for vertex < vertex_count {
                                        val position: math.Vec3 = read_vec3(
                                            asset,
                                            position_accessor,
                                            vertex
                                        )
                                        val normal_raw: mut math.Vec3 = math.vec3(
                                            0.0 as f32,
                                            1.0 as f32,
                                            0.0 as f32
                                        )
                                        if normal_accessor >= (0 as i32) {
                                            normal_raw = read_vec3(asset, normal_accessor, vertex)
                                        }
                                        val uv: math.Vec3 = read_vec2(asset, uv_accessor, vertex)
                                        val position_final: mut math.Vec3 = position
                                        val normal_final: mut math.Vec3 = normal_raw
                                        if skin_index < (0 as i32) {
                                            position_final = math.mat_transform_point(
                                                node_global,
                                                position
                                            )
                                            normal_final = math.vec3_normalize(math.mat_transform_direction(
                                                    node_global,
                                                    normal_raw
                                                ))
                                        }
                                        math.store_f32(
                                            vertices,
                                            vertex * (8 as usize) + (0 as usize),
                                            position_final.x
                                        )
                                        math.store_f32(
                                            vertices,
                                            vertex * (8 as usize) + (1 as usize),
                                            position_final.y
                                        )
                                        math.store_f32(
                                            vertices,
                                            vertex * (8 as usize) + (2 as usize),
                                            position_final.z
                                        )
                                        math.store_f32(
                                            vertices,
                                            vertex * (8 as usize) + (3 as usize),
                                            normal_final.x
                                        )
                                        math.store_f32(
                                            vertices,
                                            vertex * (8 as usize) + (4 as usize),
                                            normal_final.y
                                        )
                                        math.store_f32(
                                            vertices,
                                            vertex * (8 as usize) + (5 as usize),
                                            normal_final.z
                                        )
                                        math.store_f32(
                                            vertices,
                                            vertex * (8 as usize) + (6 as usize),
                                            uv.x
                                        )
                                        math.store_f32(
                                            vertices,
                                            vertex * (8 as usize) + (7 as usize),
                                            uv.y
                                        )
                                        vertex = vertex + (1 as usize)
                                    }

                                    val index_accessor: i32 = obj_int(primitive, "indices", -1)
                                    val index_count: mut usize = vertex_count
                                    if index_accessor >= (0 as i32) {
                                        if @get(
                                            asset.accessors,
                                            index_accessor as usize
                                        ) is some idx_acc {
                                            index_count = idx_acc.count as usize
                                        }
                                    }
                                    val indices: ref u32 = @alloc(index_count * (@sizeof(u32) as usize)) as ref u32
                                    val element: mut usize = 0 as usize
                                    for element < index_count {
                                        val value: mut u32 = element as u32
                                        if index_accessor >= (0 as i32) {
                                            value = read_u32_value(asset, index_accessor, element)
                                        }
                                        math.store_u32(indices, element, value)
                                        element = element + (1 as usize)
                                    }

                                    val joints: mut ref u16 = none as ref u16
                                    val weights: mut ref f32 = none as ref f32
                                    if skin_index >= (0 as i32) {
                                        joints = @alloc(vertex_count * (4 as usize) * (@sizeof(u16) as usize)) as ref u16
                                        weights = @alloc(vertex_count * (4 as usize) * (@sizeof(f32) as usize)) as ref f32
                                        val joint_vertex: mut usize = 0 as usize
                                        for joint_vertex < vertex_count {
                                            val influence: mut usize = 0 as usize
                                            for influence < (4 as usize) {
                                                val joint_value: u32 = read_u32_component(
                                                    asset,
                                                    joints_accessor,
                                                    joint_vertex,
                                                    influence
                                                )
                                                val weight_value: f32 = animation.accessor_f32(
                                                    asset,
                                                    weights_accessor,
                                                    joint_vertex,
                                                    influence
                                                )
                                                @store16(
                                                    @ptradd(
                                                        joints,
                                                        (joint_vertex * (4 as usize) + influence) * (2 as usize)
                                                    ) as ref u8,
                                                    joint_value as u16
                                                )
                                                math.store_f32(
                                                    weights,
                                                    joint_vertex * (4 as usize) + influence,
                                                    weight_value
                                                )
                                                influence = influence + (1 as usize)
                                            }
                                            joint_vertex = joint_vertex + (1 as usize)
                                        }
                                    }

                                    @append(result, {
                                            vertices: vertices,
                                            vertex_count: vertex_count,
                                            indices: indices,
                                            index_count: index_count,
                                            material: material_index,
                                            skin: skin_index,
                                            joints: joints,
                                            weights: weights
                                        })
                                }
                            }
                        }
                    }
                    primitive_index = primitive_index + (1 as usize)
                }
            }
        }
        mesh_index = mesh_index + (1 as usize)
    }
    return result
}

fn parse_animations(asset: ecs.ModelAsset, root: json.JsonValue) list[ecs.ModelAnimation] = trust {
    val result: mut list[ecs.ModelAnimation] = mem.persistent[ecs.ModelAnimation]()
    val animations_value: mut json.JsonValue = glb.empty_json()
    if json.object_get(root, "animations") is some value {
        animations_value = value
    } else {
        return result
    }
    val animation_index: mut usize = 0 as usize
    for animation_index < json.len(animations_value) as usize {
        if json.array_get(animations_value, animation_index as i64) is some animation_obj {
            val animation: mut ecs.ModelAnimation = {
                name: glb.dup_cstr(c"clip"),
                channels: mem.persistent[ecs.ModelAnimChannel](),
                duration: 0.0 as f32
            }
            if json.object_get_str(animation_obj, "name") is some name {
                animation.name = glb.dup_str(name)
            }
            if json.object_get(animation_obj, "channels") is some channels {
                if json.object_get(animation_obj, "samplers") is some samplers {
                    val channel_index: mut usize = 0 as usize
                    for channel_index < json.len(channels) as usize {
                        if json.array_get(channels, channel_index as i64) is some channel_obj {
                            if json.object_get_int(channel_obj, "sampler") is some sampler_index {
                                if json.array_get(samplers, sampler_index) is some sampler {
                                    if json.object_get(channel_obj, "target") is some target {
                                        if json.object_get_str(target, "path") is some path_name {
                                            val path: mut i32 = -1 as i32
                                            if string.eql(
                                                path_name,
                                                "translation"
                                            ) {
                                                path = 0 as i32
                                            } elif string.eql(
                                                path_name,
                                                "rotation"
                                            ) {
                                                path = 1 as i32
                                            } elif string.eql(
                                                path_name,
                                                "scale"
                                            ) {
                                                path = 2 as i32
                                            }
                                            if path >= (0 as i32) {
                                                val input_accessor: i32 = obj_int(
                                                    sampler,
                                                    "input",
                                                    -1
                                                )
                                                val output_accessor: i32 = obj_int(
                                                    sampler,
                                                    "output",
                                                    -1
                                                )
                                                val interpolation: mut i32 = 0 as i32
                                                if json.object_get_str(
                                                    sampler,
                                                    "interpolation"
                                                ) is some interpolation_name {
                                                    if string.eql(
                                                        interpolation_name,
                                                        "STEP"
                                                    ) {
                                                        interpolation = 1 as i32
                                                    } elif string.eql(
                                                        interpolation_name,
                                                        "CUBICSPLINE"
                                                    ) {
                                                        interpolation = 2 as i32
                                                    }
                                                }
                                                @append(animation.channels, {
                                                        node: obj_int(target, "node", -1),
                                                        path: path,
                                                        input: input_accessor,
                                                        output: output_accessor,
                                                        interpolation: interpolation
                                                    })
                                                if input_accessor >= (0 as i32) {
                                                    if @get(
                                                        asset.accessors,
                                                        input_accessor as usize
                                                    ) is some input_acc {
                                                        if input_acc.count > (0 as i32) {
                                                            val last_time: f32 = animation.accessor_f32(
                                                                asset,
                                                                input_accessor,
                                                                (input_acc.count as usize) - (1 as usize),
                                                                0 as usize
                                                            )
                                                            if last_time > animation.duration {
                                                                animation.duration = last_time
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        channel_index = channel_index + (1 as usize)
                    }
                }
            }
            @append(result, animation)
        }
        animation_index = animation_index + (1 as usize)
    }
    return result
}

type ModelBounds = {
    min: math.Vec3
    max: math.Vec3
}

fn compute_bounds(meshes: list[ecs.ModelMesh]) ModelBounds = trust {
    val min_x: mut f32 = 1e30 as f32
    val min_y: mut f32 = 1e30 as f32
    val min_z: mut f32 = 1e30 as f32
    val max_x: mut f32 = -1e30 as f32
    val max_y: mut f32 = -1e30 as f32
    val max_z: mut f32 = -1e30 as f32
    for mesh in meshes {
        val vertex: mut usize = 0 as usize
        for vertex < mesh.vertex_count {
            val x: f32 = math.read_f32(mesh.vertices, vertex * (8 as usize) + (0 as usize))
            val y: f32 = math.read_f32(mesh.vertices, vertex * (8 as usize) + (1 as usize))
            val z: f32 = math.read_f32(mesh.vertices, vertex * (8 as usize) + (2 as usize))
            if x < min_x {
                min_x = x
            }
            if y < min_y {
                min_y = y
            }
            if z < min_z {
                min_z = z
            }
            if x > max_x {
                max_x = x
            }
            if y > max_y {
                max_y = y
            }
            if z > max_z {
                max_z = z
            }
            vertex = vertex + (1 as usize)
        }
    }
    if min_x < (1e29 as f32) {
        return { min: math.vec3(min_x, min_y, min_z), max: math.vec3(max_x, max_y, max_z) }
    }
    return { min: math.vec3(
            0.0 as f32,
            0.0 as f32,
            0.0 as f32
        ), max: math.vec3(0.0 as f32, 0.0 as f32, 0.0 as f32) }
}

/// Parse a complete GLB scene. Unlike the lightweight `glb` loader this keeps
/// every primitive, material, skin and animation clip.
pub fn parse_model_bytes(data: ref u8, len: usize) option[ecs.ModelAsset] = trust {
    if data == none || len < (20 as usize) {
        return none
    }
    val magic: u32 = bin.read_u32_le(data, 0 as usize)
    val version: u32 = bin.read_u32_le(data, 4 as usize)
    val total_len: u32 = bin.read_u32_le(data, 8 as usize)
    if magic != GLB_MAGIC || version != GLB_VERSION || (total_len as usize) > len {
        return none
    }
    val json_len: u32 = bin.read_u32_le(data, 12 as usize)
    val json_type: u32 = bin.read_u32_le(data, 16 as usize)
    if json_type != GLB_JSON_CHUNK {
        return none
    }
    val json_offset: usize = 20 as usize
    val json_end: usize = json_offset + (json_len as usize)
    if json_end + (8 as usize) > len {
        return none
    }
    val bin_type: u32 = bin.read_u32_le(data, json_end + (4 as usize))
    if bin_type != GLB_BIN_CHUNK {
        return none
    }
    val bin_offset: usize = json_end + (8 as usize)

    val json_buf: ref u8 = @alloc((json_len as usize) + (1 as usize)) as ref u8
    if json_buf == none {
        return none
    }
    @memcpy(json_buf, @ptradd(data, json_offset) as ref void, json_len as usize)
    @store8(@ptradd(json_buf, json_len as usize), 0)

    if json.parse(string.view(json_buf, json_len as i64)) is ok doc {
        val root: json.JsonValue = json.root(doc)
        val asset: mut ecs.ModelAsset = ecs.empty_model_asset()
        val raw_copy: ref u8 = @alloc(len) as ref u8
        if raw_copy == none {
            json.doc_free(doc)
            @free(json_buf)
            return none
        }
        @memcpy(raw_copy, data, len)
        asset.raw_bytes = raw_copy
        asset.raw_len = len

        if json.object_get(root, "accessors") is some accessors {
            val accessor_index: mut usize = 0 as usize
            for accessor_index < json.len(accessors) as usize {
                @append(asset.accessors, build_accessor(root, bin_offset, accessor_index))
                accessor_index = accessor_index + (1 as usize)
            }
        }

        asset.nodes = parse_nodes(root)
        asset.skins = parse_skins(asset, root)
        val images: ImageTable = parse_images(root, bin_offset)
        asset.image_offsets = images.offsets
        asset.image_lengths = images.lengths
        asset.material_images = parse_materials(root)
        asset.meshes = parse_meshes(asset, root)
        asset.animations = parse_animations(asset, root)
        val bounds: ModelBounds = compute_bounds(asset.meshes)
        asset.bounds_min = bounds.min
        asset.bounds_max = bounds.max
        val has_skin: mut bool = false
        for mesh in asset.meshes {
            if mesh.skin >= (0 as i32) {
                has_skin = true
            }
        }
        asset.has_skinning = has_skin

        json.doc_free(doc)
        @free(json_buf)
        return some asset
    }

    @free(json_buf)
    return none
}

pub fn load_model(path: string.StringView) option[ecs.ModelAsset] = trust {
    if io.load_binary_file(path) is some blob {
        val parsed = parse_model_bytes(blob.data, blob.len)
        @free(blob.data)
        return parsed
    }
    return none
}

pub fn find_animation(asset: ecs.ModelAsset, name: string.StringView) i32 = trust {
    return animation.find_animation(asset, name)
}
