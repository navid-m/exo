val renderer = use("renderer.sx")
val math     = use("math.sx")
val ecs      = use("../ecs.sx")
val glb      = use("glb.sx")
val json     = use("std/json")
val string   = use("std/string")
val bin      = use("std/encoding/binary")
val mem      = use("../mem.sx")
val PI: f64 = 3.14159265358979323846

fn write_vertex(
    base: ref void,
    vertex_index: usize,
    position: math.Vec3,
    normal: math.Vec3
) void = trust {
    val offset: usize = vertex_index * (8 as usize)
    math.store_f32(base, offset + (0 as usize), position.x)
    math.store_f32(base, offset + (1 as usize), position.y)
    math.store_f32(base, offset + (2 as usize), position.z)
    math.store_f32(base, offset + (3 as usize), normal.x)
    math.store_f32(base, offset + (4 as usize), normal.y)
    math.store_f32(base, offset + (5 as usize), normal.z)
    math.store_f32(base, offset + (6 as usize), 0.0 as f32)
    math.store_f32(base, offset + (7 as usize), 0.0 as f32)
}

fn write_vertex_uv(
    base: ref void,
    vertex_index: usize,
    position: math.Vec3,
    normal: math.Vec3,
    u: f32,
    v: f32
) void = trust {
    val offset: usize = vertex_index * (8 as usize)
    math.store_f32(base, offset + (0 as usize), position.x)
    math.store_f32(base, offset + (1 as usize), position.y)
    math.store_f32(base, offset + (2 as usize), position.z)
    math.store_f32(base, offset + (3 as usize), normal.x)
    math.store_f32(base, offset + (4 as usize), normal.y)
    math.store_f32(base, offset + (5 as usize), normal.z)
    math.store_f32(base, offset + (6 as usize), u)
    math.store_f32(base, offset + (7 as usize), v)
}

/// Upload a fully parsed model asset. All primitives share one vertex/index
/// buffer; each primitive becomes a draw range with its own material texture.
pub fn upload_model_asset(runtime: ref void, asset: ecs.ModelAsset) renderer.ModelGPU = trust {
    val rt: mut ref renderer.Renderer = runtime as mut ref renderer.Renderer
    val textures: mut list[ref void] = mem.persistent[ref void]()
    val material_index: mut usize = 0 as usize
    for image_index in asset.material_images {
        val texture: mut ref void = none as ref void
        if image_index >= (0 as i32) && (image_index as usize) < @len(asset.image_offsets) {
            if @get(asset.image_offsets, image_index as usize) is some offset {
                if @get(asset.image_lengths, image_index as usize) is some length {
                    if length > (0 as usize) && asset.raw_bytes != none {
                        texture = renderer.create_texture_from_memory(
                            rt,
                            @ptradd(asset.raw_bytes, offset) as ref u8,
                            length
                        )
                    }
                }
            }
        }
        @append(textures, texture)
        material_index = material_index + (1 as usize)
    }

    val total_vertices: mut usize = 0 as usize
    val total_indices: mut usize = 0 as usize
    for mesh in asset.meshes {
        total_vertices = total_vertices + mesh.vertex_count
        total_indices = total_indices + mesh.index_count
    }

    val result: mut renderer.ModelGPU = {
        mesh: { raw: none as ref void, index_count: 0 as i32 },
        submeshes: mem.persistent[renderer.ModelSubmesh](),
        textures: textures,
        asset: asset,
        base_vertices: none as ref f32,
        draw_vertices: none as ref f32,
        vertex_float_count: 0 as usize,
        skinned: asset.has_skinning
    }
    if total_vertices == (0 as usize) || total_indices == (0 as usize) {
        return result
    }

    val vertex_float_count: usize = total_vertices * (8 as usize)
    val base_vertices: ref f32 = @alloc(vertex_float_count * (@sizeof(f32) as usize)) as ref f32
    val indices: ref u32 = @alloc(total_indices * (@sizeof(u32) as usize)) as ref u32
    if base_vertices == none || indices == none {
        if base_vertices != none {
            @free(base_vertices)
        }
        if indices != none {
            @free(indices)
        }
        return result
    }

    val vertex_base: mut usize = 0 as usize
    val index_base: mut usize = 0 as usize
    for mesh in asset.meshes {
        val float_count: usize = mesh.vertex_count * (8 as usize)
        if mesh.vertices != none {
            val source: ref void = mesh.vertices as ref void
            val target: ref void = @ptradd(
                base_vertices,
                vertex_base * (8 as usize) * (@sizeof(f32) as usize)
            ) as ref void
            @memcpy(target, source, float_count * (@sizeof(f32) as usize))
        }
        val index: mut usize = 0 as usize
        for index < mesh.index_count {
            val value: u32 = bin.read_u32_le(
                mesh.indices as ref u8,
                index * (4 as usize)
            ) + (vertex_base as u32)
            math.store_u32(indices, index_base + index, value)
            index = index + (1 as usize)
        }
        val texture: mut ref void = none as ref void
        if mesh.material >= (0 as i32) && (mesh.material as usize) < @len(textures) {
            if @get(textures, mesh.material as usize) is some value {
                texture = value
            }
        }
        @append(result.submeshes, {
                index_offset: index_base as u32,
                index_count: mesh.index_count as u32,
                texture: texture
            })
        vertex_base = vertex_base + mesh.vertex_count
        index_base = index_base + mesh.index_count
    }

    result.base_vertices = base_vertices
    result.vertex_float_count = vertex_float_count
    if asset.has_skinning {
        result.draw_vertices = @alloc(vertex_float_count * (@sizeof(f32) as usize)) as ref f32
        if result.draw_vertices != none {
            @memcpy(
                result.draw_vertices as ref void,
                base_vertices,
                vertex_float_count * (@sizeof(f32) as usize)
            )
        }
    }
    result.mesh = renderer.upload_mesh(
        runtime,
        base_vertices,
        vertex_float_count,
        indices,
        total_indices as i32
    )
    @free(indices)
    return result
}

pub fn upload_glb_model(runtime: ref void, model: ecs.GlbModel) renderer.MeshGPU = trust {
    if !model.valid || model.vertex_count <= (0 as i32) || model.raw_bytes == none || model.bin_length == (0 as usize) {
        return { raw: none as ref void, index_count: 0 as i32 }
    }
    val data: ref u8 = model.raw_bytes
    val json_offset: usize = 20 as usize
    val json_len: u32 = bin.read_u32_le(data, 12 as usize)
    val json_buf: ref u8 = @alloc((json_len as usize) + (1 as usize)) as ref u8
    if json_buf == none {
        return { raw: none as ref void, index_count: 0 as i32 }
    }
    @memcpy(json_buf, @ptradd(data, json_offset) as ref void, json_len as usize)
    @store8(@ptradd(json_buf, json_len as usize), 0)
    val result: mut renderer.MeshGPU = { raw: none as ref void, index_count: 0 as i32 }
    if json.parse(string.view(json_buf, json_len as i64)) is some doc {
        val root: ref void = json.doc_root(doc)
        val vc: usize = model.vertex_count as usize
        val ic: usize = model.index_count as usize
        val vertex_float_count: usize = vc * (8 as usize)
        val vertices: ref void = @alloc(vertex_float_count * (@sizeof(f32) as usize))
        val actual_ic: mut usize = vc

        if ic > (0 as usize) {
            actual_ic = ic
        }

        val indices: ref void = @alloc(actual_ic * (@sizeof(u32) as usize))
        if vertices != none && indices != none {
            val bin_base: ref void = @ptradd(
                data,
                (json_offset + (json_len as usize) + (8 as usize)) as usize
            )
            val pos_offset: mut usize = 0 as usize
            val nrm_offset: mut usize = 0 as usize
            val uv_offset: mut usize = 0 as usize
            val idx_offset: mut usize = 0 as usize
            val has_nrm: mut bool = false
            val has_uv: mut bool = false
            if json.obj_get(root, c"accessors") is some accessors {
                if json.obj_get(root, c"bufferViews") is some buffer_views {
                    if json.obj_get(root, c"meshes") is some meshes {
                        if json.arr_get(meshes, 0 as usize) is some mesh {
                            if json.obj_get(mesh, c"primitives") is some primitives {
                                if json.arr_get(primitives, 0 as usize) is some prim {
                                    if json.obj_get(prim, c"attributes") is some attrs {
                                        if json.obj_get_int(attrs, c"POSITION") is some pi {
                                            pos_offset = glb.parse_accessor_offset(
                                                accessors,
                                                buffer_views,
                                                pi
                                            )
                                        }
                                        if json.obj_get_int(attrs, c"NORMAL") is some ni {
                                            nrm_offset = glb.parse_accessor_offset(
                                                accessors,
                                                buffer_views,
                                                ni
                                            )
                                            has_nrm = true
                                        }
                                        if json.obj_get_int(attrs, c"TEXCOORD_0") is some ti {
                                            uv_offset = glb.parse_accessor_offset(
                                                accessors,
                                                buffer_views,
                                                ti
                                            )
                                            has_uv = true
                                        }
                                    }
                                    if json.obj_get_int(prim, c"indices") is some ii {
                                        idx_offset = glb.parse_accessor_offset(
                                            accessors,
                                            buffer_views,
                                            ii
                                        )
                                    }
                                }
                            }
                        }
                    }
                }
            }
            val vi: mut usize = 0 as usize
            for vi < vc {
                val p: ref f32 = @ptradd(bin_base, pos_offset + vi * (12 as usize)) as ref f32
                val px: f32 = math.read_f32(p, 0 as usize)
                val py: f32 = math.read_f32(p, 1 as usize)
                val pz: f32 = math.read_f32(p, 2 as usize)
                val nx: mut f32 = 0.0 as f32
                val ny: mut f32 = 1.0 as f32
                val nz: mut f32 = 0.0 as f32
                if has_nrm {
                    val n: ref f32 = @ptradd(bin_base, nrm_offset + vi * (12 as usize)) as ref f32
                    nx = math.read_f32(n, 0 as usize)
                    ny = math.read_f32(n, 1 as usize)
                    nz = math.read_f32(n, 2 as usize)
                }
                val tu: mut f32 = 0.0 as f32
                val tv: mut f32 = 0.0 as f32
                if has_uv {
                    val t: ref f32 = @ptradd(bin_base, uv_offset + vi * (8 as usize)) as ref f32
                    tu = math.read_f32(t, 0 as usize)
                    tv = math.read_f32(t, 1 as usize)
                }
                write_vertex_uv(vertices, vi, math.vec3(px, py, pz), math.vec3(nx, ny, nz), tu, tv)
                vi = vi + (1 as usize)
            }
            val use_u16: mut bool = false
            if json.parse(string.view(json_buf, json_len as i64)) is some doc2 {
                val root2: ref void = json.doc_root(doc2)
                if json.obj_get(root2, c"accessors") is some accessors2 {
                    if json.obj_get(root2, c"meshes") is some meshes2 {
                        if json.arr_get(meshes2, 0 as usize) is some mesh2 {
                            if json.obj_get(mesh2, c"primitives") is some prims2 {
                                if json.arr_get(prims2, 0 as usize) is some prim2 {
                                    if json.obj_get_int(prim2, c"indices") is some ii2 {
                                        if json.arr_get(accessors2, ii2 as usize) is some acc {
                                            if json.obj_get_int(acc, c"componentType") is some ct {
                                                if ct == (5123 as i64) {
                                                    use_u16 = true
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                json.doc_free(doc2)
            }
            val ii: mut usize = 0 as usize
            if ic > (0 as usize) {
                for ii < ic {
                    val idx_val: mut u32 = 0 as u32
                    if use_u16 {
                        val slot: ref void = @ptradd(bin_base, idx_offset + ii * (2 as usize))
                        val lo: u8 = @load8(slot as ref u8)
                        val hi: u8 = @load8(@ptradd(slot, 1 as usize) as ref u8)
                        idx_val = (lo as u32) | ((hi as u32) << (8 as u32))
                    } else {
                        val slot: ref void = @ptradd(bin_base, idx_offset + ii * (4 as usize))
                        idx_val = bin.read_u32_le(slot as ref u8, 0 as usize)
                    }
                    math.store_u32(indices, ii, idx_val)
                    ii = ii + (1 as usize)
                }
            } else {
                for ii < vc {
                    math.store_u32(indices, ii, ii as u32)
                    ii = ii + (1 as usize)
                }
            }
            result = renderer.upload_mesh(
                runtime,
                vertices,
                vertex_float_count,
                indices,
                actual_ic as i32
            )
        }
        if vertices != none {
            @free(vertices)
        }
        if indices != none {
            @free(indices)
        }
        json.doc_free(doc)
    }
    @free(json_buf)
    return result
}

pub fn cube_face(
    vertices: ref void,
    indices: ref void,
    face_index: i32,
    p0: math.Vec3,
    p1: math.Vec3,
    p2: math.Vec3,
    p3: math.Vec3,
    normal: math.Vec3
) void = trust {
    val base_vertex: usize = (face_index as usize) * (4 as usize)
    val base_index: usize = (face_index as usize) * (6 as usize)
    write_vertex(vertices, base_vertex + (0 as usize), p0, normal)
    write_vertex(vertices, base_vertex + (1 as usize), p1, normal)
    write_vertex(vertices, base_vertex + (2 as usize), p2, normal)
    write_vertex(vertices, base_vertex + (3 as usize), p3, normal)
    math.store_u32(indices, base_index + (0 as usize), (base_vertex + (0 as usize)) as u32)
    math.store_u32(indices, base_index + (1 as usize), (base_vertex + (1 as usize)) as u32)
    math.store_u32(indices, base_index + (2 as usize), (base_vertex + (2 as usize)) as u32)
    math.store_u32(indices, base_index + (3 as usize), (base_vertex + (0 as usize)) as u32)
    math.store_u32(indices, base_index + (4 as usize), (base_vertex + (2 as usize)) as u32)
    math.store_u32(indices, base_index + (5 as usize), (base_vertex + (3 as usize)) as u32)
}

pub fn build_cube_mesh(runtime: ref void) renderer.MeshGPU = trust {
    val vertex_float_count: usize = 24 as usize * 8 as usize
    val index_count: i32 = 36 as i32
    val vertices: ref void = @alloc(vertex_float_count * (@sizeof(f32) as usize))
    val indices: ref void = @alloc((index_count as usize) * (@sizeof(u32) as usize))
    if vertices == none || indices == none {
        if vertices != none {
            @free(vertices)
        }
        if indices != none {
            @free(indices)
        }
        return { raw: none as ref void, index_count: 0 as i32 }
    }
    cube_face(
        vertices, indices, 0 as i32,
        math.vec3(-0.5 as f32, -0.5 as f32, 0.5 as f32),
        math.vec3(0.5 as f32, -0.5 as f32, 0.5 as f32),
        math.vec3(0.5 as f32, 0.5 as f32, 0.5 as f32),
        math.vec3(-0.5 as f32, 0.5 as f32, 0.5 as f32),
        math.vec3(0.0 as f32, 0.0 as f32, 1.0 as f32)
    )
    cube_face(
        vertices, indices, 1 as i32,
        math.vec3(0.5 as f32, -0.5 as f32, -0.5 as f32),
        math.vec3(-0.5 as f32, -0.5 as f32, -0.5 as f32),
        math.vec3(-0.5 as f32, 0.5 as f32, -0.5 as f32),
        math.vec3(0.5 as f32, 0.5 as f32, -0.5 as f32),
        math.vec3(0.0 as f32, 0.0 as f32, -1.0 as f32)
    )
    cube_face(
        vertices, indices, 2 as i32,
        math.vec3(-0.5 as f32, -0.5 as f32, -0.5 as f32),
        math.vec3(-0.5 as f32, -0.5 as f32, 0.5 as f32),
        math.vec3(-0.5 as f32, 0.5 as f32, 0.5 as f32),
        math.vec3(-0.5 as f32, 0.5 as f32, -0.5 as f32),
        math.vec3(-1.0 as f32, 0.0 as f32, 0.0 as f32)
    )
    cube_face(
        vertices, indices, 3 as i32,
        math.vec3(0.5 as f32, -0.5 as f32, 0.5 as f32),
        math.vec3(0.5 as f32, -0.5 as f32, -0.5 as f32),
        math.vec3(0.5 as f32, 0.5 as f32, -0.5 as f32),
        math.vec3(0.5 as f32, 0.5 as f32, 0.5 as f32),
        math.vec3(1.0 as f32, 0.0 as f32, 0.0 as f32)
    )
    cube_face(
        vertices, indices, 4 as i32,
        math.vec3(-0.5 as f32, 0.5 as f32, 0.5 as f32),
        math.vec3(0.5 as f32, 0.5 as f32, 0.5 as f32),
        math.vec3(0.5 as f32, 0.5 as f32, -0.5 as f32),
        math.vec3(-0.5 as f32, 0.5 as f32, -0.5 as f32),
        math.vec3(0.0 as f32, 1.0 as f32, 0.0 as f32)
    )
    cube_face(
        vertices, indices, 5 as i32,
        math.vec3(-0.5 as f32, -0.5 as f32, -0.5 as f32),
        math.vec3(0.5 as f32, -0.5 as f32, -0.5 as f32),
        math.vec3(0.5 as f32, -0.5 as f32, 0.5 as f32),
        math.vec3(-0.5 as f32, -0.5 as f32, 0.5 as f32),
        math.vec3(0.0 as f32, -1.0 as f32, 0.0 as f32)
    )
    val mesh: renderer.MeshGPU = renderer.upload_mesh(
        runtime,
        vertices,
        vertex_float_count,
        indices,
        index_count
    )
    @free(vertices)
    @free(indices)
    return mesh
}

pub fn build_sphere_mesh(
    runtime: ref void,
    lat_segments: i32,
    lon_segments: i32
) renderer.MeshGPU = trust {
    val vertex_count: i32 = (lat_segments + 1 as i32) * (lon_segments + 1 as i32)
    val index_count: i32 = lat_segments * lon_segments * 6 as i32
    val vertex_float_count: usize = (vertex_count as usize) * (8 as usize)
    val vertices: ref void = @alloc(vertex_float_count * (@sizeof(f32) as usize))
    val indices: ref void = @alloc((index_count as usize) * (@sizeof(u32) as usize))
    if vertices == none || indices == none {
        if vertices != none {
            @free(vertices)
        }
        if indices != none {
            @free(indices)
        }
        return { raw: none as ref void, index_count: 0 as i32 }
    }
    for iy = 0, iy <= lat_segments, iy++ {
        val v: f32 = (iy as f32) / (lat_segments as f32)
        val theta: f64 = (v as f64) * PI
        val y: f32 = math.cos(theta) as f32
        val ring_r: f32 = math.sin(theta) as f32
        for ix = 0, ix <= lon_segments, ix++ {
            val u: f32 = (ix as f32) / (lon_segments as f32)
            val phi: f64 = (u as f64) * ((2.0 as f64) * PI)
            val x: f32 = (math.cos(phi) as f32) * ring_r
            val z: f32 = (math.sin(phi) as f32) * ring_r
            val normal: math.Vec3 = math.vec3(x, y, z)
            val vertex_index: usize = ((iy * (lon_segments + 1 as i32)) + ix) as usize
            write_vertex(vertices, vertex_index, normal, normal)
        }
    }
    val row_stride: i32 = lon_segments + 1 as i32
    for face_y = 0, face_y < lat_segments, face_y++ {
        for face_x = 0, face_x < lon_segments, face_x++ {
            val a: u32 = ((face_y * row_stride) + face_x) as u32
            val b: u32 = (((face_y + 1 as i32) * row_stride) + face_x) as u32
            val c: u32 = a + (1 as u32)
            val d: u32 = b + (1 as u32)
            val index_base: usize = (((face_y * lon_segments) + face_x) * 6 as i32) as usize
            math.store_u32(indices, index_base + (0 as usize), a)
            math.store_u32(indices, index_base + (1 as usize), b)
            math.store_u32(indices, index_base + (2 as usize), c)
            math.store_u32(indices, index_base + (3 as usize), c)
            math.store_u32(indices, index_base + (4 as usize), b)
            math.store_u32(indices, index_base + (5 as usize), d)
        }
    }
    val mesh: renderer.MeshGPU = renderer.upload_mesh(
        runtime,
        vertices,
        vertex_float_count,
        indices,
        index_count
    )
    @free(vertices)
    @free(indices)
    return mesh
}

pub fn build_quad_mesh(runtime: ref void) renderer.MeshGPU = trust {
    val vertex_float_count: usize = (4 as usize) * (8 as usize)
    val index_count: i32 = 6 as i32
    val vertices: ref void = @alloc(vertex_float_count * (@sizeof(f32) as usize))
    val indices: ref void = @alloc((index_count as usize) * (@sizeof(u32) as usize))
    if vertices == none || indices == none {
        if vertices != none {
            @free(vertices)
        }
        if indices != none {
            @free(indices)
        }
        return { raw: none as ref void, index_count: 0 as i32 }
    }
    val n: math.Vec3 = math.vec3(0.0 as f32, 0.0 as f32, 1.0 as f32)
    write_vertex_uv(
        vertices,
        0 as usize,
        math.vec3(-0.5 as f32, -0.5 as f32, 0.0 as f32),
        n,
        0.0 as f32,
        1.0 as f32
    )
    write_vertex_uv(
        vertices,
        1 as usize,
        math.vec3( 0.5 as f32, -0.5 as f32, 0.0 as f32),
        n,
        1.0 as f32,
        1.0 as f32
    )
    write_vertex_uv(
        vertices,
        2 as usize,
        math.vec3( 0.5 as f32, 0.5 as f32, 0.0 as f32),
        n,
        1.0 as f32,
        0.0 as f32
    )
    write_vertex_uv(
        vertices,
        3 as usize,
        math.vec3(-0.5 as f32, 0.5 as f32, 0.0 as f32),
        n,
        0.0 as f32,
        0.0 as f32
    )
    math.store_u32(indices, 0 as usize, 0 as u32)
    math.store_u32(indices, 1 as usize, 1 as u32)
    math.store_u32(indices, 2 as usize, 2 as u32)
    math.store_u32(indices, 3 as usize, 0 as u32)
    math.store_u32(indices, 4 as usize, 2 as u32)
    math.store_u32(indices, 5 as usize, 3 as u32)
    val mesh: renderer.MeshGPU = renderer.upload_mesh(
        runtime,
        vertices,
        vertex_float_count,
        indices,
        index_count
    )
    @free(vertices)
    @free(indices)
    return mesh
}
