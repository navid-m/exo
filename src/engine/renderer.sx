        light_pos_2: { x: 0.0 as f32, y: 0.0 as f32, z: 0.0 as f32, w: 0.0 as f32 },
        light_pos_3: { x: 0.0 as f32, y: 0.0 as f32, z: 0.0 as f32, w: 0.0 as f32 },
        light_pos_4: { x: 0.0 as f32, y: 0.0 as f32, z: 0.0 as f32, w: 0.0 as f32 },
        light_pos_5: { x: 0.0 as f32, y: 0.0 as f32, z: 0.0 as f32, w: 0.0 as f32 },
        light_pos_6: { x: 0.0 as f32, y: 0.0 as f32, z: 0.0 as f32, w: 0.0 as f32 },
        light_pos_7: { x: 0.0 as f32, y: 0.0 as f32, z: 0.0 as f32, w: 0.0 as f32 },
        light_color_0: { x: 0.0 as f32, y: 0.0 as f32, z: 0.0 as f32, w: 0.0 as f32 },
        light_color_1: { x: 0.0 as f32, y: 0.0 as f32, z: 0.0 as f32, w: 0.0 as f32 },
        light_color_2: { x: 0.0 as f32, y: 0.0 as f32, z: 0.0 as f32, w: 0.0 as f32 },
        light_color_3: { x: 0.0 as f32, y: 0.0 as f32, z: 0.0 as f32, w: 0.0 as f32 },
        light_color_4: { x: 0.0 as f32, y: 0.0 as f32, z: 0.0 as f32, w: 0.0 as f32 },
        light_color_5: { x: 0.0 as f32, y: 0.0 as f32, z: 0.0 as f32, w: 0.0 as f32 },
