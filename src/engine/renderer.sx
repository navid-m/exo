        light_meta: { x: 0.0 as f32, y: 0.0 as f32, z: 0.0 as f32, w: 0.0 as f32 }
    }
}

fn set_light_uniform(fu: mut SceneFragmentUniforms, index: i32, light: ecs.PointLight) void = {
    val pos_intensity: math.Vec4f = { x: light.position.x, y: light.position.y, z: light.position.z, w: light.intensity }
    val color_radius: math.Vec4f = { x: light.color.x, y: light.color.y, z: light.color.z, w: light.radius }
    if index == (0 as i32) {
        fu.light_pos_0 = pos_intensity
        fu.light_color_0 = color_radius
    } elif index == (1 as i32) {
        fu.light_pos_1 = pos_intensity
        fu.light_color_1 = color_radius
    } elif index == (2 as i32) {
        fu.light_pos_2 = pos_intensity
        fu.light_color_2 = color_radius
    } elif index == (3 as i32) {
        fu.light_pos_3 = pos_intensity
        fu.light_color_3 = color_radius
    } elif index == (4 as i32) {
        fu.light_pos_4 = pos_intensity
        fu.light_color_4 = color_radius
    } elif index == (5 as i32) {
        fu.light_pos_5 = pos_intensity
        fu.light_color_5 = color_radius
    } elif index == (6 as i32) {
        fu.light_pos_6 = pos_intensity
        fu.light_color_6 = color_radius
    } elif index == (7 as i32) {
        fu.light_pos_7 = pos_intensity
        fu.light_color_7 = color_radius
    }
}

pub fn configure_scene_style(runtime_raw: ref void, sky_top: math.Vec3, sky_horizon: math.Vec3, ambient: f32, lights: list[ecs.PointLight]) void = trust {
    if runtime_raw == none {
        return
    }
    val runtime: mut ref Renderer = runtime_raw as mut ref Renderer
    runtime.sky_top = sky_top
    runtime.sky_horizon = sky_horizon
    runtime.ambient = ambient
    runtime.lights = lights
}

