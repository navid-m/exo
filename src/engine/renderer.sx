fn set_light_uniform(fu: mut SceneFragmentUniforms, index: i32, light: ecs.PointLight) void = {
    val pos_intensity: math.Vec4f = {
        x: light.position.x,
        y: light.position.y,
        z: light.position.z,
        w: light.intensity
    }
    val color_radius: math.Vec4f = {
        x: light.color.x,
        y: light.color.y,
        z: light.color.z,
        w: light.radius
    }
    if index == (0 as i32) {
        fu.light_pos_0 = pos_intensity
        fu.light_color_0 = color_radius
    } elif index == (1 as i32) {
        fu.light_pos_1 = pos_intensity
        fu.light_color_1 = color_radius
    } elif index == (2 as i32) {
        fu.light_pos_2 = pos_intensity
        fu.light_color_2 = color_radius
    } elif index == (3 as i32) {
        fu.light_pos_3 = pos_intensity
        fu.light_color_3 = color_radius
    } elif index == (4 as i32) {
        fu.light_pos_4 = pos_intensity
        fu.light_color_4 = color_radius
    } elif index == (5 as i32) {
        fu.light_pos_5 = pos_intensity
        fu.light_color_5 = color_radius
    } elif index == (6 as i32) {
        fu.light_pos_6 = pos_intensity
        fu.light_color_6 = color_radius
    } elif index == (7 as i32) {
        fu.light_pos_7 = pos_intensity
        fu.light_color_7 = color_radius
    }
}

pub fn configure_scene_style(
    runtime_raw: ref void,
    sky_top: math.Vec3,
    sky_horizon: math.Vec3,
    ambient: f32,
    lights: list[ecs.PointLight]
) void = trust {
    if runtime_raw == none {
        return
    }
    val runtime: mut ref Renderer = runtime_raw as mut ref Renderer
    runtime.sky_top = sky_top
    runtime.sky_horizon = sky_horizon
    runtime.ambient = ambient
    runtime.lights = lights
}

/// Project a world-space point into screen UV space for full-screen effects
/// such as godrays. The origin is the top-left of the render target. `visible`
/// is false when the point is behind the camera or so far outside the viewport
/// that a screen-space effect would no longer be meaningful. Off-screen light
/// sources are allowed, which lets shafts enter from the edge of the frame.
pub fn project_to_screen(view_proj: math.Mat4, point: math.Vec3) ScreenProjection = {
    val clip_x: f32 = view_proj.m00 * point.x + view_proj.m01 * point.y + view_proj.m02 * point.z + view_proj.m03
    val clip_y: f32 = view_proj.m10 * point.x + view_proj.m11 * point.y + view_proj.m12 * point.z + view_proj.m13
    val clip_w: f32 = view_proj.m30 * point.x + view_proj.m31 * point.y + view_proj.m32 * point.z + view_proj.m33
    if clip_w <= (0.0001 as f32) {
        return { x: 0.5 as f32, y: 0.5 as f32, visible: false }
    }
    val ndc_x: f32 = clip_x / clip_w
    val ndc_y: f32 = clip_y / clip_w
    val uv_x: f32 = ndc_x * (0.5 as f32) + (0.5 as f32)
    val uv_y: f32 = (0.5 as f32) - ndc_y * (0.5 as f32)
    val visible: bool = uv_x >= (-2.0 as f32) && uv_x <= (3.0 as f32) && uv_y >= (-2.0 as f32) && uv_y <= (3.0 as f32)
    return { x: uv_x, y: uv_y, visible: visible }
}

