pub fn load_shader(
    runtime: ref Renderer,
    path: ref u8,
    stage: i32,
    num_samplers: u32,
    num_uniform_buffers: u32
) ref void = trust {
    if io.load_binary_file(path) is some blob {
        val info: mut sdl.SDLGPUShaderCreateInfo = {
            code_size: 0 as usize,
            code: none as ref u8,
            entrypoint: none as ref u8,
            format: 0 as u32,
            stage: 0 as i32,
            num_samplers: 0 as u32,
            num_storage_textures: 0 as u32,
            num_storage_buffers: 0 as u32,
            num_uniform_buffers: 0 as u32,
            props: 0 as u32
        }
        info.code_size = blob.len
        info.code = blob.data
        info.entrypoint = shaders.exo_shader_entrypoint()
        info.format = shaders.exo_shader_format()
        info.stage = stage
        info.num_samplers = num_samplers
        info.num_uniform_buffers = num_uniform_buffers
        val shader: ref void = sdl.SDL_CreateGPUShader(runtime.device, @addr(info))
        @free(blob.data as ref void)
        return shader
    }
    return none as ref void
}

pub fn create_texture(
    runtime: ref Renderer,
    format: i32,
    usage: u32,
    width: u32,
    height: u32
) ref void = {
    val info: mut sdl.SDLGPUTextureCreateInfo = {
        typ: 0 as i32,
        format: 0 as i32,
        usage: 0 as u32,
        width: 0 as u32,
        height: 0 as u32,
        layer_count_or_depth: 0 as u32,
        num_levels: 0 as u32,
        sample_count: 0 as i32,
        props: 0 as u32
    }
    info.typ = sdl.SDL_GPU_TEXTURETYPE_2D
    info.format = format
    info.usage = usage
    info.width = width
    info.height = height
    info.layer_count_or_depth = 1 as u32
    info.num_levels = 1 as u32
    info.sample_count = sdl.SDL_GPU_SAMPLECOUNT_1
    return trust sdl.SDL_CreateGPUTexture(runtime.device, @addr(info))
}

/// Upload raw, tightly packed RGBA8 pixels into a sampled GPU texture.
pub fn create_rgba_texture(
    runtime: ref Renderer,
    pixels: ref u8,
    width: i32,
    height: i32
) ref void = trust {
    if pixels == none || width <= (0 as i32) || height <= (0 as i32) {
        return none as ref void
    }
    val w: u32 = width as u32
    val h: u32 = height as u32
    val texture: ref void = create_texture(
        runtime,
        sdl.SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM,
        sdl.SDL_GPU_TEXTUREUSAGE_SAMPLER,
        w,
        h
    )
    if texture == none {
        return none as ref void
    }
    val byte_size: u32 = w * h * (4 as u32)
    val tbuf_info: mut sdl.SDLGPUTransferBufferCreateInfo = {
        usage: 0 as i32, size: 0 as u32, props: 0 as u32
    }
    tbuf_info.usage = sdl.SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD
    tbuf_info.size = byte_size
    val tbuf: ref void = sdl.SDL_CreateGPUTransferBuffer(runtime.device, @addr(tbuf_info))
    if tbuf == none {
        sdl.SDL_ReleaseGPUTexture(runtime.device, texture)
        return none as ref void
    }
    val mapped: ref void = sdl.SDL_MapGPUTransferBuffer(runtime.device, tbuf, false)
    if mapped == none {
        sdl.SDL_ReleaseGPUTransferBuffer(runtime.device, tbuf)
        sdl.SDL_ReleaseGPUTexture(runtime.device, texture)
        return none as ref void
    }
    @memcpy(mapped, pixels as ref void, byte_size as usize)
    sdl.SDL_UnmapGPUTransferBuffer(runtime.device, tbuf)
    val cmd: ref void = sdl.SDL_AcquireGPUCommandBuffer(runtime.device)
    if cmd == none {
        sdl.SDL_ReleaseGPUTransferBuffer(runtime.device, tbuf)
        sdl.SDL_ReleaseGPUTexture(runtime.device, texture)
        return none as ref void
    }
    val copy_pass: ref void = sdl.SDL_BeginGPUCopyPass(cmd)
    val src: mut sdl.SDLGPUTextureTransferInfo = {
        transfer_buffer: tbuf,
        offset: 0 as u32,
        pixels_per_row: w,
        rows_per_layer: h
    }
    val dst: mut sdl.SDLGPUTextureRegion = {
        texture: texture,
        mip_level: 0 as u32,
        layer: 0 as u32,
        x: 0 as u32,
        y: 0 as u32,
        z: 0 as u32,
        w: w,
        h: h,
        d: 1 as u32
    }
    sdl.SDL_UploadToGPUTexture(copy_pass, @addr(src), @addr(dst), false)
    sdl.SDL_EndGPUCopyPass(copy_pass)
    sdl.SDL_SubmitGPUCommandBuffer(cmd)
    sdl.SDL_ReleaseGPUTransferBuffer(runtime.device, tbuf)
    return texture
}

fn half_extent(value: u32) u32 = {
    val half: u32 = value / (2 as u32)
    if half < (1 as u32) {
        return 1 as u32
    }
    return half
}

pub fn release_render_targets(runtime: mut ref Renderer) void = trust {
    if runtime.scene_depth != none {
        sdl.SDL_ReleaseGPUTexture(runtime.device, runtime.scene_depth)
        runtime.scene_depth = none
    }
    if runtime.scene_color != none {
        sdl.SDL_ReleaseGPUTexture(runtime.device, runtime.scene_color)
        runtime.scene_color = none
    }
    if runtime.reflection_depth != none {
        sdl.SDL_ReleaseGPUTexture(runtime.device, runtime.reflection_depth)
        runtime.reflection_depth = none
    }
    if runtime.reflection_color != none {
        sdl.SDL_ReleaseGPUTexture(runtime.device, runtime.reflection_color)
        runtime.reflection_color = none
    }
    if runtime.bloom_a != none {
        sdl.SDL_ReleaseGPUTexture(runtime.device, runtime.bloom_a)
        runtime.bloom_a = none
    }
    if runtime.bloom_b != none {
        sdl.SDL_ReleaseGPUTexture(runtime.device, runtime.bloom_b)
        runtime.bloom_b = none
    }
    if runtime.godray != none {
        sdl.SDL_ReleaseGPUTexture(runtime.device, runtime.godray)
        runtime.godray = none
    }
}

pub fn recreate_render_targets(runtime: mut ref Renderer, width: u32, height: u32) bool = trust {
    runtime.render_width = width
    runtime.render_height = height
    release_render_targets(runtime)
    runtime.reflection_color = create_texture(
        runtime,
        runtime.swapchain_format,
        sdl.SDL_GPU_TEXTUREUSAGE_COLOR_TARGET | sdl.SDL_GPU_TEXTUREUSAGE_SAMPLER,
        width,
        height
    )
    if runtime.reflection_color == none {
        return false
    }
    runtime.reflection_depth = create_texture(
        runtime,
        sdl.SDL_GPU_TEXTUREFORMAT_D32_FLOAT,
        sdl.SDL_GPU_TEXTUREUSAGE_DEPTH_STENCIL_TARGET,
        width,
        height
    )
    if runtime.reflection_depth == none {
        return false
    }
    runtime.scene_depth = create_texture(
        runtime,
        sdl.SDL_GPU_TEXTUREFORMAT_D32_FLOAT,
        sdl.SDL_GPU_TEXTUREUSAGE_DEPTH_STENCIL_TARGET,
        width,
        height
    )
    if runtime.scene_depth == none {
        return false
    }
    runtime.scene_color = create_texture(
        runtime,
        runtime.swapchain_format,
        sdl.SDL_GPU_TEXTUREUSAGE_COLOR_TARGET | sdl.SDL_GPU_TEXTUREUSAGE_SAMPLER,
        width,
        height
    )
    if runtime.scene_color == none {
        return false
    }
    val bloom_width: u32 = half_extent(width)
    val bloom_height: u32 = half_extent(height)
    runtime.bloom_a = create_texture(
        runtime,
        runtime.swapchain_format,
        sdl.SDL_GPU_TEXTUREUSAGE_COLOR_TARGET | sdl.SDL_GPU_TEXTUREUSAGE_SAMPLER,
        bloom_width,
        bloom_height
    )
    if runtime.bloom_a == none {
        return false
    }
    runtime.bloom_b = create_texture(
        runtime,
        runtime.swapchain_format,
        sdl.SDL_GPU_TEXTUREUSAGE_COLOR_TARGET | sdl.SDL_GPU_TEXTUREUSAGE_SAMPLER,
        bloom_width,
        bloom_height
    )
    if runtime.bloom_b == none {
        return false
    }
    runtime.godray = create_texture(
        runtime,
        runtime.swapchain_format,
        sdl.SDL_GPU_TEXTUREUSAGE_COLOR_TARGET | sdl.SDL_GPU_TEXTUREUSAGE_SAMPLER,
        bloom_width,
        bloom_height
    )
    return runtime.godray != none
}

pub fn create_pipeline(
    runtime: ref Renderer,
    vs_path: ref u8,
    fs_path: ref u8,
    color_format: i32,
    enable_blend: bool,
    src_color: i32,
    dst_color: i32,
    src_alpha: i32,
    dst_alpha: i32,
    depth_write: bool,
    fragment_samplers: u32
) ref void = trust {
    val vs: ref void = load_shader(
        runtime,
        vs_path,
        sdl.SDL_GPU_SHADERSTAGE_VERTEX,
        0 as u32,
        1 as u32
    )
    if vs == none {
        return none as ref void
    }
    val fs: ref void = load_shader(
        runtime,
        fs_path,
        sdl.SDL_GPU_SHADERSTAGE_FRAGMENT,
        fragment_samplers,
        1 as u32
    )
    if fs == none {
        sdl.SDL_ReleaseGPUShader(runtime.device, vs)
        return none as ref void
    }
    val vertex_buffer_desc: mut sdl.SDLGPUVertexBufferDescription = {
        slot: 0 as u32,
        pitch: 0 as u32,
        input_rate: 0 as i32,
        instance_step_rate: 0 as u32
    }
    vertex_buffer_desc.slot = 0 as u32
    vertex_buffer_desc.pitch = 32 as u32
    vertex_buffer_desc.input_rate = sdl.SDL_GPU_VERTEXINPUTRATE_VERTEX
    val vertex_attributes: mut VertexAttributePair = {
        first: {
            location: 0 as u32,
            buffer_slot: 0 as u32,
            format: 0 as i32,
            offset: 0 as u32
        },
        second: {
            location: 0 as u32,
            buffer_slot: 0 as u32,
            format: 0 as i32,
            offset: 0 as u32
        }
    }
    vertex_attributes.first.location = 0 as u32
    vertex_attributes.first.buffer_slot = 0 as u32
    vertex_attributes.first.format = sdl.SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3
    vertex_attributes.first.offset = 0 as u32
    vertex_attributes.second.location = 1 as u32
    vertex_attributes.second.buffer_slot = 0 as u32
    vertex_attributes.second.format = sdl.SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3
    vertex_attributes.second.offset = 12 as u32
    val color_target: mut sdl.SDLGPUColorTargetDescription = {
        format: 0 as i32,
        blend_state: {
            src_color_blendfactor: 0 as i32,
            dst_color_blendfactor: 0 as i32,
            color_blend_op: 0 as i32,
            src_alpha_blendfactor: 0 as i32,
            dst_alpha_blendfactor: 0 as i32,
            alpha_blend_op: 0 as i32,
            color_write_mask: 0 as u8,
            enable_blend: false,
            enable_color_write_mask: false,
            padding1: 0 as u8,
            padding2: 0 as u8
        }
    }
    color_target.format = color_format
    color_target.blend_state.enable_blend = enable_blend
    color_target.blend_state.src_color_blendfactor = src_color
    color_target.blend_state.dst_color_blendfactor = dst_color
    color_target.blend_state.color_blend_op = sdl.SDL_GPU_BLENDOP_ADD
    color_target.blend_state.src_alpha_blendfactor = src_alpha
    color_target.blend_state.dst_alpha_blendfactor = dst_alpha
    color_target.blend_state.alpha_blend_op = sdl.SDL_GPU_BLENDOP_ADD
    val info: mut sdl.SDLGPUGraphicsPipelineCreateInfo = {
        vertex_shader: none as ref void,
        fragment_shader: none as ref void,
        vertex_input_state: {
            vertex_buffer_descriptions: none as ref sdl.SDLGPUVertexBufferDescription,
            num_vertex_buffers: 0 as u32,
            vertex_attributes: none as ref sdl.SDLGPUVertexAttribute,
            num_vertex_attributes: 0 as u32
        },
        primitive_type: 0 as i32,
        rasterizer_state: {
            fill_mode: 0 as i32,
            cull_mode: 0 as i32,
            front_face: 0 as i32,
            depth_bias_constant_factor: 0.0 as f32,
            depth_bias_clamp: 0.0 as f32,
            depth_bias_slope_factor: 0.0 as f32,
            enable_depth_bias: false,
            enable_depth_clip: false,
            padding1: 0 as u8,
            padding2: 0 as u8
        },
        multisample_state: {
            sample_count: 0 as i32,
            sample_mask: 0 as u32,
            enable_mask: false,
            enable_alpha_to_coverage: false,
            padding2: 0 as u8,
            padding3: 0 as u8
        },
        depth_stencil_state: {
            compare_op: 0 as i32,
            back_stencil_state: {
                fail_op: 0 as i32,
                pass_op: 0 as i32,
                depth_fail_op: 0 as i32,
                compare_op: 0 as i32
            },
            front_stencil_state: {
                fail_op: 0 as i32,
                pass_op: 0 as i32,
                depth_fail_op: 0 as i32,
                compare_op: 0 as i32
            },
            compare_mask: 0 as u8,
            write_mask: 0 as u8,
            enable_depth_test: false,
            enable_depth_write: false,
            enable_stencil_test: false,
            padding1: 0 as u8,
            padding2: 0 as u8,
            padding3: 0 as u8
        },
        target_info: {
            color_target_descriptions: none as ref sdl.SDLGPUColorTargetDescription,
            num_color_targets: 0 as u32,
            depth_stencil_format: 0 as i32,
            has_depth_stencil_target: false,
            padding1: 0 as u8,
            padding2: 0 as u8,
            padding3: 0 as u8
        },
        props: 0 as u32
    }
    info.vertex_shader = vs
    info.fragment_shader = fs
    info.vertex_input_state.vertex_buffer_descriptions = @addr(vertex_buffer_desc)
    info.vertex_input_state.num_vertex_buffers = 1 as u32
    info.vertex_input_state.vertex_attributes = @addr(vertex_attributes.first)
    info.vertex_input_state.num_vertex_attributes = 2 as u32
    info.primitive_type = sdl.SDL_GPU_PRIMITIVETYPE_TRIANGLELIST
    info.rasterizer_state.fill_mode = sdl.SDL_GPU_FILLMODE_FILL
    info.rasterizer_state.cull_mode = sdl.SDL_GPU_CULLMODE_NONE
    info.rasterizer_state.front_face = sdl.SDL_GPU_FRONTFACE_COUNTER_CLOCKWISE
    info.rasterizer_state.enable_depth_clip = true
    info.multisample_state.sample_count = sdl.SDL_GPU_SAMPLECOUNT_1
    info.depth_stencil_state.compare_op = sdl.SDL_GPU_COMPAREOP_LESS_OR_EQUAL
    info.depth_stencil_state.enable_depth_test = true
    info.depth_stencil_state.enable_depth_write = depth_write
    info.target_info.color_target_descriptions = @addr(color_target)
    info.target_info.num_color_targets = 1 as u32
    info.target_info.depth_stencil_format = sdl.SDL_GPU_TEXTUREFORMAT_D32_FLOAT
    info.target_info.has_depth_stencil_target = true
    val pipeline: ref void = sdl.SDL_CreateGPUGraphicsPipeline(runtime.device, @addr(info))
    sdl.SDL_ReleaseGPUShader(runtime.device, fs)
    sdl.SDL_ReleaseGPUShader(runtime.device, vs)
    return pipeline
}

/// Scene pipeline variant: stride=32 (pos+normal+uv), 3 vertex attributes, 1 fragment sampler.
pub fn create_scene_pipeline(
    runtime: ref Renderer,
    vs_path: ref u8,
    fs_path: ref u8,
    color_format: i32
) ref void = trust {
    val vs: ref void = load_shader(
        runtime,
        vs_path,
        sdl.SDL_GPU_SHADERSTAGE_VERTEX,
        0 as u32,
        1 as u32
    )
    if vs == none {
        return none as ref void
    }
    val fs: ref void = load_shader(
        runtime,
        fs_path,
        sdl.SDL_GPU_SHADERSTAGE_FRAGMENT,
        1 as u32,
        1 as u32
    )
    if fs == none {
        sdl.SDL_ReleaseGPUShader(runtime.device, vs)
        return none as ref void
    }
    val vbd: mut sdl.SDLGPUVertexBufferDescription = {
        slot: 0 as u32, pitch: 32 as u32,
        input_rate: sdl.SDL_GPU_VERTEXINPUTRATE_VERTEX, instance_step_rate: 0 as u32
    }
    val attrs: mut VertexAttributeTriple = {
        first: {
            location: 0 as u32,
            buffer_slot: 0 as u32,
            format: sdl.SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3,
            offset: 0 as u32
        },
        second: {
            location: 1 as u32,
            buffer_slot: 0 as u32,
            format: sdl.SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3,
            offset: 12 as u32
        },
        third: {
            location: 2 as u32,
            buffer_slot: 0 as u32,
            format: sdl.SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2,
            offset: 24 as u32
        }
    }
    val color_target: mut sdl.SDLGPUColorTargetDescription = {
        format: color_format,
        blend_state: {
            src_color_blendfactor: 0 as i32, dst_color_blendfactor: 0 as i32,
            color_blend_op: 0 as i32, src_alpha_blendfactor: 0 as i32,
            dst_alpha_blendfactor: 0 as i32, alpha_blend_op: 0 as i32,
            color_write_mask: 0 as u8, enable_blend: false,
            enable_color_write_mask: false, padding1: 0 as u8, padding2: 0 as u8
        }
    }
    val info: mut sdl.SDLGPUGraphicsPipelineCreateInfo = {
        vertex_shader: vs, fragment_shader: fs,
        vertex_input_state: {
            vertex_buffer_descriptions: @addr(vbd),
            num_vertex_buffers: 1 as u32,
            vertex_attributes: @addr(attrs.first),
            num_vertex_attributes: 3 as u32
        },
        primitive_type: sdl.SDL_GPU_PRIMITIVETYPE_TRIANGLELIST,
        rasterizer_state: {
            fill_mode: sdl.SDL_GPU_FILLMODE_FILL, cull_mode: sdl.SDL_GPU_CULLMODE_NONE,
            front_face: sdl.SDL_GPU_FRONTFACE_COUNTER_CLOCKWISE,
            depth_bias_constant_factor: 0.0 as f32, depth_bias_clamp: 0.0 as f32,
            depth_bias_slope_factor: 0.0 as f32,
            enable_depth_bias: false, enable_depth_clip: true,
            padding1: 0 as u8, padding2: 0 as u8
        },
        multisample_state: {
            sample_count: sdl.SDL_GPU_SAMPLECOUNT_1, sample_mask: 0 as u32,
            enable_mask: false, enable_alpha_to_coverage: false,
            padding2: 0 as u8, padding3: 0 as u8
        },
        depth_stencil_state: {
            compare_op: sdl.SDL_GPU_COMPAREOP_LESS_OR_EQUAL,
            back_stencil_state: {
                fail_op: 0 as i32,
                pass_op: 0 as i32,
                depth_fail_op: 0 as i32,
                compare_op: 0 as i32
            },
            front_stencil_state: {
                fail_op: 0 as i32,
                pass_op: 0 as i32,
                depth_fail_op: 0 as i32,
                compare_op: 0 as i32
            },
            compare_mask: 0 as u8, write_mask: 0 as u8,
            enable_depth_test: true, enable_depth_write: true,
            enable_stencil_test: false,
            padding1: 0 as u8, padding2: 0 as u8, padding3: 0 as u8
        },
        target_info: {
            color_target_descriptions: @addr(color_target),
            num_color_targets: 1 as u32,
            depth_stencil_format: sdl.SDL_GPU_TEXTUREFORMAT_D32_FLOAT,
            has_depth_stencil_target: true,
            padding1: 0 as u8, padding2: 0 as u8, padding3: 0 as u8
        },
        props: 0 as u32
    }
    val pipeline: ref void = sdl.SDL_CreateGPUGraphicsPipeline(runtime.device, @addr(info))
    sdl.SDL_ReleaseGPUShader(runtime.device, fs)
    sdl.SDL_ReleaseGPUShader(runtime.device, vs)
    return pipeline
}

/// UI pipeline: same vertex layout/shader as the scene pipeline, but no depth
/// target and alpha blending so HUD quads can be drawn directly to the swapchain.
pub fn create_ui_pipeline(
    runtime: ref Renderer,
    vs_path: ref u8,
    fs_path: ref u8,
    color_format: i32
) ref void = trust {
    val vs: ref void = load_shader(
        runtime,
        vs_path,
        sdl.SDL_GPU_SHADERSTAGE_VERTEX,
        0 as u32,
        1 as u32
    )
    if vs == none {
        return none as ref void
    }
    val fs: ref void = load_shader(
        runtime,
        fs_path,
        sdl.SDL_GPU_SHADERSTAGE_FRAGMENT,
        1 as u32,
        1 as u32
    )
    if fs == none {
        sdl.SDL_ReleaseGPUShader(runtime.device, vs)
        return none as ref void
    }
    val vbd: mut sdl.SDLGPUVertexBufferDescription = {
        slot: 0 as u32, pitch: 32 as u32,
        input_rate: sdl.SDL_GPU_VERTEXINPUTRATE_VERTEX, instance_step_rate: 0 as u32
    }
    val attrs: mut VertexAttributeTriple = {
        first: {
            location: 0 as u32,
            buffer_slot: 0 as u32,
            format: sdl.SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3,
            offset: 0 as u32
        },
        second: {
            location: 1 as u32,
            buffer_slot: 0 as u32,
            format: sdl.SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3,
            offset: 12 as u32
        },
        third: {
            location: 2 as u32,
            buffer_slot: 0 as u32,
            format: sdl.SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2,
            offset: 24 as u32
        }
    }
    val color_target: mut sdl.SDLGPUColorTargetDescription = {
        format: color_format,
        blend_state: {
            src_color_blendfactor: sdl.SDL_GPU_BLENDFACTOR_SRC_ALPHA,
            dst_color_blendfactor: sdl.SDL_GPU_BLENDFACTOR_ONE_MINUS_SRC_ALPHA,
            color_blend_op: sdl.SDL_GPU_BLENDOP_ADD,
            src_alpha_blendfactor: sdl.SDL_GPU_BLENDFACTOR_ONE,
            dst_alpha_blendfactor: sdl.SDL_GPU_BLENDFACTOR_ONE_MINUS_SRC_ALPHA,
            alpha_blend_op: sdl.SDL_GPU_BLENDOP_ADD,
            color_write_mask: 0 as u8, enable_blend: true,
            enable_color_write_mask: false, padding1: 0 as u8, padding2: 0 as u8
        }
    }
    val info: mut sdl.SDLGPUGraphicsPipelineCreateInfo = {
        vertex_shader: vs, fragment_shader: fs,
        vertex_input_state: {
            vertex_buffer_descriptions: @addr(vbd),
            num_vertex_buffers: 1 as u32,
            vertex_attributes: @addr(attrs.first),
            num_vertex_attributes: 3 as u32
        },
        primitive_type: sdl.SDL_GPU_PRIMITIVETYPE_TRIANGLELIST,
        rasterizer_state: {
            fill_mode: sdl.SDL_GPU_FILLMODE_FILL, cull_mode: sdl.SDL_GPU_CULLMODE_NONE,
            front_face: sdl.SDL_GPU_FRONTFACE_COUNTER_CLOCKWISE,
            depth_bias_constant_factor: 0.0 as f32, depth_bias_clamp: 0.0 as f32,
            depth_bias_slope_factor: 0.0 as f32,
            enable_depth_bias: false, enable_depth_clip: true,
            padding1: 0 as u8, padding2: 0 as u8
        },
        multisample_state: {
            sample_count: sdl.SDL_GPU_SAMPLECOUNT_1, sample_mask: 0 as u32,
            enable_mask: false, enable_alpha_to_coverage: false,
            padding2: 0 as u8, padding3: 0 as u8
        },
        depth_stencil_state: {
            compare_op: sdl.SDL_GPU_COMPAREOP_LESS_OR_EQUAL,
            back_stencil_state: {
                fail_op: 0 as i32,
                pass_op: 0 as i32,
                depth_fail_op: 0 as i32,
                compare_op: 0 as i32
            },
            front_stencil_state: {
                fail_op: 0 as i32,
                pass_op: 0 as i32,
                depth_fail_op: 0 as i32,
                compare_op: 0 as i32
            },
            compare_mask: 0 as u8, write_mask: 0 as u8,
            enable_depth_test: false, enable_depth_write: false,
            enable_stencil_test: false,
            padding1: 0 as u8, padding2: 0 as u8, padding3: 0 as u8
        },
        target_info: {
            color_target_descriptions: @addr(color_target),
            num_color_targets: 1 as u32,
            depth_stencil_format: 0 as i32,
            has_depth_stencil_target: false,
            padding1: 0 as u8, padding2: 0 as u8, padding3: 0 as u8
        },
        props: 0 as u32
    }
    val pipeline: ref void = sdl.SDL_CreateGPUGraphicsPipeline(runtime.device, @addr(info))
    sdl.SDL_ReleaseGPUShader(runtime.device, fs)
    sdl.SDL_ReleaseGPUShader(runtime.device, vs)
    return pipeline
}

pub fn create_postprocess_pipeline(
    runtime: ref Renderer,
    vs_path: ref u8,
    fs_path: ref u8,
    color_format: i32,
    fragment_samplers: u32,
    fragment_uniforms: u32
) ref void = trust {
    val vs: ref void = load_shader(
        runtime,
        vs_path,
        sdl.SDL_GPU_SHADERSTAGE_VERTEX,
        0 as u32,
        0 as u32
    )
    if vs == none {
        return none as ref void
    }
    val fs: ref void = load_shader(
        runtime,
        fs_path,
        sdl.SDL_GPU_SHADERSTAGE_FRAGMENT,
        fragment_samplers,
        fragment_uniforms
    )
    if fs == none {
        sdl.SDL_ReleaseGPUShader(runtime.device, vs)
        return none as ref void
    }
    val color_target: mut sdl.SDLGPUColorTargetDescription = {
        format: 0 as i32,
        blend_state: {
            src_color_blendfactor: 0 as i32,
            dst_color_blendfactor: 0 as i32,
            color_blend_op: 0 as i32,
            src_alpha_blendfactor: 0 as i32,
            dst_alpha_blendfactor: 0 as i32,
            alpha_blend_op: 0 as i32,
            color_write_mask: 0 as u8,
            enable_blend: false,
            enable_color_write_mask: false,
            padding1: 0 as u8,
            padding2: 0 as u8
        }
    }
    color_target.format = color_format
    val info: mut sdl.SDLGPUGraphicsPipelineCreateInfo = {
        vertex_shader: none as ref void,
        fragment_shader: none as ref void,
        vertex_input_state: {
            vertex_buffer_descriptions: none as ref sdl.SDLGPUVertexBufferDescription,
            num_vertex_buffers: 0 as u32,
            vertex_attributes: none as ref sdl.SDLGPUVertexAttribute,
            num_vertex_attributes: 0 as u32
        },
        primitive_type: 0 as i32,
        rasterizer_state: {
            fill_mode: 0 as i32,
            cull_mode: 0 as i32,
            front_face: 0 as i32,
            depth_bias_constant_factor: 0.0 as f32,
            depth_bias_clamp: 0.0 as f32,
            depth_bias_slope_factor: 0.0 as f32,
            enable_depth_bias: false,
            enable_depth_clip: false,
            padding1: 0 as u8,
            padding2: 0 as u8
        },
        multisample_state: {
            sample_count: 0 as i32,
            sample_mask: 0 as u32,
            enable_mask: false,
            enable_alpha_to_coverage: false,
            padding2: 0 as u8,
            padding3: 0 as u8
        },
        depth_stencil_state: {
            compare_op: 0 as i32,
            back_stencil_state: {
                fail_op: 0 as i32,
                pass_op: 0 as i32,
                depth_fail_op: 0 as i32,
                compare_op: 0 as i32
            },
            front_stencil_state: {
                fail_op: 0 as i32,
                pass_op: 0 as i32,
                depth_fail_op: 0 as i32,
                compare_op: 0 as i32
            },
            compare_mask: 0 as u8,
            write_mask: 0 as u8,
            enable_depth_test: false,
            enable_depth_write: false,
            enable_stencil_test: false,
            padding1: 0 as u8,
            padding2: 0 as u8,
            padding3: 0 as u8
        },
        target_info: {
            color_target_descriptions: none as ref sdl.SDLGPUColorTargetDescription,
            num_color_targets: 0 as u32,
            depth_stencil_format: 0 as i32,
            has_depth_stencil_target: false,
            padding1: 0 as u8,
            padding2: 0 as u8,
            padding3: 0 as u8
        },
        props: 0 as u32
    }
    info.vertex_shader = vs
    info.fragment_shader = fs
    info.primitive_type = sdl.SDL_GPU_PRIMITIVETYPE_TRIANGLELIST
    info.rasterizer_state.fill_mode = sdl.SDL_GPU_FILLMODE_FILL
    info.rasterizer_state.cull_mode = sdl.SDL_GPU_CULLMODE_NONE
    info.rasterizer_state.front_face = sdl.SDL_GPU_FRONTFACE_COUNTER_CLOCKWISE
    info.multisample_state.sample_count = sdl.SDL_GPU_SAMPLECOUNT_1
    info.target_info.color_target_descriptions = @addr(color_target)
    info.target_info.num_color_targets = 1 as u32
    info.target_info.has_depth_stencil_target = false
    val pipeline: ref void = sdl.SDL_CreateGPUGraphicsPipeline(runtime.device, @addr(info))
    sdl.SDL_ReleaseGPUShader(runtime.device, fs)
    sdl.SDL_ReleaseGPUShader(runtime.device, vs)
    return pipeline
}

pub fn load_png_texture(runtime: ref Renderer, path: ref u8) ref void = trust {
    if io.load_binary_file(path) is some blob {
        val w: mut i32 = 0 as i32
        val h: mut i32 = 0 as i32
        val ch: mut i32 = 0 as i32
        val pixels: ref u8 = sdl.stbi_load_from_memory(
            blob.data,
            blob.len as i32,
            @addr(w),
            @addr(h),
            @addr(ch),
            4 as i32
        )
        @free(blob.data as ref void)
        if pixels == none {
            return none as ref void
        }
        val tex_info: mut sdl.SDLGPUTextureCreateInfo = {
            typ: 0 as i32, format: 0 as i32, usage: 0 as u32,
            width: 0 as u32, height: 0 as u32, layer_count_or_depth: 0 as u32,
            num_levels: 0 as u32, sample_count: 0 as i32, props: 0 as u32
        }
        tex_info.typ = sdl.SDL_GPU_TEXTURETYPE_2D
        tex_info.format = sdl.SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM
        tex_info.usage = sdl.SDL_GPU_TEXTUREUSAGE_SAMPLER
        tex_info.width = w as u32
        tex_info.height = h as u32
        tex_info.layer_count_or_depth = 1 as u32
        tex_info.num_levels = 1 as u32
        tex_info.sample_count = sdl.SDL_GPU_SAMPLECOUNT_1
        val texture: ref void = sdl.SDL_CreateGPUTexture(runtime.device, @addr(tex_info))
        if texture == none {
            sdl.stbi_image_free(pixels)
            return none as ref void
        }
        val byte_size: u32 = (w as u32) * (h as u32) * (4 as u32)
        val tbuf_info: mut sdl.SDLGPUTransferBufferCreateInfo = {
            usage: 0 as i32, size: 0 as u32, props: 0 as u32
        }
        tbuf_info.usage = sdl.SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD
        tbuf_info.size = byte_size
        val tbuf: ref void = sdl.SDL_CreateGPUTransferBuffer(runtime.device, @addr(tbuf_info))
        if tbuf == none {
            sdl.SDL_ReleaseGPUTexture(runtime.device, texture)
            sdl.stbi_image_free(pixels)
            return none as ref void
        }
        val mapped: ref void = sdl.SDL_MapGPUTransferBuffer(runtime.device, tbuf, false)
        if mapped == none {
            sdl.SDL_ReleaseGPUTransferBuffer(runtime.device, tbuf)
            sdl.SDL_ReleaseGPUTexture(runtime.device, texture)
            sdl.stbi_image_free(pixels)
            return none as ref void
        }
        @memcpy(mapped, pixels, byte_size as usize)
        sdl.SDL_UnmapGPUTransferBuffer(runtime.device, tbuf)
        sdl.stbi_image_free(pixels)
        val cmd: ref void = sdl.SDL_AcquireGPUCommandBuffer(runtime.device)
        if cmd == none {
            sdl.SDL_ReleaseGPUTransferBuffer(runtime.device, tbuf)
            sdl.SDL_ReleaseGPUTexture(runtime.device, texture)
            return none as ref void
        }
        val copy_pass: ref void = sdl.SDL_BeginGPUCopyPass(cmd)
        val src: mut sdl.SDLGPUTextureTransferInfo = {
            transfer_buffer: tbuf, offset: 0 as u32,
            pixels_per_row: w as u32, rows_per_layer: h as u32
        }
        val dst: mut sdl.SDLGPUTextureRegion = {
            texture: texture, mip_level: 0 as u32, layer: 0 as u32,
            x: 0 as u32, y: 0 as u32, z: 0 as u32,
            w: w as u32, h: h as u32, d: 1 as u32
        }
        sdl.SDL_UploadToGPUTexture(copy_pass, @addr(src), @addr(dst), false)
        sdl.SDL_EndGPUCopyPass(copy_pass)
        sdl.SDL_SubmitGPUCommandBuffer(cmd)
        sdl.SDL_ReleaseGPUTransferBuffer(runtime.device, tbuf)
        return texture
    }
    return none as ref void
}

pub fn create_pipelines(
    runtime: mut ref Renderer,
    shader_cfg: shaders.ExoShaderConfig
) bool = trust {
    runtime.scene_pipeline = create_scene_pipeline(
        runtime,
        shader_cfg.scene.vertex_path,
        shader_cfg.scene.fragment_path,
        runtime.swapchain_format
    )
    if runtime.scene_pipeline == none {
        return false
    }
    runtime.ui_pipeline = create_ui_pipeline(
        runtime,
        shader_cfg.scene.vertex_path,
        shader_cfg.scene.fragment_path,
        runtime.swapchain_format
    )
    if runtime.ui_pipeline == none {
        return false
    }
    runtime.floor_pipeline = create_pipeline(
        runtime,
        shader_cfg.floor.vertex_path,
        shader_cfg.floor.fragment_path,
        runtime.swapchain_format,
        true,
        sdl.SDL_GPU_BLENDFACTOR_SRC_ALPHA,
        sdl.SDL_GPU_BLENDFACTOR_ONE_MINUS_SRC_ALPHA,
        sdl.SDL_GPU_BLENDFACTOR_ONE,
        sdl.SDL_GPU_BLENDFACTOR_ONE_MINUS_SRC_ALPHA,
        false,
        1 as u32
    )
    if runtime.floor_pipeline == none {
        return false
    }
    runtime.glow_pipeline = create_pipeline(
        runtime,
        shader_cfg.glow.vertex_path,
        shader_cfg.glow.fragment_path,
        runtime.swapchain_format,
        true,
        sdl.SDL_GPU_BLENDFACTOR_SRC_ALPHA,
        sdl.SDL_GPU_BLENDFACTOR_ONE,
        sdl.SDL_GPU_BLENDFACTOR_ONE,
        sdl.SDL_GPU_BLENDFACTOR_ONE,
        false,
        0 as u32
    )
    if runtime.glow_pipeline == none {
        return false
    }
    runtime.bloom_threshold_pipeline = create_postprocess_pipeline(
        runtime,
        shader_cfg.post_process.threshold.vertex_path,
        shader_cfg.post_process.threshold.fragment_path,
        runtime.swapchain_format,
        1 as u32,
        1 as u32
    )
    if runtime.bloom_threshold_pipeline == none {
        return false
    }
    runtime.bloom_blur_pipeline = create_postprocess_pipeline(
        runtime,
        shader_cfg.post_process.blur.vertex_path,
        shader_cfg.post_process.blur.fragment_path,
        runtime.swapchain_format,
        1 as u32,
        1 as u32
    )
    if runtime.bloom_blur_pipeline == none {
        return false
    }
    runtime.godray_pipeline = create_postprocess_pipeline(
        runtime,
        shader_cfg.post_process.godrays.vertex_path,
        shader_cfg.post_process.godrays.fragment_path,
        runtime.swapchain_format,
        1 as u32,
        1 as u32
    )
    if runtime.godray_pipeline == none {
        return false
    }
    runtime.post_pipeline = create_postprocess_pipeline(
        runtime,
        shader_cfg.post_process.composite.vertex_path,
        shader_cfg.post_process.composite.fragment_path,
        runtime.swapchain_format,
        3 as u32,
        1 as u32
    )
    if runtime.post_pipeline == none {
        return false
    }
    runtime.water_pipeline = create_pipeline(
        runtime,
        shader_cfg.water.vertex_path,
        shader_cfg.water.fragment_path,
        runtime.swapchain_format,
        true,
        sdl.SDL_GPU_BLENDFACTOR_SRC_ALPHA,
        sdl.SDL_GPU_BLENDFACTOR_ONE_MINUS_SRC_ALPHA,
        sdl.SDL_GPU_BLENDFACTOR_ONE,
        sdl.SDL_GPU_BLENDFACTOR_ONE_MINUS_SRC_ALPHA,
        false,
        2 as u32
    )
    return runtime.water_pipeline != none
}

pub fn destroy_pipelines(runtime: mut ref Renderer) void = trust {
    if runtime.post_pipeline != none {
        sdl.SDL_ReleaseGPUGraphicsPipeline(runtime.device, runtime.post_pipeline)
        runtime.post_pipeline = none
    }
    if runtime.bloom_blur_pipeline != none {
        sdl.SDL_ReleaseGPUGraphicsPipeline(runtime.device, runtime.bloom_blur_pipeline)
        runtime.bloom_blur_pipeline = none
    }
    if runtime.godray_pipeline != none {
        sdl.SDL_ReleaseGPUGraphicsPipeline(runtime.device, runtime.godray_pipeline)
        runtime.godray_pipeline = none
    }
    if runtime.bloom_threshold_pipeline != none {
        sdl.SDL_ReleaseGPUGraphicsPipeline(runtime.device, runtime.bloom_threshold_pipeline)
        runtime.bloom_threshold_pipeline = none
    }
    if runtime.water_pipeline != none {
        sdl.SDL_ReleaseGPUGraphicsPipeline(runtime.device, runtime.water_pipeline)
        runtime.water_pipeline = none
    }
    if runtime.glow_pipeline != none {
        sdl.SDL_ReleaseGPUGraphicsPipeline(runtime.device, runtime.glow_pipeline)
        runtime.glow_pipeline = none
    }
    if runtime.floor_pipeline != none {
        sdl.SDL_ReleaseGPUGraphicsPipeline(runtime.device, runtime.floor_pipeline)
        runtime.floor_pipeline = none
    }
    if runtime.ui_pipeline != none {
        sdl.SDL_ReleaseGPUGraphicsPipeline(runtime.device, runtime.ui_pipeline)
        runtime.ui_pipeline = none
    }
    if runtime.scene_pipeline != none {
        sdl.SDL_ReleaseGPUGraphicsPipeline(runtime.device, runtime.scene_pipeline)
        runtime.scene_pipeline = none
    }
}

pub fn begin_pass(
    runtime: mut ref Renderer,
    color_target: ref void,
    depth_target: ref void,
    r: f32,
    g: f32,
    b: f32,
    a: f32
) bool = trust {
    exoerr.clear()
    if !runtime.frame_active || runtime.command_buffer == none {
        return exoerr.set("no active frame")
    }
    if runtime.current_pass != none {
        sdl.SDL_EndGPURenderPass(runtime.current_pass)
        runtime.current_pass = none
    }
    val color_info: mut sdl.SDLGPUColorTargetInfo = {
        texture: none as ref void,
        mip_level: 0 as u32,
        layer_or_depth_plane: 0 as u32,
        clear_color: { r: 0.0 as f32, g: 0.0 as f32, b: 0.0 as f32, a: 0.0 as f32 },
        load_op: 0 as i32,
        store_op: 0 as i32,
        resolve_texture: none as ref void,
        resolve_mip_level: 0 as u32,
        resolve_layer: 0 as u32,
        cycle: false,
        cycle_resolve_texture: false,
        padding1: 0 as u8,
        padding2: 0 as u8
    }
    color_info.texture = color_target
    color_info.clear_color.r = r
    color_info.clear_color.g = g
    color_info.clear_color.b = b
    color_info.clear_color.a = a
    color_info.load_op = sdl.SDL_GPU_LOADOP_CLEAR
    color_info.store_op = sdl.SDL_GPU_STOREOP_STORE
    val depth_info: mut sdl.SDLGPUDepthStencilTargetInfo = {
        texture: none as ref void,
        clear_depth: 0.0 as f32,
        load_op: 0 as i32,
        store_op: 0 as i32,
        stencil_load_op: 0 as i32,
        stencil_store_op: 0 as i32,
        cycle: false,
        clear_stencil: 0 as u8,
        mip_level: 0 as u8,
        layer: 0 as u8
    }
    depth_info.texture = depth_target
    depth_info.clear_depth = 1.0 as f32
    depth_info.load_op = sdl.SDL_GPU_LOADOP_CLEAR
    depth_info.store_op = sdl.SDL_GPU_STOREOP_DONT_CARE
    depth_info.stencil_load_op = sdl.SDL_GPU_LOADOP_DONT_CARE
    depth_info.stencil_store_op = sdl.SDL_GPU_STOREOP_DONT_CARE
    runtime.current_pass = sdl.SDL_BeginGPURenderPass(
        runtime.command_buffer,
        @addr(color_info),
        1 as u32,
        @addr(depth_info)
    )
    if runtime.current_pass == none {
        return false
    }
    val viewport: mut sdl.SDLGPUViewport = {
        x: 0.0 as f32,
        y: 0.0 as f32,
        w: 0.0 as f32,
        h: 0.0 as f32,
        min_depth: 0.0 as f32,
        max_depth: 0.0 as f32
    }
    viewport.x = 0.0 as f32
    viewport.y = 0.0 as f32
    viewport.w = runtime.render_width as f32
    viewport.h = runtime.render_height as f32
    viewport.min_depth = 0.0 as f32
    viewport.max_depth = 1.0 as f32
    sdl.SDL_SetGPUViewport(runtime.current_pass, @addr(viewport))
    return true
}

pub fn begin_pass_no_depth_sized(
    runtime: mut ref Renderer,
    color_target: ref void,
    width: u32,
    height: u32
) bool = trust {
    exoerr.clear()
    if !runtime.frame_active || runtime.command_buffer == none {
        return exoerr.set("no active frame")
    }
    if runtime.current_pass != none {
        sdl.SDL_EndGPURenderPass(runtime.current_pass)
        runtime.current_pass = none
    }
    val color_info: mut sdl.SDLGPUColorTargetInfo = {
        texture: none as ref void,
        mip_level: 0 as u32,
        layer_or_depth_plane: 0 as u32,
        clear_color: { r: 0.0 as f32, g: 0.0 as f32, b: 0.0 as f32, a: 0.0 as f32 },
        load_op: 0 as i32,
        store_op: 0 as i32,
        resolve_texture: none as ref void,
        resolve_mip_level: 0 as u32,
        resolve_layer: 0 as u32,
        cycle: false,
        cycle_resolve_texture: false,
        padding1: 0 as u8,
        padding2: 0 as u8
    }
    color_info.texture = color_target
    color_info.load_op = sdl.SDL_GPU_LOADOP_DONT_CARE
    color_info.store_op = sdl.SDL_GPU_STOREOP_STORE
    runtime.current_pass = sdl.SDL_BeginGPURenderPass(
        runtime.command_buffer,
        @addr(color_info),
        1 as u32,
        none as ref sdl.SDLGPUDepthStencilTargetInfo
    )
    if runtime.current_pass == none {
        return false
    }
    val viewport: mut sdl.SDLGPUViewport = {
        x: 0.0 as f32,
        y: 0.0 as f32,
        w: 0.0 as f32,
        h: 0.0 as f32,
        min_depth: 0.0 as f32,
        max_depth: 0.0 as f32
    }
    viewport.x = 0.0 as f32
    viewport.y = 0.0 as f32
    viewport.w = width as f32
    viewport.h = height as f32
    viewport.min_depth = 0.0 as f32
    viewport.max_depth = 1.0 as f32
    sdl.SDL_SetGPUViewport(runtime.current_pass, @addr(viewport))
    return true
}

pub fn begin_pass_no_depth(runtime: mut ref Renderer, color_target: ref void) bool = trust {
    return begin_pass_no_depth_sized(
        runtime,
        color_target,
        runtime.render_width,
        runtime.render_height
    )
}

pub fn bind_mesh(runtime: ref Renderer, mesh: ref GpuMesh) void = trust {
    val vertex_binding: mut sdl.SDLGPUBufferBinding = {
        buffer: none as ref void,
        offset: 0 as u32
    }
    val index_binding: mut sdl.SDLGPUBufferBinding = {
        buffer: none as ref void,
        offset: 0 as u32
    }
    vertex_binding.buffer = mesh.vertex_buffer
    index_binding.buffer = mesh.index_buffer
    sdl.SDL_BindGPUVertexBuffers(runtime.current_pass, 0 as u32, @addr(vertex_binding), 1 as u32)
    sdl.SDL_BindGPUIndexBuffer(
        runtime.current_pass,
        @addr(index_binding),
        sdl.SDL_GPU_INDEXELEMENTSIZE_32BIT
    )
}

pub fn clear_glb_texture(runtime: mut ref Renderer) void = trust {
    if runtime.glb_texture != none {
        sdl.SDL_ReleaseGPUTexture(runtime.device, runtime.glb_texture)
        runtime.glb_texture = none
    }
}

pub fn destroy_runtime_resources(runtime: mut ref Renderer) void = trust {
    release_render_targets(runtime)
    if runtime.glb_texture != none {
        sdl.SDL_ReleaseGPUTexture(runtime.device, runtime.glb_texture)
        runtime.glb_texture = none
    }
    if runtime.font_texture != none {
        sdl.SDL_ReleaseGPUTexture(runtime.device, runtime.font_texture)
        runtime.font_texture = none
    }
    for atlas in runtime.font_atlases {
        if atlas.texture != none {
            sdl.SDL_ReleaseGPUTexture(runtime.device, atlas.texture)
        }
        font.destroy_atlas(atlas.cpu)
    }
    if runtime.font_data != none {
        @free(runtime.font_data as ref void)
        runtime.font_data = none
    }
    runtime.font_is_ttf = false
    runtime.font_len = 0 as usize
    if runtime.normal_map_texture != none {
        sdl.SDL_ReleaseGPUTexture(runtime.device, runtime.normal_map_texture)
        runtime.normal_map_texture = none
    }
    if runtime.repeat_sampler != none {
        sdl.SDL_ReleaseGPUSampler(runtime.device, runtime.repeat_sampler)
        runtime.repeat_sampler = none
    }
    if runtime.linear_sampler != none {
        sdl.SDL_ReleaseGPUSampler(runtime.device, runtime.linear_sampler)
        runtime.linear_sampler = none
    }
    destroy_pipelines(runtime)
}

/// Upload an image blob (PNG/JPEG bytes) as a GPU texture.
pub fn create_texture_from_memory(
    runtime: mut ref Renderer,
    img_ptr: ref u8,
    img_len: usize
) ref void = trust {
    if img_len == (0 as usize) || img_ptr == none {
        return none as ref void
    }
    val w: mut i32 = 0 as i32
    val h: mut i32 = 0 as i32
    val ch: mut i32 = 0 as i32
    val pixels: ref u8 = sdl.stbi_load_from_memory(
        img_ptr,
        img_len as i32,
        @addr(w),
        @addr(h),
        @addr(ch),
        4 as i32
    )
    if pixels == none {
        return none as ref void
    }
    val tex_info: mut sdl.SDLGPUTextureCreateInfo = {
        typ: 0 as i32, format: 0 as i32, usage: 0 as u32,
        width: 0 as u32, height: 0 as u32, layer_count_or_depth: 0 as u32,
        num_levels: 0 as u32, sample_count: 0 as i32, props: 0 as u32
    }
    tex_info.typ = sdl.SDL_GPU_TEXTURETYPE_2D
    tex_info.format = sdl.SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM
    tex_info.usage = sdl.SDL_GPU_TEXTUREUSAGE_SAMPLER
    tex_info.width = w as u32
    tex_info.height = h as u32
    tex_info.layer_count_or_depth = 1 as u32
    tex_info.num_levels = 1 as u32
    tex_info.sample_count = sdl.SDL_GPU_SAMPLECOUNT_1
    val texture: ref void = sdl.SDL_CreateGPUTexture(runtime.device, @addr(tex_info))
    if texture == none {
        sdl.stbi_image_free(pixels)
        return none as ref void
    }
    val byte_size: u32 = (w as u32) * (h as u32) * (4 as u32)
    val tbuf_info: mut sdl.SDLGPUTransferBufferCreateInfo = {
        usage: 0 as i32,
        size: 0 as u32,
        props: 0 as u32
    }
    tbuf_info.usage = sdl.SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD
    tbuf_info.size = byte_size
    val tbuf: ref void = sdl.SDL_CreateGPUTransferBuffer(runtime.device, @addr(tbuf_info))
    if tbuf == none {
        sdl.SDL_ReleaseGPUTexture(runtime.device, texture)
        sdl.stbi_image_free(pixels)
        return none as ref void
    }
    val mapped: ref void = sdl.SDL_MapGPUTransferBuffer(runtime.device, tbuf, false)
    if mapped == none {
        sdl.SDL_ReleaseGPUTransferBuffer(runtime.device, tbuf)
        sdl.SDL_ReleaseGPUTexture(runtime.device, texture)
        sdl.stbi_image_free(pixels)
        return none as ref void
    }
    @memcpy(mapped, pixels, byte_size as usize)
    sdl.SDL_UnmapGPUTransferBuffer(runtime.device, tbuf)
    sdl.stbi_image_free(pixels)
    val cmd: ref void = sdl.SDL_AcquireGPUCommandBuffer(runtime.device)
    if cmd == none {
        sdl.SDL_ReleaseGPUTransferBuffer(runtime.device, tbuf)
        sdl.SDL_ReleaseGPUTexture(runtime.device, texture)
        return none as ref void
    }
    val copy_pass: ref void = sdl.SDL_BeginGPUCopyPass(cmd)
    val src: mut sdl.SDLGPUTextureTransferInfo = {
        transfer_buffer: tbuf, offset: 0 as u32,
        pixels_per_row: w as u32, rows_per_layer: h as u32
    }
    val dst: mut sdl.SDLGPUTextureRegion = {
        texture: texture, mip_level: 0 as u32, layer: 0 as u32,
        x: 0 as u32, y: 0 as u32, z: 0 as u32,
        w: w as u32, h: h as u32, d: 1 as u32
    }
    sdl.SDL_UploadToGPUTexture(copy_pass, @addr(src), @addr(dst), false)
    sdl.SDL_EndGPUCopyPass(copy_pass)
    sdl.SDL_SubmitGPUCommandBuffer(cmd)
    sdl.SDL_ReleaseGPUTransferBuffer(runtime.device, tbuf)
    return texture
}

/// Upload an embedded GLB image (PNG/JPEG bytes in the BIN chunk) as a GPU texture.
pub fn create_glb_texture(runtime: mut ref Renderer, model: ecs.GlbModel) ref void = trust {
    if model.texture_length == (0 as usize) || model.raw_bytes == none {
        return none as ref void
    }
    return create_texture_from_memory(
        runtime,
        @ptradd(model.raw_bytes, model.texture_offset) as ref u8,
        model.texture_length
    )
}

fn font_pixel_size(scale: f32) i32 = {
    val size: f32 = scale * (8.0 as f32)
    if size < (5.0 as f32) {
        return 5 as i32
    }
    if size > (160.0 as f32) {
        return 160 as i32
    }
    return (size + (0.5 as f32)) as i32
}

fn find_font_atlas(runtime: ref Renderer, pixel_size: i32) i32 = {
    val i: mut usize = 0 as usize
    for i < @len(runtime.font_atlases) {
        if @get(runtime.font_atlases, i) is some atlas {
            if atlas.pixel_size == pixel_size {
                return i as i32
            }
        }
        i = i + (1 as usize)
    }
    return -1 as i32
}

fn create_font_atlas(runtime: mut ref Renderer, pixel_size: i32) bool = trust {
    if !runtime.font_is_ttf || runtime.font_data == none {
        return false
    }
    if font.create_atlas(
        runtime.font_data,
        runtime.font_len,
        pixel_size as f32,
        32 as i32,
        95 as i32
    ) is some atlas {
        val cpu: mut font.Atlas = atlas
        val texture: ref void = create_rgba_texture(
            runtime,
            cpu.pixels,
            cpu.width,
            cpu.height
        )
        if texture == none {
            font.destroy_atlas(cpu)
            return false
        }
        @free(cpu.pixels as ref void)
        cpu.pixels = none as ref u8
        @append(runtime.font_atlases, {
            cpu: cpu,
            texture: texture,
            pixel_size: pixel_size
        })
        return true
    }
    return false
}

/// Create any TTF atlases the current UI needs. This must run before the
/// frame's render passes begin because it uploads GPU textures.
pub fn prepare_fonts(runtime_raw: ref void, scene: ecs.Scene3D) void = trust {
    if runtime_raw == none {
        return
    }
    val runtime: mut ref Renderer = runtime_raw as mut ref Renderer
    if !runtime.font_is_ttf {
        return
    }
    for text in scene.ui.texts {
        val pixel_size: i32 = font_pixel_size(text.scale)
        if find_font_atlas(runtime, pixel_size) < (0 as i32) {
            create_font_atlas(runtime, pixel_size)
        }
    }
}

pub fn upload_glb_texture(runtime: mut ref Renderer, model: ecs.GlbModel) void = trust {
    if runtime.glb_texture != none {
        sdl.SDL_ReleaseGPUTexture(runtime.device, runtime.glb_texture)
        runtime.glb_texture = none
    }
    runtime.glb_texture = create_glb_texture(runtime, model)
}

fn lower_byte(value: u8) u8 = {
    if value >= (65 as u8) && value <= (90 as u8) {
        return value + (32 as u8)
    }
    return value
}

fn path_has_extension(path: ref u8, extension: ref u8) bool = trust {
    val path_len: usize = string.len_raw(path)
    val ext_len: usize = string.len_raw(extension)
    if path_len < ext_len {
        return false
    }
    val base: ref u8 = @ptradd(path, path_len - ext_len) as ref u8
    val i: mut usize = 0 as usize
    for i < ext_len {
        if lower_byte(@load8(@ptradd(base, i))) != lower_byte(@load8(@ptradd(extension, i))) {
            return false
        }
        i = i + (1 as usize)
    }
    return true
}

fn create_gpu_device(debug: bool) ref void = trust {
    val props: u32 = sdl.SDL_CreateProperties()
    if props == (0 as u32) {
        return exoerr.set_ptr("SDL_CreateProperties failed")
    }
    val formats: u32 = shaders.exo_shader_format()
    sdl.SDL_SetBooleanProperty(
        props,
        sdl.PROP_GPU_CREATE_SHADERS_SPIRV,
        (formats & sdl.SDL_GPU_SHADERFORMAT_SPIRV) != (0 as u32)
    )
    sdl.SDL_SetBooleanProperty(
        props,
        sdl.PROP_GPU_CREATE_SHADERS_MSL,
        (formats & sdl.SDL_GPU_SHADERFORMAT_MSL) != (0 as u32)
    )
    sdl.SDL_SetBooleanProperty(props, sdl.PROP_GPU_CREATE_DEBUGMODE, debug)
    when darwin {
        sdl.SDL_SetBooleanProperty(props, sdl.PROP_GPU_CREATE_METAL_ALLOW_MACFAMILY1, true)
    }
    val dev: ref void = sdl.SDL_CreateGPUDeviceWithProperties(props)
    sdl.SDL_DestroyProperties(props)
    if dev == none as ref void {
        return exoerr.set_ptr(sdl.SDL_GetError())
    }
    return dev
}

pub fn create(
    title: ref u8,
    width: i32,
    height: i32,
    shader_cfg: shaders.ExoShaderConfig,
    font_path: ref u8
) ref void = trust {
    exoerr.clear()
    if !sdl.SDL_Init(sdl.SDL_INIT_VIDEO | sdl.SDL_INIT_AUDIO | sdl.SDL_INIT_GAMEPAD | sdl.SDL_INIT_EVENTS) {
        return none as ref void
    }
    val runtime: mut ref Renderer = @alloc(@sizeof(Renderer)) as mut ref Renderer
    if runtime == none {
        sdl.SDL_Quit()
        return exoerr.set_ptr("failed to allocate runtime")
    }
    @memset(runtime, 0, @sizeof(Renderer))
    runtime.sky_top = math.vec3(0.26 as f32, 0.48 as f32, 0.84 as f32)
    runtime.sky_horizon = math.vec3(0.05 as f32, 0.08 as f32, 0.14 as f32)
    runtime.ambient = 0.30 as f32
    runtime.lights = mem.persistent[ecs.PointLight]()
    runtime.font_atlases = mem.persistent[FontAtlasGPU]()
    runtime.window = sdl.SDL_CreateWindow(title, width, height, 0 as u64)
    if runtime.window == none {
        destroy(runtime)
        return none as ref void
    }
    runtime.device = create_gpu_device(true)
    if runtime.device == none {
        destroy(runtime)
        return none as ref void
    }
    if !sdl.SDL_ClaimWindowForGPUDevice(runtime.device, runtime.window) {
        destroy(runtime)
        return none as ref void
    }
    runtime.swapchain_format = sdl.SDL_GetGPUSwapchainTextureFormat(runtime.device, runtime.window)
    if !create_pipelines(runtime, shader_cfg) {
        destroy(runtime)
        return none as ref void
    }
    val sampler_info: mut sdl.SDLGPUSamplerCreateInfo = {
        min_filter: 0 as i32,
        mag_filter: 0 as i32,
        mipmap_mode: 0 as i32,
        address_mode_u: 0 as i32,
        address_mode_v: 0 as i32,
        address_mode_w: 0 as i32,
        mip_lod_bias: 0.0 as f32,
        max_anisotropy: 0.0 as f32,
        compare_op: 0 as i32,
        min_lod: 0.0 as f32,
        max_lod: 0.0 as f32,
        enable_anisotropy: false,
        enable_compare: false,
        padding1: 0 as u8,
        padding2: 0 as u8,
        props: 0 as u32
    }
    sampler_info.min_filter = sdl.SDL_GPU_FILTER_LINEAR
    sampler_info.mag_filter = sdl.SDL_GPU_FILTER_LINEAR
    sampler_info.mipmap_mode = sdl.SDL_GPU_SAMPLERMIPMAPMODE_LINEAR
    sampler_info.address_mode_u = sdl.SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE
    sampler_info.address_mode_v = sdl.SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE
    sampler_info.address_mode_w = sdl.SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE
    sampler_info.max_lod = 1.0 as f32
    runtime.linear_sampler = sdl.SDL_CreateGPUSampler(runtime.device, @addr(sampler_info))
    if runtime.linear_sampler == none {
        destroy(runtime)
        return none as ref void
    }
    val repeat_info: mut sdl.SDLGPUSamplerCreateInfo = {
        min_filter: 0 as i32, mag_filter: 0 as i32, mipmap_mode: 0 as i32,
        address_mode_u: 0 as i32, address_mode_v: 0 as i32, address_mode_w: 0 as i32,
        mip_lod_bias: 0.0 as f32, max_anisotropy: 0.0 as f32, compare_op: 0 as i32,
        min_lod: 0.0 as f32, max_lod: 0.0 as f32,
        enable_anisotropy: false, enable_compare: false,
        padding1: 0 as u8, padding2: 0 as u8, props: 0 as u32
    }
    repeat_info.min_filter = sdl.SDL_GPU_FILTER_LINEAR
    repeat_info.mag_filter = sdl.SDL_GPU_FILTER_LINEAR
    repeat_info.mipmap_mode = sdl.SDL_GPU_SAMPLERMIPMAPMODE_LINEAR
    repeat_info.address_mode_u = sdl.SDL_GPU_SAMPLERADDRESSMODE_REPEAT
    repeat_info.address_mode_v = sdl.SDL_GPU_SAMPLERADDRESSMODE_REPEAT
    repeat_info.address_mode_w = sdl.SDL_GPU_SAMPLERADDRESSMODE_REPEAT
    repeat_info.max_lod = 1.0 as f32
    runtime.repeat_sampler = sdl.SDL_CreateGPUSampler(runtime.device, @addr(repeat_info))
    if runtime.repeat_sampler == none {
        destroy(runtime)
        return none as ref void
    }
    if !recreate_render_targets(runtime, width as u32, height as u32) {
        destroy(runtime)
        return none as ref void
    }
    runtime.normal_map_texture = load_png_texture(runtime, "./assets/normal_map.png")
    if font_path != none && string.len_raw(font_path) > (0 as usize) {
        if !path_has_extension(font_path, ".png") {
            if io.load_binary_file(font_path) is some blob {
                if font.valid(blob.data, blob.len) {
                    runtime.font_data = blob.data
                    runtime.font_len = blob.len
                    runtime.font_is_ttf = true
                } else {
                    @free(blob.data as ref void)
                }
            }
        }
        if !runtime.font_is_ttf {
            runtime.font_texture = load_png_texture(runtime, font_path)
        }
    }
    return runtime
}

pub fn destroy(runtime_raw: ref void) void = trust {
    if runtime_raw == none {
        sdl.SDL_Quit()
        return
    }
    val runtime: mut ref Renderer = runtime_raw as mut ref Renderer
    destroy_runtime_resources(runtime)
    if runtime.device != none && runtime.window != none {
        sdl.SDL_ReleaseWindowFromGPUDevice(runtime.device, runtime.window)
    }
    if runtime.device != none {
        sdl.SDL_DestroyGPUDevice(runtime.device)
    }
    if runtime.window != none {
        sdl.SDL_DestroyWindow(runtime.window)
    }
    @free(runtime_raw)
    sdl.SDL_Quit()
}

pub fn poll_quit() bool = {
    val evt: mut sdl.SDLEvent = {
        typ: 0 as u32, p01: 0 as u32, p02: 0 as u32, p03: 0 as u32, p04: 0 as u32, p05: 0 as u32, p06: 0 as u32, p07: 0 as u32,
        p08: 0 as u32, p09: 0 as u32, p10: 0 as u32, p11: 0 as u32, p12: 0 as u32, p13: 0 as u32, p14: 0 as u32, p15: 0 as u32,
        p16: 0 as u32, p17: 0 as u32, p18: 0 as u32, p19: 0 as u32, p20: 0 as u32, p21: 0 as u32, p22: 0 as u32, p23: 0 as u32,
        p24: 0 as u32, p25: 0 as u32, p26: 0 as u32, p27: 0 as u32, p28: 0 as u32, p29: 0 as u32, p30: 0 as u32, p31: 0 as u32
    }
    val quit: mut bool = false
    for {
        if !(trust sdl.SDL_PollEvent(@addr(evt))) {
            break
        }
        if evt.typ == sdl.SDL_EVENT_QUIT || evt.typ == sdl.SDL_EVENT_WINDOW_CLOSE_REQUESTED {
            quit = true
        }
    }
    return quit
}

pub fn get_ticks() u64 = {
    return trust sdl.SDL_GetTicks()
}

pub fn keyboard_state() ref u8 = trust {
    return sdl.SDL_GetKeyboardState(none as ref i32) as ref u8
}

pub fn set_relative_mouse_mode(runtime_raw: ref void, enabled: bool) bool = trust {
    exoerr.clear()
    if runtime_raw == none {
        return exoerr.set("runtime unavailable")
    }
    val runtime: ref Renderer = runtime_raw as ref Renderer
    if runtime.window == none {
        return exoerr.set("runtime window unavailable")
    }
    return sdl.SDL_SetWindowRelativeMouseMode(runtime.window, enabled)
}

pub fn relative_mouse_state(x: ref f32, y: ref f32) void = {
    trust sdl.SDL_GetRelativeMouseState(x, y)
}

pub fn create_mesh(
    runtime_raw: ref void,
    vertices: ref void,
    vertex_bytes: u32,
    indices: ref void,
    index_bytes: u32,
    index_count: u32
) ref void = trust {
    exoerr.clear()
    if runtime_raw == none {
        return exoerr.set_ptr("runtime unavailable")
    }
    val runtime: ref Renderer = runtime_raw as ref Renderer
    val mesh: mut ref GpuMesh = @alloc(@sizeof(GpuMesh)) as mut ref GpuMesh
    if mesh == none {
        return exoerr.set_ptr("failed to allocate mesh")
    }
    @memset(mesh, 0, @sizeof(GpuMesh))
    val vertex_info: mut sdl.SDLGPUBufferCreateInfo = {
        usage: 0 as u32,
        size: 0 as u32,
        props: 0 as u32
    }
    vertex_info.usage = sdl.SDL_GPU_BUFFERUSAGE_VERTEX
    vertex_info.size = vertex_bytes
    mesh.vertex_buffer = sdl.SDL_CreateGPUBuffer(runtime.device, @addr(vertex_info))
    if mesh.vertex_buffer == none {
        destroy_mesh_raw(runtime_raw, mesh)
        return none as ref void
    }
    val index_info: mut sdl.SDLGPUBufferCreateInfo = {
        usage: 0 as u32,
        size: 0 as u32,
        props: 0 as u32
    }
    index_info.usage = sdl.SDL_GPU_BUFFERUSAGE_INDEX
    index_info.size = index_bytes
    mesh.index_buffer = sdl.SDL_CreateGPUBuffer(runtime.device, @addr(index_info))
    if mesh.index_buffer == none {
        destroy_mesh_raw(runtime_raw, mesh)
        return none as ref void
    }
    val transfer_info: mut sdl.SDLGPUTransferBufferCreateInfo = {
        usage: 0 as i32,
        size: 0 as u32,
        props: 0 as u32
    }
    transfer_info.usage = sdl.SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD
    transfer_info.size = vertex_bytes + index_bytes
    val transfer: ref void = sdl.SDL_CreateGPUTransferBuffer(runtime.device, @addr(transfer_info))
    if transfer == none {
        destroy_mesh_raw(runtime_raw, mesh)
        return none as ref void
    }
    val mapped: ref void = sdl.SDL_MapGPUTransferBuffer(runtime.device, transfer, false)
    if mapped == none {
        sdl.SDL_ReleaseGPUTransferBuffer(runtime.device, transfer)
        destroy_mesh_raw(runtime_raw, mesh)
        return none as ref void
    }
    @memcpy(mapped, vertices, vertex_bytes as usize)
    @memcpy(@ptradd(mapped, vertex_bytes as usize), indices, index_bytes as usize)
    sdl.SDL_UnmapGPUTransferBuffer(runtime.device, transfer)
    val command_buffer: ref void = sdl.SDL_AcquireGPUCommandBuffer(runtime.device)
    if command_buffer == none {
        sdl.SDL_ReleaseGPUTransferBuffer(runtime.device, transfer)
        destroy_mesh_raw(runtime_raw, mesh)
        return none as ref void
    }
    val copy_pass: ref void = sdl.SDL_BeginGPUCopyPass(command_buffer)
    if copy_pass == none {
        sdl.SDL_CancelGPUCommandBuffer(command_buffer)
        sdl.SDL_ReleaseGPUTransferBuffer(runtime.device, transfer)
        destroy_mesh_raw(runtime_raw, mesh)
        return none as ref void
    }
    val src_vertex: mut sdl.SDLGPUTransferBufferLocation = {
        transfer_buffer: none as ref void,
        offset: 0 as u32
    }
    val dst_vertex: mut sdl.SDLGPUBufferRegion = {
        buffer: none as ref void,
        offset: 0 as u32,
        size: 0 as u32
    }
    val src_index: mut sdl.SDLGPUTransferBufferLocation = {
        transfer_buffer: none as ref void,
        offset: 0 as u32
    }
    val dst_index: mut sdl.SDLGPUBufferRegion = {
        buffer: none as ref void,
        offset: 0 as u32,
        size: 0 as u32
    }
    src_vertex.transfer_buffer = transfer
    dst_vertex.buffer = mesh.vertex_buffer
    dst_vertex.size = vertex_bytes
    src_index.transfer_buffer = transfer
    src_index.offset = vertex_bytes
    dst_index.buffer = mesh.index_buffer
    dst_index.size = index_bytes
    sdl.SDL_UploadToGPUBuffer(copy_pass, @addr(src_vertex), @addr(dst_vertex), false)
    sdl.SDL_UploadToGPUBuffer(copy_pass, @addr(src_index), @addr(dst_index), false)
    sdl.SDL_EndGPUCopyPass(copy_pass)
    if !sdl.SDL_SubmitGPUCommandBuffer(command_buffer) {
        sdl.SDL_ReleaseGPUTransferBuffer(runtime.device, transfer)
        destroy_mesh_raw(runtime_raw, mesh)
        return none as ref void
    }
    sdl.SDL_ReleaseGPUTransferBuffer(runtime.device, transfer)
    mesh.index_count = index_count
    mesh.vertex_bytes = vertex_bytes
    return mesh
}

pub fn destroy_mesh_raw(runtime_raw: ref void, mesh_raw: ref void) void = trust {
    if mesh_raw == none {
        return
    }
    val mesh: ref GpuMesh = mesh_raw as ref GpuMesh
    if runtime_raw != none {
        val runtime: ref Renderer = runtime_raw as ref Renderer
        if runtime.device != none {
            if mesh.index_buffer != none {
                sdl.SDL_ReleaseGPUBuffer(runtime.device, mesh.index_buffer)
            }
            if mesh.vertex_buffer != none {
                sdl.SDL_ReleaseGPUBuffer(runtime.device, mesh.vertex_buffer)
            }
        }
    }
    @free(mesh_raw)
}

pub fn begin_frame(runtime_raw: ref void, width: mut ref u32, height: mut ref u32) bool = trust {
    exoerr.clear()
    if runtime_raw == none {
        return exoerr.set("runtime unavailable")
    }
    val runtime: mut ref Renderer = runtime_raw as mut ref Renderer
    if runtime.frame_active {
        return exoerr.set("frame already active")
    }
    runtime.command_buffer = sdl.SDL_AcquireGPUCommandBuffer(runtime.device)
    if runtime.command_buffer == none {
        return false
    }
    val swap_width: mut u32 = 0 as u32
    val swap_height: mut u32 = 0 as u32
    if !(sdl.SDL_WaitAndAcquireGPUSwapchainTexture(
            runtime.command_buffer,
            runtime.window,
            @addr(runtime.swapchain_texture),
            @addr(swap_width),
            @addr(swap_height)
        )) {
        sdl.SDL_CancelGPUCommandBuffer(runtime.command_buffer)
        runtime.command_buffer = none
        return false
    }
    if runtime.swapchain_texture == none {
        sdl.SDL_CancelGPUCommandBuffer(runtime.command_buffer)
        runtime.command_buffer = none
        return exoerr.set("swapchain texture unavailable")
    }
    if swap_width != runtime.render_width || swap_height != runtime.render_height {
        if !recreate_render_targets(runtime, swap_width, swap_height) {
            sdl.SDL_CancelGPUCommandBuffer(runtime.command_buffer)
            runtime.command_buffer = none
            return false
        }
    }
    runtime.frame_active = true
    if width != none {
        @deref(width) = runtime.render_width
    }
    if height != none {
        @deref(height) = runtime.render_height
    }
    return true
}

pub fn begin_reflection_pass(runtime_raw: ref void, r: f32, g: f32, b: f32, a: f32) bool = trust {
    if runtime_raw == none {
        exoerr.clear()
        return exoerr.set("runtime unavailable")
    }
    val runtime: mut ref Renderer = runtime_raw as mut ref Renderer
    return begin_pass(runtime, runtime.reflection_color, runtime.reflection_depth, r, g, b, a)
}

pub fn begin_scene_pass(runtime_raw: ref void, r: f32, g: f32, b: f32, a: f32) bool = trust {
    if runtime_raw == none {
        exoerr.clear()
        return exoerr.set("runtime unavailable")
    }
    val runtime: mut ref Renderer = runtime_raw as mut ref Renderer
    return begin_pass(runtime, runtime.scene_color, runtime.scene_depth, r, g, b, a)
}

pub fn begin_swapchain_scene_pass(
    runtime_raw: ref void,
    r: f32,
    g: f32,
    b: f32,
    a: f32
) bool = trust {
    if runtime_raw == none {
        exoerr.clear()
        return exoerr.set("runtime unavailable")
    }
    val runtime: mut ref Renderer = runtime_raw as mut ref Renderer
    return begin_pass(runtime, runtime.swapchain_texture, runtime.scene_depth, r, g, b, a)
}

pub fn end_pass(runtime_raw: ref void) void = trust {
    if runtime_raw == none {
        return
    }
    val runtime: mut ref Renderer = runtime_raw as mut ref Renderer
    if runtime.current_pass != none {
        sdl.SDL_EndGPURenderPass(runtime.current_pass)
        runtime.current_pass = none
    }
}

fn bloom_blur_pass(
    runtime: mut ref Renderer,
    source: ref void,
    target: ref void,
    dir_x: f32,
    dir_y: f32,
    radius: f32,
    width: u32,
    height: u32
) bool = trust {
    if !begin_pass_no_depth_sized(runtime, target, width, height) {
        return false
    }
    sdl.SDL_BindGPUGraphicsPipeline(runtime.current_pass, runtime.bloom_blur_pipeline)
    val binding: mut sdl.SDLGPUTextureSamplerBinding = {
        texture: source,
        sampler: runtime.linear_sampler
    }
    sdl.SDL_BindGPUFragmentSamplers(runtime.current_pass, 0 as u32, @addr(binding), 1 as u32)
    val fu: mut BloomBlurUniforms = {
        texel_direction: {
            x: dir_x / (width as f32),
            y: dir_y / (height as f32),
            z: radius,
            w: 0.0 as f32
        }
    }
    sdl.SDL_PushGPUFragmentUniformData(
        runtime.command_buffer,
        0 as u32,
        @addr(fu) as ref void,
        @sizeof(BloomBlurUniforms) as u32
    )
    sdl.SDL_DrawGPUPrimitives(runtime.current_pass, 3 as u32, 1 as u32, 0 as u32, 0 as u32)
    end_pass(runtime)
    return true
}

/// Run the engine post-process stack and leave the swapchain pass open so UI
/// can be drawn on top. The engine owns the implementation; games only provide
/// generic PostProcessSettings. When godrays are enabled this convenience
/// wrapper assumes a light near the upper middle of the screen; use
/// `apply_post_process_with_light` to supply an exact projected light position.
pub fn apply_post_process(
    runtime_raw: ref void,
    settings: postprocess.PostProcessSettings,
    enabled: bool,
    time: f32
) bool = trust {
    return apply_post_process_with_light(
        runtime_raw,
        settings,
        enabled,
        time,
        0.5 as f32,
        0.42 as f32,
        settings.godrays.enabled
    )
}

/// Run the engine post-process stack with an explicit screen-space light
/// position. `light_screen_x`/`light_screen_y` are in UV space with the origin
/// at the top left. The godray pass is skipped when `light_visible` is false or
/// the light is behind the camera.
pub fn apply_post_process_with_light(
    runtime_raw: ref void,
    settings: postprocess.PostProcessSettings,
    enabled: bool,
    time: f32,
    light_screen_x: f32,
    light_screen_y: f32,
    light_visible: bool
) bool = trust {
    if runtime_raw == none {
        exoerr.clear()
        return exoerr.set("runtime unavailable")
    }
    val runtime: mut ref Renderer = runtime_raw as mut ref Renderer
    if runtime.post_pipeline == none || !runtime.frame_active || runtime.command_buffer == none {
        return exoerr.set("postprocess unavailable")
    }

    val active: bool = enabled && settings.enabled
    val bloom_active: bool = active && settings.bloom.enabled && runtime.bloom_threshold_pipeline != none && runtime.bloom_blur_pipeline != none && runtime.bloom_a != none && runtime.bloom_b != none && runtime.linear_sampler != none
    val godray_active: bool = active && settings.godrays.enabled && light_visible && runtime.godray_pipeline != none && runtime.godray != none && runtime.linear_sampler != none

    val bloom_width: u32 = half_extent(runtime.render_width)
    val bloom_height: u32 = half_extent(runtime.render_height)

    if bloom_active {
        if !begin_pass_no_depth_sized(runtime, runtime.bloom_a, bloom_width, bloom_height) {
            return false
        }
        sdl.SDL_BindGPUGraphicsPipeline(runtime.current_pass, runtime.bloom_threshold_pipeline)
        val scene_binding: mut sdl.SDLGPUTextureSamplerBinding = {
            texture: runtime.scene_color,
            sampler: runtime.linear_sampler
        }
        sdl.SDL_BindGPUFragmentSamplers(
            runtime.current_pass,
            0 as u32,
            @addr(scene_binding),
            1 as u32
        )
        val threshold_uniforms: mut BloomThresholdUniforms = {
            params: {
                x: settings.bloom.threshold,
                y: settings.bloom.knee,
                z: 0.0 as f32,
                w: 0.0 as f32
            }
        }
        sdl.SDL_PushGPUFragmentUniformData(
            runtime.command_buffer,
            0 as u32,
            @addr(threshold_uniforms) as ref void,
            @sizeof(BloomThresholdUniforms) as u32
        )
        sdl.SDL_DrawGPUPrimitives(runtime.current_pass, 3 as u32, 1 as u32, 0 as u32, 0 as u32)
        end_pass(runtime)

        val iterations_raw: i32 = settings.bloom.iterations
        val iterations: mut i32 = iterations_raw
        if iterations < (0 as i32) {
            iterations = 0 as i32
        }
        if iterations > (4 as i32) {
            iterations = 4 as i32
        }
        val iteration_index: mut i32 = 0 as i32
        for iteration_index < iterations {
            if !bloom_blur_pass(
                runtime,
                runtime.bloom_a,
                runtime.bloom_b,
                1.0 as f32,
                0.0 as f32,
                settings.bloom.radius,
                bloom_width,
                bloom_height
            ) {
                return false
            }
            if !bloom_blur_pass(
                runtime,
                runtime.bloom_b,
                runtime.bloom_a,
                0.0 as f32,
                1.0 as f32,
                settings.bloom.radius,
                bloom_width,
                bloom_height
            ) {
                return false
            }
            iteration_index = iteration_index + (1 as i32)
        }
    }

    if godray_active {
        if !begin_pass_no_depth_sized(runtime, runtime.godray, bloom_width, bloom_height) {
            return false
        }
        sdl.SDL_BindGPUGraphicsPipeline(runtime.current_pass, runtime.godray_pipeline)
        val scene_binding: mut sdl.SDLGPUTextureSamplerBinding = {
            texture: runtime.scene_color,
            sampler: runtime.linear_sampler
        }
        sdl.SDL_BindGPUFragmentSamplers(
            runtime.current_pass,
            0 as u32,
            @addr(scene_binding),
            1 as u32
        )
        val samples_raw: i32 = settings.godrays.samples
        val samples: mut i32 = samples_raw
        if samples < (1 as i32) {
            samples = 1 as i32
        }
        if samples > (64 as i32) {
            samples = 64 as i32
        }
        val godray_uniforms: mut GodrayUniforms = {
            light: {
                x: light_screen_x,
                y: light_screen_y,
                z: settings.godrays.intensity,
                w: settings.godrays.threshold
            },
            params: {
                x: settings.godrays.decay,
                y: settings.godrays.density,
                z: settings.godrays.weight,
                w: samples as f32
            },
            color: {
                x: settings.godrays.color.x,
                y: settings.godrays.color.y,
                z: settings.godrays.color.z,
                w: 0.0 as f32
            }
        }
        sdl.SDL_PushGPUFragmentUniformData(
            runtime.command_buffer,
            0 as u32,
            @addr(godray_uniforms) as ref void,
            @sizeof(GodrayUniforms) as u32
        )
        sdl.SDL_DrawGPUPrimitives(runtime.current_pass, 3 as u32, 1 as u32, 0 as u32, 0 as u32)
        end_pass(runtime)
    }

    if !begin_pass_no_depth_sized(
        runtime,
        runtime.swapchain_texture,
        runtime.render_width,
        runtime.render_height
    ) {
        return false
    }
    sdl.SDL_BindGPUGraphicsPipeline(runtime.current_pass, runtime.post_pipeline)

    val bloom_texture: mut ref void = runtime.scene_color
    if bloom_active {
        bloom_texture = runtime.bloom_a
    }
    val godray_texture: mut ref void = runtime.scene_color
    if godray_active {
        godray_texture = runtime.godray
    }
    val bindings_raw: ref void = @alloc(3 as usize * @sizeof(sdl.SDLGPUTextureSamplerBinding) as usize)
    val b0: mut ref sdl.SDLGPUTextureSamplerBinding = bindings_raw as mut ref sdl.SDLGPUTextureSamplerBinding
    val b1: mut ref sdl.SDLGPUTextureSamplerBinding = @ptradd(
        bindings_raw,
        @sizeof(sdl.SDLGPUTextureSamplerBinding) as usize
    ) as mut ref sdl.SDLGPUTextureSamplerBinding
    val b2: mut ref sdl.SDLGPUTextureSamplerBinding = @ptradd(
        bindings_raw,
        (2 as usize) * (@sizeof(sdl.SDLGPUTextureSamplerBinding) as usize)
    ) as mut ref sdl.SDLGPUTextureSamplerBinding
    b0.texture = runtime.scene_color
    b0.sampler = runtime.linear_sampler
    b1.texture = bloom_texture
    b1.sampler = runtime.linear_sampler
    b2.texture = godray_texture
    b2.sampler = runtime.linear_sampler
    sdl.SDL_BindGPUFragmentSamplers(
        runtime.current_pass,
        0 as u32,
        bindings_raw as ref sdl.SDLGPUTextureSamplerBinding,
        3 as u32
    )
    @free(bindings_raw)

    val bloom_on: mut f32 = 0.0 as f32
    if bloom_active {
        bloom_on = 1.0 as f32
    }
    val godray_on: mut f32 = 0.0 as f32
    if godray_active {
        godray_on = 1.0 as f32
    }
    val vignette_on: mut f32 = 0.0 as f32
    if active && settings.vignette.enabled {
        vignette_on = 1.0 as f32
    }
    val fxaa_on: mut f32 = 0.0 as f32
    if active && settings.fxaa {
        fxaa_on = 1.0 as f32
    }
    val bloom_intensity: mut f32 = 0.0 as f32
    if bloom_active {
        bloom_intensity = settings.bloom.intensity
    }
    val vignette_intensity: mut f32 = 0.0 as f32
    if active && settings.vignette.enabled {
        vignette_intensity = settings.vignette.intensity
    }
    val exposure: mut f32 = 1.0 as f32
    val contrast: mut f32 = 1.0 as f32
    val saturation: mut f32 = 1.0 as f32
    val aberration: mut f32 = 0.0 as f32
    val grain: mut f32 = 0.0 as f32
    if active {
        exposure = settings.exposure
        contrast = settings.contrast
        saturation = settings.saturation
        aberration = settings.chromatic_aberration
        grain = settings.film_grain
    }

    val fu: mut CompositeUniforms = {
        bloom: { x: bloom_intensity, y: bloom_on, z: godray_on, w: fxaa_on },
        vignette: {
            x: vignette_intensity,
            y: settings.vignette.smoothness,
            z: vignette_on,
            w: 0.0 as f32
        },
        color: { x: exposure, y: contrast, z: saturation, w: aberration },
        screen: {
            x: (1.0 as f32) / (runtime.render_width as f32),
            y: (1.0 as f32) / (runtime.render_height as f32),
            z: time,
            w: grain
        },
        vignette_color: {
            x: settings.vignette.color.x,
            y: settings.vignette.color.y,
            z: settings.vignette.color.z,
            w: 0.0 as f32
        }
    }
    sdl.SDL_PushGPUFragmentUniformData(
        runtime.command_buffer,
        0 as u32,
        @addr(fu) as ref void,
        @sizeof(CompositeUniforms) as u32
    )
    sdl.SDL_DrawGPUPrimitives(runtime.current_pass, 3 as u32, 1 as u32, 0 as u32, 0 as u32)
    return true
}

fn write_mapped_ppm(runtime: ref Renderer, tbuf: ref void, path: ref u8) void = trust {
    val w: u32 = runtime.render_width
    val h: u32 = runtime.render_height
    val mapped: ref u8 = sdl.SDL_MapGPUTransferBuffer(runtime.device, tbuf, false) as ref u8
    if mapped != none {
        val rgb: ref u8 = @alloc((w * h * (3 as u32)) as usize) as ref u8
        val i: mut u32 = 0 as u32
        for i < (w * h) {
            val o: usize = (i as usize) * (4 as usize)
            val d: usize = (i as usize) * (3 as usize)
            val r: u8 = @load8(@ptradd(mapped, o + (2 as usize)))
            val g: u8 = @load8(@ptradd(mapped, o + (1 as usize)))
            val b: u8 = @load8(@ptradd(mapped, o))
            @store8(@ptradd(rgb, d), r)
            @store8(@ptradd(rgb, d + (1 as usize)), g)
            @store8(@ptradd(rgb, d + (2 as usize)), b)
            i = i + (1 as u32)
        }
        val file: ref void = sdl.fopen(path, "wb")
        if file != none {
            val hdr: ref u8 = @alloc(64 as usize) as ref u8
            @snprintf(hdr, 64 as usize, "P6\n{lld} {lld}\n255\n", {w as i64, h as i64})
            sdl.fwrite(hdr, 1 as usize, string.len_raw(hdr), file)
            sdl.fwrite(rgb, 1 as usize, (w * h * (3 as u32)) as usize, file)
            sdl.fclose(file)
            @free(hdr)
        }
        @free(rgb)
        sdl.SDL_UnmapGPUTransferBuffer(runtime.device, tbuf)
    }
}

pub fn debug_dump_scene(runtime_raw: ref void, path: ref u8) void = trust {
    val runtime: ref Renderer = runtime_raw as ref Renderer
    val w: u32 = runtime.render_width
    val h: u32 = runtime.render_height
    val byte_size: u32 = w * h * (4 as u32)
    val info: mut sdl.SDLGPUTransferBufferCreateInfo = {
        usage: sdl.SDL_GPU_TRANSFERBUFFERUSAGE_DOWNLOAD,
        size: byte_size,
        props: 0 as u32
    }
    val tbuf: ref void = sdl.SDL_CreateGPUTransferBuffer(runtime.device, @addr(info))
    if tbuf == none {
        return
    }
    val cmd: ref void = sdl.SDL_AcquireGPUCommandBuffer(runtime.device)
    val pass: ref void = sdl.SDL_BeginGPUCopyPass(cmd)
    val src: mut sdl.SDLGPUTextureRegion = {
        texture: runtime.scene_color,
        mip_level: 0 as u32,
        layer: 0 as u32,
        x: 0 as u32,
        y: 0 as u32,
        z: 0 as u32,
        w: w,
        h: h,
        d: 1 as u32
    }
    val dst: mut sdl.SDLGPUTextureTransferInfo = {
        transfer_buffer: tbuf,
        offset: 0 as u32,
        pixels_per_row: w,
        rows_per_layer: h
    }
    sdl.SDL_DownloadFromGPUTexture(pass, @addr(src), @addr(dst))
    sdl.SDL_EndGPUCopyPass(pass)
    sdl.SDL_SubmitGPUCommandBuffer(cmd)
    sdl.SDL_WaitForGPUIdle(runtime.device)
    write_mapped_ppm(runtime, tbuf, path)
    sdl.SDL_ReleaseGPUTransferBuffer(runtime.device, tbuf)
}

pub fn submit_frame_capture(runtime_raw: ref void, path: ref u8) bool = trust {
    exoerr.clear()
    if runtime_raw == none {
        return exoerr.set("frame not active")
    }
    val runtime: mut ref Renderer = runtime_raw as mut ref Renderer
    if !runtime.frame_active || runtime.command_buffer == none {
        return exoerr.set("frame not active")
    }
    end_pass(runtime_raw)
    val w: u32 = runtime.render_width
    val h: u32 = runtime.render_height
    val tbuf: mut ref void = none
    if path != none && string.len_raw(path) > (0 as usize) && runtime.swapchain_texture != none {
        val byte_size: u32 = w * h * (4 as u32)
        val info: mut sdl.SDLGPUTransferBufferCreateInfo = {
            usage: sdl.SDL_GPU_TRANSFERBUFFERUSAGE_DOWNLOAD,
            size: byte_size,
            props: 0 as u32
        }
        tbuf = sdl.SDL_CreateGPUTransferBuffer(runtime.device, @addr(info))
        if tbuf != none {
            val pass: ref void = sdl.SDL_BeginGPUCopyPass(runtime.command_buffer)
            val src: mut sdl.SDLGPUTextureRegion = {
                texture: runtime.swapchain_texture,
                mip_level: 0 as u32,
                layer: 0 as u32,
                x: 0 as u32,
                y: 0 as u32,
                z: 0 as u32,
                w: w,
                h: h,
                d: 1 as u32
            }
            val dst: mut sdl.SDLGPUTextureTransferInfo = {
                transfer_buffer: tbuf,
                offset: 0 as u32,
                pixels_per_row: w,
                rows_per_layer: h
            }
            sdl.SDL_DownloadFromGPUTexture(pass, @addr(src), @addr(dst))
            sdl.SDL_EndGPUCopyPass(pass)
        }
    }
    val its_ok: bool = sdl.SDL_SubmitGPUCommandBuffer(runtime.command_buffer)
    runtime.command_buffer = none
    runtime.swapchain_texture = none
    runtime.frame_active = false
    if tbuf != none {
        if its_ok {
            sdl.SDL_WaitForGPUIdle(runtime.device)
            write_mapped_ppm(runtime, tbuf, path)
        }
        sdl.SDL_ReleaseGPUTransferBuffer(runtime.device, tbuf)
    }
    return its_ok
}

pub fn submit_frame(runtime_raw: ref void) bool = trust {
    return submit_frame_capture(runtime_raw, none as ref u8)
}

pub fn draw_scene_mesh(
    runtime_raw: ref void,
    mesh_raw: ref void,
    model: ref f32,
    view_proj: ref f32,
    color: ref f32,
    camera_pos: ref f32,
    reflective: f32,
    glow: f32,
    alpha: f32,
    light_pos: ref f32,
    light_color: ref f32,
    light_intensity: f32,
    light_radius: f32,
    texture_raw: ref void,
    first_index: u32,
    draw_index_count: u32
) void = trust {
    if runtime_raw == none || mesh_raw == none {
        return
    }
    val runtime: ref Renderer = runtime_raw as ref Renderer
    val mesh: ref GpuMesh = mesh_raw as ref GpuMesh
    val vu: mut SceneVertexUniforms = {
        model: math.transpose_mat4_ptr(model),
        view_proj: math.transpose_mat4_ptr(view_proj),
        uv_transform: { x: 1.0 as f32, y: 1.0 as f32, z: 0.0 as f32, w: 0.0 as f32 }
    }
    val fu: mut SceneFragmentUniforms = default_scene_fragment_uniforms()
    fu.color_reflective = math.vec4_from_ptr(color, reflective)
    fu.camera_glow = math.vec4_from_ptr(camera_pos, glow)
    fu.alpha_pad = { x: alpha, y: 0.0 as f32, z: 0.0 as f32, w: 0.0 as f32 }
    fu.sky_top = { x: runtime.sky_top.x, y: runtime.sky_top.y, z: runtime.sky_top.z, w: 0.0 as f32 }
    fu.sky_horizon = {
        x: runtime.sky_horizon.x,
        y: runtime.sky_horizon.y,
        z: runtime.sky_horizon.z,
        w: 0.0 as f32
    }
    fu.ambient_pad = { x: runtime.ambient, y: 0.0 as f32, z: 0.0 as f32, w: 0.0 as f32 }
    val light_count: mut i32 = 0 as i32
    for scene_light in runtime.lights {
        if light_count < (8 as i32) {
            set_light_uniform(fu, light_count, scene_light)
            light_count = light_count + (1 as i32)
        }
    }
    if light_count == (0 as i32) {
        val fallback_light: ecs.PointLight = {
            position: { x: math.read_f32(
                    light_pos,
                    0 as usize
                ), y: math.read_f32(
                    light_pos,
                    1 as usize
                ), z: math.read_f32(light_pos, 2 as usize) },
            color: { x: math.read_f32(
                    light_color,
                    0 as usize
                ), y: math.read_f32(
                    light_color,
                    1 as usize
                ), z: math.read_f32(light_color, 2 as usize) },
            intensity: light_intensity,
            radius: light_radius
        }
        set_light_uniform(fu, 0 as i32, fallback_light)
        light_count = 1 as i32
    }
    fu.light_meta = { x: light_count as f32, y: 0.0 as f32, z: 0.0 as f32, w: 0.0 as f32 }
    val has_tex: mut f32 = 0.0 as f32
    val tex_to_bind: mut ref void = runtime.reflection_color
    if texture_raw != none {
        tex_to_bind = texture_raw
        has_tex = 1.0 as f32
        fu.alpha_pad.y = has_tex
    }
    val tex_binding: mut sdl.SDLGPUTextureSamplerBinding = {
        texture: tex_to_bind,
        sampler: runtime.linear_sampler
    }
    sdl.SDL_BindGPUGraphicsPipeline(runtime.current_pass, runtime.scene_pipeline)
    sdl.SDL_PushGPUVertexUniformData(
        runtime.command_buffer,
        0 as u32,
        @addr(vu) as ref void,
        @sizeof(SceneVertexUniforms) as u32
    )
    sdl.SDL_PushGPUFragmentUniformData(
        runtime.command_buffer,
        0 as u32,
        @addr(fu) as ref void,
        @sizeof(SceneFragmentUniforms) as u32
    )
    sdl.SDL_BindGPUFragmentSamplers(runtime.current_pass, 0 as u32, @addr(tex_binding), 1 as u32)
    bind_mesh(runtime, mesh)
    val draw_count: mut u32 = draw_index_count
    if draw_count == (0 as u32) {
        draw_count = mesh.index_count
    }
    sdl.SDL_DrawGPUIndexedPrimitives(
        runtime.current_pass,
        draw_count,
        1 as u32,
        first_index,
        0 as i32,
        0 as u32
    )
}

pub fn draw_floor_raw(
    runtime_raw: ref void,
    mesh_raw: ref void,
    model: ref f32,
    view_proj: ref f32,
    reflect_view_proj: ref f32,
    camera_pos: ref f32,
    floor_color: ref f32
) void = trust {
    if runtime_raw == none || mesh_raw == none {
        return
    }
    val runtime: ref Renderer = runtime_raw as ref Renderer
    val mesh: ref GpuMesh = mesh_raw as ref GpuMesh
    val vu: mut FloorVertexUniforms = {
        model: math.transpose_mat4_ptr(model),
        view_proj: math.transpose_mat4_ptr(view_proj),
        reflect_view_proj: math.transpose_mat4_ptr(reflect_view_proj)
    }
    val fu: mut FloorFragmentUniforms = {
        camera_pos: math.vec4_from_ptr(camera_pos, 0.0 as f32),
        floor_color: math.vec4_from_ptr(floor_color, 1.0 as f32)
    }
    val binding: mut sdl.SDLGPUTextureSamplerBinding = {
        texture: none as ref void,
        sampler: none as ref void
    }
    binding.texture = runtime.reflection_color
    binding.sampler = runtime.linear_sampler
    sdl.SDL_BindGPUGraphicsPipeline(runtime.current_pass, runtime.floor_pipeline)
    sdl.SDL_PushGPUVertexUniformData(
        runtime.command_buffer,
        0 as u32,
        @addr(vu) as ref void,
        @sizeof(FloorVertexUniforms) as u32
    )
    sdl.SDL_PushGPUFragmentUniformData(
        runtime.command_buffer,
        0 as u32,
        @addr(fu) as ref void,
        @sizeof(FloorFragmentUniforms) as u32
    )
    sdl.SDL_BindGPUFragmentSamplers(runtime.current_pass, 0 as u32, @addr(binding), 1 as u32)
    bind_mesh(runtime, mesh)
    sdl.SDL_DrawGPUIndexedPrimitives(
        runtime.current_pass,
        mesh.index_count,
        1 as u32,
        0 as u32,
        0 as i32,
        0 as u32
    )
}

pub fn draw_glow(
    runtime_raw: ref void,
    mesh_raw: ref void,
    view_proj: ref f32,
    position: ref f32,
    width: f32,
    height: f32,
    camera_right: ref f32,
    camera_up: ref f32,
    color: ref f32,
    intensity: f32,
    alpha: f32
) void = trust {
    if runtime_raw == none || mesh_raw == none {
        return
    }
    val runtime: ref Renderer = runtime_raw as ref Renderer
    val mesh: ref GpuMesh = mesh_raw as ref GpuMesh
    val vu: mut GlowVertexUniforms = {
        view_proj: math.transpose_mat4_ptr(view_proj),
        position: math.vec4_from_ptr(position, 0.0 as f32),
        size: { x: width, y: height, z: 0.0 as f32, w: 0.0 as f32 },
        camera_right: math.vec4_from_ptr(camera_right, 0.0 as f32),
        camera_up: math.vec4_from_ptr(camera_up, 0.0 as f32)
    }
    val fu: mut GlowFragmentUniforms = {
        color_intensity: math.vec4_from_ptr(color, intensity),
        alpha_pad: { x: alpha, y: 0.0 as f32, z: 0.0 as f32, w: 0.0 as f32 }
    }
    sdl.SDL_BindGPUGraphicsPipeline(runtime.current_pass, runtime.glow_pipeline)
    sdl.SDL_PushGPUVertexUniformData(
        runtime.command_buffer,
        0 as u32,
        @addr(vu) as ref void,
        @sizeof(GlowVertexUniforms) as u32
    )
    sdl.SDL_PushGPUFragmentUniformData(
        runtime.command_buffer,
        0 as u32,
        @addr(fu) as ref void,
        @sizeof(GlowFragmentUniforms) as u32
    )
    bind_mesh(runtime, mesh)
    sdl.SDL_DrawGPUIndexedPrimitives(
        runtime.current_pass,
        mesh.index_count,
        1 as u32,
        0 as u32,
        0 as i32,
        0 as u32
    )
}

pub fn upload_mesh(
    runtime: ref void,
    vertices: ref void,
    vertex_float_count: usize,
    indices: ref void,
    index_count: i32
) MeshGPU = trust {
    val raw: ref void = create_mesh(
        runtime,
        vertices,
        (vertex_float_count * (@sizeof(f32) as usize)) as u32,
        indices,
        ((index_count as usize) * (@sizeof(u32) as usize)) as u32,
        index_count as u32
    )
    return { raw: raw, index_count: index_count }
}

pub fn destroy_mesh(runtime: ref void, mesh: MeshGPU) void = trust {
    if mesh.raw != none {
        destroy_mesh_raw(runtime, mesh.raw)
    }
}

pub fn mesh_valid(mesh: MeshGPU) bool = {
    return mesh.raw != none && mesh.index_count > (0 as i32)
}

/// Replace an existing mesh's vertex data in place. Used by CPU skinning and
/// other per-frame deformations.
pub fn update_mesh_vertices(
    runtime_raw: ref void,
    mesh: MeshGPU,
    vertices: ref void,
    vertex_float_count: usize
) bool = trust {
    if runtime_raw == none || mesh.raw == none || vertices == none {
        return false
    }
    if vertex_float_count == (0 as usize) {
        return false
    }
    val runtime: ref Renderer = runtime_raw as ref Renderer
    val gpu: ref GpuMesh = mesh.raw as ref GpuMesh
    val byte_size: u32 = (vertex_float_count * (@sizeof(f32) as usize)) as u32
    if byte_size > gpu.vertex_bytes {
        return false
    }
    val transfer_info: mut sdl.SDLGPUTransferBufferCreateInfo = {
        usage: 0 as i32,
        size: 0 as u32,
        props: 0 as u32
    }
    transfer_info.usage = sdl.SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD
    transfer_info.size = byte_size
    val transfer: ref void = sdl.SDL_CreateGPUTransferBuffer(runtime.device, @addr(transfer_info))
    if transfer == none {
        return false
    }
    val mapped: ref void = sdl.SDL_MapGPUTransferBuffer(runtime.device, transfer, false)
    if mapped == none {
        sdl.SDL_ReleaseGPUTransferBuffer(runtime.device, transfer)
        return false
    }
    @memcpy(mapped, vertices, byte_size as usize)
    sdl.SDL_UnmapGPUTransferBuffer(runtime.device, transfer)
    val command_buffer: ref void = sdl.SDL_AcquireGPUCommandBuffer(runtime.device)
    if command_buffer == none {
        sdl.SDL_ReleaseGPUTransferBuffer(runtime.device, transfer)
        return false
    }
    val copy_pass: ref void = sdl.SDL_BeginGPUCopyPass(command_buffer)
    if copy_pass == none {
        sdl.SDL_CancelGPUCommandBuffer(command_buffer)
        sdl.SDL_ReleaseGPUTransferBuffer(runtime.device, transfer)
        return false
    }
    val src: mut sdl.SDLGPUTransferBufferLocation = {
        transfer_buffer: transfer,
        offset: 0 as u32
    }
    val dst: mut sdl.SDLGPUBufferRegion = {
        buffer: gpu.vertex_buffer,
        offset: 0 as u32,
        size: byte_size
    }
    sdl.SDL_UploadToGPUBuffer(copy_pass, @addr(src), @addr(dst), false)
    sdl.SDL_EndGPUCopyPass(copy_pass)
    if !sdl.SDL_SubmitGPUCommandBuffer(command_buffer) {
        sdl.SDL_ReleaseGPUTransferBuffer(runtime.device, transfer)
        return false
    }
    sdl.SDL_ReleaseGPUTransferBuffer(runtime.device, transfer)
    return true
}

pub fn draw_mesh_textured(
    runtime: ref void,
    mesh: MeshGPU,
    model: math.Mat4,
    view_proj: math.Mat4,
    color: math.Vec3,
    camera_pos: math.Vec3,
    reflective: f32,
    glow: f32,
    alpha: f32,
    light: ecs.PointLight,
    texture: ref void
) void = trust {
    draw_scene_mesh(
        runtime,
        mesh.raw,
        @addr(model.m00),
        @addr(view_proj.m00),
        @addr(color.x),
        @addr(camera_pos.x),
        reflective,
        glow,
        alpha,
        @addr(light.position.x),
        @addr(light.color.x),
        light.intensity,
        light.radius,
        texture,
        0 as u32,
        0 as u32
    )
}

pub fn draw_mesh_textured_range(
    runtime: ref void,
    mesh: MeshGPU,
    first_index: u32,
    draw_index_count: u32,
    model: math.Mat4,
    view_proj: math.Mat4,
    color: math.Vec3,
    camera_pos: math.Vec3,
    reflective: f32,
    glow: f32,
    alpha: f32,
    light: ecs.PointLight,
    texture: ref void
) void = trust {
    draw_scene_mesh(
        runtime,
        mesh.raw,
        @addr(model.m00),
        @addr(view_proj.m00),
        @addr(color.x),
        @addr(camera_pos.x),
        reflective,
        glow,
        alpha,
        @addr(light.position.x),
        @addr(light.color.x),
        light.intensity,
        light.radius,
        texture,
        first_index,
        draw_index_count
    )
}

pub fn release_texture(runtime: ref void, texture: ref void) void = trust {
    if runtime == none || texture == none {
        return
    }
    val rt: ref Renderer = runtime as ref Renderer
    sdl.SDL_ReleaseGPUTexture(rt.device, texture)
}

pub fn draw_mesh(
    runtime: ref void,
    mesh: MeshGPU,
    model: math.Mat4,
    view_proj: math.Mat4,
    color: math.Vec3,
    camera_pos: math.Vec3,
    reflective: f32,
    glow: f32,
    alpha: f32,
    light: ecs.PointLight
) void = trust {
    val tex: mut ref void = none as ref void
    if runtime != none {
        val rt: ref Renderer = runtime as ref Renderer
        tex = rt.glb_texture
    }
    draw_mesh_textured(
        runtime,
        mesh,
        model,
        view_proj,
        color,
        camera_pos,
        reflective,
        glow,
        alpha,
        light,
        tex
    )
}

pub fn draw_billboard(
    runtime: ref void,
    mesh: MeshGPU,
    pos: math.Vec3,
    width: f32,
    height: f32,
    view_proj: math.Mat4,
    cam_right: math.Vec3,
    cam_up: math.Vec3,
    color: math.Vec3,
    intensity: f32,
    alpha: f32
) void = trust {
    draw_glow(
        runtime,
        mesh.raw,
        @addr(view_proj.m00),
        @addr(pos.x),
        width,
        height,
        @addr(cam_right.x),
        @addr(cam_up.x),
        @addr(color.x),
        intensity,
        alpha
    )
}

pub fn draw_typed_entities[E: ecs.SceneEntity](
    runtime: ref void,
    mesh: MeshGPU,
    entities: list[E],
    camera: cam.Camera,
    view_proj: math.Mat4,
    time: f32,
    glow_scale: f32,
    light: ecs.PointLight
) void = trust {
    for entity in entities {
        val mm: math.Mat4 = math.model_matrix(
            E.se_position(entity),
            E.se_scale(entity),
            E.se_rotation(entity, time)
        )
        draw_mesh(
            runtime,
            mesh,
            mm,
            view_proj,
            E.se_color(entity),
            camera.position,
            E.se_reflective(entity),
            glow_scale * (0.025 as f32),
            1.0 as f32,
            light
        )
    }
}

pub fn primary_light(scene: ecs.Scene3D) ecs.PointLight = {
    if @get(scene.lights, 0 as usize) is some light {
        return light
    }
    return ecs.default_light()
}

pub fn draw_models(
    runtime: ref void,
    resources: SceneMeshes,
    scene: ecs.Scene3D,
    camera: cam.Camera,
    view_proj: math.Mat4,
    glow_scale: f32
) void = trust {
    val index: mut usize = 0 as usize
    for instance in scene.models {
        if @get(resources.models, index) is some mesh {
            if mesh_valid(mesh) {
                val mm: math.Mat4 = math.model_matrix(
                    instance.position,
                    instance.scale,
                    instance.rotation_y
                )
                val tex: mut ref void = none as ref void
                if @get(resources.model_textures, index) is some texture {
                    tex = texture
                }
                draw_mesh_textured(
                    runtime,
                    mesh,
                    mm,
                    view_proj,
                    instance.color,
                    camera.position,
                    instance.reflective,
                    glow_scale * instance.glow,
                    instance.alpha,
                    primary_light(scene),
                    tex
                )
            }
        }
        index = index + (1 as usize)
    }
}

pub fn draw_custom_meshes(
    runtime: ref void,
    resources: SceneMeshes,
    scene: ecs.Scene3D,
    camera: cam.Camera,
    view_proj: math.Mat4,
    glow_scale: f32
) void = trust {
    val index: mut usize = 0 as usize
    for instance in scene.mesh_instances {
        if @get(resources.custom, index) is some mesh {
            if mesh_valid(mesh) {
                val mm: math.Mat4 = math.model_matrix_scaled(
                    instance.position,
                    instance.scale,
                    instance.rotation_y
                )
                draw_mesh(
                    runtime,
                    mesh,
                    mm,
                    view_proj,
                    instance.color,
                    camera.position,
                    instance.reflective,
                    glow_scale * instance.glow,
                    instance.alpha,
                    primary_light(scene)
                )
            }
        }
        index = index + (1 as usize)
    }
}

/// Update all CPU-skinned model instances once per frame.
pub fn prepare_models(
    runtime: ref void,
    resources: SceneMeshes,
    scene: ecs.Scene3D,
    time: f32
) void = trust {
    val index: mut usize = 0 as usize
    for draw in scene.model_draws {
        if draw.visible {
            if @get(resources.model_draws, index) is some gpu {
                if gpu.skinned && gpu.base_vertices != none && gpu.draw_vertices != none {
                    val animation_time: f32 = time * draw.animation_speed + draw.animation_offset
                    animation.skin_vertices(
                        gpu.asset,
                        draw.animation,
                        animation_time,
                        gpu.base_vertices,
                        gpu.draw_vertices
                    )
                    update_mesh_vertices(
                        runtime,
                        gpu.mesh,
                        gpu.draw_vertices as ref void,
                        gpu.vertex_float_count
                    )
                }
            }
        }
        index = index + (1 as usize)
    }
}

pub fn draw_model_instances(
    runtime: ref void,
    resources: SceneMeshes,
    scene: ecs.Scene3D,
    camera: cam.Camera,
    view_proj: math.Mat4,
    glow_scale: f32
) void = trust {
    val light: ecs.PointLight = primary_light(scene)
    val index: mut usize = 0 as usize
    for draw in scene.model_draws {
        if draw.visible {
            if @get(resources.model_draws, index) is some gpu {
                if mesh_valid(gpu.mesh) {
                    for submesh in gpu.submeshes {
                        draw_mesh_textured_range(
                            runtime,
                            gpu.mesh,
                            submesh.index_offset,
                            submesh.index_count,
                            draw.transform,
                            view_proj,
                            draw.color,
                            camera.position,
                            0.10 as f32,
                            glow_scale * draw.glow,
                            draw.alpha,
                            light,
                            submesh.texture
                        )
                    }
                }
            }
        }
        index = index + (1 as usize)
    }
}

pub fn draw_scene_entities(
    runtime: ref void,
    resources: SceneMeshes,
    scene: ecs.Scene3D,
    camera: cam.Camera,
    view_proj: math.Mat4,
    time: f32,
    glow_scale: f32,
    include_models: bool
) void = trust {
    val light: ecs.PointLight = primary_light(scene)
    draw_typed_entities[ecs.SphereEntity](
        runtime,
        resources.sphere,
        scene.spheres,
        camera,
        view_proj,
        time,
        glow_scale,
        light
    )
    draw_typed_entities[ecs.CubeEntity](
        runtime,
        resources.cube,
        scene.cubes,
        camera,
        view_proj,
        time,
        glow_scale,
        light
    )
    if include_models {
        draw_models(runtime, resources, scene, camera, view_proj, glow_scale)
        draw_custom_meshes(runtime, resources, scene, camera, view_proj, glow_scale)
        draw_model_instances(runtime, resources, scene, camera, view_proj, glow_scale)
    }
}

pub fn draw_floor(
    runtime: ref void,
    mesh: MeshGPU,
    model: math.Mat4,
    view_proj: math.Mat4,
    reflect_view_proj: math.Mat4,
    camera: cam.Camera,
    color: math.Vec3
) void = trust {
    draw_floor_raw(
        runtime,
        mesh.raw,
        @addr(model.m00),
        @addr(view_proj.m00),
        @addr(reflect_view_proj.m00),
        @addr(camera.position.x),
        @addr(color.x)
    )
}

pub fn draw_water(
    runtime: ref void,
    mesh: MeshGPU,
    model: math.Mat4,
    view_proj: math.Mat4,
    reflect_view_proj: math.Mat4,
    camera: cam.Camera,
    color: math.Vec3,
    wave_offset: f32,
    wave_amplitude: f32,
    wave_frequency: f32,
    light: ecs.PointLight,
    corner_radius: f32,
    size_x: f32,
    size_z: f32,
    center_x: f32,
    center_z: f32
) void = trust {
    if runtime == none || mesh.raw == none {
        return
    }
    val rt: ref Renderer = runtime as ref Renderer
    if rt.water_pipeline == none {
        return
    }
    val vu: mut WaterVertexUniforms = {
        model: math.transpose_mat4_ptr(@addr(model.m00)),
        view_proj: math.transpose_mat4_ptr(@addr(view_proj.m00)),
        reflect_vp: math.transpose_mat4_ptr(@addr(reflect_view_proj.m00)),
        time_wave: { x: wave_offset, y: wave_amplitude, z: wave_frequency, w: 0.0 as f32 }
    }
    val light_dir: math.Vec3 = math.vec3_normalize(math.vec3_sub(
            light.position,
            math.vec3(0.0 as f32, 0.0 as f32, 0.0 as f32)
        ))
    val fu: mut WaterFragmentUniforms = {
        camera_pos: {
            x: camera.position.x,
            y: camera.position.y,
            z: camera.position.z,
            w: wave_offset
        },
        water_color: { x: color.x, y: color.y, z: color.z, w: center_x },
        light_dir: { x: light_dir.x, y: light_dir.y, z: light_dir.z, w: light.intensity },
        water_params: { x: corner_radius, y: size_x, z: size_z, w: center_z }
    }
    sdl.SDL_BindGPUGraphicsPipeline(rt.current_pass, rt.water_pipeline)
    sdl.SDL_PushGPUVertexUniformData(
        rt.command_buffer,
        0 as u32,
        @addr(vu) as ref void,
        @sizeof(WaterVertexUniforms) as u32
    )
    sdl.SDL_PushGPUFragmentUniformData(
        rt.command_buffer,
        0 as u32,
        @addr(fu) as ref void,
        @sizeof(WaterFragmentUniforms) as u32
    )
    val normal_tex: mut ref void = rt.reflection_color

    if rt.normal_map_texture != none {
        normal_tex = rt.normal_map_texture
    }
    val bindings_raw: ref void = @alloc(2 as usize * @sizeof(sdl.SDLGPUTextureSamplerBinding) as usize)
    val b0: mut ref sdl.SDLGPUTextureSamplerBinding = bindings_raw as mut ref sdl.SDLGPUTextureSamplerBinding
    val b1: mut ref sdl.SDLGPUTextureSamplerBinding = @ptradd(
        bindings_raw,
        @sizeof(sdl.SDLGPUTextureSamplerBinding) as usize
    ) as mut ref sdl.SDLGPUTextureSamplerBinding
    b0.texture = rt.reflection_color
    b0.sampler = rt.linear_sampler
    b1.texture = normal_tex
    b1.sampler = rt.repeat_sampler
    sdl.SDL_BindGPUFragmentSamplers(
        rt.current_pass,
        0 as u32,
        bindings_raw as ref sdl.SDLGPUTextureSamplerBinding,
        2 as u32
    )
    @free(bindings_raw)
    bind_mesh(rt, mesh.raw as ref GpuMesh)
    sdl.SDL_DrawGPUIndexedPrimitives(
        rt.current_pass,
        mesh.index_count as u32,
        1 as u32,
        0 as u32,
        0 as i32,
        0 as u32
    )
}

pub fn render_reflection_scene(
    runtime: ref void,
    resources: SceneMeshes,
    scene: ecs.Scene3D,
    camera: cam.Camera,
    width: i32,
    height: i32,
    time: f32
) void = trust {
    val mirror_y: mut f32 = scene.render.reflection_plane
    if @get(scene.waters, 0 as usize) is some water {
        mirror_y = water.y
    }
    val mirrored: cam.Camera = cam.mirrored_camera(camera, mirror_y)
    val reflect_vp: math.Mat4 = cam.view_projection(mirrored, width, height)
    draw_scene_entities(
        runtime,
        resources,
        scene,
        mirrored,
        reflect_vp,
        time,
        0.60 as f32,
        scene.render.reflect_models
    )
}

pub fn render_scene(
    runtime: ref void,
    resources: SceneMeshes,
    scene: ecs.Scene3D,
    camera: cam.Camera,
    width: i32,
    height: i32,
    time: f32
) void = trust {
    val vp: math.Mat4 = cam.view_projection(camera, width, height)
    draw_scene_entities(runtime, resources, scene, camera, vp, time, 1.00 as f32, true)
    for floor in scene.floors {
        val floor_position: math.Vec3 = math.vec3(
            floor.center_x,
            floor.y - (0.08 as f32),
            floor.center_z
        )
        val floor_scale: math.Vec3 = math.vec3(floor.size_x, 0.16 as f32, floor.size_z)
        val reflect_vp: math.Mat4 = cam.view_projection(
            cam.mirrored_camera(camera, floor.y),
            width,
            height
        )
        draw_floor(
            runtime,
            resources.cube,
            math.model_matrix_scaled(floor_position, floor_scale, 0.0 as f32),
            vp,
            reflect_vp,
            camera,
            floor.color
        )
    }
    val light: ecs.PointLight = primary_light(scene)
    for water in scene.waters {
        val wave_offset: f32 = time * water.wave_speed
        val fit_x: mut f32 = water.size_x
        val fit_z: mut f32 = water.size_z
        val fit_ox: mut f32 = water.offset_x
        val fit_oz: mut f32 = water.offset_z
        val fit_y: mut f32 = water.y
        if fit_x == (0.0 as f32) && fit_z == (0.0 as f32) && @len(scene.models) > (0 as usize) {
            if @get(scene.models, 0 as usize) is some first_model {
                val s: f32 = first_model.scale
                fit_x = (first_model.model.bounds_max_x - first_model.model.bounds_min_x) * s * water.fit_scale
                fit_z = (first_model.model.bounds_max_z - first_model.model.bounds_min_z) * s * water.fit_scale
                fit_ox = ((first_model.model.bounds_min_x + first_model.model.bounds_max_x) * 0.5 as f32) * s
                fit_oz = ((first_model.model.bounds_min_z + first_model.model.bounds_max_z) * 0.5 as f32) * s
                fit_y = first_model.model.bounds_max_y * s + water.y
            }
        }
        val water_position: math.Vec3 = math.vec3(fit_ox, fit_y, fit_oz)
        val water_scale: math.Vec3 = math.vec3(fit_x, 0.04 as f32, fit_z)
        val water_model: math.Mat4 = math.model_matrix_scaled(
            water_position,
            water_scale,
            0.0 as f32
        )
        val reflect_water_vp: math.Mat4 = cam.view_projection(
            cam.mirrored_camera(camera, fit_y),
            width,
            height
        )
        draw_water(
            runtime,
            resources.cube,
            water_model,
            vp,
            reflect_water_vp,
            camera,
            water.color,
            wave_offset,
            water.wave_amplitude,
            water.wave_frequency,
            light,
            water.corner_radius,
            fit_x,
            fit_z,
            fit_ox,
            fit_oz
        )
    }
    if scene.render.enable_light_glow {
        val cam_fwd: math.Vec3 = cam.camera_forward(camera)
        val world_up_v: math.Vec3 = math.vec3(0.0 as f32, 1.0 as f32, 0.0 as f32)
        val cam_right: math.Vec3 = math.vec3_normalize(math.vec3_cross(cam_fwd, world_up_v))
        val cam_up: math.Vec3 = math.vec3_normalize(math.vec3_cross(cam_right, cam_fwd))
        for point_light in scene.lights {
            draw_billboard(
                runtime,
                resources.quad,
                point_light.position,
                1.05 as f32,
                1.05 as f32,
                vp,
                cam_right,
                cam_up,
                point_light.color,
                1.4 as f32,
                0.62 as f32
            )
        }
    }
}

fn ui_model(x: f32, y: f32, width: f32, height: f32, screen_w: f32, screen_h: f32) math.Mat4 = {
    val ndc_x: f32 = ((x + width * (0.5 as f32)) / screen_w) * (2.0 as f32) - (1.0 as f32)
    val ndc_y: f32 = (1.0 as f32) - ((y + height * (0.5 as f32)) / screen_h) * (2.0 as f32)
    val sx: f32 = (width / screen_w) * (2.0 as f32)
    val sy: f32 = (height / screen_h) * (2.0 as f32)
    return math.model_matrix_scaled(
        math.vec3(ndc_x, ndc_y, 0.0 as f32),
        math.vec3(sx, sy, 1.0 as f32),
        0.0 as f32
    )
}

fn identity_matrix() math.Mat4 = {
    return math.mat4(
        1.0 as f32, 0.0 as f32, 0.0 as f32, 0.0 as f32,
        0.0 as f32, 1.0 as f32, 0.0 as f32, 0.0 as f32,
        0.0 as f32, 0.0 as f32, 1.0 as f32, 0.0 as f32,
        0.0 as f32, 0.0 as f32, 0.0 as f32, 1.0 as f32
    )
}

pub fn draw_ui_quad(
    runtime_raw: ref void,
    quad_mesh: MeshGPU,
    x: f32, y: f32, width: f32, height: f32,
    u0: f32, v0: f32, u1: f32, v1: f32,
    color: math.Vec3, alpha: f32,
    screen_w: f32, screen_h: f32,
    textured: bool,
    texture: ref void
) void = trust {
    if runtime_raw == none || !mesh_valid(quad_mesh) {
        return
    }
    val runtime: ref Renderer = runtime_raw as ref Renderer
    if runtime.ui_pipeline == none {
        return
    }
    val model: math.Mat4 = ui_model(x, y, width, height, screen_w, screen_h)
    val vp: math.Mat4 = identity_matrix()
    val vu: mut SceneVertexUniforms = {
        model: math.transpose_mat4_ptr(@addr(model.m00)),
        view_proj: math.transpose_mat4_ptr(@addr(vp.m00)),
        uv_transform: { x: u1 - u0, y: v1 - v0, z: u0, w: v0 }
    }
    val has_tex: mut f32 = 0.0 as f32
    if textured {
        has_tex = 1.0 as f32
    }
    val fu: mut SceneFragmentUniforms = default_scene_fragment_uniforms()
    fu.color_reflective = { x: color.x, y: color.y, z: color.z, w: 0.0 as f32 }
    fu.alpha_pad = { x: alpha, y: has_tex, z: 1.0 as f32, w: 0.0 as f32 }
    val tex: mut ref void = runtime.font_texture
    if textured && texture != none {
        tex = texture
    }
    if !textured {
        tex = runtime.reflection_color
    }
    val binding: mut sdl.SDLGPUTextureSamplerBinding = {
        texture: tex,
        sampler: runtime.linear_sampler
    }
    sdl.SDL_BindGPUGraphicsPipeline(runtime.current_pass, runtime.ui_pipeline)
    sdl.SDL_PushGPUVertexUniformData(
        runtime.command_buffer,
        0 as u32,
        @addr(vu) as ref void,
        @sizeof(SceneVertexUniforms) as u32
    )
    sdl.SDL_PushGPUFragmentUniformData(
        runtime.command_buffer,
        0 as u32,
        @addr(fu) as ref void,
        @sizeof(SceneFragmentUniforms) as u32
    )
    sdl.SDL_BindGPUFragmentSamplers(runtime.current_pass, 0 as u32, @addr(binding), 1 as u32)
    bind_mesh(runtime, quad_mesh.raw as ref GpuMesh)
    sdl.SDL_DrawGPUIndexedPrimitives(
        runtime.current_pass,
        quad_mesh.index_count as u32,
        1 as u32,
        0 as u32,
        0 as i32,
        0 as u32
    )
}

fn draw_ttf_text(
    runtime: ref void,
    quad: MeshGPU,
    text: ecs.UiText,
    atlas: FontAtlasGPU,
    screen_w: f32,
    screen_h: f32
) void = trust {
    if text.text == none {
        return
    }
    val line_height: f32 = font.line_height(atlas.cpu)
    val pen_x: mut f32 = text.x
    val pen_y: mut f32 = text.y
    val i: mut usize = 0 as usize
    for {
        val ch: u8 = @load8(@ptradd(text.text, i))
        if ch == (0 as u8) {
            break
        }
        if ch == (10 as u8) {
            pen_x = text.x
            pen_y = pen_y + line_height
        } elif ch != (13 as u8) {
            val glyph_index: mut i32 = (ch as i32) - atlas.cpu.first_codepoint
            if glyph_index < (0 as i32) || glyph_index >= atlas.cpu.glyph_count {
                glyph_index = (63 as i32) - atlas.cpu.first_codepoint
            }
            if font.glyph(atlas.cpu, glyph_index) is some glyph {
                if glyph.width > (0.0 as f32) && glyph.height > (0.0 as f32) {
                    draw_ui_quad(
                        runtime,
                        quad,
                        pen_x + glyph.xoff,
                        pen_y + atlas.cpu.ascent + glyph.yoff,
                        glyph.width,
                        glyph.height,
                        glyph.u0,
                        glyph.v0,
                        glyph.u1,
                        glyph.v1,
                        text.color,
                        text.alpha,
                        screen_w,
                        screen_h,
                        true,
                        atlas.texture
                    )
                }
                pen_x = pen_x + glyph.advance
            }
        }
        i = i + (1 as usize)
    }
}

pub fn render_ui(
    runtime: ref void,
    resources: SceneMeshes,
    scene: ecs.Scene3D,
    screen_w: i32,
    screen_h: i32
) void = trust {
    if runtime == none {
        return
    }
    val rt: ref Renderer = runtime as ref Renderer
    val sw: f32 = screen_w as f32
    val sh: f32 = screen_h as f32
    for rect in scene.ui.rects {
        draw_ui_quad(
            runtime,
            resources.quad,
            rect.x,
            rect.y,
            rect.width,
            rect.height,
            0.0 as f32,
            0.0 as f32,
            1.0 as f32,
            1.0 as f32,
            rect.color,
            rect.alpha,
            sw,
            sh,
            false,
            none as ref void
        )
    }
    if rt.font_is_ttf {
        for text in scene.ui.texts {
            val pixel_size: i32 = font_pixel_size(text.scale)
            val atlas_index: i32 = find_font_atlas(rt, pixel_size)
            if atlas_index >= (0 as i32) {
                if @get(rt.font_atlases, atlas_index as usize) is some atlas {
                    draw_ttf_text(runtime, resources.quad, text, atlas, sw, sh)
                }
            }
        }
        return
    }
    for text in scene.ui.texts {
        val line_height: f32 = 8.0 as f32 * text.scale
        val advance: f32 = 6.0 as f32 * text.scale
        val pen_x: mut f32 = text.x
        val pen_y: mut f32 = text.y
        val i: mut usize = 0 as usize
        for {
            val ch: u8 = @load8(@ptradd(text.text, i))
            if ch == (0 as u8) {
                break
            }
            if ch == (10 as u8) {
                pen_x = text.x
                pen_y = pen_y + line_height + (2.0 as f32) * text.scale
            } elif ch != (32 as u8) {
                val glyph: i32 = ch as i32 - (32 as i32)
                if glyph >= (0 as i32) && glyph < (96 as i32) {
                    val cell_x: f32 = ((glyph % (16 as i32)) as f32) * (8.0 as f32)
                    val cell_y: f32 = ((glyph / (16 as i32)) as f32) * (8.0 as f32)
                    val u0: f32 = cell_x / (128.0 as f32)
                    val v0: f32 = cell_y / (48.0 as f32)
                    val u1: f32 = (cell_x + (8.0 as f32)) / (128.0 as f32)
                    val v1: f32 = (cell_y + (8.0 as f32)) / (48.0 as f32)
                    draw_ui_quad(
                        runtime,
                        resources.quad,
                        pen_x,
                        pen_y,
                        line_height,
                        line_height,
                        u0,
                        v0,
                        u1,
                        v1,
                        text.color,
                        text.alpha,
                        sw,
                        sh,
                        true,
                        none as ref void
                    )
                }
                pen_x = pen_x + advance
            } else {
                pen_x = pen_x + advance
            }
            i = i + (1 as usize)
        }
    }
}
