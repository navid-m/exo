val sdl = use("sdl.sx")

pub type ShaderProgramConfig = {
    vertex_path: ref u8
    fragment_path: ref u8
}

pub type PostProcessShaderConfig = {
    threshold: ShaderProgramConfig
    blur: ShaderProgramConfig
    godrays: ShaderProgramConfig
    sharpen: ShaderProgramConfig
    flare: ShaderProgramConfig
    taa: ShaderProgramConfig
    composite: ShaderProgramConfig
}

pub type ExoShaderConfig = {
    scene: ShaderProgramConfig
    instanced: ShaderProgramConfig
    sky: ShaderProgramConfig
    ui: ShaderProgramConfig
    floor: ShaderProgramConfig
    glow: ShaderProgramConfig
    water: ShaderProgramConfig
    post_process: PostProcessShaderConfig
}


pub fn exo_shader_format() u32 = {
    when darwin {
        return sdl.SDL_GPU_SHADERFORMAT_MSL
    }
    return sdl.SDL_GPU_SHADERFORMAT_SPIRV
}

pub fn exo_shader_entrypoint() ref u8 = {
    when darwin {
        return "main0"
    }
    return "main"
}


pub fn default_shader_config() ExoShaderConfig = {
    when darwin {
        return {
            scene: {
                vertex_path: "./assets/shaders/scene.vert.msl",
                fragment_path: "./assets/shaders/scene.frag.msl"
            },
            instanced: {
                vertex_path: "./assets/shaders/instanced.vert.msl",
                fragment_path: "./assets/shaders/instanced.frag.msl"
            },
            sky: {
                vertex_path: "./assets/shaders/fullscreen.vert.msl",
                fragment_path: "./assets/shaders/sky.frag.msl"
            },
            ui: {
                vertex_path: "./assets/shaders/ui.vert.msl",
                fragment_path: "./assets/shaders/ui.frag.msl"
            },
            floor: {
                vertex_path: "./assets/shaders/floor.vert.msl",
                fragment_path: "./assets/shaders/floor.frag.msl"
            },
            glow: {
                vertex_path: "./assets/shaders/glow.vert.msl",
