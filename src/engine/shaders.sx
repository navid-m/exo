            },
            water: {
                vertex_path: "./assets/shaders/water.vert.msl",
                fragment_path: "./assets/shaders/water.frag.msl"
            },
            post_process: {
                threshold: {
                    vertex_path: "./assets/shaders/fullscreen.vert.msl",
                    fragment_path: "./assets/shaders/bloom_threshold.frag.msl"
                },
                blur: {
                    vertex_path: "./assets/shaders/fullscreen.vert.msl",
                    fragment_path: "./assets/shaders/bloom_blur.frag.msl"
                },
                godrays: {
                    vertex_path: "./assets/shaders/fullscreen.vert.msl",
                    fragment_path: "./assets/shaders/godrays.frag.msl"
                },
                sharpen: {
                    vertex_path: "./assets/shaders/fullscreen.vert.msl",
                    fragment_path: "./assets/shaders/sharpen.frag.msl"
                },
                flare: {
                    vertex_path: "./assets/shaders/fullscreen.vert.msl",
                    fragment_path: "./assets/shaders/flare.frag.msl"
                },
                taa: {
                    vertex_path: "./assets/shaders/fullscreen.vert.msl",
                    fragment_path: "./assets/shaders/taa.frag.msl"
