        },
        post_process: {
            threshold: {
                vertex_path: "./assets/shaders/fullscreen.vert.spv",
                fragment_path: "./assets/shaders/bloom_threshold.frag.spv"
            },
            blur: {
                vertex_path: "./assets/shaders/fullscreen.vert.spv",
                fragment_path: "./assets/shaders/bloom_blur.frag.spv"
            },
            godrays: {
                vertex_path: "./assets/shaders/fullscreen.vert.spv",
                fragment_path: "./assets/shaders/godrays.frag.spv"
            },
            sharpen: {
                vertex_path: "./assets/shaders/fullscreen.vert.spv",
