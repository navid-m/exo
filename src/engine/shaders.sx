val sdl = use("sdl.sx")

pub type ShaderProgramConfig = {
    vertex_path: ref u8
    fragment_path: ref u8
}

pub type PostProcessShaderConfig = {
    threshold: ShaderProgramConfig
    blur: ShaderProgramConfig
    godrays: ShaderProgramConfig
    composite: ShaderProgramConfig
}

pub type ExoShaderConfig = {
    scene: ShaderProgramConfig
    floor: ShaderProgramConfig
    glow: ShaderProgramConfig
    water: ShaderProgramConfig
    /// Depth-only shader used for the dynamic cube shadow pass. The vertex
    /// shader can be the scene vertex shader; the fragment shader only needs
    /// to exist for the pipeline.
    shadow: ShaderProgramConfig
    post_process: PostProcessShaderConfig
}


pub fn exo_shader_format() u32 = {
    when darwin {
        return sdl.SDL_GPU_SHADERFORMAT_MSL
    }
    return sdl.SDL_GPU_SHADERFORMAT_SPIRV
}

pub fn exo_shader_entrypoint() ref u8 = {
    when darwin {
        return "main0"
    }
    return "main"
}


pub fn default_shader_config() ExoShaderConfig = {
    when darwin {
        return {
            scene: {
                vertex_path: "./assets/shaders/scene.vert.msl",
                fragment_path: "./assets/shaders/scene.frag.msl"
            },
            floor: {
                vertex_path: "./assets/shaders/floor.vert.msl",
                fragment_path: "./assets/shaders/floor.frag.msl"
            },
            glow: {
                vertex_path: "./assets/shaders/glow.vert.msl",
                fragment_path: "./assets/shaders/glow.frag.msl"
            },
            water: {
                vertex_path: "./assets/shaders/water.vert.msl",
                fragment_path: "./assets/shaders/water.frag.msl"
            },
            shadow: {
                vertex_path: "./assets/shaders/scene.vert.msl",
                fragment_path: "./assets/shaders/shadow.frag.msl"
            },
            post_process: {
                threshold: {
                    vertex_path: "./assets/shaders/fullscreen.vert.msl",
                    fragment_path: "./assets/shaders/bloom_threshold.frag.msl"
                },
                blur: {
                    vertex_path: "./assets/shaders/fullscreen.vert.msl",
                    fragment_path: "./assets/shaders/bloom_blur.frag.msl"
                },
                godrays: {
                    vertex_path: "./assets/shaders/fullscreen.vert.msl",
                    fragment_path: "./assets/shaders/godrays.frag.msl"
                },
                composite: {
                    vertex_path: "./assets/shaders/fullscreen.vert.msl",
                    fragment_path: "./assets/shaders/composite.frag.msl"
                }
            }
        }
    }
    return {
        scene: {
            vertex_path: "./assets/shaders/scene.vert.spv",
            fragment_path: "./assets/shaders/scene.frag.spv"
        },
        floor: {
            vertex_path: "./assets/shaders/floor.vert.spv",
            fragment_path: "./assets/shaders/floor.frag.spv"
        },
        glow: {
            vertex_path: "./assets/shaders/glow.vert.spv",
            fragment_path: "./assets/shaders/glow.frag.spv"
        },
        water: {
            vertex_path: "./assets/shaders/water.vert.spv",
            fragment_path: "./assets/shaders/water.frag.spv"
        },
        shadow: {
            vertex_path: "./assets/shaders/scene.vert.spv",
            fragment_path: "./assets/shaders/shadow.frag.spv"
        },
        post_process: {
            threshold: {
                vertex_path: "./assets/shaders/fullscreen.vert.spv",
                fragment_path: "./assets/shaders/bloom_threshold.frag.spv"
            },
            blur: {
                vertex_path: "./assets/shaders/fullscreen.vert.spv",
                fragment_path: "./assets/shaders/bloom_blur.frag.spv"
            },
            godrays: {
                vertex_path: "./assets/shaders/fullscreen.vert.spv",
                fragment_path: "./assets/shaders/godrays.frag.spv"
            },
            composite: {
                vertex_path: "./assets/shaders/fullscreen.vert.spv",
                fragment_path: "./assets/shaders/composite.frag.spv"
            }
        }
    }
}
