            },
            flare: {
                vertex_path: "./assets/shaders/fullscreen.vert.spv",
                fragment_path: "./assets/shaders/flare.frag.spv"
            },
            taa: {
                vertex_path: "./assets/shaders/fullscreen.vert.spv",
