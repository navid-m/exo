pub extern (C) fn SDL_Init(flags: u32) bool = "SDL_Init"
pub extern (C) fn SDL_Quit() void = "SDL_Quit"
pub extern (C) fn SDL_GetError() ref u8 = "SDL_GetError"
pub extern (C) fn SDL_CreateWindow(
    title: ref u8,
    w: i32,
    h: i32,
    flags: u64
) ref void = "SDL_CreateWindow"
pub extern (C) fn SDL_DestroyWindow(window: ref void) void = "SDL_DestroyWindow"
pub extern (C) fn SDL_PollEvent(event: ref SDLEvent) bool = "SDL_PollEvent"
pub extern (C) fn SDL_GetTicks() u64 = "SDL_GetTicks"
pub extern (C) fn SDL_GetKeyboardState(numkeys: ref i32) ref bool = "SDL_GetKeyboardState"
pub extern (C) fn SDL_SetWindowRelativeMouseMode(
    window: ref void,
    enabled: bool
) bool = "SDL_SetWindowRelativeMouseMode"
pub extern (C) fn SDL_GetRelativeMouseState(
    x: ref f32,
    y: ref f32
) u32 = "SDL_GetRelativeMouseState"
pub extern (C) fn SDL_CreateGPUDevice(
    format_flags: u32,
    debug_mode: bool,
    name: ref u8
) ref void = "SDL_CreateGPUDevice"
pub extern (C) fn SDL_SetGPUAllowedFramesInFlight(
    device: ref void,
    allowed_frames_in_flight: u32
) bool = "SDL_SetGPUAllowedFramesInFlight"
pub extern (C) fn SDL_DestroyGPUDevice(device: ref void) void = "SDL_DestroyGPUDevice"
pub extern (C) fn SDL_ClaimWindowForGPUDevice(
    device: ref void,
    window: ref void
) bool = "SDL_ClaimWindowForGPUDevice"
pub extern (C) fn SDL_SetGPUSwapchainParameters(
    device: ref void,
    window: ref void,
    swapchain_composition: i32,
    present_mode: i32
) bool = "SDL_SetGPUSwapchainParameters"
pub extern (C) fn SDL_WindowSupportsGPUPresentMode(
    device: ref void,
    window: ref void,
    present_mode: i32
) bool = "SDL_WindowSupportsGPUPresentMode"
pub extern (C) fn SDL_ReleaseWindowFromGPUDevice(
    device: ref void,
    window: ref void
) void = "SDL_ReleaseWindowFromGPUDevice"
pub extern (C) fn SDL_GetGPUSwapchainTextureFormat(
    device: ref void,
    window: ref void
) i32 = "SDL_GetGPUSwapchainTextureFormat"
pub extern (C) fn SDL_CreateGPUSampler(
    device: ref void,
    createinfo: ref SDLGPUSamplerCreateInfo
) ref void = "SDL_CreateGPUSampler"
pub extern (C) fn SDL_CreateGPUShader(
    device: ref void,
    createinfo: ref SDLGPUShaderCreateInfo
) ref void = "SDL_CreateGPUShader"
pub extern (C) fn SDL_CreateGPUGraphicsPipeline(
    device: ref void,
    createinfo: ref SDLGPUGraphicsPipelineCreateInfo
) ref void = "SDL_CreateGPUGraphicsPipeline"
pub extern (C) fn SDL_CreateGPUTexture(
    device: ref void,
    createinfo: ref SDLGPUTextureCreateInfo
) ref void = "SDL_CreateGPUTexture"
pub extern (C) fn SDL_CreateGPUBuffer(
    device: ref void,
    createinfo: ref SDLGPUBufferCreateInfo
) ref void = "SDL_CreateGPUBuffer"
pub extern (C) fn SDL_CreateGPUTransferBuffer(
    device: ref void,
    createinfo: ref SDLGPUTransferBufferCreateInfo
) ref void = "SDL_CreateGPUTransferBuffer"
pub extern (C) fn SDL_ReleaseGPUTexture(
    device: ref void,
    texture: ref void
) void = "SDL_ReleaseGPUTexture"
pub extern (C) fn SDL_ReleaseGPUSampler(
    device: ref void,
    sampler: ref void
) void = "SDL_ReleaseGPUSampler"
pub extern (C) fn SDL_ReleaseGPUBuffer(
    device: ref void,
    buffer: ref void
) void = "SDL_ReleaseGPUBuffer"
pub extern (C) fn SDL_ReleaseGPUTransferBuffer(
    device: ref void,
    transfer_buffer: ref void
) void = "SDL_ReleaseGPUTransferBuffer"
pub extern (C) fn SDL_ReleaseGPUShader(
    device: ref void,
    shader: ref void
) void = "SDL_ReleaseGPUShader"
pub extern (C) fn SDL_ReleaseGPUGraphicsPipeline(
    device: ref void,
    graphics_pipeline: ref void
) void = "SDL_ReleaseGPUGraphicsPipeline"
pub extern (C) fn SDL_AcquireGPUCommandBuffer(device: ref void) ref void = "SDL_AcquireGPUCommandBuffer"
pub extern (C) fn SDL_PushGPUVertexUniformData(
    command_buffer: ref void,
    slot_index: u32,
    data: ref void,
    length: u32
) void = "SDL_PushGPUVertexUniformData"
pub extern (C) fn SDL_PushGPUFragmentUniformData(
    command_buffer: ref void,
    slot_index: u32,
    data: ref void,
    length: u32
) void = "SDL_PushGPUFragmentUniformData"
pub extern (C) fn SDL_BeginGPURenderPass(
    command_buffer: ref void,
    color_target_infos: ref SDLGPUColorTargetInfo,
    num_color_targets: u32,
    depth_stencil_target_info: ref SDLGPUDepthStencilTargetInfo
) ref void = "SDL_BeginGPURenderPass"
pub extern (C) fn SDL_BindGPUGraphicsPipeline(
    render_pass: ref void,
    graphics_pipeline: ref void
