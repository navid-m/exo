val math = use("std/math")

pub type Vec3 = {
    x: f32
    y: f32
    z: f32
}

pub type Mat4 = {
    m00: f32
    m01: f32
    m02: f32
    m03: f32
    m10: f32
    m11: f32
    m12: f32
    m13: f32
    m20: f32
    m21: f32
    m22: f32
    m23: f32
    m30: f32
    m31: f32
    m32: f32
    m33: f32
}


pub type F32Slot = {
    value: mut f32
}

pub type U32Slot = {
    value: mut u32
}


pub type Vec4f = {
    x: mut f32
    y: mut f32
    z: mut f32
    w: mut f32
}


pub fn read_f32(base: ref f32, index: usize) f32 = trust {
    val slot: ref F32Slot = @ptradd(
        base,
        index * (@sizeof(f32) as usize)
    ) as ref F32Slot
    return slot.value
}

pub fn transpose_mat4_ptr(src: ref f32) Mat4 = trust {
    return mat4(
        read_f32(
            src,
            0 as usize
        ), read_f32(src, 4 as usize), read_f32(src, 8 as usize), read_f32(src, 12 as usize),
        read_f32(
            src,
            1 as usize
        ), read_f32(src, 5 as usize), read_f32(src, 9 as usize), read_f32(src, 13 as usize),
        read_f32(
            src,
            2 as usize
        ), read_f32(src, 6 as usize), read_f32(src, 10 as usize), read_f32(src, 14 as usize),
        read_f32(
            src,
            3 as usize
        ), read_f32(src, 7 as usize), read_f32(src, 11 as usize), read_f32(src, 15 as usize)
    )
}

pub fn vec4_from_ptr(src: ref f32, w: f32) Vec4f = trust {
    return {
        x: read_f32(src, 0 as usize),
        y: read_f32(src, 1 as usize),
        z: read_f32(src, 2 as usize),
        w: w
    }
}


pub fn vec3(x: f32, y: f32, z: f32) Vec3 = {
    return { x: x, y: y, z: z }
}

pub fn vec3_add(a: Vec3, b: Vec3) Vec3 = {
    return vec3(a.x + b.x, a.y + b.y, a.z + b.z)
}

pub fn vec3_sub(a: Vec3, b: Vec3) Vec3 = {
    return vec3(a.x - b.x, a.y - b.y, a.z - b.z)
}

pub fn vec3_scale(v: Vec3, s: f32) Vec3 = {
    return vec3(v.x * s, v.y * s, v.z * s)
}

pub fn vec3_dot(a: Vec3, b: Vec3) f32 = {
    return a.x * b.x + a.y * b.y + a.z * b.z
}

pub fn vec3_cross(a: Vec3, b: Vec3) Vec3 = {
    return vec3(
        a.y * b.z - a.z * b.y,
        a.z * b.x - a.x * b.z,
        a.x * b.y - a.y * b.x
    )
}

pub fn vec3_length(v: Vec3) f32 = {
    return math.sqrt((vec3_dot(v, v)) as f64) as f32
}

pub fn vec3_normalize(v: Vec3) Vec3 = {
    val len: f32 = vec3_length(v)
    if len < (0.00001 as f32) {
        return vec3(0.0 as f32, 0.0 as f32, 0.0 as f32)
    }
    return vec3_scale(v, (1.0 as f32) / len)
}

pub fn mat4(
    m00: f32, m01: f32, m02: f32, m03: f32,
    m10: f32, m11: f32, m12: f32, m13: f32,
    m20: f32, m21: f32, m22: f32, m23: f32,
    m30: f32, m31: f32, m32: f32, m33: f32
) Mat4 = {
    return {
        m00: m00, m01: m01, m02: m02, m03: m03,
        m10: m10, m11: m11, m12: m12, m13: m13,
        m20: m20, m21: m21, m22: m22, m23: m23,
        m30: m30, m31: m31, m32: m32, m33: m33
    }
}

pub fn mat_mul(a: Mat4, b: Mat4) Mat4 = {
    val r00: f32 = a.m00 * b.m00 + a.m01 * b.m10 + a.m02 * b.m20 + a.m03 * b.m30
    val r01: f32 = a.m00 * b.m01 + a.m01 * b.m11 + a.m02 * b.m21 + a.m03 * b.m31
    val r02: f32 = a.m00 * b.m02 + a.m01 * b.m12 + a.m02 * b.m22 + a.m03 * b.m32
    val r03: f32 = a.m00 * b.m03 + a.m01 * b.m13 + a.m02 * b.m23 + a.m03 * b.m33
    val r10: f32 = a.m10 * b.m00 + a.m11 * b.m10 + a.m12 * b.m20 + a.m13 * b.m30
    val r11: f32 = a.m10 * b.m01 + a.m11 * b.m11 + a.m12 * b.m21 + a.m13 * b.m31
    val r12: f32 = a.m10 * b.m02 + a.m11 * b.m12 + a.m12 * b.m22 + a.m13 * b.m32
    val r13: f32 = a.m10 * b.m03 + a.m11 * b.m13 + a.m12 * b.m23 + a.m13 * b.m33
    val r20: f32 = a.m20 * b.m00 + a.m21 * b.m10 + a.m22 * b.m20 + a.m23 * b.m30
    val r21: f32 = a.m20 * b.m01 + a.m21 * b.m11 + a.m22 * b.m21 + a.m23 * b.m31
    val r22: f32 = a.m20 * b.m02 + a.m21 * b.m12 + a.m22 * b.m22 + a.m23 * b.m32
    val r23: f32 = a.m20 * b.m03 + a.m21 * b.m13 + a.m22 * b.m23 + a.m23 * b.m33
    val r30: f32 = a.m30 * b.m00 + a.m31 * b.m10 + a.m32 * b.m20 + a.m33 * b.m30
    val r31: f32 = a.m30 * b.m01 + a.m31 * b.m11 + a.m32 * b.m21 + a.m33 * b.m31
    val r32: f32 = a.m30 * b.m02 + a.m31 * b.m12 + a.m32 * b.m22 + a.m33 * b.m32
    val r33: f32 = a.m30 * b.m03 + a.m31 * b.m13 + a.m32 * b.m23 + a.m33 * b.m33
    return mat4(
        r00, r01, r02, r03,
        r10, r11, r12, r13,
        r20, r21, r22, r23,
        r30, r31, r32, r33
    )
}

pub fn mat_translation(offset: Vec3) Mat4 = {
    return mat4(
        1.0 as f32, 0.0 as f32, 0.0 as f32, offset.x,
        0.0 as f32, 1.0 as f32, 0.0 as f32, offset.y,
        0.0 as f32, 0.0 as f32, 1.0 as f32, offset.z,
        0.0 as f32, 0.0 as f32, 0.0 as f32, 1.0 as f32
    )
}

pub fn mat_scale(scale: Vec3) Mat4 = {
    return mat4(
        scale.x, 0.0 as f32, 0.0 as f32, 0.0 as f32,
        0.0 as f32, scale.y, 0.0 as f32, 0.0 as f32,
        0.0 as f32, 0.0 as f32, scale.z, 0.0 as f32,
        0.0 as f32, 0.0 as f32, 0.0 as f32, 1.0 as f32
    )
}

pub fn mat_rotation_y(angle: f32) Mat4 = {
    val c: f32 = math.cos(angle as f64) as f32
    val s: f32 = math.sin(angle as f64) as f32
    return mat4(
        c, 0.0 as f32, s, 0.0 as f32,
        0.0 as f32, 1.0 as f32, 0.0 as f32, 0.0 as f32,
        -s, 0.0 as f32, c, 0.0 as f32,
        0.0 as f32, 0.0 as f32, 0.0 as f32, 1.0 as f32
    )
}

pub fn mat_rotation_x(angle: f32) Mat4 = {
    val c: f32 = math.cos(angle as f64) as f32
    val s: f32 = math.sin(angle as f64) as f32
    return mat4(
        1.0 as f32, 0.0 as f32, 0.0 as f32, 0.0 as f32,
        0.0 as f32, c, -s, 0.0 as f32,
        0.0 as f32, s, c, 0.0 as f32,
        0.0 as f32, 0.0 as f32, 0.0 as f32, 1.0 as f32
    )
}

pub fn mat_rotation_z(angle: f32) Mat4 = {
    val c: f32 = math.cos(angle as f64) as f32
    val s: f32 = math.sin(angle as f64) as f32
    return mat4(
        c, -s, 0.0 as f32, 0.0 as f32,
        s, c, 0.0 as f32, 0.0 as f32,
        0.0 as f32, 0.0 as f32, 1.0 as f32, 0.0 as f32,
        0.0 as f32, 0.0 as f32, 0.0 as f32, 1.0 as f32
    )
}

pub fn quat(x: f32, y: f32, z: f32, w: f32) Vec4f = {
    return { x: x, y: y, z: z, w: w }
}

pub fn quat_normalize(q: Vec4f) Vec4f = {
    val len: f32 = math.sqrt((q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w) as f64) as f32
    if len < (0.000001 as f32) {
        return quat(0.0 as f32, 0.0 as f32, 0.0 as f32, 1.0 as f32)
    }
    val inv: f32 = (1.0 as f32) / len
    return quat(q.x * inv, q.y * inv, q.z * inv, q.w * inv)
}

pub fn quat_slerp(a: Vec4f, b: Vec4f, t: f32) Vec4f = {
    val av: Vec4f = quat_normalize(a)
    val bv0: Vec4f = quat_normalize(b)
    val dot: f32 = av.x * bv0.x + av.y * bv0.y + av.z * bv0.z + av.w * bv0.w
    val sign: mut f32 = 1.0 as f32
    if dot < (0.0 as f32) {
        sign = -1.0 as f32
    }
    val bv: Vec4f = quat(bv0.x * sign, bv0.y * sign, bv0.z * sign, bv0.w * sign)
    val d: f32 = dot * sign
    if d > (0.9995 as f32) {
        return quat_normalize(quat(
                av.x + (bv.x - av.x) * t,
                av.y + (bv.y - av.y) * t,
                av.z + (bv.z - av.z) * t,
                av.w + (bv.w - av.w) * t
            ))
    }
    val theta: f64 = math.acos(d as f64)
    val st: f32 = math.sin(theta) as f32
    val wa: f32 = (math.sin((1.0 - (t as f64)) * theta) as f32) / st
    val wb: f32 = (math.sin((t as f64) * theta) as f32) / st
    return quat(
        av.x * wa + bv.x * wb,
        av.y * wa + bv.y * wb,
        av.z * wa + bv.z * wb,
        av.w * wa + bv.w * wb
    )
}

pub fn mat_from_quat(q: Vec4f) Mat4 = {
    val n: Vec4f = quat_normalize(q)
    val x: f32 = n.x
    val y: f32 = n.y
    val z: f32 = n.z
    val w: f32 = n.w
    return mat4(
        1.0 as f32 - (2.0 as f32) * (y * y + z * z), (2.0 as f32) * (x * y - z * w), (2.0 as f32) * (x * z + y * w), 0.0 as f32,
        (2.0 as f32) * (x * y + z * w), 1.0 as f32 - (2.0 as f32) * (x * x + z * z), (2.0 as f32) * (y * z - x * w), 0.0 as f32,
        (2.0 as f32) * (x * z - y * w), (2.0 as f32) * (y * z + x * w), 1.0 as f32 - (2.0 as f32) * (x * x + y * y), 0.0 as f32,
        0.0 as f32, 0.0 as f32, 0.0 as f32, 1.0 as f32
    )
}

pub fn mat_from_trs(translation: Vec3, rotation: Vec4f, scale: Vec3) Mat4 = {
    return mat_mul(mat_translation(translation), mat_mul(mat_from_quat(rotation), mat_scale(scale)))
}

pub fn mat_transform_point(m: Mat4, v: Vec3) Vec3 = {
    return vec3(
        m.m00 * v.x + m.m01 * v.y + m.m02 * v.z + m.m03,
        m.m10 * v.x + m.m11 * v.y + m.m12 * v.z + m.m13,
        m.m20 * v.x + m.m21 * v.y + m.m22 * v.z + m.m23
    )
}

pub fn mat_transform_direction(m: Mat4, v: Vec3) Vec3 = {
    return vec3(
        m.m00 * v.x + m.m01 * v.y + m.m02 * v.z,
        m.m10 * v.x + m.m11 * v.y + m.m12 * v.z,
        m.m20 * v.x + m.m21 * v.y + m.m22 * v.z
    )
}

pub fn mat4_identity() Mat4 = {
    return mat4(
        1.0 as f32, 0.0 as f32, 0.0 as f32, 0.0 as f32,
        0.0 as f32, 1.0 as f32, 0.0 as f32, 0.0 as f32,
        0.0 as f32, 0.0 as f32, 1.0 as f32, 0.0 as f32,
        0.0 as f32, 0.0 as f32, 0.0 as f32, 1.0 as f32
    )
}

pub fn mat_perspective(fov_y: f32, aspect: f32, near_z: f32, far_z: f32) Mat4 = {
    val f: f32 = (1.0 as f32) / (math.tan(((fov_y as f64) * 0.5)) as f32)
    val nf: f32 = (1.0 as f32) / (near_z - far_z)
    return mat4(
        f / aspect, 0.0 as f32, 0.0 as f32, 0.0 as f32,
        0.0 as f32, f, 0.0 as f32, 0.0 as f32,
        0.0 as f32, 0.0 as f32, far_z * nf, far_z * near_z * nf,
        0.0 as f32, 0.0 as f32, -1.0 as f32, 0.0 as f32
    )
}

/// Right-handed orthographic projection that maps view-space `-near_z` to 0
/// and `-far_z` to 1, matching the engine's perspective depth convention.
pub fn mat_orthographic(
    left: f32,
    right: f32,
    bottom: f32,
    top: f32,
    near_z: f32,
    far_z: f32
) Mat4 = {
    val rl: f32 = right - left
    val tb: f32 = top - bottom
    val depth_span: f32 = far_z - near_z
    return mat4(
        (2.0 as f32) / rl, 0.0 as f32, 0.0 as f32, (0.0 as f32) - (right + left) / rl,
        0.0 as f32, (2.0 as f32) / tb, 0.0 as f32, (0.0 as f32) - (top + bottom) / tb,
        0.0 as f32, 0.0 as f32, (0.0 as f32) - (1.0 as f32) / depth_span, (0.0 as f32) - near_z / depth_span,
        0.0 as f32, 0.0 as f32, 0.0 as f32, 1.0 as f32
    )
}

pub fn mat_look_at(eye: Vec3, center: Vec3, up_hint: Vec3) Mat4 = {
    val forward: Vec3 = vec3_normalize(vec3_sub(center, eye))
    val side: Vec3 = vec3_normalize(vec3_cross(forward, up_hint))
    val up: Vec3 = vec3_cross(side, forward)
    return mat4(
        side.x, side.y, side.z, -vec3_dot(side, eye),
        up.x, up.y, up.z, -vec3_dot(up, eye),
        -forward.x, -forward.y, -forward.z, vec3_dot(forward, eye),
        0.0 as f32, 0.0 as f32, 0.0 as f32, 1.0 as f32
    )
}

pub fn store_f32(base: ref void, index: usize, value: f32) void = trust {
    val slot: mut ref F32Slot = @ptradd(base, index * (@sizeof(f32) as usize)) as mut ref F32Slot
    slot.value = value
}

pub fn store_u32(base: ref void, index: usize, value: u32) void = trust {
    val slot: mut ref U32Slot = @ptradd(base, index * (@sizeof(u32) as usize)) as mut ref U32Slot
    slot.value = value
}


pub fn model_matrix_scaled(position: Vec3, scale: Vec3, rotation_y: f32) Mat4 = {
    return mat_mul(mat_translation(position), mat_mul(mat_rotation_y(rotation_y), mat_scale(scale)))
}

pub fn model_matrix(position: Vec3, uniform_scale: f32, rotation_y: f32) Mat4 = {
    return model_matrix_scaled(
        position,
        vec3(uniform_scale, uniform_scale, uniform_scale),
        rotation_y
    )
}

pub fn sin(x: f64) f64 = {
    return math.sin(x)
}

pub fn cos(x: f64) f64 = {
    return math.cos(x)
}

pub fn tan(x: f64) f64 = {
    return math.tan(x)
}

pub fn acos(x: f64) f64 = {
    return math.acos(x)
}

pub fn sqrt(x: f64) f64 = {
    return math.sqrt(x)
}

pub fn fabs(x: f64) f64 = {
    return math.fabs(x)
}

pub fn floor(x: f64) f64 = {
    return math.floor(x)
}

pub fn fclamp(x: f64, lo: f64, hi: f64) f64 = {
    return math.fclamp(x, lo, hi)
}

pub fn reflect_position_y(position: Vec3, plane_y: f32) Vec3 = {
    return vec3(position.x, ((2.0 as f32) * plane_y) - position.y, position.z)
}
