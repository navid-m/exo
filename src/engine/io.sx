val sdl      = use("sdl.sx")
val string   = use("std/string")
val exoerr   = use("error.sx")
val embedded = use("../embedded.sx")

pub type BinaryBlob = {
    data: mut ref u8
    len: mut usize
}

/// Resolve relative asset paths against the current directory and a small
/// number of parent directories. This lets an executable run from a nested
/// directory (for example ./examples) while still finding ./assets.
pub fn resolve_path(path: ref u8) ref u8 = trust {
    if path == none {
        return path
    }
    val probe: ref void = sdl.fopen(path, "rb")
    if probe != none {
        sdl.fclose(probe)
        return path
    }
    if string.len_raw(path) == 0 || @load8(path) == (47 as u8) {
        return path
    }
    val name: mut ref u8 = path
    if string.len_raw(path) > 2 && @load8(path) == (46 as u8) && @load8(@ptradd(
            path,
            1
        )) == (47 as u8) {
        name = @ptradd(path, 2) as ref u8
    }
    val prefix: mut ref u8 = "."
    val depth: mut i32 = 0 as i32
    for depth < (4 as i32) {
        val candidate: ref u8 = @fmtalloc("{s}/{s}", {prefix, name})
        val candidate_file: ref void = sdl.fopen(candidate, "rb")
        if candidate_file != none {
            sdl.fclose(candidate_file)
            return candidate
        }
        prefix = @fmtalloc("{s}/..", {prefix})
        depth += (1 as i32)
    }
    return path
}

pub fn load_binary_file(path: ref u8) option[BinaryBlob] = trust {
    val resolved: ref u8 = resolve_path(path)
    val file: ref void = sdl.fopen(resolved, "rb")
    if file == none {
        if embedded.find(path) is some asset {
            val buf: ref u8 = @alloc(asset.len) as ref u8
            if buf != none {
                @memcpy(buf, asset.data as ref void, asset.len)
                return some {
                    data: buf,
                    len: asset.len
                }
            }
        }
        exoerr.set(path)
        return none
    }
    sdl.fseek(file, 0, 2 as i32)
    val size: i64 = sdl.ftell(file)
    sdl.rewind(file)
    if size <= 0 {
        sdl.fclose(file)
        exoerr.set("failed to read file")
        return none
    }
    val buf: ref u8 = @alloc(size as usize) as ref u8
    if buf == none {
        sdl.fclose(file)
        exoerr.set("failed to allocate file buffer")
        return none
    }
    val read_count: usize = sdl.fread(buf, 1 as usize, size as usize, file)
    sdl.fclose(file)
    if read_count != size as usize {
        @free(buf)
        exoerr.set("failed to read file")
        return none
    }
    return some {
        data: buf,
        len: size as usize
    }
}
