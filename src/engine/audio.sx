val sdl      = use("sdl.sx")
val io       = use("io.sx")
val string   = use("std/string")
val exoerr   = use("error.sx")
val embedded = use("../embedded.sx")
val mem      = use("../mem.sx")

pub type AudioClip = {
    path: ref u8
    loops: i32
    volume: i32
}

pub type AudioBankConfig = {
    master_volume: i32
    clips: list[AudioClip]
}

pub type RuntimeAudioClip = {
    loaded: bool
    audio: ref void
    loops: i32
    volume: i32
}

pub type RuntimeAudioBank = {
    initialized: mut bool
    clips: mut list[RuntimeAudioClip]
}

pub type ExoSDL3Audio = {
    stream: mut ref void
    speci: mut sdl.SDLAudioSpec
    buffer: mut ref u8
    length: mut u32
    /// Non-null when the PCM buffer is owned by the MP3 decoder shim.
    mp3: mut ref void
}

fn lower_ascii(value: u8) u8 = {
    if value >= (65 as u8) && value <= (90 as u8) {
        return value + (32 as u8)
    }
    return value
}

fn is_mp3_path(path: ref u8) bool = trust {
    val length: usize = string.len_raw(path)
    if length < (4 as usize) {
        return false
    }
    val suffix: ref u8 = @ptradd(path, length - (4 as usize)) as ref u8
    return @load8(suffix) == (46 as u8)
    && lower_ascii(@load8(@ptradd(suffix, 1 as usize))) == (109 as u8)
    && lower_ascii(@load8(@ptradd(suffix, 2 as usize))) == (112 as u8)
    && lower_ascii(@load8(@ptradd(suffix, 3 as usize))) == (51 as u8)
}

fn load_mp3(audio: mut ref ExoSDL3Audio, path: ref u8) bool = trust {
    if io.load_binary_file(path) is some blob {
        val handle: ref void = sdl.exo_mp3_load(blob.data as ref void, blob.len)
        @free(blob.data as ref void)
        if handle != none {
            audio.mp3 = handle
            audio.buffer = sdl.exo_mp3_pcm(handle) as ref u8
            audio.length = sdl.exo_mp3_pcm_len(handle) as u32
            audio.speci.format = sdl.SDL_AUDIO_S16
            audio.speci.channels = sdl.exo_mp3_channels(handle)
            audio.speci.freq = sdl.exo_mp3_sample_rate(handle)
            return audio.buffer != none && audio.length > (0 as u32)
        }
    }
    return false
}

pub fn create_audio(wav_path: ref u8, volume: i32) ref void = trust {
    exoerr.clear()
    if wav_path == none || string.len_raw(wav_path) == (0 as usize) {
        return exoerr.set_ptr("audio path is empty")
    }
    val audio: mut ref ExoSDL3Audio = @alloc(@sizeof(ExoSDL3Audio)) as mut ref ExoSDL3Audio
    if audio == none {
        return exoerr.set_ptr("failed to allocate audio")
    }
    @memset(audio, 0, @sizeof(ExoSDL3Audio))
    val loaded: mut bool = false
    if is_mp3_path(wav_path) {
        loaded = load_mp3(audio, wav_path)
    } else {
        if embedded.find(wav_path) is some asset {
            val stream: ref void = sdl.SDL_IOFromMem(asset.data as ref void, asset.len)
            if stream != none {
                loaded = sdl.SDL_LoadWAV_IO(
                    stream,
                    true,
                    @addr(audio.speci),
                    @addr(audio.buffer),
                    @addr(audio.length)
                )
            }
        } else {
            val resolved_path: ref u8 = io.resolve_path(wav_path)
            loaded = sdl.SDL_LoadWAV(
                resolved_path,
                @addr(audio.speci),
                @addr(audio.buffer),
                @addr(audio.length)
            )
            if !loaded {
                loaded = load_mp3(audio, wav_path)
            }
        }
    }
    if !loaded {
        destroy_audio(audio)
        return none as ref void
    }
    audio.stream = sdl.SDL_OpenAudioDeviceStream(
        sdl.SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK,
        @addr(audio.speci),
        none as ref void,
        none as ref void
    )
    if audio.stream == none {
        destroy_audio(audio)
        return none as ref void
    }
    sdl.SDL_SetAudioStreamGain(audio.stream, (volume as f32) / (128.0 as f32))
    if !sdl.SDL_ResumeAudioStreamDevice(audio.stream) {
        destroy_audio(audio)
        return none as ref void
    }
    return audio
}

pub fn destroy_audio(audio_raw: ref void) void = trust {
    if audio_raw == none {
        return
    }
    val audio: ref ExoSDL3Audio = audio_raw as ref ExoSDL3Audio
    if audio.stream != none {
        sdl.SDL_DestroyAudioStream(audio.stream)
    }
    if audio.mp3 != none {
        sdl.exo_mp3_destroy(audio.mp3)
    } elif audio.buffer != none {
        sdl.SDL_free(audio.buffer as ref void)
    }
    @free(audio_raw)
}

pub fn play_audio(audio_raw: ref void, loops: i32, volume: i32) bool = trust {
    exoerr.clear()
    if audio_raw == none {
        return exoerr.set("audio unavailable")
    }
    val audio: ref ExoSDL3Audio = audio_raw as ref ExoSDL3Audio
    if audio.stream == none || audio.buffer == none || audio.length == (0 as u32) {
        return exoerr.set("audio unavailable")
    }
    val play_loops: mut i32 = loops
    if play_loops < (0 as i32) {
        play_loops = 0 as i32
    }
    if !sdl.SDL_ClearAudioStream(audio.stream) {
        return false
    }
    sdl.SDL_SetAudioStreamGain(audio.stream, (volume as f32) / (128.0 as f32))
    val repeats: mut i32 = 0 as i32
    for {
        if repeats > play_loops {
            break
        }
        if !sdl.SDL_PutAudioStreamData(
            audio.stream,
            audio.buffer as ref void,
            audio.length as i32
        ) {
            return false
        }
        repeats = repeats + (1 as i32)
    }
    return sdl.SDL_FlushAudioStream(audio.stream)
}

pub fn default_audio_mixer() AudioBankConfig = {
    return {
        master_volume: 96 as i32,
        clips: mem.persistent[AudioClip]()
    }
}

pub fn make_clip(path: ref u8, loops: i32, volume: i32) AudioClip = {
    return {
        path: path,
        loops: loops,
        volume: volume
    }
}

pub fn add_clip(config: mut AudioBankConfig, clip: AudioClip) void = {
    @append(config.clips, clip)
}

pub fn audio_enabled(config: AudioBankConfig) bool = {
    for clip in config.clips {
        if clip.path != none && string.len_raw(clip.path) > (0 as usize) {
            return true
        }
    }
    return false
}

pub fn init_runtime_audio(config: AudioBankConfig) RuntimeAudioBank = trust {
    val runtime: mut RuntimeAudioBank = {
        initialized: false,
        clips: mem.persistent[RuntimeAudioClip]()
    }
    val loaded_count: mut i32 = 0 as i32
    for clip in config.clips {
        val volume: mut i32 = clip.volume
        if volume <= (0 as i32) {
            volume = config.master_volume
        }
        val audio: ref void = create_audio(clip.path, volume)
        @append(runtime.clips, {
                loaded: audio != none,
                audio: audio,
                loops: clip.loops,
                volume: volume
            })
        if audio != none {
            loaded_count = loaded_count + (1 as i32)
        }
    }
    runtime.initialized = loaded_count > (0 as i32)
    return runtime
}

pub fn shutdown_runtime_audio(runtime: RuntimeAudioBank) void = trust {
    for clip in runtime.clips {
        if clip.audio != none {
            destroy_audio(clip.audio)
        }
    }
}

pub fn play_runtime_clip(
    config: AudioBankConfig,
    runtime: RuntimeAudioBank,
    index: usize
) bool = trust {
    if @get(runtime.clips, index) is some clip {
        if clip.loaded && clip.audio != none {
            val volume: mut i32 = clip.volume
            if volume <= (0 as i32) {
                volume = config.master_volume
            }
            return play_audio(clip.audio, clip.loops, volume)
        }
    }
    return false
}

pub fn play_runtime_audio(config: AudioBankConfig, runtime: RuntimeAudioBank) bool = trust {
    return play_runtime_clip(config, runtime, 0 as usize)
}

pub fn stop_runtime_audio(runtime: RuntimeAudioBank) void = trust {
    for clip in runtime.clips {
        if clip.audio != none {
            val audio: ref ExoSDL3Audio = clip.audio as ref ExoSDL3Audio
            if audio.stream != none {
                sdl.SDL_ClearAudioStream(audio.stream)
                sdl.SDL_FlushAudioStream(audio.stream)
            }
        }
    }
}
