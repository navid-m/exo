val math  = use("math.sx")
val input = use("input.sx")
val PI: f64 = 3.14159265358979323846

pub type Camera = {
    position: mut math.Vec3
    yaw: mut f32
    pitch: mut f32
    move_speed: f32
    turn_speed: f32
}


pub fn default_camera() Camera = {
    return {
        position: math.vec3(0.0 as f32, 2.6 as f32, 8.5 as f32),
        yaw: PI as f32,
        pitch: -0.20 as f32,
        move_speed: 4.8 as f32,
        turn_speed: 1.9 as f32
    }
}


pub fn camera_forward(camera: Camera) math.Vec3 = {
    val yaw_f64: f64 = camera.yaw as f64
    val pitch_f64: f64 = camera.pitch as f64
    val cp: f32 = (math.cos(pitch_f64)) as f32
    return math.vec3(
        (math.sin(yaw_f64) as f32) * cp,
        (math.sin(pitch_f64) as f32),
        (math.cos(yaw_f64) as f32) * cp
    )
}


pub fn update_camera(
    camera: mut Camera,
    cfg: input.InputConfig,
    dt: f32,
    keys: ref u8,
    mouse_dx: f32,
    mouse_dy: f32
) void = trust {
    val yaw_step: f32 = camera.turn_speed * dt
    val move_step: f32 = camera.move_speed * dt
    val key_fwd: u8 = input.safe_key(keys, cfg.keys.move_forward)
    val key_back: u8 = input.safe_key(keys, cfg.keys.move_back)
    val key_left: u8 = input.safe_key(keys, cfg.keys.move_left)
    val key_right: u8 = input.safe_key(keys, cfg.keys.move_right)
    val key_tleft: u8 = input.safe_key(keys, cfg.keys.turn_left)
    val key_tright: u8 = input.safe_key(keys, cfg.keys.turn_right)
    val key_up: u8 = input.safe_key(keys, cfg.keys.look_up)
    val key_down: u8 = input.safe_key(keys, cfg.keys.look_down)
    val key_move_up: u8 = input.safe_key(keys, cfg.keys.move_up)
    val key_move_down: u8 = input.safe_key(keys, cfg.keys.move_down)
    if key_tleft != 0 {
        camera.yaw = camera.yaw + yaw_step
    }
    if key_tright != 0 {
        camera.yaw = camera.yaw - yaw_step
    }
    if key_up != 0 {
        camera.pitch = camera.pitch + yaw_step * (0.70 as f32)
    }
    if key_down != 0 {
        camera.pitch = camera.pitch - yaw_step * (0.70 as f32)
    }
    if cfg.mouse.enabled {
        camera.yaw = camera.yaw - mouse_dx * cfg.mouse.sensitivity_x
        if cfg.mouse.invert_y {
            camera.pitch = camera.pitch + mouse_dy * cfg.mouse.sensitivity_y
        } else {
            camera.pitch = camera.pitch - mouse_dy * cfg.mouse.sensitivity_y
        }
    }
    if camera.pitch > (1.2 as f32) {
        camera.pitch = 1.2 as f32
    }
    if camera.pitch < (-1.2 as f32) {
        camera.pitch = -1.2 as f32
    }
    val forward: math.Vec3 = camera_forward(camera)
    val flat_fwd: math.Vec3 = math.vec3_normalize(math.vec3(forward.x, 0.0 as f32, forward.z))
    val right_v: math.Vec3 = math.vec3_normalize(math.vec3(-flat_fwd.z, 0.0 as f32, flat_fwd.x))
    if key_fwd != 0 {
        camera.position = math.vec3_add(camera.position, math.vec3_scale(flat_fwd, move_step))
    }
    if key_back != 0 {
        camera.position = math.vec3_sub(camera.position, math.vec3_scale(flat_fwd, move_step))
    }
    if key_left != 0 {
        camera.position = math.vec3_sub(camera.position, math.vec3_scale(right_v, move_step))
    }
    if key_right != 0 {
        camera.position = math.vec3_add(camera.position, math.vec3_scale(right_v, move_step))
    }
    if key_move_up != 0 {
        camera.position = math.vec3_add(
            camera.position,
            math.vec3(0.0 as f32, move_step, 0.0 as f32)
        )
    }
    if key_move_down != 0 {
        camera.position = math.vec3_sub(
            camera.position,
            math.vec3(0.0 as f32, move_step, 0.0 as f32)
        )
    }
}


pub fn mirrored_camera(camera: Camera, plane_y: f32) Camera = {
    return {
        position: math.reflect_position_y(camera.position, plane_y),
        yaw: camera.yaw,
        pitch: -camera.pitch,
        move_speed: camera.move_speed,
        turn_speed: camera.turn_speed
    }
}

pub fn view_projection(camera: Camera, width: i32, height: i32) math.Mat4 = {
    val aspect: f32 = (width as f32) / (height as f32)
    val projection: math.Mat4 = math.mat_perspective(
        (60.0 as f32) * ((PI as f32) / (180.0 as f32)),
        aspect,
        0.1 as f32,
        100.0 as f32
    )
    val center: math.Vec3 = math.vec3_add(camera.position, camera_forward(camera))
    val view: math.Mat4 = math.mat_look_at(
        camera.position,
        center,
        math.vec3(0.0 as f32, 1.0 as f32, 0.0 as f32)
    )
    return math.mat_mul(projection, view)
}
