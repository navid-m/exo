val ecs       = use("ecs.sx")
val engine    = use("engine.sx")
val rendering = use("rendering.sx")
val sdl       = use("engine/sdl.sx")
val input     = use("engine/input.sx")
val audio     = use("engine/audio.sx")
val math      = use("std/math")

val ORB_COUNT: i32 = 9
val COLLECT_RADIUS: f32 = 1.10

// Crystal Run is a small self-contained game. It only talks to the engine
// through the public ExoApp/AppEvents API: no engine file knows about this
// game, its keys, its goal, or its sound cues.
type (engine.AppEvents) CrystalRun = {
    orb_home: mut list[ecs.SphereEntity]
    collected: mut i32
    won: mut bool
    pulse: mut f32
}

fn make_orb(x: f32, y: f32, z: f32, radius: f32, r: f32, g: f32, b: f32) ecs.SphereEntity = {
    return ecs.make_sphere(
        ecs.make_vec3(x, y, z),
        ecs.make_vec3(r, g, b),
        radius
    )
}

fn build_orbs() list[ecs.SphereEntity] = {
    val orbs: mut list[ecs.SphereEntity] = []
    @append(orbs, make_orb(-5.0 as f32, 0.9 as f32, 4.0 as f32, 0.38 as f32, 0.20 as f32, 0.95 as f32, 1.00 as f32))
    @append(orbs, make_orb(-3.4 as f32, 1.5 as f32, 1.6 as f32, 0.34 as f32, 0.30 as f32, 0.65 as f32, 1.00 as f32))
    @append(orbs, make_orb(-1.7 as f32, 2.4 as f32, -0.4 as f32, 0.40 as f32, 0.85 as f32, 0.40 as f32, 1.00 as f32))
    @append(orbs, make_orb(0.2 as f32, 1.3 as f32, -2.0 as f32, 0.36 as f32, 0.25 as f32, 1.00 as f32, 0.55 as f32))
    @append(orbs, make_orb(2.2 as f32, 2.8 as f32, -1.0 as f32, 0.32 as f32, 1.00 as f32, 0.55 as f32, 0.20 as f32))
    @append(orbs, make_orb(4.0 as f32, 1.7 as f32, 0.6 as f32, 0.38 as f32, 1.00 as f32, 0.25 as f32, 0.45 as f32))
    @append(orbs, make_orb(4.8 as f32, 0.8 as f32, 3.4 as f32, 0.34 as f32, 1.00 as f32, 0.92 as f32, 0.30 as f32))
    @append(orbs, make_orb(2.4 as f32, 2.2 as f32, 5.0 as f32, 0.36 as f32, 0.45 as f32, 1.00 as f32, 0.95 as f32))
    @append(orbs, make_orb(0.0 as f32, 3.5 as f32, 2.8 as f32, 0.44 as f32, 1.00 as f32, 1.00 as f32, 1.00 as f32))
    return orbs
}

fn build_scene() ecs.Scene3D = {
    val scene: mut ecs.Scene3D = ecs.new_scene(
        ecs.make_light(
            ecs.make_vec3(0.0 as f32, 7.5 as f32, 2.0 as f32),
            ecs.make_vec3(0.70 as f32, 0.88 as f32, 1.00 as f32),
            2.3 as f32,
            22.0 as f32
        )
    )
    scene.gravity = 0.0 as f32
    scene.water = some ecs.make_water(
        -1.35 as f32,
        0.0 as f32,
        0.0 as f32,
        16.0 as f32,
        18.0 as f32,
        ecs.make_vec3(0.06 as f32, 0.32 as f32, 0.58 as f32),
        1.15 as f32,
        0.030 as f32,
        2.6 as f32,
        0.40 as f32
    )

    @append(scene.cubes, ecs.make_cube(ecs.make_vec3(-6.6 as f32, -0.30 as f32, -4.4 as f32), ecs.make_vec3(0.10 as f32, 0.22 as f32, 0.38 as f32), 1.9 as f32, 0.12 as f32))
    @append(scene.cubes, ecs.make_cube(ecs.make_vec3(-6.5 as f32, -0.35 as f32, 3.8 as f32), ecs.make_vec3(0.12 as f32, 0.28 as f32, 0.44 as f32), 1.7 as f32, -0.18 as f32))
    @append(scene.cubes, ecs.make_cube(ecs.make_vec3(6.6 as f32, -0.30 as f32, -4.0 as f32), ecs.make_vec3(0.10 as f32, 0.24 as f32, 0.40 as f32), 2.0 as f32, 0.20 as f32))
    @append(scene.cubes, ecs.make_cube(ecs.make_vec3(6.4 as f32, -0.35 as f32, 3.6 as f32), ecs.make_vec3(0.12 as f32, 0.26 as f32, 0.42 as f32), 1.8 as f32, -0.10 as f32))
    @append(scene.cubes, ecs.make_cube(ecs.make_vec3(-3.8 as f32, -1.10 as f32, -6.8 as f32), ecs.make_vec3(0.08 as f32, 0.18 as f32, 0.30 as f32), 2.2 as f32, 0.06 as f32))
    @append(scene.cubes, ecs.make_cube(ecs.make_vec3(3.8 as f32, -1.10 as f32, -6.8 as f32), ecs.make_vec3(0.08 as f32, 0.18 as f32, 0.30 as f32), 2.2 as f32, -0.06 as f32))

    @append(scene.cubes, ecs.make_cube(ecs.make_vec3(-3.0 as f32, 2.6 as f32, 3.4 as f32), ecs.make_vec3(0.55 as f32, 0.82 as f32, 1.00 as f32), 0.52 as f32, 0.75 as f32))
    @append(scene.cubes, ecs.make_cube(ecs.make_vec3(-0.8 as f32, 3.9 as f32, 0.8 as f32), ecs.make_vec3(1.00 as f32, 0.78 as f32, 0.35 as f32), 0.44 as f32, -1.10 as f32))
    @append(scene.cubes, ecs.make_cube(ecs.make_vec3(1.4 as f32, 0.2 as f32, 3.2 as f32), ecs.make_vec3(0.35 as f32, 1.00 as f32, 0.78 as f32), 0.62 as f32, 0.92 as f32))
    @append(scene.cubes, ecs.make_cube(ecs.make_vec3(3.2 as f32, 3.8 as f32, -2.6 as f32), ecs.make_vec3(0.95 as f32, 0.45 as f32, 1.00 as f32), 0.48 as f32, -0.62 as f32))
    @append(scene.cubes, ecs.make_cube(ecs.make_vec3(0.4 as f32, 4.6 as f32, -4.2 as f32), ecs.make_vec3(1.00 as f32, 0.92 as f32, 0.45 as f32), 0.40 as f32, 1.35 as f32))
    @append(scene.cubes, ecs.make_cube(ecs.make_vec3(-4.6 as f32, 4.2 as f32, -1.8 as f32), ecs.make_vec3(0.45 as f32, 0.95 as f32, 1.00 as f32), 0.56 as f32, 0.48 as f32))

    scene.spheres = build_orbs()
    return scene
}

fn place_player(app: mut engine.ExoApp) void = {
    app.camera.position = ecs.make_vec3(0.0 as f32, 2.4 as f32, 10.5 as f32)
    app.camera.yaw = 3.14159265 as f32
    app.camera.pitch = -0.08 as f32
}

fn reset_game(game: mut CrystalRun, app: mut engine.ExoApp) void = {
    game.orb_home = build_orbs()
    game.collected = 0 as i32
    game.won = false
    game.pulse = 0.0 as f32
    app.scene.spheres = build_orbs()
    place_player(app)
    trust engine.play_sound(app)
    trust @print("Crystal Run: collect all {d} crystals. R resets, F pulses.\n", {ORB_COUNT})
}

pub fn (CrystalRun) on_start(game: mut self, app: mut engine.ExoApp) void = {
    game.orb_home = build_orbs()
    game.collected = 0 as i32
    game.won = false
    game.pulse = 0.0 as f32
    app.scene.spheres = build_orbs()
    place_player(app)
    trust @print("Crystal Run: collect all {d} crystals. R resets, F pulses.\n", {ORB_COUNT})
}

pub fn (CrystalRun) on_update(game: mut self, app: mut engine.ExoApp, dt: f32, time: f32) void = {
    if game.pulse > (0.0 as f32) {
        game.pulse = game.pulse - dt * (2.4 as f32)
    }
    val glow: f32 = (1.0 as f32) + game.pulse * (1.8 as f32)
    val animated: mut list[ecs.SphereEntity] = []
    val hit_index: mut i32 = -1 as i32
    val index: mut i32 = 0 as i32
    for orb in game.orb_home {
        val phase: f32 = time * (1.6 as f32) + (index as f32) * (0.85 as f32)
        val bob: f32 = (math.sin(phase as f64) as f32) * (0.22 as f32)
        val sway: f32 = (math.cos((phase * (1.3 as f32)) as f64) as f32) * (0.12 as f32)
        val shimmer: f32 = (0.82 as f32) + (math.sin((phase * (2.1 as f32)) as f64) as f32) * (0.18 as f32)
        val pos = ecs.make_vec3(orb.position.x + sway, orb.position.y + bob, orb.position.z)
        val tint: f32 = glow * shimmer
        val animated_orb = ecs.make_sphere(
            pos,
            ecs.make_vec3(orb.color.x * tint, orb.color.y * tint, orb.color.z * tint),
            orb.radius
        )
        @append(animated, animated_orb)
        if !game.won && hit_index < (0 as i32) {
            val distance: f32 = math.vec3_length(math.vec3_sub(app.camera.position, pos))
            if distance < COLLECT_RADIUS {
                hit_index = index
            }
        }
        index = index + (1 as i32)
    }
    app.scene.spheres = animated

    if hit_index >= (0 as i32) {
        @remove(game.orb_home, hit_index as usize)
        game.collected = game.collected + (1 as i32)
        if !trust engine.play_sound(app) {
            trust @print("audio unavailable\n", {})
        }
        if game.collected >= ORB_COUNT {
            game.won = true
            trust @print("All crystals collected! Press R to play again.\n", {})
        } else {
            trust @print("crystal {d}/{d} collected\n", {game.collected, ORB_COUNT})
        }
    }
}

pub fn (CrystalRun) on_key_down(game: mut self, app: mut engine.ExoApp, key: i32) void = {
    if key == sdl.SDL_SCANCODE_R {
        reset_game(game, app)
    }
    if key == sdl.SDL_SCANCODE_F && !game.won {
        game.pulse = 1.0 as f32
        trust engine.play_sound(app)
    }
}

pub fn (CrystalRun) on_key_up(_: mut self, _: mut engine.ExoApp, _: i32) void = {}
pub fn (CrystalRun) on_mouse_move(_: mut self, _: mut engine.ExoApp, _: f32, _: f32) void = {}
pub fn (CrystalRun) on_shutdown(_: mut self, _: mut engine.ExoApp) void = {}

pub fn main() i32 = {
    val scenes: mut list[ecs.Scene3D] = []
    @append(scenes, build_scene())

    val input_cfg: input.InputConfig = {
        keys: rendering.default_key_bindings(),
        mouse: {
            enabled: true,
            sensitivity_x: 0.0018 as f32,
            sensitivity_y: 0.0018 as f32,
            invert_y: false
        },
        quit_key: sdl.SDL_SCANCODE_ESCAPE
    }
    val audio_cfg: audio.AudioMixerConfig = {
        music_volume: 96 as i32,
        sample: {
            path: "./assets/example_sound.wav",
            loops: 0 as i32
        }
    }

    val builder: mut engine.ExoAppBuilder = engine.new_app()
    engine.with_title(builder, "exo | crystal run")
    engine.with_resolution(builder, 1280 as i32, 720 as i32)
    engine.with_shaders(builder, engine.default_shader_config())
    engine.with_scene_list(builder, scenes)
    engine.with_default_camera(builder)
    engine.with_input(builder, input_cfg)
    engine.with_audio(builder, audio_cfg)

    val app: engine.ExoApp = engine.build_app(builder)
    val game: CrystalRun = {
        orb_home: build_orbs(),
        collected: 0 as i32,
        won: false,
        pulse: 0.0 as f32
    }
    return trust engine.run_app_with_events[CrystalRun](app, game)
}

test {
    val orbs = build_orbs()
    assert @len(orbs) == (ORB_COUNT as usize)

    val scene = build_scene()
    assert @len(scene.spheres) == (ORB_COUNT as usize)
    assert @len(scene.cubes) > (0 as usize)
    assert scene.gravity == (0.0 as f32)

    val game: CrystalRun = {
        orb_home: build_orbs(),
        collected: 0 as i32,
        won: false,
        pulse: 0.0 as f32
    }
    assert @len(game.orb_home) == (ORB_COUNT as usize)
    assert !game.won
}
