pub type Vec3 = {
    x: f32
    y: f32
    z: f32
}

pub spec SceneEntity = {
    pub fn se_position(e: self) Vec3
    pub fn se_color(e: self) Vec3
    pub fn se_scale(e: self) f32
    pub fn se_rotation(e: self, time: f32) f32
    pub fn se_reflective(e: self) f32
    pub fn se_is_sphere(e: self) bool
}

pub type (SceneEntity) SphereEntity = {
    position: mut Vec3
    color: Vec3
    radius: f32
    velocity: mut Vec3
}

pub type (SceneEntity) CubeEntity = {
    position: mut Vec3
    color: Vec3
    size: f32
    rotation_speed: f32
    velocity: mut Vec3
}

pub fn (SphereEntity) se_position(e: self) Vec3 = { return e.position }
pub fn (SphereEntity) se_color(e: self) Vec3 = { return e.color }
pub fn (SphereEntity) se_scale(e: self) f32 = { return e.radius }
pub fn (SphereEntity) se_rotation(_: self, _: f32) f32 = { return 0.0 as f32 }
pub fn (SphereEntity) se_reflective(_: self) f32 = { return 0.12 as f32 }
pub fn (SphereEntity) se_is_sphere(_: self) bool = { return true }

pub fn (CubeEntity) se_position(e: self) Vec3 = { return e.position }
pub fn (CubeEntity) se_color(e: self) Vec3 = { return e.color }
pub fn (CubeEntity) se_scale(e: self) f32 = { return e.size }
pub fn (CubeEntity) se_rotation(e: self, time: f32) f32 = { return time * e.rotation_speed }
pub fn (CubeEntity) se_reflective(_: self) f32 = { return 0.08 as f32 }
pub fn (CubeEntity) se_is_sphere(_: self) bool = { return false }

pub type PointLight = {
    position: Vec3
    color: Vec3
    intensity: f32
    radius: f32
}

pub type GlbModel = {
    valid: mut bool
    byte_length: mut usize
    json_length: mut usize
    bin_length: mut usize
    mesh_name: mut ref u8
    primitive_count: mut i32
    vertex_count: mut i32
    index_count: mut i32
    has_normals: mut bool
    has_uvs: mut bool
    raw_bytes: mut ref u8
    raw_bytes_len: mut usize
    bounds_min_x: mut f32
    bounds_max_x: mut f32
    bounds_min_y: mut f32
    bounds_max_y: mut f32
    bounds_min_z: mut f32
    bounds_max_z: mut f32
}

// A flat infinite floor at a given Y height that entities collide with.
// restitution: 0.0 = entities stop dead, 1.0 = perfectly elastic bounce.
pub type FloorCollider = {
    y:           f32
    restitution: f32
}

// A flat animated water surface rendered at a given Y height.
// wave_speed:     how fast the wave pattern scrolls
// wave_amplitude: vertical displacement scale (visual only, via shader uniforms)
// wave_frequency: spatial frequency of the wave pattern
// size_x / size_z: extent of the water plane in world units
pub type WaterSurface = {
    y:              f32
    offset_x:       f32
    offset_z:       f32
    wave_speed:     f32
    wave_amplitude: f32
    wave_frequency: f32
    size_x:         f32
    size_z:         f32
    fit_scale:      f32
    color:          Vec3
    corner_radius:  f32
}

pub type Scene3D = {
    spheres:     mut list[SphereEntity]
    cubes:       mut list[CubeEntity]
    model:       mut GlbModel
    model_scale: mut f32
    light:       PointLight
    gravity:     mut f32
    floor:       mut option[FloorCollider]
    water:       mut option[WaterSurface]
}

pub fn make_water(y: f32, offset_x: f32, offset_z: f32, size_x: f32, size_z: f32, color: Vec3, wave_speed: f32, wave_amplitude: f32, wave_frequency: f32, corner_radius: f32) WaterSurface = {
    return {
        y:              y,
        offset_x:       offset_x,
        offset_z:       offset_z,
        wave_speed:     wave_speed,
        wave_amplitude: wave_amplitude,
        wave_frequency: wave_frequency,
        size_x:         size_x,
        size_z:         size_z,
        fit_scale:      1.0 as f32,
        color:          color,
        corner_radius:  corner_radius
    }
}

pub fn make_floor(y: f32, restitution: f32) FloorCollider = {
    return { y: y, restitution: restitution }
}

pub fn make_vec3(x: f32, y: f32, z: f32) Vec3 = {
    return { x: x, y: y, z: z }
}

pub fn make_sphere(position: Vec3, color: Vec3, radius: f32) SphereEntity = {
    return {
        position: position,
        color: color,
        radius: radius,
        velocity: { x: 0.0 as f32, y: 0.0 as f32, z: 0.0 as f32 }
    }
}

pub fn make_cube(position: Vec3, color: Vec3, size: f32, rotation_speed: f32) CubeEntity = {
    return {
        position: position,
        color: color,
        size: size,
        rotation_speed: rotation_speed,
        velocity: { x: 0.0 as f32, y: 0.0 as f32, z: 0.0 as f32 }
    }
}

pub fn default_light() PointLight = {
    return {
        position: { x: 0.0 as f32, y: 4.0 as f32, z: 0.0 as f32 },
        color: { x: 1.0 as f32, y: 0.92 as f32, z: 0.78 as f32 },
        intensity: 1.6 as f32,
        radius: 7.0 as f32
    }
}

pub fn make_light(position: Vec3, color: Vec3, intensity: f32, radius: f32) PointLight = {
    return { position: position, color: color, intensity: intensity, radius: radius }
}

pub fn empty_model() GlbModel = {
    return {
        valid: false,
        byte_length: 0 as usize,
        json_length: 0 as usize,
        bin_length: 0 as usize,
        mesh_name: "",
        primitive_count: 0 as i32,
        vertex_count: 0 as i32,
        index_count: 0 as i32,
        has_normals: false,
        has_uvs: false,
        raw_bytes: none as ref u8,
        raw_bytes_len: 0 as usize,
        bounds_min_x: 0.0 as f32,
        bounds_max_x: 0.0 as f32,
        bounds_min_y: 0.0 as f32,
        bounds_max_y: 0.0 as f32,
        bounds_min_z: 0.0 as f32,
        bounds_max_z: 0.0 as f32
    }
}

pub fn new_scene(light: PointLight) Scene3D = {
    return {
        spheres:     [],
        cubes:       [],
        model:       empty_model(),
        model_scale: 1.0 as f32,
        light:       light,
        gravity:     9.8 as f32,
        floor:       none,
        water:       none
    }
}
