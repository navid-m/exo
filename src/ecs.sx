val math        = use("engine/math.sx")
val postprocess = use("engine/postprocess.sx")

pub spec SceneEntity = {
    pub fn se_position(e: self) math.Vec3
    pub fn se_color(e: self) math.Vec3
    pub fn se_scale(e: self) f32
    pub fn se_rotation(e: self, time: f32) f32
    pub fn se_reflective(e: self) f32
    pub fn se_is_sphere(e: self) bool
}

pub type (SceneEntity) SphereEntity = {
    id: mut u64
    position: mut math.Vec3
    color: math.Vec3
    radius: f32
    velocity: mut math.Vec3
}

pub type (SceneEntity) CubeEntity = {
    id: mut u64
    position: mut math.Vec3
    color: math.Vec3
    size: f32
    rotation_speed: f32
    velocity: mut math.Vec3
}

pub fn (SphereEntity) se_position(e: self) math.Vec3 = {
    return e.position
}

pub fn (SphereEntity) se_color(e: self) math.Vec3 = {
    return e.color
}

pub fn (SphereEntity) se_scale(e: self) f32 = {
    return e.radius
}

pub fn (SphereEntity) se_rotation(_: self, _: f32) f32 = {
    return 0.0 as f32
}

pub fn (SphereEntity) se_reflective(_: self) f32 = {
    return 0.12 as f32
}

pub fn (SphereEntity) se_is_sphere(_: self) bool = {
    return true
}

pub fn (CubeEntity) se_position(e: self) math.Vec3 = {
    return e.position
}

pub fn (CubeEntity) se_color(e: self) math.Vec3 = {
    return e.color
}

pub fn (CubeEntity) se_scale(e: self) f32 = {
    return e.size
}

pub fn (CubeEntity) se_rotation(e: self, time: f32) f32 = {
    return time * e.rotation_speed
}

pub fn (CubeEntity) se_reflective(_: self) f32 = {
    return 0.08 as f32
}

pub fn (CubeEntity) se_is_sphere(_: self) bool = {
    return false
}

pub type PointLight = {
    position: math.Vec3
    color: math.Vec3
    intensity: f32
    radius: f32
}

pub type GlbModel = {
    valid: mut bool
    byte_length: mut usize
    json_length: mut usize
    bin_length: mut usize
    mesh_name: mut ref u8
    primitive_count: mut i32
    vertex_count: mut i32
    index_count: mut i32
    has_normals: mut bool
    has_uvs: mut bool
    raw_bytes: mut ref u8
    raw_bytes_len: mut usize
    bounds_min_x: mut f32
    bounds_max_x: mut f32
    bounds_min_y: mut f32
    bounds_max_y: mut f32
    bounds_min_z: mut f32
    bounds_max_z: mut f32
    texture_offset: mut usize
    texture_length: mut usize
}

/// A GLB model placed somewhere in the world.
pub type ModelInstance = {
    model: mut GlbModel
    position: math.Vec3
    rotation_y: f32
    scale: f32
    color: math.Vec3
    reflective: f32
    glow: f32
    alpha: f32
}

/// Raw CPU-side mesh data. Vertices are interleaved position/normal/uv
/// (8 floats per vertex) and indices are 32-bit.
pub type MeshGeometry = {
    vertices: ref f32
    vertex_float_count: usize
    indices: ref u32
    index_count: i32
    owned: bool
}

pub type MeshInstance = {
    geometry: MeshGeometry
    position: math.Vec3
    rotation_y: f32
    scale: math.Vec3
    color: math.Vec3
    reflective: f32
    glow: f32
    alpha: f32
}

/// One accessor from a glTF/GLB file. Offsets are absolute byte offsets into
/// the asset's raw GLB buffer.
pub type ModelAccessor = {
    offset: usize
    count: i32
    component_type: i32
    components: i32
    stride: usize
    normalized: bool
}

/// A single draw range from a model asset. Vertices are interleaved
/// position/normal/uv (8 floats each) and indices are 32-bit.
pub type ModelMesh = {
    vertices: ref f32
    vertex_count: usize
    indices: ref u32
    index_count: usize
    material: i32
    skin: i32
    joints: ref u16
    weights: ref f32
}

pub type ModelNode = {
    translation: math.Vec3
    rotation: math.Vec4f
    scale: math.Vec3
    matrix: math.Mat4
    has_matrix: bool
    parent: i32
    mesh: i32
    skin: i32
}

pub type ModelSkin = {
    joints: list[i32]
    inverse_bind: ref f32
    inverse_bind_count: usize
    joint_offset: usize
}

pub type ModelAnimChannel = {
    node: i32
    path: i32
    input: i32
    output: i32
    interpolation: i32
}

pub type ModelAnimation = {
    name: ref u8
    channels: list[ModelAnimChannel]
    duration: f32
}

/// A fully parsed GLB scene: meshes, materials, node hierarchy, skinning and
/// animation clips. Rendering a model asset is entirely engine-owned.
pub type ModelAsset = {
    meshes: list[ModelMesh]
    nodes: list[ModelNode]
    skins: list[ModelSkin]
    animations: list[ModelAnimation]
    accessors: list[ModelAccessor]
    material_images: list[i32]
    image_offsets: list[usize]
    image_lengths: list[usize]
    raw_bytes: ref u8
    raw_len: usize
    has_skinning: bool
    bounds_min: math.Vec3
    bounds_max: math.Vec3
}

/// A model placed in the world. The transform is applied after any skeletal
/// animation, so the same asset can be instanced many times.
pub type ModelDraw = {
    asset: ModelAsset
    transform: math.Mat4
    color: math.Vec3
    glow: f32
    alpha: f32
    visible: bool
    animation: i32
    animation_speed: f32
    animation_offset: f32
    animation_loop: bool
}

/// A flat floor at a given Y height that entities collide with.
///
///    - restitution: 0.0 = entities stop dead
///    - 1.0 = perfectly elastic bounce.
pub type FloorCollider = {
    y: f32
    restitution: f32
    center_x: f32
    center_z: f32
    size_x: f32
    size_z: f32
    color: math.Vec3
}

// A flat animated water surface rendered at a given Y height.
//
// wave_speed:      how fast the wave pattern scrolls
// wave_amplitude:  vertical displacement scale (visual only, via shader uniforms)
// wave_frequency:  spatial frequency of the wave pattern
// size_x / size_z: extent of the water plane in world units
pub type WaterSurface = {
    y: f32
    offset_x: f32
    offset_z: f32
    wave_speed: f32
    wave_amplitude: f32
    wave_frequency: f32
    size_x: f32
    size_z: f32
    fit_scale: f32
    color: math.Vec3
    corner_radius: f32
}

/// Rendering options that are owned by the scene, not the engine.
pub type RenderSettings = {
    clear_top: math.Vec3
    clear_bottom: math.Vec3
    reflection_plane: f32
    enable_reflections: bool
    reflect_models: bool
    enable_fxaa: bool
    enable_light_glow: bool
    ambient: f32
    post_process: postprocess.PostProcessSettings
}

pub type UiText = {
    text: ref u8
    x: f32
    y: f32
    scale: f32
    color: math.Vec3
    alpha: f32
}

pub type UiRect = {
    x: f32
    y: f32
    width: f32
    height: f32
    color: math.Vec3
    alpha: f32
}

pub type Ui = {
    texts: mut list[UiText]
    rects: mut list[UiRect]
}

pub type Scene3D = {
    spheres: mut list[SphereEntity]
    cubes: mut list[CubeEntity]
    models: mut list[ModelInstance]
    model_draws: mut list[ModelDraw]
    mesh_instances: mut list[MeshInstance]
    lights: mut list[PointLight]
    gravity: mut f32
    floors: mut list[FloorCollider]
    waters: mut list[WaterSurface]
    render: mut RenderSettings
    ui: mut Ui
    next_entity_id: mut u64
}

pub fn make_water(y: f32, offset_x: f32, offset_z: f32, size_x: f32, size_z: f32, color: math.Vec3, wave_speed: f32, wave_amplitude: f32, wave_frequency: f32, corner_radius: f32) WaterSurface = {
    return {
        y: y,
        offset_x: offset_x,
        offset_z: offset_z,
        wave_speed: wave_speed,
        wave_amplitude: wave_amplitude,
        wave_frequency: wave_frequency,
        size_x: size_x,
        size_z: size_z,
        fit_scale: 1.0 as f32,
        color: color,
        corner_radius: corner_radius
    }
}

pub fn make_floor(y: f32, restitution: f32) FloorCollider = {
    return {
        y: y,
        restitution: restitution,
        center_x: 0.0 as f32,
        center_z: 0.0 as f32,
        size_x: 8.0 as f32,
        size_z: 8.0 as f32,
        color: math.vec3(0.03 as f32, 0.06 as f32, 0.08 as f32)
    }
}

pub fn make_floor_sized(y: f32, restitution: f32, center_x: f32, center_z: f32, size_x: f32, size_z: f32, color: math.Vec3) FloorCollider = {
    return {
        y: y,
        restitution: restitution,
        center_x: center_x,
        center_z: center_z,
        size_x: size_x,
        size_z: size_z,
        color: color
    }
}

pub fn make_vec3(x: f32, y: f32, z: f32) math.Vec3 = {
    return { x: x, y: y, z: z }
}

pub fn make_sphere(position: math.Vec3, color: math.Vec3, radius: f32) SphereEntity = {
    return {
        id: 0 as u64,
        position: position,
        color: color,
        radius: radius,
        velocity: { x: 0.0 as f32, y: 0.0 as f32, z: 0.0 as f32 }
    }
}

pub fn make_cube(position: math.Vec3, color: math.Vec3, size: f32, rotation_speed: f32) CubeEntity = {
    return {
        id: 0 as u64,
        position: position,
        color: color,
        size: size,
        rotation_speed: rotation_speed,
        velocity: { x: 0.0 as f32, y: 0.0 as f32, z: 0.0 as f32 }
    }
}

pub fn make_model(model: GlbModel, position: math.Vec3, rotation_y: f32, scale: f32, color: math.Vec3) ModelInstance = {
    return {
        model: model,
        position: position,
        rotation_y: rotation_y,
        scale: scale,
        color: color,
        reflective: 0.05 as f32,
        glow: 0.0 as f32,
        alpha: 1.0 as f32
    }
}

pub fn make_mesh(geometry: MeshGeometry, position: math.Vec3, rotation_y: f32, scale: math.Vec3, color: math.Vec3) MeshInstance = {
    return {
        geometry: geometry,
        position: position,
        rotation_y: rotation_y,
        scale: scale,
        color: color,
        reflective: 0.08 as f32,
        glow: 0.0 as f32,
        alpha: 1.0 as f32
    }
}

pub fn default_render_settings() RenderSettings = {
    return {
        clear_top: math.vec3(0.05 as f32, 0.08 as f32, 0.14 as f32),
        clear_bottom: math.vec3(0.09 as f32, 0.15 as f32, 0.30 as f32),
        reflection_plane: -0.18 as f32,
        enable_reflections: true,
        reflect_models: false,
        enable_fxaa: true,
        enable_light_glow: true,
        ambient: 0.30 as f32,
        post_process: postprocess.default_settings()
    }
}

pub fn default_ui() Ui = {
    return {
        texts: [],
        rects: []
    }
}

pub fn ui_clear(ui: mut Ui) void = {
    ui.texts = []
    ui.rects = []
}

pub fn ui_text(ui: mut Ui, text: ref u8, x: f32, y: f32, scale: f32, color: math.Vec3, alpha: f32) void = {
    @append(ui.texts, {
            text: text,
            x: x,
            y: y,
            scale: scale,
            color: color,
            alpha: alpha
        })
}

pub fn ui_rect(ui: mut Ui, x: f32, y: f32, width: f32, height: f32, color: math.Vec3, alpha: f32) void = {
    @append(ui.rects, {
            x: x,
            y: y,
            width: width,
            height: height,
            color: color,
            alpha: alpha
        })
}

pub fn default_light() PointLight = {
    return {
        position: { x: 0.0 as f32, y: 4.0 as f32, z: 0.0 as f32 },
        color: { x: 1.0 as f32, y: 0.92 as f32, z: 0.78 as f32 },
        intensity: 1.6 as f32,
        radius: 7.0 as f32
    }
}

pub fn make_light(position: math.Vec3, color: math.Vec3, intensity: f32, radius: f32) PointLight = {
    return { position: position, color: color, intensity: intensity, radius: radius }
}

pub fn empty_model() GlbModel = {
    return {
        valid: false,
        byte_length: 0 as usize,
        json_length: 0 as usize,
        bin_length: 0 as usize,
        mesh_name: "",
        primitive_count: 0 as i32,
        vertex_count: 0 as i32,
        index_count: 0 as i32,
        has_normals: false,
        has_uvs: false,
        raw_bytes: none as ref u8,
        raw_bytes_len: 0 as usize,
        bounds_min_x: 0.0 as f32,
        bounds_max_x: 0.0 as f32,
        bounds_min_y: 0.0 as f32,
        bounds_max_y: 0.0 as f32,
        bounds_min_z: 0.0 as f32,
        bounds_max_z: 0.0 as f32,
        texture_offset: 0 as usize,
        texture_length: 0 as usize
    }
}

pub fn empty_model_asset() ModelAsset = {
    return {
        meshes: [],
        nodes: [],
        skins: [],
        animations: [],
        accessors: [],
        material_images: [],
        image_offsets: [],
        image_lengths: [],
        raw_bytes: none as ref u8,
        raw_len: 0 as usize,
        has_skinning: false,
        bounds_min: math.vec3(0.0 as f32, 0.0 as f32, 0.0 as f32),
        bounds_max: math.vec3(0.0 as f32, 0.0 as f32, 0.0 as f32)
    }
}

pub fn make_model_draw(asset: ModelAsset, transform: math.Mat4) ModelDraw = {
    return {
        asset: asset,
        transform: transform,
        color: math.vec3(1.0 as f32, 1.0 as f32, 1.0 as f32),
        glow: 0.0 as f32,
        alpha: 1.0 as f32,
        visible: true,
        animation: -1 as i32,
        animation_speed: 1.0 as f32,
        animation_offset: 0.0 as f32,
        animation_loop: true
    }
}

pub fn new_scene() Scene3D = {
    return {
        spheres: [],
        cubes: [],
        models: [],
        model_draws: [],
        mesh_instances: [],
        lights: [],
        gravity: 9.8 as f32,
        floors: [],
        waters: [],
        render: default_render_settings(),
        ui: default_ui(),
        next_entity_id: 1 as u64
    }
}

pub fn add_light(scene: mut Scene3D, light: PointLight) void = {
    @append(scene.lights, light)
}

pub fn add_model(scene: mut Scene3D, instance: ModelInstance) void = {
    @append(scene.models, instance)
}

pub fn add_model_draw(scene: mut Scene3D, instance: ModelDraw) void = {
    @append(scene.model_draws, instance)
}

pub fn add_mesh(scene: mut Scene3D, instance: MeshInstance) void = {
    @append(scene.mesh_instances, instance)
}

pub fn add_floor(scene: mut Scene3D, floor: FloorCollider) void = {
    @append(scene.floors, floor)
}

pub fn add_water(scene: mut Scene3D, water: WaterSurface) void = {
    @append(scene.waters, water)
}

pub fn add_sphere(scene: mut Scene3D, sphere: SphereEntity) u64 = {
    val id: u64 = scene.next_entity_id
    scene.next_entity_id = scene.next_entity_id + (1 as u64)
    val entity: mut SphereEntity = sphere
    entity.id = id
    @append(scene.spheres, entity)
    return id
}

pub fn add_cube(scene: mut Scene3D, cube: CubeEntity) u64 = {
    val id: u64 = scene.next_entity_id
    scene.next_entity_id = scene.next_entity_id + (1 as u64)
    val entity: mut CubeEntity = cube
    entity.id = id
    @append(scene.cubes, entity)
    return id
}

pub fn find_sphere_index(scene: Scene3D, id: u64) option[usize] = {
    val index: mut usize = 0 as usize
    for sphere in scene.spheres {
        if sphere.id == id {
            return some index
        }
        index = index + (1 as usize)
    }
    return none
}

pub fn find_cube_index(scene: Scene3D, id: u64) option[usize] = {
    val index: mut usize = 0 as usize
    for cube in scene.cubes {
        if cube.id == id {
            return some index
        }
        index = index + (1 as usize)
    }
    return none
}

pub fn remove_sphere(scene: mut Scene3D, id: u64) bool = {
    if find_sphere_index(scene, id) is some index {
        @remove(scene.spheres, index)
        return true
    }
    return false
}

pub fn remove_cube(scene: mut Scene3D, id: u64) bool = {
    if find_cube_index(scene, id) is some index {
        @remove(scene.cubes, index)
        return true
    }
    return false
}
