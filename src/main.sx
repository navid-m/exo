val string    = use("std/string")
val ecs       = use("ecs.sx")
val engine    = use("engine.sx")
val rendering = use("rendering.sx")
val physics   = use("physics.sx")

type (engine.SceneUpdater) PhysicsUpdater = {}

pub fn (PhysicsUpdater) su_update(_: mut self, scene: ecs.Scene3D, dt: f32, _: f32) void = {
    physics.update_physics(scene, dt)
}

fn build_game_scene() ecs.Scene3D = {
    val scene: mut ecs.Scene3D = ecs.new_scene(
        ecs.make_light(
            ecs.make_vec3(0.0 as f32, 3.8 as f32, -1.2 as f32),
            ecs.make_vec3(1.0 as f32, 0.92 as f32, 0.78 as f32),
            1.6 as f32,
            7.0 as f32
        )
    )
    scene.gravity = 9.8 as f32
    scene.floor = some ecs.make_floor(0.0 as f32, 0.3 as f32)
    @append(scene.cubes, ecs.make_cube(
        ecs.make_vec3(-1.55 as f32, 4.82 as f32, -0.65 as f32),
        ecs.make_vec3(0.20 as f32, 0.36 as f32, 0.82 as f32),
        0.98 as f32,
        1.15 as f32
    ))
    @append(scene.cubes, ecs.make_cube(
        ecs.make_vec3(1.55 as f32, 1.16 as f32, -2.30 as f32),
        ecs.make_vec3(0.24 as f32, 0.92 as f32, 1.00 as f32),
        1.16 as f32,
        -0.88 as f32
    ))
    return scene
}

fn build_feature_scene() ecs.Scene3D = {
    val scene: mut ecs.Scene3D = ecs.new_scene(
        ecs.make_light(
            ecs.make_vec3(-0.8 as f32, 3.4 as f32, 1.1 as f32),
            ecs.make_vec3(0.68 as f32, 0.86 as f32, 1.00 as f32),
            1.9 as f32,
            8.5 as f32
        )
    )
    scene.gravity = 0.0 as f32
    @append(scene.spheres, ecs.make_sphere(
        ecs.make_vec3(-1.20 as f32, 0.10 as f32, -0.25 as f32),
        ecs.make_vec3(1.00 as f32, 0.58 as f32, 0.24 as f32),
        0.78 as f32
    ))
    @append(scene.spheres, ecs.make_sphere(
        ecs.make_vec3(1.35 as f32, -0.05 as f32, -1.75 as f32),
        ecs.make_vec3(0.36 as f32, 0.74 as f32, 1.00 as f32),
        1.02 as f32
    ))
    @append(scene.cubes, ecs.make_cube(
        ecs.make_vec3(0.00 as f32, 1.48 as f32, -2.75 as f32),
        ecs.make_vec3(0.82 as f32, 0.34 as f32, 1.00 as f32),
        0.92 as f32,
        0.62 as f32
    ))
    @append(scene.cubes, ecs.make_cube(
        ecs.make_vec3(2.10 as f32, 0.62 as f32, 0.55 as f32),
        ecs.make_vec3(0.24 as f32, 1.00 as f32, 0.72 as f32),
        0.70 as f32,
        -1.18 as f32
    ))
    return scene
}

fn build_water_scene() ecs.Scene3D = {
    val scene: mut ecs.Scene3D = ecs.new_scene(
        ecs.make_light(
            ecs.make_vec3(0.0 as f32, 4.5 as f32, 0.5 as f32),
            ecs.make_vec3(0.72 as f32, 0.88 as f32, 1.00 as f32),
            2.0 as f32,
            10.0 as f32
        )
    )
    scene.gravity = 0.0 as f32
    scene.water = some ecs.make_water(
        0.05 as f32,
        5.5 as f32,
        5.5 as f32,
        ecs.make_vec3(0.18 as f32, 0.52 as f32, 0.82 as f32),
        1.4 as f32,
        0.018 as f32,
        2.8 as f32
    )
    return scene
}

fn build_scenes() list[ecs.Scene3D] = {
    val scenes: mut list[ecs.Scene3D] = []
    val intro_scene: mut ecs.Scene3D = build_game_scene()
    intro_scene.model = trust engine.load_embedded_fixture_model()
    @append(scenes, intro_scene)

    val feature_scene: mut ecs.Scene3D = build_feature_scene()
    feature_scene.model = trust engine.load_embedded_fixture_model()
    @append(scenes, feature_scene)

    val water_scene: mut ecs.Scene3D = build_water_scene()
    if trust engine.load_glb("./assets/pond.glb") is some pond_model {
        water_scene.model = pond_model
    }
    @append(scenes, water_scene)
    return scenes
}

pub fn main() i32 = {
    val scenes: list[ecs.Scene3D] = build_scenes()
    val input: engine.InputConfig = {
        keys: rendering.default_key_bindings(),
        mouse: {
            enabled:       true,
            sensitivity_x: 0.0018 as f32,
            sensitivity_y: 0.0018 as f32,
            invert_y:      false
        },
        quit_key: engine.SDL_SCANCODE_ESCAPE
    }
    val audio: engine.AudioMixerConfig = {
        trigger_key: engine.SDL_SCANCODE_Y,
        music_volume: 96 as i32,
        sample: {
            path: "./assets/example_sound.wav",
            loops: 0 as i32
        }
    }
    
    val app_builder: mut engine.ExoAppBuilder = engine.new_app()
    engine.with_title(app_builder, "exo-engine")
    engine.with_resolution(app_builder, 1280 as i32, 720 as i32)
    engine.with_shaders(app_builder, engine.default_shader_config())
    engine.with_scene_list(app_builder, scenes)
    engine.with_default_camera(app_builder)
    engine.with_input(app_builder, input)
    engine.with_next_scene_key(app_builder, engine.SDL_SCANCODE_X)
    engine.with_audio(app_builder, audio)
    val app: engine.ExoApp = engine.build_app(app_builder)
    val su: PhysicsUpdater = {}

    return trust engine.run_app_with_scene_updater[PhysicsUpdater](app, su)
}

test {
    val scene0 = build_game_scene()
    val scene1 = build_feature_scene()
    val scenes: mut list[ecs.Scene3D] = []
    @append(scenes, scene0)
    @append(scenes, scene1)
    val app_builder: mut engine.ExoAppBuilder = engine.new_app()
    engine.with_scene_list(app_builder, scenes)
    engine.with_default_camera(app_builder)
    engine.with_input(app_builder, rendering.default_input_config())
    engine.with_next_scene_key(app_builder, engine.SDL_SCANCODE_X)
    engine.with_audio(app_builder, {
        trigger_key: engine.SDL_SCANCODE_Y,
        music_volume: 96 as i32,
        sample: {
            path: "./example_sound.mp3",
            loops: 0 as i32
        }
    })
    val app: engine.ExoApp = engine.build_app(app_builder)
    assert @len(scene0.spheres) == (0 as usize)
    assert @len(scene0.cubes) == (2 as usize)
    assert @len(scene1.spheres) == (2 as usize)
    assert @len(scene1.cubes) == (2 as usize)
    assert @len(app.scenes) == (2 as usize)
    assert app.active_scene_index == (0 as usize)
    assert app.next_scene_key == engine.SDL_SCANCODE_X
    assert app.audio.trigger_key == engine.SDL_SCANCODE_Y
    assert trust string.compare[ref u8, ref u8](app.audio.sample.path, "./example_sound.mp3") == 0

    if @get(scene1.spheres, 0 as usize) is some s0 {
        assert s0.radius > (0.5 as f32)
    } else { assert false }

    if @get(scene1.spheres, 1 as usize) is some s1 {
        assert s1.radius > (0.5 as f32)
    } else { assert false }

    if @get(scene0.cubes, 0 as usize) is some c0 {
        assert c0.rotation_speed > (0.5 as f32)
    } else { assert false }

    if @get(scene1.cubes, 1 as usize) is some c1 {
        assert c1.rotation_speed < (0.0 as f32)
    } else { assert false }

    assert app.camera.move_speed > (3.0 as f32)

    val fixture: mut engine.GlbFixture = trust engine.build_test_glb_fixture()
    if trust engine.parse_glb_bytes(fixture.ptr, fixture.len) is some model {
        assert model.valid
        assert model.primitive_count == 1
        assert model.vertex_count == 3
        assert model.index_count == 0
        assert trust string.compare[ref u8, ref u8](model.mesh_name, "fixture") == 0
    } else {
        assert false
    }
    trust @free(fixture.ptr as ref void)
}
