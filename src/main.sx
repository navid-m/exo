val string = use("std/string")
val engine = use("engine.sx")

fn build_demo_scene() engine.Scene3D = {
    return {
        sphere0: engine.make_sphere(
            engine.make_vec3(-1.75 as f32, -0.45 as f32, 0.6 as f32),
            engine.make_vec3(0.96 as f32, 0.38 as f32, 0.33 as f32),
            0.92 as f32
        ),
        sphere1: engine.make_sphere(
            engine.make_vec3(1.75 as f32, -0.22 as f32, -1.0 as f32),
            engine.make_vec3(0.32 as f32, 0.72 as f32, 1.00 as f32),
            1.02 as f32
        ),
        cube0: engine.make_cube(
            engine.make_vec3(-1.55 as f32, 0.82 as f32, -0.65 as f32),
            engine.make_vec3(1.00 as f32, 0.44 as f32, 0.82 as f32),
            0.98 as f32,
            1.15 as f32
        ),
        cube1: engine.make_cube(
            engine.make_vec3(1.55 as f32, 1.16 as f32, -2.30 as f32),
            engine.make_vec3(0.28 as f32, 0.92 as f32, 1.00 as f32),
            1.16 as f32,
            -0.88 as f32
        ),
        stars: [
            engine.make_star(engine.make_vec3(-7.0 as f32, 4.8 as f32, -13.0 as f32), engine.make_vec3(0.95 as f32, 0.98 as f32, 1.00 as f32), 0.06 as f32, 0.26 as f32),
            engine.make_star(engine.make_vec3(-5.4 as f32, 6.0 as f32, -11.0 as f32), engine.make_vec3(0.72 as f32, 0.84 as f32, 1.00 as f32), 0.05 as f32, 0.22 as f32),
            engine.make_star(engine.make_vec3(-3.1 as f32, 5.4 as f32, -12.5 as f32), engine.make_vec3(1.00 as f32, 0.90 as f32, 0.78 as f32), 0.07 as f32, 0.28 as f32),
            engine.make_star(engine.make_vec3(-1.2 as f32, 6.4 as f32, -10.4 as f32), engine.make_vec3(0.82 as f32, 0.92 as f32, 1.00 as f32), 0.05 as f32, 0.20 as f32),
            engine.make_star(engine.make_vec3(0.8 as f32, 5.0 as f32, -14.0 as f32), engine.make_vec3(0.96 as f32, 0.98 as f32, 1.00 as f32), 0.06 as f32, 0.24 as f32),
            engine.make_star(engine.make_vec3(2.5 as f32, 6.1 as f32, -12.2 as f32), engine.make_vec3(0.72 as f32, 0.84 as f32, 1.00 as f32), 0.05 as f32, 0.22 as f32),
            engine.make_star(engine.make_vec3(4.7 as f32, 5.6 as f32, -11.4 as f32), engine.make_vec3(1.00 as f32, 0.92 as f32, 0.84 as f32), 0.06 as f32, 0.24 as f32),
            engine.make_star(engine.make_vec3(6.8 as f32, 4.9 as f32, -13.3 as f32), engine.make_vec3(0.84 as f32, 0.92 as f32, 1.00 as f32), 0.05 as f32, 0.20 as f32)
        ],
        particles: [
            engine.make_particle(engine.make_vec3(-1.55 as f32, 0.32 as f32, -0.65 as f32), engine.make_vec3(1.00 as f32, 0.48 as f32, 0.86 as f32), 0.034 as f32, 0.34 as f32, 2.10 as f32, 0.0 as f32, 0.16 as f32, 1.10 as f32),
            engine.make_particle(engine.make_vec3(-1.55 as f32, 0.34 as f32, -0.65 as f32), engine.make_vec3(0.98 as f32, 0.74 as f32, 1.00 as f32), 0.028 as f32, 0.46 as f32, 1.45 as f32, 1.2 as f32, 0.24 as f32, 0.92 as f32),
            engine.make_particle(engine.make_vec3(-1.55 as f32, 0.31 as f32, -0.65 as f32), engine.make_vec3(1.00 as f32, 0.62 as f32, 0.94 as f32), 0.024 as f32, 0.58 as f32, 1.80 as f32, 2.4 as f32, 0.34 as f32, 0.80 as f32),
            engine.make_particle(engine.make_vec3(1.55 as f32, 0.52 as f32, -2.30 as f32), engine.make_vec3(0.34 as f32, 0.90 as f32, 1.00 as f32), 0.036 as f32, 0.38 as f32, -1.75 as f32, 0.5 as f32, 0.18 as f32, 1.08 as f32),
            engine.make_particle(engine.make_vec3(1.55 as f32, 0.56 as f32, -2.30 as f32), engine.make_vec3(0.78 as f32, 0.96 as f32, 1.00 as f32), 0.026 as f32, 0.52 as f32, -1.30 as f32, 2.1 as f32, 0.30 as f32, 0.88 as f32),
            engine.make_particle(engine.make_vec3(1.55 as f32, 0.48 as f32, -2.30 as f32), engine.make_vec3(0.54 as f32, 0.82 as f32, 1.00 as f32), 0.022 as f32, 0.66 as f32, -0.90 as f32, 3.1 as f32, 0.42 as f32, 0.76 as f32),
            engine.make_particle(engine.make_vec3(0.0 as f32, 0.26 as f32, -1.50 as f32), engine.make_vec3(1.00 as f32, 0.84 as f32, 0.56 as f32), 0.030 as f32, 0.96 as f32, 0.85 as f32, 2.4 as f32, 0.08 as f32, 0.94 as f32),
            engine.make_particle(engine.make_vec3(0.0 as f32, 0.28 as f32, -1.50 as f32), engine.make_vec3(1.00 as f32, 0.70 as f32, 0.42 as f32), 0.022 as f32, 1.28 as f32, -0.60 as f32, 0.9 as f32, 0.12 as f32, 0.70 as f32)
        ],
        environment: {
            sky_bottom: engine.make_vec3(0.12 as f32, 0.18 as f32, 0.34 as f32),
            sky_top: engine.make_vec3(0.40 as f32, 0.62 as f32, 0.98 as f32),
            ambient_strength: 0.54 as f32,
            floor_tint: engine.make_vec3(0.03 as f32, 0.05 as f32, 0.09 as f32),
            floor_alpha: 0.54 as f32,
            floor_reflectivity: 0.88 as f32
        },
        model: engine.empty_model()
    }
}

pub fn main() i32 = {
    val scene: mut engine.Scene3D = build_demo_scene()
    scene.model = trust engine.load_embedded_fixture_model()
    val app: engine.EngineApp = engine.create_app(
        engine.default_config(),
        scene,
        engine.default_camera()
    )
    return trust engine.run_app(app)
}

test {
    val scene = engine.build_simple_scene()
    val app: engine.EngineApp = engine.create_app(
        engine.default_config(),
        scene,
        engine.default_camera()
    )
    assert scene.sphere0.radius > (0.5 as f32)
    assert scene.sphere1.radius > (0.5 as f32)
    assert scene.cube0.rotation_speed > (0.5 as f32)
    assert scene.cube1.rotation_speed < (0.0 as f32)
    assert @len(scene.stars) == 0 as usize
    assert scene.environment.floor_alpha > (0.3 as f32)
    assert app.camera.move_speed > (3.0 as f32)

    val fixture: mut engine.GlbFixture = trust engine.build_test_glb_fixture()
    if trust engine.parse_glb_bytes(fixture.ptr, fixture.len) is some model {
        assert model.valid
        assert model.primitive_count == 1
        assert model.vertex_count == 3
        assert model.index_count == 0
        assert trust string.compare[ref u8, ref u8](model.mesh_name, "fixture") == 0
    } else {
        assert false
    }
    trust @free(fixture.ptr as ref void)
}
