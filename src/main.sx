val string = use("std/string")
val ecs = use("ecs.sx")
val engine = use("engine.sx")
val rendering = use("rendering.sx")

fn build_game_scene() ecs.Scene3D = {
    return ecs.make_scene(
        ecs.make_sphere(
            ecs.make_vec3(-1.75 as f32, -0.45 as f32, 0.6 as f32),
            ecs.make_vec3(0.96 as f32, 0.38 as f32, 0.33 as f32),
            0.92 as f32
        ),
        ecs.make_sphere(
            ecs.make_vec3(1.75 as f32, -0.22 as f32, -1.0 as f32),
            ecs.make_vec3(0.32 as f32, 0.72 as f32, 1.00 as f32),
            1.02 as f32
        ),
        ecs.make_cube(
            ecs.make_vec3(-1.55 as f32, 0.82 as f32, -0.65 as f32),
            ecs.make_vec3(1.00 as f32, 0.36 as f32, 0.82 as f32),
            0.98 as f32,
            1.15 as f32
        ),
        ecs.make_cube(
            ecs.make_vec3(1.55 as f32, 1.16 as f32, -2.30 as f32),
            ecs.make_vec3(0.24 as f32, 0.92 as f32, 1.00 as f32),
            1.16 as f32,
            -0.88 as f32
        )
    )
}

pub fn main() i32 = {
    val scene: mut ecs.Scene3D = build_game_scene()
    scene.model = trust engine.load_embedded_fixture_model()
    val app: engine.EngineApp = rendering.create_app(scene)
    return trust rendering.run(app)
}

test {
    val scene = build_game_scene()
    val app: engine.EngineApp = rendering.create_app(scene)
    assert scene.sphere0.radius > (0.5 as f32)
    assert scene.sphere1.radius > (0.5 as f32)
    assert scene.cube0.rotation_speed > (0.5 as f32)
    assert scene.cube1.rotation_speed < (0.0 as f32)
    assert app.camera.move_speed > (3.0 as f32)

    val fixture: mut engine.GlbFixture = trust engine.build_test_glb_fixture()
    if trust engine.parse_glb_bytes(fixture.ptr, fixture.len) is some model {
        assert model.valid
        assert model.primitive_count == 1
        assert model.vertex_count == 3
        assert model.index_count == 0
        assert trust string.compare[ref u8, ref u8](model.mesh_name, "fixture") == 0
    } else {
        assert false
    }
    trust @free(fixture.ptr as ref void)
}
