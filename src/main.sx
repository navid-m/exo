val string = use("std/string")
val engine = use("engine.sx")

pub fn main() i32 = {
    val scene: mut engine.Scene3D = engine.build_simple_scene()
    scene.model = trust engine.load_embedded_fixture_model()
    val app: engine.EngineApp = engine.create_app(
        engine.default_config(),
        scene,
        engine.default_camera()
    )
    return trust engine.run_app(app)
}

test {
    val scene = engine.build_simple_scene()
    val app: engine.EngineApp = engine.create_app(
        engine.default_config(),
        scene,
        engine.default_camera()
    )
    assert scene.sphere0.radius > (0.5 as f32)
    assert scene.sphere1.radius > (0.5 as f32)
    assert scene.cube0.rotation_speed > (0.5 as f32)
    assert scene.cube1.rotation_speed < (0.0 as f32)
    assert app.camera.move_speed > (3.0 as f32)

    val fixture: mut engine.GlbFixture = trust engine.build_test_glb_fixture()
    if trust engine.parse_glb_bytes(fixture.ptr, fixture.len) is some model {
        assert model.valid
        assert model.primitive_count == 1
        assert model.vertex_count == 3
        assert model.index_count == 0
        assert trust string.compare[ref u8, ref u8](model.mesh_name, "fixture") == 0
    } else {
        assert false
    }
    trust @free(fixture.ptr as ref void)
}
