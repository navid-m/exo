val ecs      = use("../src/ecs.sx")
val engine   = use("../src/engine.sx")
val embedded = use("../src/embedded.sx")
val mem      = use("../src/mem.sx")
val testing  = use("std/testing")

fn exercise() i32 = {
    val scene: mut ecs.Scene3D = ecs.new_scene()
    @append(scene.spheres, ecs.make_sphere(
            ecs.make_vec3(0.0 as f32, 1.0 as f32, 0.0 as f32),
            ecs.make_vec3(1.0 as f32, 0.5 as f32, 0.2 as f32),
            0.5 as f32
        ))
    @append(scene.cubes, ecs.make_cube(
            ecs.make_vec3(1.0 as f32, 0.5 as f32, 0.0 as f32),
            ecs.make_vec3(0.2 as f32, 0.6 as f32, 1.0 as f32),
            1.0 as f32,
            0.0 as f32
        ))
    ecs.add_floor(scene, ecs.make_floor(-0.5 as f32, 0.2 as f32))
    ecs.ui_clear(scene.ui)
    ecs.ui_text(scene.ui, "leak check", 10.0 as f32, 10.0 as f32, 1.0 as f32, ecs.make_vec3(
            1.0 as f32,
            1.0 as f32,
            1.0 as f32
        ), 1.0 as f32)

    trust embedded.find("./assets/shaders/scene.vert.spv")

    val builder: mut engine.ExoAppBuilder = engine.new_app()
    engine.with_scene(builder, scene)
    val app: mut engine.ExoApp = engine.build_app(builder)

    val frame: mut i32 = 0 as i32
    for frame < (3 as i32) {
        mem.begin_update()

        val spheres: mut list[ecs.SphereEntity] = mem.scoped[ecs.SphereEntity]()
        @append(spheres, ecs.make_sphere(
                ecs.make_vec3(frame as f32, 1.0 as f32, 0.0 as f32),
                ecs.make_vec3(0.4 as f32, 0.8 as f32, 1.0 as f32),
                0.25 as f32
            ))
        app.scene.spheres = spheres

        ecs.ui_clear(app.scene.ui)
        ecs.ui_text(app.scene.ui, "frame", 0.0 as f32, 0.0 as f32, 1.0 as f32, ecs.make_vec3(
                1.0 as f32,
                1.0 as f32,
                1.0 as f32
            ), 1.0 as f32)

        mem.begin_render()
        val scratch: mut list[i64] = mem.render[i64]()
        @append(scratch, frame as i64)
        frame = frame + (1 as i32)
    }

    val result: mut i32 = app.config.width
    result = result + (@len(app.scene.spheres) as i32)
    return result
}

pub fn main() i32 = {
    val result: i32 = exercise()

    val before: testing.LeakDiagnostics = @dumpmemleaks()
    testing.LeakDiagnostics.pprint(before)

    mem.close()

    val after: testing.LeakDiagnostics = @dumpmemleaks()
    testing.LeakDiagnostics.pprint(after)

    if result < (0 as i32) {
        return 1 as i32
    }
    return 0 as i32
}
