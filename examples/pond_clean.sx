val ecs    = use("../src/ecs.sx")
val engine = use("../src/engine.sx")
val sdl    = use("../src/engine/sdl.sx")

// Pond showcase without the heavy GLB basin. Water, cubes, and glowing
// spheres only: the lightweight version used by perf variant 3.
fn build_pond() ecs.Scene3D = {
    val scene: mut ecs.Scene3D = ecs.new_scene()
    ecs.add_light(scene, ecs.make_light(
        ecs.make_vec3(0.0 as f32, 4.5 as f32, 0.5 as f32),
        ecs.make_vec3(0.72 as f32, 0.88 as f32, 1.00 as f32),
        2.0 as f32,
        10.0 as f32
    ))
    scene.gravity = 0.0 as f32

    val water: ecs.WaterSurface = ecs.make_water(
        -0.385 as f32,
        1.19 as f32,
        -2.04 as f32,
        6.95 as f32,
        9.48 as f32,
        ecs.make_vec3(0.10 as f32, 0.46 as f32, 0.78 as f32),
        1.25 as f32,
        0.022 as f32,
        3.0 as f32,
        0.45 as f32
    )
    ecs.add_water(scene, water)

    val surface_y: f32 = water.y
    val cx: f32 = water.offset_x
    val cz: f32 = water.offset_z

    @append(scene.cubes, ecs.make_cube(
        ecs.make_vec3(cx - 2.2 as f32, surface_y + 0.18 as f32, cz + 0.9 as f32),
        ecs.make_vec3(0.92 as f32, 0.64 as f32, 0.22 as f32),
        0.62 as f32,
        0.42 as f32
    ))
    @append(scene.cubes, ecs.make_cube(
        ecs.make_vec3(cx + 1.8 as f32, surface_y + 0.24 as f32, cz - 0.6 as f32),
        ecs.make_vec3(0.24 as f32, 0.72 as f32, 0.58 as f32),
        0.48 as f32,
        -0.58 as f32
    ))
    @append(scene.cubes, ecs.make_cube(
        ecs.make_vec3(cx + 0.4 as f32, surface_y + 0.30 as f32, cz - 2.0 as f32),
        ecs.make_vec3(0.76 as f32, 0.32 as f32, 0.46 as f32),
        0.70 as f32,
        0.31 as f32
    ))

    @append(scene.spheres, ecs.make_sphere(
        ecs.make_vec3(cx - 1.1 as f32, surface_y + 0.30 as f32, cz - 0.3 as f32),
        ecs.make_vec3(1.00 as f32, 0.72 as f32, 0.24 as f32),
        0.34 as f32
    ))
    @append(scene.spheres, ecs.make_sphere(
        ecs.make_vec3(cx + 2.8 as f32, surface_y + 0.22 as f32, cz - 1.9 as f32),
        ecs.make_vec3(0.32 as f32, 0.82 as f32, 1.00 as f32),
        0.30 as f32
    ))
    @append(scene.spheres, ecs.make_sphere(
        ecs.make_vec3(cx - 2.9 as f32, surface_y + 0.28 as f32, cz - 2.4 as f32),
        ecs.make_vec3(0.92 as f32, 0.36 as f32, 0.58 as f32),
        0.42 as f32
    ))
    @append(scene.spheres, ecs.make_sphere(
        ecs.make_vec3(cx + 0.9 as f32, surface_y + 0.20 as f32, cz - 3.4 as f32),
        ecs.make_vec3(0.72 as f32, 0.94 as f32, 1.00 as f32),
        0.24 as f32
    ))
    return scene
}

type (engine.AppEvents) PondEvents = {}

pub fn (PondEvents) on_start(_: mut self, _: mut engine.ExoApp) void = {}
pub fn (PondEvents) on_update(_: mut self, _: mut engine.ExoApp, _: f32, _: f32) void = {}
pub fn (PondEvents) on_fixed_update(_: mut self, _: mut engine.ExoApp, _: f32) void = {}
pub fn (PondEvents) on_key_down(_: mut self, _: mut engine.ExoApp, _: i32, _: bool, _: u16) void = {}
pub fn (PondEvents) on_key_up(_: mut self, _: mut engine.ExoApp, _: i32, _: u16) void = {}
pub fn (PondEvents) on_mouse_move(_: mut self, _: mut engine.ExoApp, _: f32, _: f32, _: f32, _: f32) void = {}
pub fn (PondEvents) on_mouse_button(_: mut self, _: mut engine.ExoApp, _: u8, _: bool, _: u8, _: f32, _: f32) void = {}
pub fn (PondEvents) on_mouse_wheel(_: mut self, _: mut engine.ExoApp, _: f32, _: f32, _: f32, _: f32) void = {}
pub fn (PondEvents) on_text_input(_: mut self, _: mut engine.ExoApp, _: ref u8) void = {}
pub fn (PondEvents) on_window_resize(_: mut self, _: mut engine.ExoApp, _: i32, _: i32) void = {}
pub fn (PondEvents) on_focus_changed(_: mut self, _: mut engine.ExoApp, _: bool) void = {}
pub fn (PondEvents) on_gamepad_button(_: mut self, _: mut engine.ExoApp, _: i32, _: bool) void = {}
pub fn (PondEvents) on_gamepad_axis(_: mut self, _: mut engine.ExoApp, _: i32, _: f32) void = {}
pub fn (PondEvents) on_shutdown(_: mut self, _: mut engine.ExoApp) void = {}

pub fn main() i32 = {
    val builder: mut engine.ExoAppBuilder = engine.new_app()
    engine.with_title(builder, "exo | pond (clean)")
    engine.with_resolution(builder, 1280 as i32, 720 as i32)
    engine.with_shaders(builder, engine.default_shader_config())
    engine.with_scene(builder, build_pond())
    engine.with_default_camera(builder)
    engine.with_auto_camera(builder)
    engine.with_quit_key(builder, sdl.SDL_SCANCODE_ESCAPE)

    val app: engine.ExoApp = engine.build_app(builder)
    val events: PondEvents = {}
    return trust engine.run_app_with_events[PondEvents](app, events)
}
