val math      = use("std/math")
val ecs       = use("../src/ecs.sx")
val engine    = use("../src/engine.sx")
val rendering = use("../src/rendering.sx")
val sdl       = use("../src/engine/sdl.sx")
val input     = use("../src/engine/input.sx")

val MAZE_ROWS: i32 = 21
val MAZE_COLS: i32 = 19
val CELL_SIZE: f32 = 1.0 as f32
val PAC_SPEED: f32 = 5.8 as f32
val GHOST_BASE_SPEED: f32 = 3.9 as f32
val FRIGHT_TIME: f32 = 8.0 as f32
val START_LIVES: i32 = 3
val PAC_START_X: i32 = 9
val PAC_START_Z: i32 = 15
val PI: f32 = 3.14159265 as f32

type Pellet = {
    x: i32
    z: i32
    power: bool
    eaten: mut bool
}

type Ghost = {
    cell_x: mut i32
    cell_z: mut i32
    from_x: mut f32
    from_z: mut f32
    to_x: mut i32
    to_z: mut i32
    dir_x: mut i32
    dir_z: mut i32
    progress: mut f32
    moving: mut bool
    spawn_x: i32
    spawn_z: i32
    r: f32
    g: f32
    b: f32
}

type (engine.AppEvents) PacmanGame = {
    rows: list[ref u8]
    pellets: mut list[Pellet]
    ghosts: mut list[Ghost]
    pellets_left: mut i32
    score: mut i32
    lives: mut i32
    power_timer: mut f32
    invuln: mut f32
    state: mut i32
    pac_cell_x: mut i32
    pac_cell_z: mut i32
    pac_from_x: mut f32
    pac_from_z: mut f32
    pac_to_x: mut i32
    pac_to_z: mut i32
    pac_progress: mut f32
    pac_moving: mut bool
    pac_dir_x: mut i32
    pac_dir_z: mut i32
    pac_want_x: mut i32
    pac_want_z: mut i32
    hud: mut ref u8
}

fn maze_rows() list[ref u8] = {
    val rows: mut list[ref u8] = []
    @append(rows, "###################")
    @append(rows, "#........#........#")
    @append(rows, "#o##.###.#.###.##o#")
    @append(rows, "#.................#")
    @append(rows, "#.##.#.#####.#.##.#")
    @append(rows, "#....#...#...#....#")
    @append(rows, "####.###.#.###.####")
    @append(rows, "#....#.......#....#")
    @append(rows, "#.##.#.##.##.#.##.#")
    @append(rows, "#.#.......#.......#")
    @append(rows, "##.#.###.#.#.###.##")
    @append(rows, "#....#...#...#....#")
    @append(rows, "#.####.#####.####.#")
    @append(rows, "#o......#.#......o#")
    @append(rows, "#.##.##.#.#.##.##.#")
    @append(rows, "#....#...P...#....#")
    @append(rows, "####.#.#####.#.####")
    @append(rows, "#....#...#...#....#")
    @append(rows, "#.######.#.######.#")
    @append(rows, "#.................#")
    @append(rows, "###################")
    return rows
}

fn row_char(rows: list[ref u8], r: i32, c: i32) u8 = {
    if r < (0 as i32) || r >= MAZE_ROWS || c < (0 as i32) || c >= MAZE_COLS {
        return 35 as u8
    }
    if @get(rows, r as usize) is some row {
        return trust @load8(@ptradd(row, c as usize))
    }
    return 35 as u8
}

fn is_open_cell(game: PacmanGame, x: i32, z: i32) bool = {
    if x < (0 as i32) || x >= MAZE_COLS || z < (0 as i32) || z >= MAZE_ROWS {
        return false
    }
    val ch: u8 = row_char(game.rows, z, x)
    return ch != (35 as u8) && ch != (45 as u8)
}

fn world_x(cell_x: f32) f32 = {
    return (cell_x - (((MAZE_COLS - (1 as i32)) as f32) * (0.5 as f32))) * CELL_SIZE
}

fn world_z(cell_z: f32) f32 = {
    return (cell_z - (((MAZE_ROWS - (1 as i32)) as f32) * (0.5 as f32))) * CELL_SIZE
}

fn fabs_f32(v: f32) f32 = {
    return math.fabs(v as f64) as f32
}

fn dist2(ax: f32, az: f32, bx: f32, bz: f32) f32 = {
    val dx: f32 = ax - bx
    val dz: f32 = az - bz
    return dx * dx + dz * dz
}

fn make_ghost(sx: i32, sz: i32, r: f32, g: f32, b: f32) Ghost = {
    return {
        cell_x: sx,
        cell_z: sz,
        from_x: sx as f32,
        from_z: sz as f32,
        to_x: sx,
        to_z: sz,
        dir_x: 0 as i32,
        dir_z: 0 as i32,
        progress: 0.0 as f32,
        moving: false,
        spawn_x: sx,
        spawn_z: sz,
        r: r,
        g: g,
        b: b
    }
}

fn build_pellets(game: mut PacmanGame) void = {
    val pellets: mut list[Pellet] = []
    val r: mut i32 = 0 as i32
    for r < MAZE_ROWS {
        val c: mut i32 = 0 as i32
        for c < MAZE_COLS {
            val ch: u8 = row_char(game.rows, r, c)
            if ch == (46 as u8) {
                @append(pellets, { x: c, z: r, power: false, eaten: false })
            } elif ch == (111 as u8) {
                @append(pellets, { x: c, z: r, power: true, eaten: false })
            }
            c = c + (1 as i32)
        }
        r = r + (1 as i32)
    }
    game.pellets = pellets
    game.pellets_left = @len(pellets) as i32
}

fn build_ghosts(game: mut PacmanGame) void = {
    val ghosts: mut list[Ghost] = []
    @append(ghosts, make_ghost(9 as i32, 9 as i32, 1.00 as f32, 0.22 as f32, 0.22 as f32))
    @append(ghosts, make_ghost(7 as i32, 7 as i32, 1.00 as f32, 0.52 as f32, 0.78 as f32))
    @append(ghosts, make_ghost(11 as i32, 7 as i32, 1.00 as f32, 0.55 as f32, 0.30 as f32))
    @append(ghosts, make_ghost(9 as i32, 7 as i32, 0.92 as f32, 0.42 as f32, 0.92 as f32))
    game.ghosts = ghosts
}

fn reset_positions(game: mut PacmanGame) void = {
    game.pac_cell_x = PAC_START_X
    game.pac_cell_z = PAC_START_Z
    game.pac_from_x = PAC_START_X as f32
    game.pac_from_z = PAC_START_Z as f32
    game.pac_to_x = PAC_START_X
    game.pac_to_z = PAC_START_Z
    game.pac_progress = 0.0 as f32
    game.pac_moving = false
    game.pac_dir_x = 0 as i32
    game.pac_dir_z = 0 as i32
    game.pac_want_x = 0 as i32
    game.pac_want_z = 0 as i32
    game.power_timer = 0.0 as f32
    game.invuln = 1.2 as f32
    val i: mut usize = 0 as usize
    for i < @len(game.ghosts) {
        if @get(game.ghosts, i) is some ghost {
            val g: mut Ghost = ghost
            g.cell_x = g.spawn_x
            g.cell_z = g.spawn_z
            g.from_x = g.spawn_x as f32
            g.from_z = g.spawn_z as f32
            g.to_x = g.spawn_x
            g.to_z = g.spawn_z
            g.progress = 0.0 as f32
            g.moving = false
            g.dir_x = 0 as i32
            g.dir_z = 0 as i32
            @set(game.ghosts, i, g)
        }
        i = i + (1 as usize)
    }
}

fn reset_game(game: mut PacmanGame) void = {
    build_pellets(game)
    build_ghosts(game)
    game.score = 0 as i32
    game.lives = START_LIVES
    game.state = 0 as i32
    reset_positions(game)
}

fn make_game(rows: list[ref u8]) PacmanGame = {
    val game: mut PacmanGame = {
        rows: rows,
        pellets: [],
        ghosts: [],
        pellets_left: 0 as i32,
        score: 0 as i32,
        lives: START_LIVES,
        power_timer: 0.0 as f32,
        invuln: 1.2 as f32,
        state: 0 as i32,
        pac_cell_x: PAC_START_X,
        pac_cell_z: PAC_START_Z,
        pac_from_x: PAC_START_X as f32,
        pac_from_z: PAC_START_Z as f32,
        pac_to_x: PAC_START_X,
        pac_to_z: PAC_START_Z,
        pac_progress: 0.0 as f32,
        pac_moving: false,
        pac_dir_x: 0 as i32,
        pac_dir_z: 0 as i32,
        pac_want_x: 0 as i32,
        pac_want_z: 0 as i32,
        hud: none as ref u8
    }
    reset_game(game)
    return game
}

fn pac_render_x(game: PacmanGame) f32 = {
    return game.pac_from_x + ((game.pac_to_x as f32) - game.pac_from_x) * game.pac_progress
}

fn pac_render_z(game: PacmanGame) f32 = {
    return game.pac_from_z + ((game.pac_to_z as f32) - game.pac_from_z) * game.pac_progress
}

fn ghost_render_x(g: Ghost) f32 = {
    return g.from_x + ((g.to_x as f32) - g.from_x) * g.progress
}

fn ghost_render_z(g: Ghost) f32 = {
    return g.from_z + ((g.to_z as f32) - g.from_z) * g.progress
}

fn consume_at(game: mut PacmanGame, cx: i32, cz: i32) void = {
    val i: mut usize = 0 as usize
    for i < @len(game.pellets) {
        if @get(game.pellets, i) is some pellet {
            if !pellet.eaten && pellet.x == cx && pellet.z == cz {
                val updated: Pellet = {
                    x: pellet.x,
                    z: pellet.z,
                    power: pellet.power,
                    eaten: true
                }
                @set(game.pellets, i, updated)
                game.pellets_left = game.pellets_left - (1 as i32)
                if pellet.power {
                    game.score = game.score + 50
                    game.power_timer = FRIGHT_TIME
                } else {
                    game.score = game.score + 10
                }
                if game.pellets_left <= (0 as i32) {
                    game.state = 1 as i32
                }
            }
        }
        i = i + (1 as usize)
    }
}

fn update_pacman(game: mut PacmanGame, dt: f32) void = {
    if game.pac_moving {
        game.pac_progress = game.pac_progress + PAC_SPEED * dt
        if game.pac_progress >= (1.0 as f32) {
            game.pac_cell_x = game.pac_to_x
            game.pac_cell_z = game.pac_to_z
            game.pac_from_x = game.pac_cell_x as f32
            game.pac_from_z = game.pac_cell_z as f32
            game.pac_to_x = game.pac_cell_x
            game.pac_to_z = game.pac_cell_z
            game.pac_progress = 0.0 as f32
            game.pac_moving = false
            consume_at(game, game.pac_cell_x, game.pac_cell_z)
        }
    }
    if !game.pac_moving && game.state == (0 as i32) {
        if game.pac_want_x != (0 as i32) || game.pac_want_z != (0 as i32) {
            if is_open_cell(game, game.pac_cell_x + game.pac_want_x, game.pac_cell_z + game.pac_want_z) {
                game.pac_dir_x = game.pac_want_x
                game.pac_dir_z = game.pac_want_z
            }
        }
        if is_open_cell(game, game.pac_cell_x + game.pac_dir_x, game.pac_cell_z + game.pac_dir_z) {
            game.pac_from_x = game.pac_cell_x as f32
            game.pac_from_z = game.pac_cell_z as f32
            game.pac_to_x = game.pac_cell_x + game.pac_dir_x
            game.pac_to_z = game.pac_cell_z + game.pac_dir_z
            game.pac_progress = 0.0 as f32
            game.pac_moving = true
        }
    }
}

fn ghost_dir_score(game: PacmanGame, g: Ghost, dx: i32, dz: i32, tx: i32, tz: i32, allow_reverse: bool) f32 = {
    if !allow_reverse && (g.dir_x != (0 as i32) || g.dir_z != (0 as i32)) {
        if dx == ((0 as i32) - g.dir_x) && dz == ((0 as i32) - g.dir_z) {
            return -1.0 as f32
        }
    }
    if !is_open_cell(game, g.cell_x + dx, g.cell_z + dz) {
        return -1.0 as f32
    }
    val ddx: i32 = g.cell_x + dx - tx
    val ddz: i32 = g.cell_z + dz - tz
    return (ddx as f32) * (ddx as f32) + (ddz as f32) * (ddz as f32)
}

fn ghost_better(score: f32, best: f32, have: bool, flee: bool) bool = {
    if !have {
        return true
    }
    if flee {
        return score > best
    }
    return score < best
}

fn ghost_choose(game: PacmanGame, g: mut Ghost, tx: i32, tz: i32, flee: bool) void = {
    val s0: mut f32 = ghost_dir_score(game, g, 1 as i32, 0 as i32, tx, tz, false)
    val s1: mut f32 = ghost_dir_score(game, g, (0 as i32) - (1 as i32), 0 as i32, tx, tz, false)
    val s2: mut f32 = ghost_dir_score(game, g, 0 as i32, 1 as i32, tx, tz, false)
    val s3: mut f32 = ghost_dir_score(game, g, 0 as i32, (0 as i32) - (1 as i32), tx, tz, false)
    if s0 < (0.0 as f32) && s1 < (0.0 as f32) && s2 < (0.0 as f32) && s3 < (0.0 as f32) {
        s0 = ghost_dir_score(game, g, 1 as i32, 0 as i32, tx, tz, true)
        s1 = ghost_dir_score(game, g, (0 as i32) - (1 as i32), 0 as i32, tx, tz, true)
        s2 = ghost_dir_score(game, g, 0 as i32, 1 as i32, tx, tz, true)
        s3 = ghost_dir_score(game, g, 0 as i32, (0 as i32) - (1 as i32), tx, tz, true)
    }
    val best: mut f32 = 0.0 as f32
    val best_x: mut i32 = 0 as i32
    val best_z: mut i32 = 0 as i32
    val have: mut bool = false
    if s0 >= (0.0 as f32) && ghost_better(s0, best, have, flee) {
        best = s0
        best_x = 1 as i32
        best_z = 0 as i32
        have = true
    }
    if s1 >= (0.0 as f32) && ghost_better(s1, best, have, flee) {
        best = s1
        best_x = (0 as i32) - (1 as i32)
        best_z = 0 as i32
        have = true
    }
    if s2 >= (0.0 as f32) && ghost_better(s2, best, have, flee) {
        best = s2
        best_x = 0 as i32
        best_z = 1 as i32
        have = true
    }
    if s3 >= (0.0 as f32) && ghost_better(s3, best, have, flee) {
        best = s3
        best_x = 0 as i32
        best_z = (0 as i32) - (1 as i32)
        have = true
    }
    if have {
        g.dir_x = best_x
        g.dir_z = best_z
    } else {
        g.dir_x = 0 as i32
        g.dir_z = 0 as i32
    }
}

fn advance_ghost(game: PacmanGame, g: mut Ghost, dt: f32, speed: f32, tx: i32, tz: i32, flee: bool) void = {
    if g.moving {
        g.progress = g.progress + speed * dt
        if g.progress >= (1.0 as f32) {
            g.cell_x = g.to_x
            g.cell_z = g.to_z
            g.from_x = g.cell_x as f32
            g.from_z = g.cell_z as f32
            g.to_x = g.cell_x
            g.to_z = g.cell_z
            g.progress = 0.0 as f32
            g.moving = false
        }
    }
    if !g.moving {
        ghost_choose(game, g, tx, tz, flee)
        if is_open_cell(game, g.cell_x + g.dir_x, g.cell_z + g.dir_z) {
            g.from_x = g.cell_x as f32
            g.from_z = g.cell_z as f32
            g.to_x = g.cell_x + g.dir_x
            g.to_z = g.cell_z + g.dir_z
            g.progress = 0.0 as f32
            g.moving = true
        }
    }
}

fn ghost_send_home(g: mut Ghost) void = {
    g.cell_x = g.spawn_x
    g.cell_z = g.spawn_z
    g.from_x = g.spawn_x as f32
    g.from_z = g.spawn_z as f32
    g.to_x = g.spawn_x
    g.to_z = g.spawn_z
    g.progress = 0.0 as f32
    g.moving = false
    g.dir_x = 0 as i32
    g.dir_z = 0 as i32
}

fn update_ghosts(game: mut PacmanGame, dt: f32) void = {
    val frightened: bool = game.power_timer > (0.0 as f32)
    val i: mut usize = 0 as usize
    for i < @len(game.ghosts) {
        if @get(game.ghosts, i) is some ghost {
            val g: mut Ghost = ghost
            val target_x: mut i32 = game.pac_cell_x
            val target_z: mut i32 = game.pac_cell_z
            if !frightened {
                if i == (1 as usize) {
                    target_x = game.pac_cell_x + game.pac_dir_x * (2 as i32)
                    target_z = game.pac_cell_z + game.pac_dir_z * (2 as i32)
                } elif i == (2 as usize) {
                    target_x = 1 as i32
                    target_z = 1 as i32
                } elif i == (3 as usize) {
                    target_x = MAZE_COLS - (2 as i32)
                    target_z = MAZE_ROWS - (2 as i32)
                }
            }
            val speed: mut f32 = GHOST_BASE_SPEED + ((i as f32) * (0.15 as f32))
            if frightened {
                speed = GHOST_BASE_SPEED * (0.65 as f32)
            }
            advance_ghost(game, g, dt, speed, target_x, target_z, frightened)
            @set(game.ghosts, i, g)
        }
        i = i + (1 as usize)
    }
}

fn check_ghost_hits(game: mut PacmanGame) void = {
    if game.invuln > (0.0 as f32) || game.state != (0 as i32) {
        return
    }
    val px: f32 = pac_render_x(game)
    val pz: f32 = pac_render_z(game)
    val i: mut usize = 0 as usize
    for i < @len(game.ghosts) {
        if @get(game.ghosts, i) is some ghost {
            val gx: f32 = ghost_render_x(ghost)
            val gz: f32 = ghost_render_z(ghost)
            if dist2(px, pz, gx, gz) < (0.55 as f32) * (0.55 as f32) {
                if game.power_timer > (0.0 as f32) {
                    val g: mut Ghost = ghost
                    ghost_send_home(g)
                    @set(game.ghosts, i, g)
                    game.score = game.score + 200
                } else {
                    game.lives = game.lives - (1 as i32)
                    if game.lives <= (0 as i32) {
                        game.state = 2 as i32
                        game.lives = 0 as i32
                    } else {
                        reset_positions(game)
                    }
                    return
                }
            }
        }
        i = i + (1 as usize)
    }
}

fn sync_scene(game: PacmanGame, app: mut engine.ExoApp, time: f32) void = {
    val spheres: mut list[ecs.SphereEntity] = []
    for pellet in game.pellets {
        if !pellet.eaten {
            val wx: f32 = world_x(pellet.x as f32)
            val wz: f32 = world_z(pellet.z as f32)
            if pellet.power {
                val pulse: f32 = (math.sin((time * (5.0 as f32)) as f64) as f32) * (0.03 as f32)
                @append(spheres, ecs.make_sphere(
                    ecs.make_vec3(wx, 0.28 as f32, wz),
                    ecs.make_vec3(0.98 as f32, 0.96 as f32, 0.72 as f32),
                    (0.17 as f32) + pulse
                ))
            } else {
                @append(spheres, ecs.make_sphere(
                    ecs.make_vec3(wx, 0.20 as f32, wz),
                    ecs.make_vec3(0.95 as f32, 0.82 as f32, 0.42 as f32),
                    0.07 as f32
                ))
            }
        }
    }
    val px: f32 = world_x(pac_render_x(game))
    val pz: f32 = world_z(pac_render_z(game))
    val chomp: f32 = (math.sin((time * (13.0 as f32)) as f64) as f32) * (0.03 as f32)
    @append(spheres, ecs.make_sphere(
        ecs.make_vec3(px, 0.52 as f32, pz),
        ecs.make_vec3(1.00 as f32, 0.86 as f32, 0.12 as f32),
        (0.38 as f32) + chomp
    ))
    for ghost in game.ghosts {
        val gx: f32 = world_x(ghost_render_x(ghost))
        val gz: f32 = world_z(ghost_render_z(ghost))
        val frightened: bool = game.power_timer > (0.0 as f32)
        val blink: bool = game.power_timer < (2.0 as f32) && (math.sin((time * (18.0 as f32)) as f64) as f32) > (0.0 as f32)
        val final_r: mut f32 = ghost.r
        val final_g: mut f32 = ghost.g
        val final_b: mut f32 = ghost.b
        if frightened {
            final_r = 0.22 as f32
            final_g = 0.36 as f32
            final_b = 1.00 as f32
        }
        if blink {
            final_r = 0.92 as f32
            final_g = 0.92 as f32
            final_b = 0.98 as f32
        }
        @append(spheres, ecs.make_sphere(
            ecs.make_vec3(gx, 0.56 as f32, gz),
            ecs.make_vec3(final_r, final_g, final_b),
            0.37 as f32
        ))
        val dir_x: f32 = ghost.dir_x as f32
        val dir_z: f32 = ghost.dir_z as f32
        val side_x: f32 = (0.0 as f32) - dir_z
        val side_z: f32 = dir_x
        @append(spheres, ecs.make_sphere(
            ecs.make_vec3(gx + side_x * (0.13 as f32) + dir_x * (0.10 as f32), 0.68 as f32, gz + side_z * (0.13 as f32) + dir_z * (0.10 as f32)),
            ecs.make_vec3(1.00 as f32, 1.00 as f32, 1.00 as f32),
            0.075 as f32
        ))
        @append(spheres, ecs.make_sphere(
            ecs.make_vec3(gx - side_x * (0.13 as f32) + dir_x * (0.10 as f32), 0.68 as f32, gz - side_z * (0.13 as f32) + dir_z * (0.10 as f32)),
            ecs.make_vec3(1.00 as f32, 1.00 as f32, 1.00 as f32),
            0.075 as f32
        ))
    }
    app.scene.spheres = spheres
}

fn follow_camera(game: PacmanGame, app: mut engine.ExoApp) void = {
    val px: f32 = world_x(pac_render_x(game))
    val pz: f32 = world_z(pac_render_z(game))
    app.camera.position = ecs.make_vec3(px, 10.5 as f32, pz + (7.6 as f32))
    app.camera.yaw = PI
    app.camera.pitch = -0.88 as f32
}

fn refresh_hud(game: PacmanGame, app: mut engine.ExoApp) void = {
    @snprintf(game.hud, 128 as usize, "SCORE {d}   LIVES {d}   DOTS {d}", { game.score, game.lives, game.pellets_left })
    ecs.ui_clear(app.scene.ui)
    ecs.ui_rect(app.scene.ui, 16.0 as f32, 16.0 as f32, 430.0 as f32, 44.0 as f32, ecs.make_vec3(0.01 as f32, 0.02 as f32, 0.08 as f32), 0.72 as f32)
    ecs.ui_text(app.scene.ui, game.hud, 26.0 as f32, 26.0 as f32, 3.0 as f32, ecs.make_vec3(1.00 as f32, 0.86 as f32, 0.18 as f32), 1.0 as f32)
    if game.state == (1 as i32) {
        ecs.ui_text(app.scene.ui, "YOU WIN!  PRESS R TO PLAY AGAIN", 26.0 as f32, 82.0 as f32, 2.2 as f32, ecs.make_vec3(0.40 as f32, 1.00 as f32, 0.55 as f32), 1.0 as f32)
    } elif game.state == (2 as i32) {
        ecs.ui_text(app.scene.ui, "GAME OVER  -  PRESS R TO RETRY", 26.0 as f32, 82.0 as f32, 2.2 as f32, ecs.make_vec3(1.00 as f32, 0.38 as f32, 0.32 as f32), 1.0 as f32)
    } elif game.power_timer > (0.0 as f32) {
        ecs.ui_text(app.scene.ui, "POWER MODE", 26.0 as f32, 82.0 as f32, 2.0 as f32, ecs.make_vec3(0.45 as f32, 0.72 as f32, 1.00 as f32), 1.0 as f32)
    } else {
        ecs.ui_text(app.scene.ui, "ARROWS / WASD MOVE    R RESTART", 26.0 as f32, 82.0 as f32, 2.0 as f32, ecs.make_vec3(0.62 as f32, 0.72 as f32, 0.88 as f32), 1.0 as f32)
    }
}

fn build_scene(rows: list[ref u8]) ecs.Scene3D = {
    val scene: mut ecs.Scene3D = ecs.new_scene()
    scene.gravity = 0.0 as f32
    scene.render.clear_top = ecs.make_vec3(0.005 as f32, 0.008 as f32, 0.030 as f32)
    scene.render.clear_bottom = ecs.make_vec3(0.020 as f32, 0.035 as f32, 0.090 as f32)
    scene.render.ambient = 0.48 as f32
    scene.render.enable_reflections = false
    scene.render.enable_fxaa = true
    scene.render.enable_light_glow = true
    scene.render.reflection_plane = -0.2 as f32
    ecs.add_light(scene, ecs.make_light(
        ecs.make_vec3(0.0 as f32, 11.0 as f32, 0.0 as f32),
        ecs.make_vec3(0.82 as f32, 0.88 as f32, 1.00 as f32),
        2.1 as f32,
        26.0 as f32
    ))
    ecs.add_light(scene, ecs.make_light(
        ecs.make_vec3(-7.0 as f32, 5.0 as f32, 6.0 as f32),
        ecs.make_vec3(0.25 as f32, 0.42 as f32, 1.00 as f32),
        1.2 as f32,
        16.0 as f32
    ))
    ecs.add_floor(scene, ecs.make_floor_sized(
        0.0 as f32,
        0.0 as f32,
        0.0 as f32,
        0.0 as f32,
        ((MAZE_COLS as f32) * CELL_SIZE) + (2.0 as f32),
        ((MAZE_ROWS as f32) * CELL_SIZE) + (2.0 as f32),
        ecs.make_vec3(0.025 as f32, 0.040 as f32, 0.095 as f32)
    ))
    val r: mut i32 = 0 as i32
    for r < MAZE_ROWS {
        val c: mut i32 = 0 as i32
        for c < MAZE_COLS {
            if row_char(rows, r, c) == (35 as u8) {
                val border: bool = r == (0 as i32) || r == (MAZE_ROWS - (1 as i32)) || c == (0 as i32) || c == (MAZE_COLS - (1 as i32))
                if border {
                    @append(scene.cubes, ecs.make_cube(
                        ecs.make_vec3(world_x(c as f32), 0.50 as f32, world_z(r as f32)),
                        ecs.make_vec3(0.12 as f32, 0.24 as f32, 0.62 as f32),
                        CELL_SIZE * (0.98 as f32),
                        0.0 as f32
                    ))
                } else {
                    @append(scene.cubes, ecs.make_cube(
                        ecs.make_vec3(world_x(c as f32), 0.50 as f32, world_z(r as f32)),
                        ecs.make_vec3(0.055 as f32, 0.11 as f32, 0.31 as f32),
                        CELL_SIZE * (0.98 as f32),
                        0.0 as f32
                    ))
                }
            }
            c = c + (1 as i32)
        }
        r = r + (1 as i32)
    }
    return scene
}

pub fn (PacmanGame) on_start(game: mut self, app: mut engine.ExoApp) void = {
    game.hud = @alloc(128 as usize) as ref u8
    reset_game(game)
    sync_scene(game, app, 0.0 as f32)
    follow_camera(game, app)
    refresh_hud(game, app)
}

pub fn (PacmanGame) on_update(game: mut self, app: mut engine.ExoApp, dt: f32, time: f32) void = {
    if game.state == (0 as i32) {
        val wx: mut i32 = 0 as i32
        val wz: mut i32 = 0 as i32
        if trust engine.key_held(app, sdl.SDL_SCANCODE_LEFT) || trust engine.key_held(app, sdl.SDL_SCANCODE_A) {
            wx = (0 as i32) - (1 as i32)
            wz = 0 as i32
        } elif trust engine.key_held(app, sdl.SDL_SCANCODE_RIGHT) || trust engine.key_held(app, sdl.SDL_SCANCODE_D) {
            wx = 1 as i32
            wz = 0 as i32
        } elif trust engine.key_held(app, sdl.SDL_SCANCODE_UP) || trust engine.key_held(app, sdl.SDL_SCANCODE_W) {
            wx = 0 as i32
            wz = (0 as i32) - (1 as i32)
        } elif trust engine.key_held(app, sdl.SDL_SCANCODE_DOWN) || trust engine.key_held(app, sdl.SDL_SCANCODE_S) {
            wx = 0 as i32
            wz = 1 as i32
        }
        if wx != (0 as i32) || wz != (0 as i32) {
            game.pac_want_x = wx
            game.pac_want_z = wz
        }
        if game.power_timer > (0.0 as f32) {
            game.power_timer = game.power_timer - dt
            if game.power_timer < (0.0 as f32) {
                game.power_timer = 0.0 as f32
            }
        }
        if game.invuln > (0.0 as f32) {
            game.invuln = game.invuln - dt
            if game.invuln < (0.0 as f32) {
                game.invuln = 0.0 as f32
            }
        }
        update_pacman(game, dt)
        update_ghosts(game, dt)
        check_ghost_hits(game)
    }
    sync_scene(game, app, time)
    follow_camera(game, app)
    refresh_hud(game, app)
}

pub fn (PacmanGame) on_fixed_update(_: mut self, _: mut engine.ExoApp, _: f32) void = {}

pub fn (PacmanGame) on_key_down(game: mut self, _: mut engine.ExoApp, key: i32, _: bool, _: u16) void = {
    if key == sdl.SDL_SCANCODE_R {
        reset_game(game)
    }
}

pub fn (PacmanGame) on_key_up(_: mut self, _: mut engine.ExoApp, _: i32, _: u16) void = {}
pub fn (PacmanGame) on_mouse_move(_: mut self, _: mut engine.ExoApp, _: f32, _: f32, _: f32, _: f32) void = {}
pub fn (PacmanGame) on_mouse_button(_: mut self, _: mut engine.ExoApp, _: u8, _: bool, _: u8, _: f32, _: f32) void = {}
pub fn (PacmanGame) on_mouse_wheel(_: mut self, _: mut engine.ExoApp, _: f32, _: f32, _: f32, _: f32) void = {}
pub fn (PacmanGame) on_text_input(_: mut self, _: mut engine.ExoApp, _: ref u8) void = {}
pub fn (PacmanGame) on_window_resize(_: mut self, _: mut engine.ExoApp, _: i32, _: i32) void = {}
pub fn (PacmanGame) on_focus_changed(_: mut self, _: mut engine.ExoApp, _: bool) void = {}
pub fn (PacmanGame) on_gamepad_button(_: mut self, _: mut engine.ExoApp, _: i32, _: bool) void = {}
pub fn (PacmanGame) on_gamepad_axis(_: mut self, _: mut engine.ExoApp, _: i32, _: f32) void = {}

pub fn (PacmanGame) on_shutdown(game: mut self, _: mut engine.ExoApp) void = {
    if game.hud != none {
        trust @free(game.hud as ref void)
        game.hud = none as ref u8
    }
}

pub fn main() i32 = {
    val rows: list[ref u8] = maze_rows()
    val scene: ecs.Scene3D = build_scene(rows)
    val input_cfg: input.InputConfig = {
        keys: rendering.default_key_bindings(),
        mouse: {
            enabled: false,
            sensitivity_x: 0.0018 as f32,
            sensitivity_y: 0.0018 as f32,
            invert_y: false
        },
        text_input: false,
        gamepad: true
    }

    val builder: mut engine.ExoAppBuilder = engine.new_app()
    engine.with_title(builder, "exo | pacman 3d")
    engine.with_resolution(builder, 1280 as i32, 720 as i32)
    engine.with_shaders(builder, engine.default_shader_config())
    engine.with_scene(builder, scene)
    engine.with_camera(builder, engine.default_camera())
    engine.with_input(builder, input_cfg)
    engine.with_quit_key(builder, sdl.SDL_SCANCODE_ESCAPE)

    val app: engine.ExoApp = engine.build_app(builder)
    val game: PacmanGame = make_game(rows)
    return trust engine.run_app_with_events[PacmanGame](app, game)
}

test {
    val rows = maze_rows()
    assert @len(rows) == (MAZE_ROWS as usize)
    if @get(rows, 0 as usize) is some row {
        val ch: u8 = trust @load8(row)
        assert ch == (35 as u8)
    } else {
        assert false
    }
    val game = make_game(rows)
    assert game.pellets_left > (100 as i32)
    assert @len(game.ghosts) == (4 as usize)
    assert game.state == (0 as i32)
    assert is_open_cell(game, PAC_START_X, PAC_START_Z)
    assert !is_open_cell(game, 0 as i32, 0 as i32)
}
