val math      = use("std/math")
val emath     = use("../src/engine/math.sx")
val ecs       = use("../src/ecs.sx")
val engine    = use("../src/engine.sx")
val rendering = use("../src/rendering.sx")
val sdl       = use("../src/engine/sdl.sx")

fn make_instance(
    position: emath.Vec3,
    scale: emath.Vec3,
    color: emath.Vec3,
    glow: f32,
    reflective: f32
) ecs.InstanceData = {
    return {
        position: position,
        scale: scale,
        rotation_y: 0.0 as f32,
        color: color,
        glow: glow,
        reflective: reflective
    }
}

fn add_showcase_scene() ecs.Scene3D = {
    val scene: mut ecs.Scene3D = ecs.new_scene()
    scene.gravity = 0.0 as f32
    scene.render.clear_top = ecs.make_vec3(0.02 as f32, 0.06 as f32, 0.18 as f32)
    scene.render.clear_bottom = ecs.make_vec3(0.90 as f32, 0.38 as f32, 0.14 as f32)
    scene.render.ambient = 0.26 as f32
    scene.render.enable_reflections = false
    scene.render.enable_fxaa = false
    scene.render.enable_light_glow = true
    scene.render.reflection_plane = -1.0 as f32

    scene.render.sky_enabled = true
    scene.render.sun_enabled = true
    scene.render.sun_direction = ecs.make_vec3(0.00 as f32, 0.22 as f32, -1.00 as f32)
    scene.render.sun_color = ecs.make_vec3(1.00 as f32, 0.72 as f32, 0.38 as f32)
    scene.render.sun_size = 0.045 as f32
    scene.render.sun_intensity = 18.0 as f32

    scene.render.fog_enabled = true
    scene.render.fog_color = ecs.make_vec3(0.42 as f32, 0.40 as f32, 0.48 as f32)
    scene.render.fog_density = 0.020 as f32
    scene.render.fog_height = -0.2 as f32
    scene.render.fog_falloff = 0.16 as f32

    scene.render.post_process.enabled = true
    scene.render.post_process.bloom.enabled = true
    scene.render.post_process.bloom.threshold = 1.10 as f32
    scene.render.post_process.bloom.knee = 0.45 as f32
    scene.render.post_process.bloom.intensity = 1.40 as f32
    scene.render.post_process.bloom.radius = 1.60 as f32
    scene.render.post_process.bloom.iterations = 3 as i32
    scene.render.post_process.godrays.enabled = true
    scene.render.post_process.godrays.depth_occlusion = true
    scene.render.post_process.godrays.intensity = 2.20 as f32
    scene.render.post_process.godrays.threshold = 0.40 as f32
    scene.render.post_process.godrays.decay = 0.97 as f32
    scene.render.post_process.godrays.density = 0.92 as f32
    scene.render.post_process.godrays.weight = 1.0 as f32
    scene.render.post_process.godrays.samples = 64 as i32
    scene.render.post_process.godrays.color = ecs.make_vec3(1.00 as f32, 0.78 as f32, 0.48 as f32)
    scene.render.post_process.flare.enabled = true
    scene.render.post_process.flare.intensity = 1.20 as f32
    scene.render.post_process.flare.threshold = 0.80 as f32
    scene.render.post_process.flare.width = 0.62 as f32
    scene.render.post_process.flare.ghosts = 0.55 as f32
    scene.render.post_process.flare.color = ecs.make_vec3(1.00 as f32, 0.70 as f32, 0.40 as f32)
    scene.render.post_process.sharpen.enabled = true
    scene.render.post_process.sharpen.strength = 0.35 as f32
    scene.render.post_process.color_grade.enabled = true
    scene.render.post_process.color_grade.strength = 0.45 as f32
    scene.render.post_process.taa.enabled = true
    scene.render.post_process.taa.blend = 0.92 as f32
    scene.render.post_process.taa.jitter = 1.0 as f32
    scene.render.post_process.exposure = 0.95 as f32
    scene.render.post_process.contrast = 1.12 as f32
    scene.render.post_process.saturation = 1.28 as f32
    scene.render.post_process.chromatic_aberration = 0.0004 as f32
    scene.render.post_process.film_grain = 0.010 as f32
    scene.render.post_process.vignette.enabled = true
    scene.render.post_process.vignette.intensity = 0.24 as f32
    scene.render.post_process.vignette.smoothness = 0.62 as f32

    ecs.add_light(scene, ecs.make_light(
            ecs.make_vec3(2.2 as f32, 1.1 as f32, -2.5 as f32),
            ecs.make_vec3(1.00 as f32, 0.55 as f32, 0.28 as f32),
            2.2 as f32,
            6.0 as f32
        ))
    ecs.add_light(scene, ecs.make_light(
            ecs.make_vec3(-2.4 as f32, 1.8 as f32, -1.5 as f32),
            ecs.make_vec3(0.35 as f32, 0.85 as f32, 1.00 as f32),
            1.8 as f32,
            6.0 as f32
        ))

    ecs.add_floor(scene, ecs.make_floor(-1.2 as f32, 12.0 as f32))

    val pillars: mut list[ecs.InstanceData] = []
    val pillar_x: list[f32] = [-3.2 as f32, -1.8 as f32, -0.4 as f32, 1.0 as f32, 2.4 as f32, 3.8 as f32]
    for x in pillar_x {
        @append(pillars, make_instance(
                ecs.make_vec3(x, -0.20 as f32, -6.0 as f32),
                ecs.make_vec3(0.36 as f32, 2.2 as f32, 0.36 as f32),
                ecs.make_vec3(0.22 as f32, 0.30 as f32, 0.42 as f32),
                0.02 as f32,
                0.10 as f32
            ))
    }
    @append(pillars, make_instance(
            ecs.make_vec3(-1.2 as f32, 0.40 as f32, -3.8 as f32),
            ecs.make_vec3(0.8 as f32, 1.1 as f32, 0.8 as f32),
            ecs.make_vec3(0.60 as f32, 0.30 as f32, 0.25 as f32),
            0.05 as f32,
            0.20 as f32
        ))
    @append(pillars, make_instance(
            ecs.make_vec3(1.6 as f32, 0.20 as f32, -4.2 as f32),
            ecs.make_vec3(0.55 as f32, 0.8 as f32, 0.55 as f32),
            ecs.make_vec3(0.25 as f32, 0.50 as f32, 0.55 as f32),
            0.05 as f32,
            0.20 as f32
        ))
    for pillar in pillars {
        ecs.add_cube_instance(scene, pillar)
    }

    val orbs: mut list[ecs.InstanceData] = []
    val row: mut i32 = 0 as i32
    for row < (5 as i32) {
        val col: mut i32 = 0 as i32
        for col < (7 as i32) {
            val x: f32 = ((col as f32) - (3.0 as f32)) * (1.15 as f32)
            val z: f32 = (((row as f32) - (2.0 as f32)) * (1.15 as f32)) - (1.0 as f32)
            val h: f32 = (0.35 as f32) + (math.sin((x + z) as f64) as f32) * (0.20 as f32)
            val tint: f32 = (col as f32) / (6.0 as f32)
            @append(orbs, make_instance(
                    ecs.make_vec3(x, h, z),
                    ecs.make_vec3(0.16 as f32, 0.16 as f32, 0.16 as f32),
                    ecs.make_vec3(0.20 as f32 + tint * 0.55 as f32, 0.45 as f32, 0.90 as f32 - tint * 0.35 as f32),
                    0.45 as f32,
                    0.35 as f32
                ))
            col = col + (1 as i32)
        }
        row = row + (1 as i32)
    }
    for orb in orbs {
        ecs.add_sphere_instance(scene, orb)
    }

    @append(scene.cubes, ecs.make_cube(
            ecs.make_vec3(0.0 as f32, 0.0 as f32, -8.5 as f32),
            ecs.make_vec3(0.30 as f32, 0.36 as f32, 0.55 as f32),
            1.2 as f32,
            0.05 as f32
        ))
    @append(scene.spheres, ecs.make_sphere(
            ecs.make_vec3(-0.8 as f32, -0.2 as f32, -2.6 as f32),
            ecs.make_vec3(0.90 as f32, 0.42 as f32, 0.20 as f32),
            0.35 as f32
        ))
    return scene
}

fn tonemap_name(mode: i32) ref u8 = {
    if mode == 1 {
        return "REINHARD"
    }
    if mode == 2 {
        return "FILMIC"
    }
    if mode == 3 {
        return "NEUTRAL"
    }
    return "ACES"
}

type (engine.AppEvents) Showcase = {
    hud: mut ref u8
}

pub fn (Showcase) on_start(game: mut self, _: mut engine.ExoApp) void = {
    game.hud = @alloc(256 as usize) as ref u8
}

pub fn (Showcase) on_shutdown(game: mut self, _: mut engine.ExoApp) void = trust {
    if game.hud != none {
        @free(game.hud as ref void)
        game.hud = none as ref u8
    }
}

pub fn (Showcase) on_update(game: mut self, app: mut engine.ExoApp, _: f32, _: f32) void = {
    @snprintf(
        game.hud,
        256 as usize,
        "GRAPHICS SHOWCASE | HDR + BLOOM + GODRAYS + FLARE | TONEMAP: {s} | 1-4 tonemap  G godrays  F flare  S sharpen  L LUT  T TAA  ESC quit",
        {tonemap_name(app.scene.render.post_process.tonemap)}
    )
    ecs.ui_clear(app.scene.ui)
    ecs.ui_rect(
        app.scene.ui,
        16.0 as f32,
        16.0 as f32,
        1170.0 as f32,
        44.0 as f32,
        ecs.make_vec3(0.02 as f32, 0.03 as f32, 0.06 as f32),
        0.72 as f32
    )
    ecs.ui_text(
        app.scene.ui,
        game.hud,
        26.0 as f32,
        26.0 as f32,
        2.0 as f32,
        ecs.make_vec3(1.00 as f32, 0.88 as f32, 0.58 as f32),
        1.0 as f32
    )
}

pub fn (Showcase) on_fixed_update(_: mut self, _: mut engine.ExoApp, _: f32) void = {}

pub fn (Showcase) on_key_down(
    _: mut self,
    app: mut engine.ExoApp,
    key: i32,
    _: bool,
    _: u16
) void = {
    if key == sdl.SDL_SCANCODE_1 {
        app.scene.render.post_process.tonemap = 0 as i32
    }
    if key == sdl.SDL_SCANCODE_2 {
        app.scene.render.post_process.tonemap = 1 as i32
    }
    if key == sdl.SDL_SCANCODE_3 {
        app.scene.render.post_process.tonemap = 2 as i32
    }
    if key == sdl.SDL_SCANCODE_4 {
        app.scene.render.post_process.tonemap = 3 as i32
    }
    if key == sdl.SDL_SCANCODE_G {
        app.scene.render.post_process.godrays.enabled = !app.scene.render.post_process.godrays.enabled
    }
    if key == sdl.SDL_SCANCODE_F {
        app.scene.render.post_process.flare.enabled = !app.scene.render.post_process.flare.enabled
    }
    if key == sdl.SDL_SCANCODE_S {
        app.scene.render.post_process.sharpen.enabled = !app.scene.render.post_process.sharpen.enabled
    }
    if key == sdl.SDL_SCANCODE_L {
        app.scene.render.post_process.color_grade.enabled = !app.scene.render.post_process.color_grade.enabled
    }
    if key == sdl.SDL_SCANCODE_T {
        app.scene.render.post_process.taa.enabled = !app.scene.render.post_process.taa.enabled
    }
    if key == sdl.SDL_SCANCODE_ESCAPE {
        engine.request_quit(app)
    }
}

pub fn (Showcase) on_key_up(_: mut self, _: mut engine.ExoApp, _: i32, _: u16) void = {}

pub fn (Showcase) on_mouse_move(
    _: mut self,
    _: mut engine.ExoApp,
    _: f32,
    _: f32,
    _: f32,
    _: f32
) void = {}

pub fn (Showcase) on_mouse_button(
    _: mut self,
    _: mut engine.ExoApp,
    _: u8,
    _: bool,
    _: u8,
    _: f32,
    _: f32
) void = {}

pub fn (Showcase) on_mouse_wheel(
    _: mut self,
    _: mut engine.ExoApp,
    _: f32,
    _: f32,
    _: f32,
    _: f32
) void = {}

pub fn (Showcase) on_text_input(_: mut self, _: mut engine.ExoApp, _: ref u8) void = {}

pub fn (Showcase) on_window_resize(_: mut self, _: mut engine.ExoApp, _: i32, _: i32) void = {}

pub fn (Showcase) on_focus_changed(_: mut self, _: mut engine.ExoApp, _: bool) void = {}

pub fn (Showcase) on_gamepad_button(_: mut self, _: mut engine.ExoApp, _: i32, _: bool) void = {}

pub fn (Showcase) on_gamepad_axis(_: mut self, _: mut engine.ExoApp, _: i32, _: f32) void = {}

pub fn main() i32 = {
    val builder: mut engine.ExoAppBuilder = engine.new_app()
    engine.with_title(builder, "Exo Graphics Showcase")
    engine.with_resolution(builder, 1280 as i32, 720 as i32)
    engine.with_scene(builder, add_showcase_scene())
    engine.with_default_camera(builder)
    engine.with_shaders(builder, engine.default_shader_config())
    engine.with_key_bindings(builder, rendering.default_key_bindings())
    engine.with_input(builder, rendering.default_input_config())
    val app: engine.ExoApp = engine.build_app(builder)
    val game: Showcase = { hud: none as ref u8 }
    return trust engine.run_app_with_events[Showcase](app, game)
}
