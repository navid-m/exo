#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct UiFragmentUniforms
{
    float4 uColor;
    float4 uParams;
};

struct main0_out
{
    float4 FragColor [[color(0)]];
};

struct main0_in
{
    float2 vTexCoord [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant UiFragmentUniforms& _25 [[buffer(0)]], texture2d<float> uAlbedo [[texture(0)]], sampler uAlbedoSmplr [[sampler(0)]])
{
    main0_out out = {};
    float4 tex = uAlbedo.sample(uAlbedoSmplr, in.vTexCoord);
    float3 color_value = mix(_25.uColor.xyz, tex.xyz, float3(_25.uParams.x));
    float alpha = _25.uParams.y * mix(1.0, tex.w, _25.uParams.x);
    out.FragColor = float4(color_value, alpha);
    return out;
}

