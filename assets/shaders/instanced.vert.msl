vertex main0_out main0(main0_in in [[stage_in]], constant InstancedVertexUniforms& _78 [[buffer(0)]])
{
    main0_out out = {};
    float4x4 model = float4x4(float4(in.aModel0), float4(in.aModel1), float4(in.aModel2), float4(in.aModel3));
