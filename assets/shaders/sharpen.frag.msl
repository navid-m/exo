#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct SharpenUniforms
{
    float4 uParams;
};

struct main0_out
{
    float4 FragColor [[color(0)]];
};

struct main0_in
{
    float2 vTexCoord [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant SharpenUniforms& _13 [[buffer(0)]], texture2d<float> uSceneTex [[texture(0)]], sampler uSceneTexSmplr [[sampler(0)]])
{
    main0_out out = {};
    float2 texel = _13.uParams.yz;
    float3 center = uSceneTex.sample(uSceneTexSmplr, in.vTexCoord).xyz;
    float3 blur = ((uSceneTex.sample(uSceneTexSmplr, (in.vTexCoord + float2(-texel.x, 0.0))).xyz + uSceneTex.sample(uSceneTexSmplr, (in.vTexCoord + float2(texel.x, 0.0))).xyz) + uSceneTex.sample(uSceneTexSmplr, (in.vTexCoord + float2(0.0, -texel.y))).xyz) + uSceneTex.sample(uSceneTexSmplr, (in.vTexCoord + float2(0.0, texel.y))).xyz;
    blur *= 0.25;
    float3 color_value = center + ((center - blur) * _13.uParams.x);
    out.FragColor = float4(max(color_value, float3(0.0)), 1.0);
    return out;
}

