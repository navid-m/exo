#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct BloomBlurUniforms
{
    float4 uTexelDirection;
};

struct main0_out
{
    float4 FragColor [[color(0)]];
};

struct main0_in
{
    float2 vTexCoord [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant BloomBlurUniforms& u [[buffer(0)]], texture2d<float> uSourceTex [[texture(0)]], sampler uSourceTexSmplr [[sampler(0)]])
{
    main0_out out = {};
    float2 offset = u.uTexelDirection.xy * u.uTexelDirection.z;
    float3 color_value = uSourceTex.sample(uSourceTexSmplr, in.vTexCoord).rgb * 0.2270270270;
    color_value += uSourceTex.sample(uSourceTexSmplr, in.vTexCoord + offset * 1.3846153846).rgb * 0.3162162162;
    color_value += uSourceTex.sample(uSourceTexSmplr, in.vTexCoord - offset * 1.3846153846).rgb * 0.3162162162;
    color_value += uSourceTex.sample(uSourceTexSmplr, in.vTexCoord + offset * 3.2307692308).rgb * 0.0702702703;
    color_value += uSourceTex.sample(uSourceTexSmplr, in.vTexCoord - offset * 3.2307692308).rgb * 0.0702702703;
    out.FragColor = float4(color_value, 1.0);
    return out;
}
